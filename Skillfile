# octo-feather skill management, ported from octo-lite's Skillfile
# (varelaseb/octo-lite@cc6fa4e, Apache-2.0; its ADR 0002, kept for reference
# at spec/adr/0002-tdd-skill-vendoring.spec.html).
#
# skillfile (github.com/eljulians/skillfile) pins upstream skills at exact SHAs
# and preserves the tdd seam-gate patch across upstream updates
# (.skillfile/patches). The managed tree materializes into agents/skills and is
# committed. Pi loads it from there: herdr-spawn passes every skill directory
# under skills/ and agents/skills/ with --skill, so there is no per-platform
# mirror and nothing is installed into the user's Pi profile.

install-path  octo-feather  skill  agents/skills

# Managed upstream skills pinned at exact canonical SHAs.
github  skill  tdd  mattpocock/skills@ed37663cc5fbef691ddfecd080dff42f7e7e350d  skills/engineering/tdd
github  skill  code-review  mattpocock/skills@49dd158d1076134a641b33efb035946536778336  skills/engineering/code-review

# octo-feather's own skills, authored locally under skills/ (most ported from octo-lite).
local  skill  commit                  skills/commit
local  skill  github                  skills/github
local  skill  grill-with-docs         skills/grill-with-docs
local  skill  herdr-comms             skills/herdr-comms
local  skill  implement-spec          skills/implement-spec
local  skill  nodejs                  skills/nodejs
local  skill  pnpm                    skills/pnpm
local  skill  pull                    skills/pull
local  skill  push                    skills/push
local  skill  python                  skills/python
local  skill  typescript              skills/typescript
