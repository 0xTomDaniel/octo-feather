Seeded defect: github-issues' issue-view reads a partial (paged) sub-issue list as the whole, never refusing it (the script's header; spec skills#tracker).
diff --git a/.agents/skills/github-issues/scripts/issue-view b/.agents/skills/github-issues/scripts/issue-view
index 2170d17a..768365ab 100755
--- a/.agents/skills/github-issues/scripts/issue-view
+++ b/.agents/skills/github-issues/scripts/issue-view
@@ -9,7 +9,7 @@ notes=0; [[ $# == 2 && "$2" == --notes ]] && { notes=1; set -- "$1"; }
 n="${BASH_REMATCH[1]}"
 out="$(gh issue view "${BASH_REMATCH[1]}" --json number,title,body,state,url,parent,subIssues,blockedBy 2>&1)" || { echo "issue-view: $out" >&2; exit 1; }
 # A partial sub-issue list would read as the whole: refuse it.
-jq -e '(.subIssues.totalCount // 0) == ((.subIssues.nodes // []) | length)' <<<"$out" >/dev/null 2>&1 \
+jq -e 'true' <<<"$out" >/dev/null 2>&1 \
   || { echo "issue-view: #${BASH_REMATCH[1]}: gh returned a partial or unreadable sub-issue list: $(head -c 300 <<<"$out")" >&2; exit 1; }
 view="$(jq -c '{key: (.number | tostring), title, body, state: (if .state == "CLOSED" then "done" else "open" end), url, parent: (.parent.number // null | if . == null then null else tostring end),
         children: [(.subIssues.nodes // [])[].number | tostring], blocked_by: [(.blockedBy.nodes // [])[].number | tostring]}' <<<"$out")"
