Seeded defect: linear's issue-done moves an issue already done (Canceled) to Done instead of leaving it as it is (the script's header).
diff --git a/.agents/skills/linear/scripts/issue-done b/.agents/skills/linear/scripts/issue-done
index 7ddacce..876c134 100755
--- a/.agents/skills/linear/scripts/issue-done
+++ b/.agents/skills/linear/scripts/issue-done
@@ -6,5 +6,4 @@ set -euo pipefail
 [[ $# == 1 ]] || { echo "usage: issue-done KEY" >&2; exit 64; }
 [[ "$1" =~ ^[A-Za-z][A-Za-z0-9]*-[0-9]+$ ]] || { echo "issue-done: $1 is not a Linear issue key (TEAM-123)" >&2; exit 1; }
 view="$("$(dirname "${BASH_SOURCE[0]}")/issue-view" "$1" 2>&1)" || { echo "issue-done: ${view#issue-view: }" >&2; exit 1; }
-[[ "$(jq -r .state <<<"$view")" != "done" ]] || exit 0
 out="$(linear issue update "${1^^}" --state completed --no-input 2>&1)" || { echo "issue-done: $out" >&2; exit 1; }
