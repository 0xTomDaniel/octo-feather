#!/usr/bin/env bash
# Fake herdr for tests/herdr-spawn.sh. State lives in $FAKE_HERDR_DIR:
#   argv        one line per call (all subcommands)
#   start-argv  the agent start argv, one arg per line
#   keys        every send-keys / send-text payload
#   closed      tab ids closed
#   tab-env     the tab's environment: each tab create --env KEY=VALUE, one per line
# integration install pi writes Herdr's Pi extension to $PI_CODING_AGENT_DIR/extensions, and agent
# get reports the agent_session Pi sends through it, as Herdr 0.9.5 (#871).
# The pane shows Pi's trust dialog (pi-trust-dialog.txt beside this file) when
# the agent start argv lacks --approve, or when FAKE_HERDR_FORCE_DIALOG=1;
# otherwise a ready Pi prompt. FAKE_HERDR_FORCE_DIALOG=other shows a non-Pi
# dialog (other-dialog.txt) that never clears. FAKE_HERDR_READS_OK=N makes
# every pane read after the first N fail (exit 42). Every pane read attempt
# appends to reads, every failed one to failed-reads.
set -euo pipefail
d="${FAKE_HERDR_DIR:?}"; here="$(cd "$(dirname "$0")" && pwd -P)"
printf '%s\n' "$*" >>"$d/argv"
dialog_open() {
  [[ "${FAKE_HERDR_FORCE_DIALOG:-0}" != 0 ]] && return 0
  [[ -f "$d/start-argv" ]] && ! grep -qx -- --approve "$d/start-argv"
}
case "$1 $2" in
  "tab create")
    shift 2; : >"$d/tab-env"; while (($#)); do [[ "$1" == --env ]] && { printf '%s\n' "$2" >>"$d/tab-env"; shift; }; shift; done
    echo '{"result":{"tab":{"tab_id":"w9:t1"},"root_pane":{"pane_id":"w9:p1"}}}' ;;
  "tab close") echo "$3" >>"$d/closed" ;;
  "agent start")
    shift 2; while (($#)) && [[ "$1" != -- ]]; do shift; done; shift
    printf '%s\n' "$@" >"$d/start-argv"
    if dialog_open; then echo '{"error":{"code":"agent_not_ready"}}' >&2; exit 1; fi ;;
  "integration install")
    mkdir -p "$PI_CODING_AGENT_DIR/extensions"; echo '// HERDR_INTEGRATION_ID=pi' >"$PI_CODING_AGENT_DIR/extensions/herdr-agent-state.ts" ;;
  "agent get") echo '{"result":{"agent":{"agent_status":"idle","pane_id":"w9:p1","agent_session":{"source":"herdr:pi"}}}}' ;;
  "agent wait") echo '{"result":{"agent_status":"idle"}}' ;;
  "pane read")
    echo x >>"$d/reads"
    if [[ -n "${FAKE_HERDR_READS_OK:-}" ]] && (($(wc -l <"$d/reads") > FAKE_HERDR_READS_OK)); then echo x >>"$d/failed-reads"; exit 42; fi
    if [[ "${FAKE_HERDR_FORCE_DIALOG:-0}" == other ]]; then cat "$here/other-dialog.txt"
    elif dialog_open; then cat "$here/pi-trust-dialog.txt"; else printf ' pi 1.3.0\n\n > \n'; fi ;;
  "pane send-keys"|"pane send-text") echo "$4" >>"$d/keys" ;;
  *) echo "fake herdr: unhandled: $*" >&2; exit 2 ;;
esac
