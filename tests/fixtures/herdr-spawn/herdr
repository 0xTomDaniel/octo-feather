#!/usr/bin/env bash
# Fake herdr for tests/herdr-spawn.sh. State lives in $FAKE_HERDR_DIR:
#   argv        one line per call (all subcommands)
#   start-argv  the agent start argv, one arg per line
#   keys        every send-keys / send-text payload
#   closed      tab ids closed
# The pane shows Pi's trust dialog (pi-trust-dialog.txt beside this file) when
# the agent start argv lacks --approve, or when FAKE_HERDR_FORCE_DIALOG=1;
# otherwise a ready Pi prompt.
set -euo pipefail
d="${FAKE_HERDR_DIR:?}"; here="$(cd "$(dirname "$0")" && pwd -P)"
printf '%s\n' "$*" >>"$d/argv"
dialog_open() {
  [[ "${FAKE_HERDR_FORCE_DIALOG:-0}" == 1 ]] && return 0
  [[ -f "$d/start-argv" ]] && ! grep -qx -- --approve "$d/start-argv"
}
case "$1 $2" in
  "tab create") echo '{"result":{"tab":{"tab_id":"w9:t1"},"root_pane":{"pane_id":"w9:p1"}}}' ;;
  "tab close") echo "$3" >>"$d/closed" ;;
  "agent start")
    shift 2; while (($#)) && [[ "$1" != -- ]]; do shift; done; shift
    printf '%s\n' "$@" >"$d/start-argv"
    if dialog_open; then echo '{"error":{"code":"agent_not_ready"}}' >&2; exit 1; fi ;;
  "agent get") echo '{"result":{"agent":{"agent_status":"idle"}}}' ;;
  "pane read")
    if dialog_open; then cat "$here/pi-trust-dialog.txt"; else printf ' pi 1.3.0\n\n > \n'; fi ;;
  "pane send-keys"|"pane send-text") echo "$4" >>"$d/keys" ;;
  *) echo "fake herdr: unhandled: $*" >&2; exit 2 ;;
esac
