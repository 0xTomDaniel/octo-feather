#!/usr/bin/env python3
# Fake curl for tests/gate/kit/lane_spend.py: OpenRouter's GET /api/v1/key. Logs argv to $FAKE_CURL_DIR/argv.
# Reads the Bearer key from the --config on stdin; sk-test-123 gets the usage windows, any other key 401.
# FAKE_CURL_EXIT set: fails as an unreachable host does, with that exit.
import os, sys

d = os.environ.get("FAKE_CURL_DIR") or sys.exit("fake curl: FAKE_CURL_DIR unset")
with open(f"{d}/argv", "a") as f:
    f.write(" ".join(sys.argv[1:]) + "\n")
cfg = sys.stdin.read().splitlines()
if os.environ.get("FAKE_CURL_EXIT"):
    print("curl: (7) Failed to connect to openrouter.ai port 443", file=sys.stderr)
    sys.exit(int(os.environ["FAKE_CURL_EXIT"]))
if sys.argv[-1] != "https://openrouter.ai/api/v1/key":
    print(f"fake curl: unexpected URL {sys.argv[-1]}", file=sys.stderr)
    sys.exit(3)
if 'header = "Authorization: Bearer sk-test-123"' in cfg:
    sys.stdout.write('{"data":{"label":"x","usage":9,"usage_daily":1.5,"usage_weekly":2.5,"usage_monthly":4.0}}\n200')
else:
    sys.stdout.write('{"error":{"code":401}}\n401')
