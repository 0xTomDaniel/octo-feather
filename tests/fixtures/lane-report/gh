#!/usr/bin/env python3
# Fake gh for tests/lane-report.sh: answers only `gh pr view N --repo O/R --json F` (or -R) from
# $FAKE_GH_PRS/<owner>__<name>/N.json; a call without a repository fails exit 2. Logs argv to
# $FAKE_GH_LOG. FAKE_GH_FAIL=1 fails every call as an unreachable network does.
import json, os, sys
a = sys.argv[1:]
with open(os.environ["FAKE_GH_LOG"], "a") as f:
    f.write(" ".join(a) + "\n")
def die(m, rc=1):
    print(m, file=sys.stderr); sys.exit(rc)
if os.environ.get("FAKE_GH_FAIL"):
    die("error connecting to api.github.com")
if a[:2] != ["pr", "view"] or "--json" not in a:
    die(f"fake gh: unexpected {a}", 2)
flag = next((x for x in ("--repo", "-R") if x in a), None)
if not flag:
    die(f"fake gh: no --repo in {a}", 2)
path = os.path.join(os.environ["FAKE_GH_PRS"], a[a.index(flag) + 1].replace("/", "__"), f"{a[2]}.json")
if not os.path.exists(path):
    die(f"GraphQL: Could not resolve to a PullRequest with the number of {a[2]}.")
d = json.load(open(path))
print(json.dumps({k: d[k] for k in a[a.index("--json") + 1].split(",") if k in d}))
