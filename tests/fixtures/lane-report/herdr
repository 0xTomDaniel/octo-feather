#!/usr/bin/env python3
# Fake herdr for tests/lane-report.sh: `herdr agent list` prints $FAKE_HERDR_AGENTS (a JSON list of
# agents) in Herdr's envelope. FAKE_HERDR_FAIL=1 fails as a herdr with no server does.
import json, os, sys
if os.environ.get("FAKE_HERDR_FAIL"):
    print("error: could not connect to herdr server", file=sys.stderr); sys.exit(1)
if sys.argv[1:] != ["agent", "list"]:
    print(f"fake herdr: unexpected {sys.argv[1:]}", file=sys.stderr); sys.exit(2)
print(json.dumps({"id": "1", "result": {"agents": json.load(open(os.environ["FAKE_HERDR_AGENTS"]))}}))
