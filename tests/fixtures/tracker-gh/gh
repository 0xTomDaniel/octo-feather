#!/usr/bin/env python3
"""gh: an offline fake of the GitHub CLI for the kit's correction-lane tests; never the network.

One JSON store, $FAKE_GH_STORE:
  {"issues": [{"number", "repo", "title", "body", "state" (OPEN|CLOSED), "closedAt", "comments"}],
   "repos": {"OWNER/NAME": {"nameWithOwner", "createdAt", ...}}}
(created when absent). The repo is --repo, else $GH_REPO, else "local/repo". It takes only:
  issue list [--repo R] --state all --limit N --search 'WORDS in:title' --json FIELDS
    issues whose title has WORDS
  issue create --title T --body-file F|-
    prints the new issue's url
  repo view OWNER/NAME --json FIELDS
    its "repos" entry's FIELDS (null when absent); an unstored one fails as real gh 2.102.0:
    `GraphQL: Could not resolve to a Repository with the name 'OWNER/NAME'. (repository)`, exit 1
Anything else is refused, exit 1, naming the call.
"""

import json
import os
import sys
from pathlib import Path
from typing import NoReturn, cast

Issue = dict[str, object]

STORE = Path(os.environ["FAKE_GH_STORE"])
argv = sys.argv[1:]


def refuse(why: str) -> NoReturn:
    sys.stderr.write(f"gh (offline fake): {why}: gh {' '.join(argv)}\n")
    sys.exit(1)


def opts(args: list[str]) -> dict[str, str]:
    out: dict[str, str] = {}
    i = 0
    while i < len(args):
        if not args[i].startswith("--") or i + 1 >= len(args):
            refuse(f"unsupported argument {args[i]}")
        out[args[i]] = args[i + 1]
        i += 2
    return out


def load() -> dict[str, list[Issue]]:
    if not STORE.exists():
        return {"issues": []}
    with STORE.open() as f:
        return cast("dict[str, list[Issue]]", json.load(f))


db = load()
issues = db["issues"]
if argv[:2] == ["issue", "list"]:
    o = opts(argv[2:])
    if set(o) - {"--repo", "--state", "--limit", "--search", "--json"} or o.get("--state") != "all":
        refuse("unsupported flags")
    repo = o.get("--repo") or os.environ.get("GH_REPO") or "local/repo"
    words = o["--search"].removesuffix(" in:title").strip('"')
    fields = o["--json"].split(",")
    hits = [i for i in issues if i["repo"] == repo and words in str(i["title"])]
    hits = hits[: int(o["--limit"])]
    sys.stdout.write(json.dumps([{f: i.get(f) for f in fields} for i in hits]) + "\n")
elif argv[:2] == ["issue", "create"]:
    o = opts(argv[2:])
    if set(o) != {"--title", "--body-file"}:
        refuse("unsupported flags")
    f = o["--body-file"]
    body = sys.stdin.read() if f == "-" else Path(f).read_text()
    repo = os.environ.get("GH_REPO") or "local/repo"
    n = max((cast("int", i["number"]) for i in issues), default=900) + 1
    issues.append(
        {
            "number": n,
            "repo": repo,
            "title": o["--title"],
            "body": body,
            "state": "OPEN",
            "closedAt": None,
            "comments": [],  # as gh: an issue with no comment lists none
        }
    )
    with STORE.open("w") as out:
        json.dump(db, out, indent=1)
    sys.stdout.write(f"https://github.com/{repo}/issues/{n}\n")
elif argv[:2] == ["repo", "view"] and len(argv) == 5 and argv[3] == "--json":
    repos = cast("dict[str, dict[str, object]]", cast("dict[str, object]", db).get("repos") or {})
    if argv[2] not in repos:
        sys.stderr.write(
            f"GraphQL: Could not resolve to a Repository with the name '{argv[2]}'. (repository)\n"
        )
        sys.exit(1)
    sys.stdout.write(json.dumps({f: repos[argv[2]].get(f) for f in argv[4].split(",")}) + "\n")
else:
    refuse("unsupported call")
