#!/usr/bin/env python3
"""gh: an offline fake of the GitHub CLI for the kit's correction-lane tests; never the network.
One JSON store, $FAKE_GH_STORE: {"issues": [{"number", "repo", "title", "body", "state" (OPEN|CLOSED), "closedAt"}]}
(created when absent). The repo is --repo, else $GH_REPO, else "local/repo". It takes only:
  issue list [--repo R] --state all --limit N --search 'WORDS in:title' --json FIELDS   issues whose title has WORDS
  issue create --title T --body-file F|-                                                 prints the new issue's url
Anything else is refused, exit 1, naming the call."""
import json, os, sys

STORE = os.environ["FAKE_GH_STORE"]
argv = sys.argv[1:]


def refuse(why):
    print(f"gh (offline fake): {why}: gh {' '.join(argv)}", file=sys.stderr)
    sys.exit(1)


def opts(args):
    out, i = {}, 0
    while i < len(args):
        if not args[i].startswith("--") or i + 1 >= len(args):
            refuse(f"unsupported argument {args[i]}")
        out[args[i]] = args[i + 1]
        i += 2
    return out


db = json.load(open(STORE)) if os.path.exists(STORE) else {"issues": []}
if argv[:2] == ["issue", "list"]:
    o = opts(argv[2:])
    if set(o) - {"--repo", "--state", "--limit", "--search", "--json"} or o.get("--state") != "all":
        refuse("unsupported flags")
    repo = o.get("--repo") or os.environ.get("GH_REPO") or "local/repo"
    words = o["--search"].removesuffix(" in:title").strip('"')
    fields = o["--json"].split(",")
    hits = [i for i in db["issues"] if i["repo"] == repo and words in i["title"]][: int(o["--limit"])]
    print(json.dumps([{f: i.get(f) for f in fields} for i in hits]))
elif argv[:2] == ["issue", "create"]:
    o = opts(argv[2:])
    if set(o) != {"--title", "--body-file"}:
        refuse("unsupported flags")
    f = o["--body-file"]
    body = sys.stdin.read() if f == "-" else open(f).read()
    repo = os.environ.get("GH_REPO") or "local/repo"
    n = max((i["number"] for i in db["issues"]), default=900) + 1
    db["issues"].append({"number": n, "repo": repo, "title": o["--title"], "body": body, "state": "OPEN", "closedAt": None})
    json.dump(db, open(STORE, "w"), indent=1)
    print(f"https://github.com/{repo}/issues/{n}")
else:
    refuse("unsupported call")
