#!/usr/bin/env python3
"""Stub `pi` at the classifier boundary, first on PATH for a test or a verify drive.

`pi --version` exits 0. An extension command (`pi ... -e EXT -p "/cmd args"`, the kit's one
classify path) runs for real under node with harness.mjs here: a stub model registry listing one
classifier, STUB_KIT (default: the kit's judgment model, evals/judgment-model.json), and each
provider/id in STUB_ALSO (space-separated), a classify call to any of which exits 5 (only STUB_KIT
may be asked). Every answer
is STUB_ANSWER at confidence STUB_CONFIDENCE (default 0.91), the rest spread over the other
labels; STUB_ANSWER unset: each call fails with a provider error. STUB_WANT: a state not
containing it is refused with an error naming it (the caller's proof of what the classifier was
shown); with STUB_WANT_EXACT=1, a state not equal to it, byte for byte, is refused with an
error naming it. Anything else exits 2. STUB_LAUNCHED set: every call first appends its argv
there, a JSON list per line (a caller's proof that nothing started pi). As pi's print mode, an extension's stdout goes to stderr.
node is the kit's pin (its mise.toml, asked of mise for the kit's dir), else the first on
PATH: from a bare pane, the node on PATH is mise's shim, which in a dir pinning no node (a
scratch target, qc's advice run) resolves no version and, the qc sandbox turning the shims'
system fallback off (docs/adr/0022), fails (#465).
"""

import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

here = Path(__file__).resolve().parent
a = sys.argv[1:]
if os.environ.get("STUB_LAUNCHED"):
    with Path(os.environ["STUB_LAUNCHED"]).open("a") as f:
        f.write(json.dumps(a) + "\n")
if a == ["--version"]:
    sys.exit(0)
if "-p" not in a or "-e" not in a or not a[a.index("-p") + 1].startswith("/"):
    sys.exit(f"stub pi: only an extension command, got {a}")
model_file = here.parents[2] / "evals" / "judgment-model.json"
kit_model = os.environ.get("STUB_KIT") or json.loads(model_file.read_text())["model"]
name, _, args = a[a.index("-p") + 1][1:].partition(" ")
ext = a[a.index("-e") + 1]
mise = shutil.which("mise")
node = "node"
if mise:
    w = subprocess.run(
        [mise, "-C", str(here.parents[2]), "which", "node"],
        capture_output=True,
        text=True,
        check=False,
    )
    node = w.stdout.strip() if w.returncode == 0 and w.stdout.strip() else node
run = [node, str(here / "harness.mjs"), ext, name, args, kit_model]
sys.exit(subprocess.run(run, check=False).returncode)
