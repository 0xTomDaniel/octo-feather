#!/usr/bin/env python3
"""Recording-only nohup boundary for start.sh, never executes a model.

The FIFO is held until process exit, not merely until the invocation is recorded.
Python stdlib handles the handshake; pidfd is the real Linux process-exit API.
"""
import json
import os
from pathlib import Path
import select
import signal
import sys

if Path(sys.argv[0]).name == "nohup":
    fd = os.open(os.environ["START_COMPLETION"], os.O_WRONLY)
    os.write(fd, (json.dumps([os.getpid(), sys.argv[1:]]) + "\n").encode())
    # No close before exit: EOF means there can be no more fixture writes.
    os._exit(0)

signal.alarm(10)
with open(sys.argv[1], encoding="utf-8") as stream:
    pid, argv = json.load(stream)
assert argv == [sys.argv[2], "reflect", "--director", "--due"], argv
try:
    fd = os.pidfd_open(pid)
except ProcessLookupError:
    pass
else:
    try:
        assert select.select([fd], [], [], 10)[0], "nohup fixture still alive"
    finally:
        os.close(fd)
print("start reflection boundary: invocation recorded, process exited")
