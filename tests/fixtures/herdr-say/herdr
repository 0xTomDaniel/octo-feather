#!/usr/bin/env bash
# Fake herdr for tests/herdr-spawn.sh, tests/herdr-say.sh and tests/herdr-close.sh. State lives in $FAKE_HERDR_DIR:
#   argv     one line per call
#   spaces   existing workspaces, one "LABEL ID" per line
#   agents   started agents, one "NAME PANE [TAB]" per line; agent get reports TAB as tab_id
#   prompts  every delivered prompt, "TARGET<TAB>MESSAGE"
#   closed   tab ids closed
#   shells   a pane's shell, "PANE PID" per line; pane process-info answers PID, else a stand-in
#            shell it starts (a real process, ending once this dir is gone)
# integration install pi writes Herdr's Pi extension to $PI_CODING_AGENT_DIR/extensions, and agent
# get reports the agent_session Pi sends through it, as Herdr 0.9.5 (#871).
# A workspace create makes w8 with seed tab w8:t1; a tab create in workspace W
# makes tab W:t9 with pane W:p9. A prompt reaches only a started agent, by name
# or pane; any other target is agent_not_found.
set -euo pipefail
d="${FAKE_HERDR_DIR:?}"
printf '%s\n' "$*" >>"$d/argv"
touch "$d/spaces" "$d/agents" "$d/shells"
opt() { # $1: flag; rest: args. Prints the flag's value.
  local f="$1"; shift
  while (($#)); do [[ "$1" == "$f" ]] && { printf '%s\n' "$2"; return; }; shift; done
}
live() { awk -v t="$1" '$1 == t || $2 == t {print $2; exit}' "$d/agents"; }
named() { awk -v t="$1" '$1 == t || $2 == t {print $1; exit}' "$d/agents"; }
case "$1 $2" in
  "workspace list")
    jq -Rn '{result: {workspaces: [inputs | split(" ") | {label: .[0], workspace_id: .[1]}]}}' "$d/spaces" ;;
  "workspace create")
    echo "$(opt --label "$@") w8" >>"$d/spaces"
    echo '{"result":{"workspace":{"workspace_id":"w8"},"tab":{"tab_id":"w8:t1"}}}' ;;
  "workspace close") ;;
  "workspace get") echo '{"result":{"workspace":{"tab_count":2}}}' ;;
  "tab get") echo '{"result":{"tab":{"label":"worker"}}}' ;;
  "tab create")
    w="$(opt --workspace "$@")"
    printf '{"result":{"tab":{"tab_id":"%s:t9"},"root_pane":{"pane_id":"%s:p9"}}}\n' "$w" "$w" ;;
  "tab close") echo "$3" >>"$d/closed" ;;
  "integration install")
    mkdir -p "$PI_CODING_AGENT_DIR/extensions"; echo '// HERDR_INTEGRATION_ID=pi' >"$PI_CODING_AGENT_DIR/extensions/herdr-agent-state.ts" ;;
  "agent start") echo "$3 $(opt --pane "$@")" >>"$d/agents" ;;
  "agent get")
    p="$(live "$3")"
    [[ -n "$p" ]] || { echo '{"error":{"code":"agent_not_found"}}'; exit 1; }
    printf '{"result":{"agent":{"agent_status":"idle","name":"%s","pane_id":"%s","workspace_id":"%s","tab_id":"%s","agent_session":{"source":"herdr:pi"}}}}\n' \
      "$(named "$3")" "$p" "${p%%:*}" "$(awk -v t="$3" '$1 == t || $2 == t {print $3; exit}' "$d/agents")" ;;
  "agent wait")
    [[ -n "$(live "$3")" ]] || { echo '{"error":{"code":"agent_not_found"}}'; exit 1; }
    echo '{"result":{"agent_status":"idle"}}' ;;
  "agent prompt")
    [[ -n "$(live "$3")" ]] || { echo '{"error":{"code":"agent_not_found"}}'; exit 1; }
    printf '%s\t%s\n' "$3" "$4" >>"$d/prompts"; echo '{"result":{}}' ;;
  "pane read") printf ' pi 1.3.0\n\n > \n' ;;
  "pane list")
    jq -Rn --arg w "$(opt --workspace "$@")" '{result: {panes: [inputs | split(" ") | select(.[1] | startswith($w + ":"))
      | {pane_id: .[1], tab_id: .[2], workspace_id: $w, terminal_id: ("term_" + .[1]), focused: false,
        agent_status: "idle", revision: 0}], type: "pane_list"}}' "$d/agents" ;;
  "pane process-info")
    p="$(opt --pane "$@")"; pid="$(awk -v p="$p" '$1 == p {print $2; exit}' "$d/shells")"
    [[ -n "$pid" ]] || { sh -c 'i=0; while [ -d "$1" ] && [ $i -lt 600 ]; do sleep 1; i=$((i+1)); done' sh "$d" >/dev/null 2>&1 </dev/null & pid=$!; }
    printf '{"result":{"process_info":{"pane_id":"%s","shell_pid":%s},"type":"pane_process_info"}}\n' "$p" "$pid" ;;
  *) echo "fake herdr: unhandled: $*" >&2; exit 2 ;;
esac
