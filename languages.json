{
  "languages": {
    "python": {
      "extensions": [
        ".py"
      ],
      "shebangs": [
        "python"
      ],
      "tools": [
        "ruff",
        "ruff-format",
        "basedpyright",
        "python-compile"
      ]
    },
    "shell": {
      "extensions": [
        ".sh"
      ],
      "shebangs": [
        "bash",
        "sh"
      ],
      "tools": [
        "shellcheck"
      ]
    },
    "typescript": {
      "extensions": [
        ".ts"
      ],
      "shebangs": [],
      "tools": [
        "tsc",
        "eslint"
      ]
    },
    "javascript": {
      "extensions": [
        ".js",
        ".cjs"
      ],
      "shebangs": [
        "node"
      ],
      "tools": [
        "tsc",
        "eslint"
      ]
    }
  },
  "tools": {
    "ruff": {
      "program": "ruff",
      "argv": [
        "ruff"
      ],
      "recipe": "check-lint",
      "adapter": "lint",
      "install": "uv sync --locked"
    },
    "ruff-format": {
      "program": "ruff",
      "argv": [
        "ruff"
      ],
      "recipe": "check-format",
      "adapter": "format",
      "install": "uv sync --locked"
    },
    "basedpyright": {
      "program": "basedpyright",
      "argv": [
        "basedpyright"
      ],
      "recipe": "check-types",
      "adapter": "types",
      "install": "uv sync --locked"
    },
    "shellcheck": {
      "program": "shellcheck",
      "argv": [
        "shellcheck",
        "-S",
        "warning"
      ],
      "recipe": "check-scripts",
      "install": "install ShellCheck at shellcheck-version: https://github.com/koalaman/shellcheck/releases"
    },
    "tsc": {
      "program": "tsc",
      "argv": [
        "pnpm",
        "exec",
        "tsc"
      ],
      "recipe": "check-ts",
      "adapter": "tsc",
      "install": "pnpm install --frozen-lockfile"
    },
    "eslint": {
      "program": "eslint",
      "argv": [
        "pnpm",
        "exec",
        "eslint",
        "--max-warnings",
        "0",
        "--"
      ],
      "recipe": "check-ts",
      "install": "pnpm install --frozen-lockfile"
    },
    "python-compile": {
      "program": "python3",
      "argv": [
        "python3",
        "-m",
        "py_compile"
      ],
      "adapter": "compile",
      "recipe": "check-scripts",
      "install": "install Python3"
    }
  },
  "exemptions": [
    {
      "path": "templates",
      "reason": "Each generated target runs its own gate; template adoption is issue362."
    },
    {
      "path": "evals",
      "reason": "Frozen evaluation cases and deliberately flawed target fixtures, not kit runtime."
    },
    {
      "path": "evidence",
      "reason": "Frozen transcripts and reproductions of historical failures."
    },
    {
      "path": "docs/specs/.viz",
      "reason": "Pinned Spec Chat upstream runtime, owned and validated upstream."
    },
    {
      "path": "docs/specs/.style",
      "reason": "Pinned Spec Chat upstream stylesheet assets."
    },
    {
