-def farewell(name: str) -> Farewell:
+def farewell(name: str, *, wave: bool = False) -> Farewell:
     trimmed = name.strip()
     if len(trimmed) == 0:
         error = "name must not be empty"
         raise ValueError(error)
     text = "Goodbye, " + trimmed
+    if wave:
+        text += " o/"
     return Farewell(name=trimmed, text=text)
