set shell := ["bash", "-euo", "pipefail", "-c"]

default:
    @just --list

# Dependencies and the git hook.
setup:
    just setup-dependencies
    git config core.hooksPath .githooks

# Frozen install from the lockfile; the store rule: docs/pnpm-setup.md.
setup-dependencies:
    pnpm install --frozen-lockfile

# The gate: compiler and tests.
check:
    pnpm exec tsc --noEmit
    node --test test/*.test.ts
