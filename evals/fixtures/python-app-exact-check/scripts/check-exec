#!/usr/bin/env bash
# Every file tracked under scripts/ and .githooks/ is executable in git (ticket T6).
set -euo pipefail
status=0
while read -r mode _ _ path; do
  if [ "$mode" != 100755 ]; then
    echo "check-exec: $path: git mode $mode, want 100755 (git update-index --chmod=+x $path)" >&2
    status=1
  fi
done < <(git ls-files -s -- scripts .githooks)
exit "$status"
