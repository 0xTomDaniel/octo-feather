#!/usr/bin/env python3
"""octo-feather-shape [--json] [pi args...]   (`just shape`, docs/adr/0021)

Start the shaper role in the target repo: `pi-role agents/shaper.md` from the
kit, run from the working directory, so its listed kit skills load and its
externalSkills (Spec Chat's) come from the target repo's .agents/skills, never
home (pi-role --help). --json prints pi-role's launch (pi-role --json).
"""
import os, subprocess, sys
from pathlib import Path

KIT = Path(__file__).resolve().parent.parent


def main(argv):
    # Review state never lands in the target's tracked tree (octo-feather-exclude).
    if subprocess.run(["git", "rev-parse", "--is-inside-work-tree"], capture_output=True).returncode == 0:
        subprocess.run([str(KIT / "scripts" / "octo-feather-exclude")], stdout=sys.stderr, check=False)
    as_json = argv[:1] == ["--json"]
    pi_role = str(KIT / "scripts" / "pi-role")
    role = str(KIT / "agents" / "shaper.md")
    os.execv(pi_role, [pi_role, *(["--json"] if as_json else []), role, *argv[as_json:]])


if __name__ == "__main__":
    main(sys.argv[1:])
