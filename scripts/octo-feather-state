#!/usr/bin/env bash
# Print octo-feather's state directory for the caller's Herdr session: the one
# holding that session's lanes/ and operator files. The session key is
# ${HERDR_SESSION:-default}, as Herdr exports it to every pane of a named
# session and to none of the default one. The default session's directory is
# the top one, beside the box's onboarding file; a named session's is
# sessions/<key> under it, as Herdr keeps its own.
# Ported from octo-lite's state command (varelaseb/octo-lite@cc6fa4e, Apache-2.0).
set -euo pipefail
dir="${XDG_STATE_HOME:-$HOME/.local/state}/octo-feather"
[[ "${HERDR_SESSION:-default}" == default ]] || dir+="/sessions/$HERDR_SESSION"
printf '%s\n' "$dir"
