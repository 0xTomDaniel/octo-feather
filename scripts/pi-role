#!/usr/bin/env python3
"""pi-role [--json | --print-env] AGENT_FILE [extra pi args...]
pi-role --set-identity NAME EMAIL

Start Pi under one of this kit's role files (agents/<role>.md, docs/adr/0016):
the frontmatter's model, thinking and tool allowlist, only the listed skills,
and the body appended to Pi's system prompt. Pi still loads the target repo's
AGENTS.md from the working directory, so roles never read it by hand.

Pane:      herdr-spawn --role <role> (calls `pi-role --json` and hands the args
           to `herdr agent start`, and "path", the caller's PATH with mise's
           shims placed before its system dirs when the working directory's
           repo has a mise.toml, as the tab's PATH).
Headless:  pi-role agents/<role>.md -p "<brief>" in the worktree; the final
           message is on stdout. A -p (--print) run has no route to any pane:
           its child gets no OCTO_FEATHER_PARENT, HERDR_PANE_ID, HERDR_TAB_ID
           or HERDR_WORKSPACE_ID (issue #77). A pane launch keeps its env.
           Its Herdr space stays as OCTO_FEATHER_SPEND_SPACE, read only by the
           spend ledger's writer for the lane (octo-feather-lane --help, spend
           record; issue #189).

Frontmatter (one `key: value` per line, lists comma-separated):
  name         must equal the file name; names the cached prompt file
  description  one line for owners; pi-role ignores it
  model        --model
  thinking     --thinking
  tools        --tools (built-in Pi tools only; spec roles#launch-codemode);
               an empty list stays --no-tools. `web` (spec roles#launch-web):
               --extension extensions/web-servers.ts with the kit's web-mcp.json,
               and an `mcp__<server>__*` --tools entry per server in it; any
               other role gets --no-mcp
  skills       --skill for each, from the kit's .agents/skills/ (docs/adr/0018), or,
               for one the target's AGENTS.md also declares on its `Repo skills:`
               line, that declared folder instead, passed once (a declared skill
               outranks the kit's; two folders of one name make Pi load neither);
               {tracker} is the target's tracker skill: `tracker` in
               .octo-feather.toml at the working directory's checkout top,
               github when the file or key is absent (docs/adr/0004). A tracker
               the kit has no skill for refuses the start, naming the ones it has
  externalSkills  optional: skills installed into the target repo, not the kit
               (Spec Chat's), looked up in the target repo's .agents/skills: the
               working directory's checkout, then its main checkout (a lane
               worktree lacks the gitignored install links). Never in home.
               A missing one is skipped with a warning
scripts/check-roles rejects any other key. Pi always gets --no-skills, so a
global skill folder never leaks into a role: only listed skills load.
Pi always gets --approve: project-local files are trusted for that one run, so
Pi's "Trust project folder?" dialog never opens and ~/.pi/agent/trust.json is
never written (issue #3).
Pi always gets --extension for the kit's extensions/resume-on-error.ts
(docs/adr/0023), extensions/results-on-wake.ts (comms spec #roles-goal; its header)
and extensions/spend-ledger.ts (spec spend#writer-agent), and
--octo-feather-role <the role file's name> for the latter's purpose.
Pi always gets --extension for the kit's extensions/skills-loaded.ts with
--octo-feather-skills-loaded: every --skill folder and each other `Repo skills:`
entry of the target's AGENTS.md (declared_skills), checked, never offered.
The rule: spec skills#loading-refuse.

Commit identity (#665, owner ruling #587): one factory setting on the box, the
[identity] table (name, email) of the box onboarding file,
${XDG_STATE_HOME:-~/.local/state}/octo-feather/onboarding.toml (beside the
default session's state, octo-feather-state; its [consent] table: the github-pr
skill). Every launch applies it: the role's environment gets GIT_AUTHOR_NAME,
GIT_AUTHOR_EMAIL, GIT_COMMITTER_NAME and GIT_COMMITTER_EMAIL from it (a pane
launch: --print-env's lines, which herdr-spawn and octo-feather-start ask for
before any tab or workspace, and passes to the tab; --json alone is the launch's
args, which checks read too), so no repo's .git/config needs one. A role that
would commit refuses to start without it, naming the setting and how to set it;
no placeholder, no fallback. Would commit:
its tools include bash (git runs only through bash; no tools key: Pi's default
tools, bash among them), unless its contract never commits: read-only (READ_ONLY:
the code reviewer and the qc judge) or editing and writing without committing
(NO_COMMIT: the general worker). Such a role starts with no identity set, and gets
the identity's env like any role when one is set.
  --print-env      print the environment the launch applies (KEY=VALUE lines), or refuse
  --set-identity   write NAME and EMAIL as the [identity] table, other tables kept
"""
import hashlib, json, os, re, shutil, subprocess, sys, tomllib
from typing import Any, cast

KEYS = {"name", "description", "model", "thinking", "tools", "skills", "externalSkills"}
LIST_KEYS = {"tools", "skills", "externalSkills"}
# A headless run's route to panes: herdr-say --parent and Herdr's own pane ids (#77).
HEADLESS_UNSET = ("OCTO_FEATHER_PARENT", "HERDR_PANE_ID", "HERDR_TAB_ID", "HERDR_WORKSPACE_ID")
# A target's `tracker` value and the kit skill that implements it (spec skills#tracker); the kit
# has a tracker when its skill folder exists. {tracker} on a role's skills line loads it.
TRACKERS = {"github": "github-issues", "linear": "linear"}
DEFAULT_TRACKER = "github"
TRACKER_SLOT = "{tracker}"
# The kit's Pi extensions every role loads, in the kit's extensions/ (issues #152, #187).
EXTENSIONS = ("resume-on-error.ts", "results-on-wake.ts", "spend-ledger.ts")
# A role's `web` tool: the kit's one web server list, loaded by the web extension (spec roles#launch-web).
WEB = "web"
WEB_LIST = "web-mcp.json"
WEB_EXTENSION = "web-servers.ts"
# The launch refuses a skill Pi did not load (spec skills#loading-refuse): the extension and its flag.
SKILLS_EXTENSION = "skills-loaded.ts"
SKILLS_FLAG = "--octo-feather-skills-loaded"
REPO_SKILLS = re.compile(r"^Repo skills:(.*)$", re.M)
# The commit identity (pi-role --help, Commit identity): the onboarding file's table, and the env each key fills.
IDENTITY = "identity"
IDENTITY_ENV = {"GIT_AUTHOR_NAME": "name", "GIT_AUTHOR_EMAIL": "email",
                "GIT_COMMITTER_NAME": "name", "GIT_COMMITTER_EMAIL": "email"}
# Roles whose contract never commits (their Never: no edit, no commit); every other role with bash would.
READ_ONLY = ("code-reviewer", "qc-judge")
# Roles whose contract never commits though they have edit and write (spec roles#general-purpose-workers).
NO_COMMIT = ("general-worker",)


def onboarding_file() -> str:
    """The box onboarding file: the default session's state top (scripts/octo-feather-state), whatever HERDR_SESSION."""
    return os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "octo-feather", "onboarding.toml")


def set_hint() -> str:
    return f'{os.path.abspath(__file__)} --set-identity "Your Name" you@example.com (README, Bootstrap a box)'


def identity() -> tuple[dict[str, str], str]:
    """The launch env the commit identity fills, or why there is none."""
    path = onboarding_file()
    try:
        with open(path, "rb") as f:
            data = tomllib.load(f)
    except FileNotFoundError:
        return {}, f"no file {path}"
    except (OSError, tomllib.TOMLDecodeError) as e:
        return {}, f"cannot read {path}: {e}"
    table = data.get(IDENTITY)
    if not isinstance(table, dict):
        return {}, f"{path} has no [{IDENTITY}] table"
    t = cast("dict[str, object]", table)
    bad = [k for k in ("name", "email") if not isinstance(t.get(k), str) or not str(t.get(k)).strip()
           or not str(t.get(k)).isprintable()]
    if bad:
        return {}, f"[{IDENTITY}] in {path} lacks a non-empty one-line {' and '.join(bad)}"
    return {k: str(t[v]).strip() for k, v in IDENTITY_ENV.items()}, ""


def would_commit(fm: dict[str, Any]) -> bool:
    return "bash" in fm.get("tools", ["bash"]) and fm.get("name") not in READ_ONLY + NO_COMMIT


def launch_env(path: str) -> dict[str, str]:
    """The env every launch of the role at PATH applies: the commit identity; exits naming the setting when a role that
    would commit has none."""
    fm, _ = parse(path)
    env, why = identity()
    if not env and would_commit(fm):
        sys.exit(f"pi-role: {fm.get('name', path)} not started: it would commit, and the factory commit identity is not set "
                 f"({why}). The setting: [{IDENTITY}] name and email in the box onboarding file {onboarding_file()}. "
                 f"Set it once per box: {set_hint()}")
    return env


TABLE = re.compile(r"^\s*\[")


def set_identity(name: str, email: str) -> None:
    """Write [identity] name and email into the onboarding file, every other table kept. The kit's scripts stay stdlib-only
    (AGENTS.md) and tomllib only reads, so the table is written as text: the old [identity] table's lines dropped, the
    new one appended, its strings JSON-quoted (a TOML basic string), and the result read back with tomllib: it must hold
    exactly the old data with the new identity, else nothing is written."""
    name, email = name.strip(), email.strip()
    if not name or not email or not (name + email).isprintable():
        sys.exit("pi-role: --set-identity needs a non-empty one-line NAME and EMAIL")
    path = onboarding_file()
    try:
        with open(path, encoding="utf-8") as f:
            text = f.read()
        old = tomllib.loads(text)
    except FileNotFoundError:
        text, old = "", {}
    except (OSError, UnicodeDecodeError, tomllib.TOMLDecodeError) as e:
        sys.exit(f"pi-role: cannot read {path}: {e}; fix it by hand, then rerun")
    keep: list[str] = []
    skip = False
    for line in text.splitlines():
        if TABLE.match(line):
            skip = re.match(rf"^\s*\[\s*{IDENTITY}\s*\]\s*(#.*)?$", line) is not None
        if not skip:
            keep.append(line)
    body = "\n".join(keep).rstrip("\n")
    new = (body + "\n\n" if body else "") + f"[{IDENTITY}]\nname = {json.dumps(name)}\nemail = {json.dumps(email)}\n"
    want = {**old, IDENTITY: {"name": name, "email": email}}
    try:
        ok = tomllib.loads(new) == want
    except tomllib.TOMLDecodeError:
        ok = False
    if not ok:
        sys.exit(f"pi-role: {path} holds [{IDENTITY}] in a form this writer cannot replace (a dotted key or a subtable); "
                 f"edit its [{IDENTITY}] name and email by hand")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + ".tmp", "w", encoding="utf-8") as f:
        f.write(new)
    os.replace(path + ".tmp", path)
    print(f"pi-role: commit identity {name} <{email}> set in {path}")


def web_patterns(kit: str) -> list[str]:
    """One --tools entry per server in the kit's web list: Pi's tool name rule, mcp__<server>__*."""
    with open(os.path.join(kit, WEB_LIST), encoding="utf-8") as f:
        servers: dict[str, object] = json.load(f).get("mcpServers", {})
    return [f"mcp__{re.sub(r'[^A-Za-z0-9_]', '_', s)}__*" for s in servers]


def parse(path: str) -> tuple[dict[str, Any], str]:
    text = open(path, encoding="utf-8").read()
    m = re.match(r"---\n(.*?)\n---\n?(.*)", text, re.S)
    if not m:
        sys.exit(f"pi-role: {path} has no frontmatter")
    fm: dict[str, Any] = {}
    for line in m.group(1).splitlines():
        k, sep, v = line.partition(":")
        k, v = k.strip(), v.strip()
        if not sep or k not in KEYS:
            sys.exit(f"pi-role: {path}: unsupported frontmatter line {line!r}; keys: {sorted(KEYS)}")
        fm[k] = [x.strip() for x in v.split(",") if x.strip()] if k in LIST_KEYS else v.strip('"')
    return fm, m.group(2).strip()


def skill_roots(path):
    kit = os.path.dirname(os.path.dirname(os.path.abspath(path)))
    return [os.path.join(kit, ".agents", "skills")]


def repo_skill_roots(cwd="."):
    """The target repo's .agents/skills: this checkout's, then the main checkout's."""
    def git(*a):
        r = subprocess.run(["git", "-C", cwd, *a], capture_output=True, text=True)
        return r.stdout.strip() if r.returncode == 0 else ""
    tops = [git("rev-parse", "--show-toplevel") or os.path.abspath(cwd)]
    common = git("rev-parse", "--path-format=absolute", "--git-common-dir")
    if common.endswith("/.git"):
        tops.append(os.path.dirname(common))
    roots = []
    for t in tops:
        r = os.path.join(t, ".agents", "skills")
        if r not in roots:
            roots.append(r)
    return roots


def declared_skills(kit_root: str) -> list[str]:
    """The skill folders the target's AGENTS.md declares on its `Repo skills:` line: the first holding a SKILL.md in
    the target's .agents/skills (repo_skill_roots), then the kit's. A name none holds keeps a folder anyway, the first
    that exists (a dangling link, a folder with no SKILL.md) or the target's, so Pi's check refuses it."""
    roots = cast("list[str]", repo_skill_roots())
    try:
        with open(os.path.join(os.path.dirname(os.path.dirname(roots[0])), "AGENTS.md"), encoding="utf-8") as f:
            m = REPO_SKILLS.search(f.read())
    except (OSError, UnicodeDecodeError):
        return []
    out: list[str] = []
    for s in [x.strip() for x in (m.group(1) if m else "").split(",") if x.strip()]:
        dirs = [os.path.join(d, s) for d in [*roots, kit_root]]
        hit = [d for d in dirs if os.path.isfile(os.path.join(d, "SKILL.md"))] or [d for d in dirs if os.path.lexists(d)]
        out.append(hit[0] if hit else dirs[0])
    return out


def kit_trackers(skills_root):
    """Trackers the kit has: those whose tracker skill is in the kit's .agents/skills."""
    return [t for t, s in TRACKERS.items() if os.path.isfile(os.path.join(skills_root, s, "SKILL.md"))]


def tracker_skill(skills_root, cwd="."):
    """The tracker skill the target at cwd names in its .octo-feather.toml; exits on an unknown one."""
    r = subprocess.run(["git", "-C", cwd, "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    cfg = os.path.join(r.stdout.strip() if r.returncode == 0 else os.path.abspath(cwd), ".octo-feather.toml")
    name = DEFAULT_TRACKER
    if os.path.isfile(cfg):
        try:
            with open(cfg, "rb") as f:
                name = tomllib.load(f).get("tracker", DEFAULT_TRACKER)
        except (OSError, tomllib.TOMLDecodeError) as e:
            sys.exit(f"pi-role: cannot read {cfg}: {e}")
    have = kit_trackers(skills_root)
    if name not in have:
        sys.exit(f"pi-role: unknown tracker {name!r} in {cfg}; the kit has: {', '.join(have) or 'none'}")
    return TRACKERS[name]


def launch(path: str, *, to_file: bool = False):
    fm, body = parse(path)
    args = ["--approve"]
    if fm.get("model"):
        args += ["--model", fm["model"]]
    if fm.get("thinking"):
        args += ["--thinking", fm["thinking"]]
    kit = os.path.dirname(os.path.dirname(os.path.abspath(path)))
    role_tools: list[str] = fm.get("tools", [])
    web = WEB in role_tools
    if "tools" in fm:
        tools = [t for t in role_tools if t != WEB] + ["codemode"] + (web_patterns(kit) if web else [])
        args += ["--tools", ",".join(tools)] if fm["tools"] else ["--no-tools"]
    args += [] if web else ["--no-mcp"]
    args += ["--no-skills"]
    roots = skill_roots(path)
    for e in EXTENSIONS:
        args += ["--extension", os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(path))), "extensions", e)]
    if web:
        args += ["--extension", os.path.join(kit, "extensions", WEB_EXTENSION),
                 "--octo-feather-web-servers", os.path.join(kit, WEB_LIST)]
    args += ["--octo-feather-role", os.path.splitext(os.path.basename(path))[0]]
    tracker = tracker_skill(roots[0])
    # pi-role --help, skills
    declared = declared_skills(roots[0])
    own = {os.path.basename(d): d for d in declared if os.path.isfile(os.path.join(d, "SKILL.md"))}
    for s in fm.get("skills", []):
        s = tracker if s == TRACKER_SLOT else s
        if s in own:
            declared.remove(own[s])
        for r in [os.path.dirname(own[s])] if s in own else roots:
            if os.path.isfile(os.path.join(r, s, "SKILL.md")):
                args += ["--skill", os.path.join(r, s)]
                break
        else:
            sys.exit(f"pi-role: skill {s} not found in {roots}")
    ext = repo_skill_roots()
    for s in fm.get("externalSkills", []):
        hit = [os.path.join(d, s) for d in ext if os.path.isfile(os.path.join(d, s, "SKILL.md"))]
        if hit:
            args += ["--skill", hit[0]]
        else:
            print(f"pi-role: external skill {s} not installed in {' or '.join(ext)}; skipped", file=sys.stderr)
    listed = [args[i + 1] for i, a in enumerate(args) if a == "--skill"]
    args += ["--extension", os.path.join(kit, "extensions", SKILLS_EXTENSION),
             SKILLS_FLAG, json.dumps({"role": fm.get("name", ""), "listed": listed, "declared": declared})]
    if body:
        if to_file:
            # A pane launch goes through `herdr agent start`; hand Pi a file,
            # not a 100-line argv string.
            d = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "octo-feather", "roles")
            os.makedirs(d, exist_ok=True)
            f = os.path.join(d, f"{fm.get('name', 'role')}-{hashlib.sha256(body.encode()).hexdigest()[:12]}.md")
            if not os.path.exists(f):
                with open(f + ".tmp", "w", encoding="utf-8") as h:
                    h.write(body + "\n")
                os.replace(f + ".tmp", f)
            args += ["--append-system-prompt", f]
        else:
            args += ["--append-system-prompt", body]
    return args


def mise_shims():
    """mise's shims dir, as mise itself reports it, when the working directory's repo has its own mise.toml
    (the kit, a repo the kit created, or one that chose mise itself); else None. Agent shells are
    non-interactive, so no mise activate hook runs: the headless exec below and herdr-spawn's tab (from
    --json's "path") put this dir on PATH before the system dirs (with_mise; owner ruling, #261).
    Never in a repo without mise.toml: there a shim would read its .tool-versions and install or swap a tool the repo's own setup runs
    (carry gh261 shims-foreign). No mise on PATH: None (`just install-check` names the missing mise)."""
    r = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    top = r.stdout.strip() if r.returncode == 0 else "."
    if not os.path.isfile(os.path.join(top, "mise.toml")) or not shutil.which("mise"):
        return None
    r = subprocess.run(["mise", "doctor", "--json"], capture_output=True, text=True)
    try:
        return json.loads(r.stdout)["dirs"]["shims"]
    except (ValueError, KeyError, TypeError):
        sys.exit(f"pi-role: mise doctor --json gave no dirs.shims (exit {r.returncode}): {r.stderr.strip()}")


# The system default dirs: mise's dir goes just before the first of these on a PATH, so it replaces only
# what would resolve from the system; every dir a caller put earlier (a test stub, a user's tools, an npm
# global) still wins (#261: CI's real Pi in mise's node prefix shadowed the tests' stub pi).
SYSTEM_DIRS = ("/usr/local/sbin", "/usr/local/bin", "/usr/sbin", "/usr/bin", "/sbin", "/bin")


def with_mise(path: str, mise_dir: str) -> str:
    """PATH with mise_dir before its first system dir (at the end when it has none), once."""
    dirs = [d for d in path.split(os.pathsep) if d and d != mise_dir]
    at = next((i for i, d in enumerate(dirs) if d.rstrip("/") in SYSTEM_DIRS), len(dirs))
    return os.pathsep.join([*dirs[:at], mise_dir, *dirs[at:]])


def mise_path():
    """The caller's PATH with mise's shims placed (with_mise), or None when there are no shims to place."""
    shims = mise_shims()
    return with_mise(os.environ.get("PATH", ""), shims) if shims else None


def mise_shims_first():
    path = mise_path()
    if path:
        os.environ["PATH"] = path


def main(argv: list[str]):
    match argv:
        case ["--set-identity", name, email]:
            set_identity(name, email)
            return
        case ["--set-identity", *_]:
            sys.exit("usage: pi-role --set-identity NAME EMAIL")
        case _:
            pass
    print_env = argv[:1] == ["--print-env"]
    as_json = argv[:1] == ["--json"]
    if as_json or print_env:
        argv = argv[1:]
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip(), file=sys.stderr)
        sys.exit(64)
    if print_env:
        sys.stdout.writelines(f"{k}={v}\n" for k, v in launch_env(argv[0]).items())
        return
    args = launch(argv[0], to_file=as_json) + argv[1:]
    if as_json:
        path = mise_path()
        print(json.dumps({"args": args, **({"path": path} if path else {})}))
        return
    os.environ.update(launch_env(argv[0]))
    flags = argv[1:argv.index("--")] if "--" in argv else argv[1:]
    if "-p" in flags or "--print" in flags:
        if os.environ.get("HERDR_WORKSPACE_ID"):
            os.environ["OCTO_FEATHER_SPEND_SPACE"] = os.environ["HERDR_WORKSPACE_ID"]
        for v in HEADLESS_UNSET:
            os.environ.pop(v, None)
    mise_shims_first()
    os.execvp("pi", ["pi", *args])


if __name__ == "__main__":
    main(sys.argv[1:])
