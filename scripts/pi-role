#!/usr/bin/env python3
"""pi-role [--json] AGENT_FILE [extra pi args...]

Start Pi under one of this kit's role files (agents/<role>.md, docs/adr/0016):
the frontmatter's model, thinking and tool allowlist, only the listed skills,
and the body appended to Pi's system prompt. Pi still loads the target repo's
AGENTS.md from the working directory, so roles never read it by hand.

Pane:      herdr-spawn --role <role> (calls `pi-role --json` and hands the args
           to `herdr agent start`).
Headless:  pi-role agents/<role>.md -p "<brief>" in the worktree; the final
           message is on stdout.

Frontmatter (one `key: value` per line, lists comma-separated):
  name         must equal the file name; names the cached prompt file
  description  one line for owners; pi-role ignores it
  model        --model
  thinking     --thinking
  tools        --tools (built-in Pi tools only)
  skills       --skill for each, from the kit's .agents/skills/ (docs/adr/0018)
  externalSkills  optional: skills installed into the target repo, not the kit
               (Spec Chat's), looked up in the target repo's .agents/skills: the
               working directory's checkout, then its main checkout (a lane
               worktree lacks the gitignored install links). Never in home.
               A missing one is skipped with a warning
scripts/check-roles rejects any other key. Pi always gets --no-skills, so a
global skill folder never leaks into a role: only listed skills load.
Pi always gets --approve: project-local files are trusted for that one run, so
Pi's "Trust project folder?" dialog never opens and ~/.pi/agent/trust.json is
never written (issue #3).
"""
import hashlib, json, os, re, subprocess, sys

KEYS = {"name", "description", "model", "thinking", "tools", "skills", "externalSkills"}
LIST_KEYS = {"tools", "skills", "externalSkills"}


def parse(path):
    text = open(path, encoding="utf-8").read()
    m = re.match(r"---\n(.*?)\n---\n?(.*)", text, re.S)
    if not m:
        sys.exit(f"pi-role: {path} has no frontmatter")
    fm = {}
    for line in m.group(1).splitlines():
        k, sep, v = line.partition(":")
        k, v = k.strip(), v.strip()
        if not sep or k not in KEYS:
            sys.exit(f"pi-role: {path}: unsupported frontmatter line {line!r}; keys: {sorted(KEYS)}")
        fm[k] = [x.strip() for x in v.split(",") if x.strip()] if k in LIST_KEYS else v.strip('"')
    return fm, m.group(2).strip()


def skill_roots(path):
    kit = os.path.dirname(os.path.dirname(os.path.abspath(path)))
    return [os.path.join(kit, ".agents", "skills")]


def repo_skill_roots(cwd="."):
    """The target repo's .agents/skills: this checkout's, then the main checkout's."""
    def git(*a):
        r = subprocess.run(["git", "-C", cwd, *a], capture_output=True, text=True)
        return r.stdout.strip() if r.returncode == 0 else ""
    tops = [git("rev-parse", "--show-toplevel") or os.path.abspath(cwd)]
    common = git("rev-parse", "--path-format=absolute", "--git-common-dir")
    if common.endswith("/.git"):
        tops.append(os.path.dirname(common))
    roots = []
    for t in tops:
        r = os.path.join(t, ".agents", "skills")
        if r not in roots:
            roots.append(r)
    return roots


def launch(path, to_file=False):
    fm, body = parse(path)
    args = ["--approve"]
    if fm.get("model"):
        args += ["--model", fm["model"]]
    if fm.get("thinking"):
        args += ["--thinking", fm["thinking"]]
    if "tools" in fm:
        args += ["--tools", ",".join(fm["tools"])] if fm["tools"] else ["--no-tools"]
    args += ["--no-mcp", "--no-skills"]
    roots = skill_roots(path)
    for s in fm.get("skills", []):
        for r in roots:
            if os.path.isfile(os.path.join(r, s, "SKILL.md")):
                args += ["--skill", os.path.join(r, s)]
                break
        else:
            sys.exit(f"pi-role: skill {s} not found in {roots}")
    ext = repo_skill_roots()
    for s in fm.get("externalSkills", []):
        hit = [os.path.join(d, s) for d in ext if os.path.isfile(os.path.join(d, s, "SKILL.md"))]
        if hit:
            args += ["--skill", hit[0]]
        else:
            print(f"pi-role: external skill {s} not installed in {' or '.join(ext)}; skipped", file=sys.stderr)
    if body:
        if to_file:
            # A pane launch goes through `herdr agent start`; hand Pi a file,
            # not a 100-line argv string.
            d = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "octo-feather", "roles")
            os.makedirs(d, exist_ok=True)
            f = os.path.join(d, f"{fm.get('name', 'role')}-{hashlib.sha256(body.encode()).hexdigest()[:12]}.md")
            if not os.path.exists(f):
                with open(f + ".tmp", "w", encoding="utf-8") as h:
                    h.write(body + "\n")
                os.replace(f + ".tmp", f)
            args += ["--append-system-prompt", f]
        else:
            args += ["--append-system-prompt", body]
    return args


def main(argv):
    as_json = bool(argv) and argv[0] == "--json"
    if as_json:
        argv = argv[1:]
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip(), file=sys.stderr)
        sys.exit(64)
    args = launch(argv[0], to_file=as_json) + argv[1:]
    if as_json:
        print(json.dumps({"args": args}))
        return
    os.execvp("pi", ["pi", *args])


if __name__ == "__main__":
    main(sys.argv[1:])
