#!/usr/bin/env bash
# octo-feather-integrate TICKET REF...   (also: just integrate TICKET REF...)
#
# Integrate named worker commits onto the lane's integration branch, then run
# that worktree's `just check` (docs/adr/0017). Run from anywhere in the target
# repo. A branch REF is merged (--no-ff); any other REF is a commit and is
# cherry-picked (-x), in the order given.
#
# All or nothing: on a conflict or a red gate the lane branch is reset to where
# it started, and the supervisor hands the problem to an implementer.
#
# The hand-in stays clean: a worker commit that adds Spec Chat review state
# (`*.review/`, kept out of git by octo-feather-exclude) or adds the factory
# recipes `integrate` or `qc` to the target's justfile (they live in the kit's
# justfile, docs/adr/0017) is refused like a red gate. recipe_names reads the lane
# worktree's own justfile with `just --dump` (imports included) before and after;
# the recipe sets are compared (#121 D12 D13); a justfile just cannot read refuses.
#
# TICKET is the lane's parent ticket as the target's tracker writes it (12, ENG-123);
# the lane key is that tracker skill's lane-key of it (gh12, eng-123; roles spec #lane-key).
#
# Exit: 0 integrated and green; 1 conflict; 2 `just check` red; 3 adds review
#       state or factory recipes, or a justfile just cannot read; 64 usage, or TICKET has no lane key;
#       65 lane worktree not clean; 66 no single lane worktree for the lane key.
# Does not push.
set -euo pipefail

(($# >= 2)) || { echo "usage: octo-feather-integrate TICKET REF..." >&2; exit 64; }
root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd -P)"
# The target's tracker, from pi-role's own resolution (one mechanism: its tracker_skill), names the
# lane-key script.
skill="$(python3 -c 'import importlib.machinery as m, importlib.util as u, sys
l = m.SourceFileLoader("pi_role", sys.argv[1]); p = u.module_from_spec(u.spec_from_loader("pi_role", l)); l.exec_module(p)
print(p.tracker_skill(sys.argv[2]))' "$root/scripts/pi-role" "$root/.agents/skills")" || exit 64
n="$("$root/.agents/skills/$skill/scripts/lane-key" "$1")" \
  || { echo "octo-feather-integrate: $1 has no lane key in this target's tracker ($skill, reason above)" >&2; exit 64; }
shift

# The lane worktree is the one whose branch ends in the path segment of the lane key
# (docs/adr/0011): gh12 or a namespaced <prefix>/gh12. No suffix, so worker branches
# gh12-* and lane gh120 never match (likewise eng-123-*, eng-1230).
mapfile -t lanes < <(git worktree list --porcelain | awk -v re="(^|/)$n\$" '
  /^worktree /{wt=substr($0, 10)} /^branch /{b=substr($0, 19); if (b ~ re) print wt "\t" b}')
if ((${#lanes[@]} != 1)); then
  echo "octo-feather-integrate: need exactly one worktree on branch $n or <prefix>/$n, found ${#lanes[@]}" >&2
  ((${#lanes[@]} == 0)) || printf "  %s\n" "${lanes[@]}" >&2; exit 66
fi
wt="${lanes[0]%%$'\t'*}"; branch="${lanes[0]#*$'\t'}"
cd "$wt"
[[ -z "$(git status --porcelain)" ]] || { echo "octo-feather-integrate: $wt has uncommitted changes" >&2; exit 65; }
start="$(git rev-parse HEAD)"
# Recipe names (imported ones included; aliases are no recipes) from this worktree's own
# justfile (just would search parent directories); none without one. Fails, saying why, if just cannot read it.
recipe_names() {
  local f n out c=()
  for n in .[jJ]* [jJ]*; do [[ -e "$n" && ( "${n,,}" == justfile || "${n,,}" == .justfile ) ]] && c+=("$n"); done
  ((${#c[@]})) || return 0
  ((${#c[@]} == 1)) || { echo "justfile is ambiguous, just refuses to pick one of: ${c[*]}"; return 1; }
  f="${c[0]}"
  out="$(just --justfile "$f" --working-directory . --dump --dump-format json 2>/dev/null)" \
    || { echo "$f does not parse: $(just --justfile "$f" --working-directory . --dump 2>&1 >/dev/null | head -1)"; return 1; }
  python3 -c 'import json, sys; print(*sorted(json.loads(sys.argv[1])["recipes"]), sep="\n")' "$out"
}
before_names="$(recipe_names)" || { echo "hand-in: refused before integrating, lane $branch: $before_names" >&2; exit 3; }

rollback() { git reset -q --hard "$start"; echo "octo-feather-integrate: $branch reset to ${start:0:12}" >&2; }

for ref in "$@"; do
  if git show-ref -q --verify "refs/heads/$ref"; then
    op=(merge --no-ff --no-edit "$ref"); abort=(merge --abort)
  else
    git rev-parse -q --verify "$ref^{commit}" >/dev/null || { rollback; echo "octo-feather-integrate: $ref is not a branch or commit" >&2; exit 64; }
    op=(cherry-pick -x "$ref"); abort=(cherry-pick --abort)
  fi
  if ! git "${op[@]}" >/dev/null 2>&1; then
    files="$(git diff --name-only --diff-filter=U | paste -sd' ' -)"
    git "${abort[@]}" >/dev/null 2>&1 || true
    rollback
    echo "conflict: $ref in ${files:-(no conflicted paths; see git ${op[0]})}" >&2
    exit 1
  fi
done

review="$(git diff --name-only --diff-filter=A "$start" HEAD -- ':(glob)**/*.review/**' | head -5 | paste -sd' ' -)"
if ! after_names="$(recipe_names)"; then
  rollback
  echo "hand-in: $* refused, after integrating: $after_names" >&2
  exit 3
fi
recipes="$(LC_ALL=C comm -13 <(echo "$before_names") <(echo "$after_names") | grep -xE 'integrate|qc' | paste -sd' ' - || true)"
if [[ -n "$review" || -n "$recipes" ]]; then
  rollback
  [[ -z "$review" ]] || echo "hand-in: $* adds Spec Chat review state ($review); drop it from the commit, it stays local (octo-feather-exclude)" >&2
  [[ -z "$recipes" ]] || echo "hand-in: $* adds factory recipes to the justfile ($recipes); drop them and run the kit's command (octo-feather-integrate, octo-feather-qc; docs/adr/0017)" >&2
  exit 3
fi

if ! just check; then
  rollback
  echo "red: just check failed after integrating $*" >&2
  exit 2
fi
echo "integrated=$# branch=$branch head=$(git rev-parse --short=12 HEAD)"
