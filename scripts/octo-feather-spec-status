#!/usr/bin/env python3
"""octo-feather-spec-status: the command's launcher. Its code, scripts/octo_feather_spec_status.py,
is imported, so Python caches its bytecode (scripts/__pycache__/), which it never does for the
__main__ script; on a read-only tree (the qc sandbox) it compiles the module each run instead.
Code that needs its functions imports octo_feather_spec_status, never this file. A loader of this
file by path (scripts/octo-feather-qc script(), until it imports the module) runs nothing and
gets the module's names."""

import sys

import octo_feather_spec_status

if __name__ == "__main__":
    sys.exit(octo_feather_spec_status.main(sys.argv[1:]))
globals().update(
    {k: v for k, v in vars(octo_feather_spec_status).items() if not k.startswith("__")}
)
