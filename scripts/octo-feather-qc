#!/usr/bin/env python3
"""octo-feather-qc STATUS PR ID... [--no-sandbox] [--no-github]   interim product QC (`just qc`, docs/adr/0022)

Run in a lane worktree at its integrated head. Capture first (quality spec #qc-capture), no model: each
named criterion whose contract (qc.toml, validated by octo-feather-contract) declares a demo under
[demo."<spec>#<id>"] has that demo's command run at the head in the sandbox below, one sandbox per demo,
and its command, exit status, stdout and stderr appended to the target's evidence store
(octo-feather-evidence append: demo.cmd, demo.exit, demo.stdout, demo.stderr, and screenshots/<name> for each file
the demo wrote to $QC_SCREENSHOTS). A demo with browser = true gets PLAYWRIGHT_BROWSERS_PATH, the box's
headless Chromium shell at the contract's [browser] playwright pin where `just install-check` names it, bound
read-only (never a download; no pin or none installed there: refused, 64 or 66). Its result is then read
from that stored record alone: evidence complete (record at the head, clean, criterion text hash as
the spec's, every output there), decision source the demo's checks, pass on exit status 0, else fail.
The criteria with no declared demo go to the agent fallback below (quality spec #qc-fallback); with none left, no
judge and no model run. Each gets its own fresh, read-only qc judge (agents/qc-judge.md, headless through pi-role),
one at a time, in its own sandbox, under a fixed time cap (FALLBACK_CAP_S, through coreutils timeout): its QC brief
names that criterion alone (judge the whole head against it, run its demo path, report pass or fail with the command
and its output). Its report is appended to the evidence store as that criterion's record (judge.exit, judge.stdout,
judge.report.json; a judge stopped by the cap leaves no report, so its record's evidence is incomplete and, until
#406, the run exits 3 naming it), and the result is read back from that record alone, decision source agent fallback.
Then this script, not the judge, sets each passed criterion to built in
PR (through octo-feather-spec-status built: its record, the commit that record was captured at, and the tests its
demo declares, none for an agent fallback result) and each failed one to planned, and commits only the status file. The judge
model's family (the part before "/") must differ from the implementer's.

The judge runs in a sandbox (`unshare -rm` scripts/octo-feather-qc-sandbox,
which documents its mounts and checks): a pre-run proof is printed and any
failed check aborts before the judge starts; after it exits, leftovers are
killed and the agents it started are counted; its agents' model spend is recorded
(record_spend). The judge has no persistent
writable path: the worktree is an overlay whose upper dir lives on the run's
tmpfs, so every write (credential copies included) dies with the run; a write
to a tracked file or an untracked non-ignored file is reported and fails it.
Pi's auth.json and models.json: the judge gets per-run copies, discarded with the
run and never written back. If the box auth.json holds OAuth credentials, a warning
says a token refresh during the run is discarded.
GitHub evidence: when origin is a GitHub repo, octo-feather-qc-ghsnap fetches a
fresh snapshot with this shell's gh auth into per-run scratch before every run;
the sandbox binds it read-only and the offline gh (.agents/skills/github-pr/scripts/gh) serves it,
refusing writes. No GitHub remote: no snapshot, and that gh refuses every call.
No tracker credential: the judge never gets LINEAR_API_KEY (also not with --no-sandbox), so it
reads no Linear ticket; the sandbox proof fails if it is set.
  --no-github            skip the snapshot (printed in the proof) instead of
                         aborting when the fetch fails
  --no-sandbox           debugging only: prints UNSANDBOXED, writes the report,
                         never changes or commits the status file
  OCTO_FEATHER_QC_MODEL  judge model override (still checked against the family)
  OCTO_FEATHER_QC_ARGS   extra pi args, e.g. "--thinking off" for a smoke
  OCTO_FEATHER_QC_RO_BINDS, OCTO_FEATHER_QC_PATH  ":"-separated paths bound
                         read-only into the sandbox / put first on its PATH
Report: $(octo-feather-state)/qc/<head>-<UTC stamp>-<runid>.json, new per run
(`fallback`, by criterion: each judge's report, raw run, exit, proof and cleanup, record; `cap_s`; each demo's capture;
`results`, one per criterion: verdict, evidence state, decision source, evidence record id, judged head).
Exit: 0 all passed, 1 some failed (or --no-sandbox), 3 judge report unusable,
the judge wrote a tracked or non-ignored file (paths listed), 64 usage (PR not a
positive integer, an id not in the status file or spec) or same-family judge, 65 dirty worktree,
66 sandbox unavailable or a pre-run proof check failed, 67 GitHub snapshot fetch failed
(no auth, network; rerun with --no-github to judge without it), 69 on macOS (no sandbox there), 70 inside a `just check`
run, whatever pi it would launch (scripts/check-gate-free --refuse; the gate stays free). On 64 to 70 the judge never
started; after it ran, the status file is never left modified and uncommitted.
"""
import base64, fcntl, hashlib, json, os, re, secrets, shlex, shutil, signal, subprocess, sys, tempfile, threading, time, tomllib
from html.parser import HTMLParser
from pathlib import Path
from typing import Any, NoReturn

Result = dict[str, Any]   # one claimed criterion's result (quality spec #qc-results)

KIT = Path(__file__).resolve().parent.parent
STATUS_TOOL = KIT / "scripts" / "octo-feather-spec-status"
EVIDENCE_TOOL = KIT / "scripts" / "octo-feather-evidence"
CONTRACT_TOOL = KIT / "scripts" / "octo-feather-contract"
DEMO_OUTPUTS = ("demo.cmd", "demo.exit", "demo.stdout", "demo.stderr")
FALLBACK_CAP_S = 900   # each agent fallback judge's fixed time cap (quality spec #qc-fallback)
CAPPED = (124, 137)   # timeout's exit when the cap stopped the judge: 124 by TERM, 137 once -k sent KILL (--foreground)


def die(code: int, msg: str) -> NoReturn:
    print(f"octo-feather-qc: {msg}", file=sys.stderr); sys.exit(code)


def git(*a):
    return subprocess.run(["git", *a], capture_output=True, text=True, check=True).stdout.strip()


def front(role, key):
    m = re.search(rf"^{key}:\s*(.+)$", (KIT / "agents" / f"{role}.md").read_text(), re.M)
    return m.group(1).strip() if m else ""


class _Text(HTMLParser):
    def __init__(self):
        super().__init__(); self.depth = 0; self.cur = None; self.out = {}

    def handle_starttag(self, tag, attrs):
        a = dict(attrs)
        if self.cur is None and "data-acceptance-criterion" in a:
            self.cur = a.get("data-anchor") or ""; self.depth = 0; self.out[self.cur] = ""
        elif self.cur is not None:
            self.depth += 1

    def handle_endtag(self, tag):
        if self.cur is not None:
            if self.depth == 0:
                self.cur = None
            else:
                self.depth -= 1

    def handle_data(self, d):
        if self.cur is not None:
            self.out[self.cur] += d


def criteria_text(spec: Path) -> dict[str, str]:
    p = _Text(); p.feed(spec.read_text(encoding="utf-8"))
    return {k: " ".join(v.split()) for k, v in p.out.items()}


BRIEF = """QC run (docs/adr/0022).
Repo: {repo}, head {head}. Spec: {spec}.
Evidence besides the repo:
- GitHub: {github}
- Lane and director history: $(octo-feather-state)/lanes/archive/ holds closed lanes' records and hand-off logs, and $(octo-feather-state)/director.handoffs.jsonl the director's log; both read-only, either may be absent.
When you judge a criterion only from this history (GitHub snapshot, lane records, logs) rather than by exercising it, its why starts "history only:" and it passes only if the history shows the exact required behavior. If neither exercising nor history shows it, fail it and say what was missing.
Criteria:
{criteria}
Your final message is exactly one fenced json block and nothing else:
```json
{{"head": "{head}", "criteria": [{{"id": "<id>", "verdict": "pass" or "fail", "command": "<exact command you ran>", "output": "<its output, trimmed to what shows the outcome>", "why": "<one line>"}}]}}
```"""


def github_snapshot(skip, runid):
    """Fetch this run's GitHub snapshot outside the sandbox; return {dir, line, repo, meta} or {off}."""
    url = subprocess.run(["git", "remote", "get-url", "origin"], capture_output=True, text=True).stdout.strip()
    m = re.search(r"github\.com[:/]+([^/\s]+/[^/\s]+?)(?:\.git)?/?$", url)
    if not m:
        return {"off": "github: none (no GitHub remote)"}
    if skip:
        return {"off": f"github: SKIPPED (--no-github; {m.group(1)} not fetched, the judge has no GitHub evidence)"}
    snap = Path(tempfile.mkdtemp(prefix=f"qc-ghsnap-{runid}-"))
    try:   # killed mid-fetch (SIGTERM, see main): the partial snapshot goes too
        p = subprocess.run([str(KIT / "scripts" / "octo-feather-qc-ghsnap"), m.group(1), str(snap)], capture_output=True, text=True)
        if p.returncode:
            die(67, f"GitHub snapshot of {m.group(1)} failed; judge not started (rerun with --no-github to judge without it): "
                    f"{p.stderr.strip() or p.stdout.strip()}")
        subprocess.run(["chmod", "-R", "a-w", str(snap)], check=True)
        meta = json.loads((snap / "meta.json").read_text())
    except BaseException:
        drop(snap)
        raise
    return {"dir": str(snap), "line": p.stdout.strip(), "repo": meta["repo"], "meta": meta}


def drop(path):
    # No child process here: a killed run's 2nd signal (timeout sends one to its whole group) would kill it
    # mid-cleanup and leave the read-only snapshot behind (issue #235).
    for d, _, _ in os.walk(path):   # top-down: each dir writable before its entries go
        try:
            os.chmod(d, os.lstat(d).st_mode | 0o700)
        except OSError:
            pass
    shutil.rmtree(path, ignore_errors=True)


def evidence(gh):
    if "off" in gh:
        return f"{gh['off']}. `gh` here is the offline gh and refuses every call."
    m = gh["meta"]
    cap = f" Older items, list rows only: {' '.join(m['capped'])}." if m["capped"] else ""
    return (f"`gh` is an offline, read-only {gh['line']}, fetched before this run. Full views (comments, reviews, commits, "
            f"files, closing issues, sub-issues, blocked-by, timeline, head check runs) for the {m['counts']['detail']} most "
            f"recently updated issues and PRs.{cap} It answers `gh issue view|list`, `gh pr view|list|diff|checks`, "
            f"`gh run view|list`, `gh repo view` and `gh api` GET paths of {m['repo']} (--json, -q/--jq); it refuses every write "
            f"and anything not in the snapshot, and each refusal is counted in the report.")


def pi_auth():
    return Path(os.environ.get("PI_CODING_AGENT_DIR") or Path.home() / ".pi" / "agent") / "auth.json"


def oauth_warning():
    """The warning line if the box auth.json holds an OAuth entry (type oauth or a refresh token field), else None."""
    try:
        auth = json.loads(pi_auth().read_bytes())
    except (OSError, ValueError):
        return None
    entries = auth.values() if isinstance(auth, dict) else []
    if any(isinstance(e, dict) and (e.get("type") == "oauth" or any("refresh" in str(k).lower() for k in e)) for e in entries):
        return "qc: warning: auth.json has OAuth credentials: a token refresh during this run is discarded"
    return None


def sandboxed(judge: list[str], session: str, gh: dict[str, Any], *, history: bool = True,
              kit: Path | None = None, browser: str | None = None,
              shots: bool = False) -> tuple[subprocess.CompletedProcess[str] | None, dict[str, Any]]:
    """Run JUDGE inside `unshare -rm` octo-feather-qc-sandbox; return (run, sandbox record), run None if it never started.
    history False: no archived lanes or director log bound in (a factory eval, octo-feather-qa); kit: the kit under
    test (default this kit; what the sandbox shows of it: docs/adr/0022, sandbox paragraph); browser: the box's
    Playwright browsers folder, bound read-only (a browser demo); shots: a $QC_SCREENSHOTS dir whose files come back as
    the record's "shots" ([name, base64] pairs)."""
    unshare = shutil.which("unshare")
    if not unshare and sys.platform == "darwin":
        die(69, "just qc: not on macOS (the judge's sandbox needs Linux unshare and /proc); run it on a Linux box, or say `just qc` not run (macOS) in the merge ask")
    if not unshare:
        die(66, "unshare not found; the judge runs only in its sandbox (or pass --no-sandbox to debug)")
    # Proof, post record, judge stderr and our stderr come back over pipes, drained by threads: a write
    # fd on a file would pin its mount and the sandbox's read-only remount would fail with EBUSY.
    names = ("proof", "post", "err", "stderr")
    pipes = {n: os.pipe() for n in names}
    for n in names:   # write ends above 100 so the sandbox's dup onto fds 4-6 cannot clobber one
        r, w = pipes[n]; pipes[n] = (r, fcntl.fcntl(w, fcntl.F_DUPFD, 100)); os.close(w)
    got = {n: [] for n in names}
    state = Path(subprocess.run([str(KIT / "scripts" / "octo-feather-state")], capture_output=True, text=True).stdout.strip())
    top = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local" / "state") / "octo-feather"
    ro = [p for p in os.environ.get("OCTO_FEATHER_QC_RO_BINDS", "").split(":") if p] + ([gh["dir"]] if "dir" in gh else []) + ([browser] if browser else [])
    pre = [p for p in os.environ.get("OCTO_FEATHER_QC_PATH", "").split(":") if p]
    worktree = git("rev-parse", "--show-toplevel")
    # Paths under /tmp the run needs back after /tmp turns private (tests run repos from mktemp).
    want = [worktree, KIT, state, top, Path.home(), *ro, *pre, *os.environ.get("PATH", "").split(":")]
    keep = sorted({str(Path(p).resolve()) for p in want if p and Path(p).exists()})
    keep = [p for p in keep if p.startswith("/tmp/")]
    env = dict(os.environ, QC_SESSION=session, QC_STATE=str(state), QC_WORKTREE=worktree, QC_KIT=str(kit or KIT),
               QC_UID=str(os.getuid()), QC_GID=str(os.getgid()),
               # inside a qc sandbox `herdr` is its shim: wrap the real binary it names
               QC_HERDR=os.environ.get("OCTO_FEATHER_QC_HERDR") or shutil.which("herdr") or "", QC_GH=shutil.which("gh") or "",
               QC_KEEP="\n".join(keep), QC_RO_BINDS="\n".join(ro), QC_PATH_PREPEND=":".join(pre),
               QC_GHSNAP=gh.get("dir", ""), QC_GHSNAP_LINE=gh.get("line", ""), QC_GHSNAP_OFF=gh.get("off", ""),
               QC_HISTORY="" if history else "none", QC_BROWSER=browser or "", QC_SHOTS="1" if shots else "",
               QC_FD_PROOF=str(pipes["proof"][1]), QC_FD_POST=str(pipes["post"][1]), QC_FD_ERR=str(pipes["err"][1]))
    if (w := oauth_warning()):
        print(w, file=sys.stderr)

    def drain(n):
        with os.fdopen(pipes[n][0], "rb") as f:
            for chunk in iter(lambda: f.read1(65536), b""):
                got[n].append(chunk)
                if n == "stderr":
                    sys.stderr.buffer.write(chunk); sys.stderr.flush()
    threads = [threading.Thread(target=drain, args=(n,), daemon=True) for n in names]
    for th in threads:
        th.start()
    p = subprocess.Popen([unshare, "-rm", str(KIT / "scripts" / "octo-feather-qc-sandbox"), "--", *judge],
                         env=env, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=pipes["stderr"][1],
                         pass_fds=[pipes[n][1] for n in ("proof", "post", "err")], process_group=0)
    for n in names:
        os.close(pipes[n][1])
    try:
        stdout = p.stdout.read().decode(errors="replace"); p.wait()
    except BaseException:   # qc killed (timeout, ^C): its PID 1 and unshare --fork ignore SIGTERM, so take the
        os.killpg(p.pid, signal.SIGKILL); p.wait()   # sandbox's group down here, or it judges on unwatched
        for _ in range(300):   # and exit only once that group is gone, its judge included (issue #235)
            try:
                os.killpg(p.pid, 0)
            except OSError:
                break
            time.sleep(0.01)
        raise
    for th in threads:
        th.join(timeout=10)   # a writer outliving the PID namespace cannot exist; do not hang if it did
    read = lambda n: b"".join(got[n]).decode(errors="replace")
    record = {"session": session, "proof": read("proof").splitlines()}
    for line in read("post").splitlines():   # the cleanup record (only once the judge ran), then the overlay upper list
        record.update(json.loads(line))
    record_spend(record.get("spend") or [], f"sandbox {session}")
    if "agents_started" not in record:
        return None, record
    return subprocess.CompletedProcess(judge, p.returncode, stdout, read("err")), record


def record_spend(lines, what):
    """LINES (ledger lines a run's call paths wrote where they could not reach the box ledger) appended through the
    ledger's one writer, `octo-feather-lane spend record`, run here in the caller's environment so its lane resolves
    (spec spend#rule-lane; its failures, never the caller's: `octo-feather-lane --help`, spend record)."""
    if not lines:
        return
    try:
        subprocess.run([str(KIT / "scripts" / "octo-feather-lane"), "spend", "record"], input="".join(l + "\n" for l in lines),
                       text=True, stdout=subprocess.DEVNULL, timeout=60)
    except (OSError, subprocess.SubprocessError) as e:
        print(f"octo-feather-qc: spend unrecorded ({len(lines)} call(s), {what}): octo-feather-lane spend record "
              f"did not run ({type(e).__name__})", file=sys.stderr)


def worktree_writes(upper):
    """Of the judge's writes (overlay upper entries, all discarded), the ones that broke read-only:
    a tracked file new, changed or deleted, or an untracked file git does not ignore. .git is git's own."""
    rel = [(k, p) for k, p in upper if p != ".git" and not p.startswith(".git/")]
    tracked = set(git("ls-files", "-z").split("\0"))
    cand = [p for k, p in rel if p not in tracked and k == "new"]
    ignored = set(subprocess.run(["git", "check-ignore", "--stdin", "-z"], input="\0".join(cand), capture_output=True,
                                 text=True).stdout.split("\0")) if cand else set()
    return [f"{k} {p}" for k, p in rel if p in tracked or (k == "new" and p not in ignored)]


def browsers(root: str, ids: list[str], stem: str) -> str | None:
    """The box's Playwright browsers folder for the browser demos IDS (none: None), where `just install-check` names it
    (remote spec #host-tools): ${XDG_DATA_HOME:-~/.local/share}/octo-feather/ms-playwright/<the contract's [browser]
    playwright pin>. No pin, or no headless shell installed there, is refused before any demo runs."""
    if not ids:
        return None
    pin = tomllib.loads((Path(root) / "qc.toml").read_text(encoding="utf-8")).get("browser", {}).get("playwright")
    if not pin:
        die(64, f"demo {' '.join(f'{stem}#{i}' for i in ids)}: browser = true but qc.toml has no [browser] playwright pin; nothing ran")
    data = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local" / "share")
    folder = data / "octo-feather" / "ms-playwright" / pin
    cache = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache")
    if folder.resolve().is_relative_to(cache.resolve()):
        die(66, f"browser folder {folder} is under {cache}, which the qc sandbox masks; set XDG_DATA_HOME outside it (just install-check)")
    if not list(folder.glob("chromium_headless_shell-*/INSTALLATION_COMPLETE")):
        die(66, f"no Playwright {pin} headless Chromium shell in {folder}; nothing ran. Install it once per box (just install-check "
                f"names it): PLAYWRIGHT_BROWSERS_PATH={folder} npx -y playwright@{pin} install --only-shell chromium")
    return str(folder)


def contract_demos(root: str) -> dict[str, dict[str, Any]]:
    """The demos the target's qc.toml declares, by criterion id <spec>#<anchor> (quality spec #qc-contract); none
    without a qc.toml. A qc.toml octo-feather-contract refuses is refused here, before anything runs."""
    path = Path(root) / "qc.toml"
    if not path.is_file():
        return {}
    p = subprocess.run([str(CONTRACT_TOOL), str(path)], capture_output=True, text=True)
    if p.returncode:
        die(64, f"qc.toml is not a valid contract (octo-feather-contract); nothing ran:\n{(p.stderr or p.stdout).strip()}")
    demos: dict[str, dict[str, Any]] = tomllib.loads(path.read_text(encoding="utf-8")).get("demo", {})
    return demos


def capture(ids: list[str], demos: dict[str, dict[str, Any]], head: str, text: dict[str, str], stem: str, runid: str,
            report_path: Path, *, nosb: bool) -> tuple[dict[str, Result], list[dict[str, Any]]]:
    """Capture (quality spec #qc-capture), no model, deciding nothing: each declared demo run at HEAD in its own qc
    sandbox, what it captured appended to the target's evidence store; then each result judged from its stored
    record alone (judged). --no-sandbox: run with this shell's access, stored nowhere. Returns (results by id, captures)."""
    root = git("rev-parse", "--show-toplevel")
    done: dict[str, Result] = {}
    caps: list[dict[str, Any]] = []
    folder = browsers(root, [i for i in ids if i in demos and demos[i].get("browser")], stem)
    for n, i in enumerate(i for i in ids if i in demos):
        cid, line = f"{stem}#{i}", str(demos[i]["command"])
        br = folder if demos[i].get("browser") else None   # never downloads one: the box's, read-only
        cmd = ["env", f"QC_REPO={root}", *([f"PLAYWRIGHT_BROWSERS_PATH={br}", "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1"] if br else []),
               "sh", "-c", 'cd "$QC_REPO" || exit 127; exec sh -c "$1"', "qc-demo", line]
        print(f"qc: demo {cid}: $ {line}", file=sys.stderr)
        run: subprocess.CompletedProcess[str] | None
        sandbox: dict[str, Any] | bool
        if nosb:
            run, sandbox = subprocess.run(cmd, stdin=subprocess.DEVNULL, capture_output=True, text=True), False
        else:
            run, sandbox = sandboxed(cmd, f"qc-{head[:12]}-{runid}-d{n}", {"off": "github: none (a declared demo, no agent judge)"},
                                     browser=br, shots=True)
            assert isinstance(sandbox, dict)
            sandbox["discarded_writes"] = len(sandbox.pop("upper", []))   # the demo's writes died with its overlay
        shots: list[list[str]] = sandbox.pop("shots", []) if sandbox else []   # the screenshots it took, for the record
        rc = None if run is None else 128 - run.returncode if run.returncode < 0 else run.returncode
        caps.append({"id": cid, "command": line, "exit": rc, "sandbox": sandbox, "screenshots": [s for s, _ in shots]})
        if run is None:
            report_path.write_text(json.dumps({"head": head, "ids": ids, "run_id": runid, "captures": caps}, indent=2))
            die(66, f"sandbox proof failed or sandbox unavailable; demo of {cid} not run (report {report_path})")
        if nosb:
            done[i] = {"id": i, "verdict": "pass" if rc == 0 else "fail", "command": line, "exit": rc, "output": tail(run.stdout + run.stderr),
                       "why": f"demo exit status {rc}", "evidence": "unrecorded (--no-sandbox)", "decision": "demo checks", "record": None, "head": head}
            continue
        with tempfile.TemporaryDirectory(prefix=f"qc-demo-{runid}-") as d:
            for name, body in zip(DEMO_OUTPUTS, (line + "\n", f"{rc}\n", run.stdout, run.stderr), strict=True):
                Path(d, name).write_text(body)
            for name, b64 in shots:
                Path(d, "screenshots", name).parent.mkdir(parents=True, exist_ok=True)
                Path(d, "screenshots", name).write_bytes(base64.b64decode(b64))
            p = subprocess.run([str(EVIDENCE_TOOL), "append", "--repo", root, "--criterion", cid, "--criterion-text", text[i],
                                "--outputs", d], capture_output=True, text=True)
        if p.returncode:
            report_path.write_text(json.dumps({"head": head, "ids": ids, "run_id": runid, "captures": caps}, indent=2))
            die(3, f"evidence record for {cid} not appended: {p.stderr.strip()}; report {report_path}")
        caps[-1]["record"] = rid = p.stdout.strip()
        done[i] = judged(i, cid, rid, head, text[i], root)
    bad = [f"{r['id']} (record {r['record']}): {'; '.join(r['missing'])}" for r in done.values() if r["evidence"] == "incomplete"]
    if bad:
        report_path.write_text(json.dumps({"head": head, "ids": ids, "run_id": runid, "captures": caps,
                                           "results": list(done.values())}, indent=2))
        die(3, f"evidence incomplete, nothing judged: {' | '.join(bad)}; report {report_path}")
    return done, caps


def judged(i: str, cid: str, rid: str, head: str, text: str, root: str) -> Result:
    """One criterion's result from its stored record alone (quality spec #qc-judgment): its evidence state, complete
    or incomplete naming what is missing, then the demo's checks, which its exit status reports."""
    p = subprocess.run([str(EVIDENCE_TOOL), "read", "--repo", root, "--criterion", cid, "--commit", head, "--json"],
                       capture_output=True, text=True)
    found: list[Any] = [x for x in json.loads(p.stdout) if x["record"]["id"] == rid] if p.returncode == 0 else []
    res: Result = {"id": i, "evidence": "incomplete", "decision": "demo checks", "record": rid, "head": head}
    if not found:
        return res | {"missing": [f"record not in the store at {head[:12]} ({p.stderr.strip() or 'no match'})"]}
    r: dict[str, Any] = found[0]["record"]
    d = Path(found[0]["dir"]) / "outputs"
    missing = [m for m, bad in (
        (f"captured at {r['revision'][:12]}, not the judged head", r["revision"] != head),
        ("captured from a dirty worktree", r["dirty"]),
        ("criterion text hash differs from the spec's at the head", r["criterion"]["text_sha256"] != hashlib.sha256(text.encode()).hexdigest()),
        (f"outputs missing: {' '.join(o for o in DEMO_OUTPUTS if o not in r['outputs'])}", any(o not in r["outputs"] for o in DEMO_OUTPUTS)),
    ) if bad]
    if missing:
        return res | {"missing": missing}
    rc = int((d / "demo.exit").read_text())
    return res | {"verdict": "pass" if rc == 0 else "fail", "command": (d / "demo.cmd").read_text().rstrip("\n"), "exit": rc,
                  "output": tail((d / "demo.stdout").read_text() + (d / "demo.stderr").read_text()),
                  "why": f"demo exit status {rc}", "evidence": "complete"}


def tail(out: str, lines: int = 40) -> str:
    return "\n".join(out.splitlines()[-lines:])[-4000:]


def gate_free():
    """Never inside a check run, whatever pi the judge would launch."""
    p = subprocess.run([str(KIT / "scripts" / "check-gate-free"), "--refuse", "the product judge (octo-feather-qc)"],
                       stdout=subprocess.PIPE, text=True)
    if p.stdout.strip() != "gate-free: ok":
        die(70, "refused inside just check, which stays deterministic and free (message above)")


def main(argv: list[str]) -> int:
    gate_free()
    flags = {"--no-sandbox", "--no-github"}
    nosb, nogh = "--no-sandbox" in argv, "--no-github" in argv
    argv = [a for a in argv if a not in flags]
    if len(argv) < 3:
        print(__doc__.strip(), file=sys.stderr); return 64
    if not re.fullmatch(r"[1-9][0-9]*", argv[1]):
        die(64, f"PR must be a positive integer, got {argv[1]!r}")
    status, pr, ids = Path(argv[0]), int(argv[1]), argv[2:]
    if git("status", "--porcelain"):
        die(65, "worktree is dirty; QC judges a committed head")
    head = git("rev-parse", "HEAD")
    data = json.loads(status.read_text(encoding="utf-8"))
    dup = sorted({i for i in ids if ids.count(i) > 1})
    if dup:
        die(64, f"ids given twice: {' '.join(dup)}")
    missing = [i for i in ids if i not in data.get("criteria", {})]
    if missing:
        die(64, f"not in {status}: {' '.join(missing)}")
    spec = status.with_name(data["spec"])
    text = criteria_text(spec)
    missing = [i for i in ids if not text.get(i)]
    if missing:
        die(64, f"no criterion text in {spec}: {' '.join(missing)}")
    stem = spec.name.removesuffix(".spec.html")
    declared = contract_demos(git("rev-parse", "--show-toplevel"))
    demos = {i: declared[f"{stem}#{i}"] for i in ids if f"{stem}#{i}" in declared}

    model = os.environ.get("OCTO_FEATHER_QC_MODEL") or front("qc-judge", "model")
    impl = front("implementer", "model")
    if len(demos) < len(ids) and model.split("/")[0] == impl.split("/")[0]:
        die(64, f"judge {model} is the implementer's family ({impl}); QC needs another family (docs/adr/0022)")

    runid = secrets.token_hex(3)
    def killed(n, _f):   # a timeout or a closed pane: exit through the finally blocks, so this run's scratch
        if not killed.once:   # (snapshot, miss log) is removed; a 2nd signal (timeout sends one to the child
            killed.once = True   # and one to its group) must not cut that short
            sys.exit(128 + n)
    killed.once = False
    for s in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(s, killed)
    gh: dict[str, Any] = {}
    try:
        gh = github_snapshot(nogh, runid) if len(demos) < len(ids) else {"off": "github: none (every criterion has a declared demo: no judge)"}
        print(f"qc: {gh.get('off') or 'github: ' + gh['line']}", file=sys.stderr)
        return judge(status, pr, ids, head, data, spec, text, model, runid, gh, demos, stem, nosb=nosb)
    finally:
        if "dir" in gh:
            drop(gh["dir"])


def judge(status: Path, pr: int, ids: list[str], head: str, data: dict[str, Any], spec: Path, text: dict[str, str], model: str,
          runid: str, gh: dict[str, Any], demos: dict[str, dict[str, Any]], stem: str, *, nosb: bool) -> int:
    rest = [i for i in ids if i not in demos]   # no declared demo: the agent fallback's
    state = Path(subprocess.run([str(KIT / "scripts" / "octo-feather-state")], capture_output=True, text=True).stdout.strip())
    out_dir = Path(os.environ.get("OCTO_FEATHER_QC_DIR") or state / "qc"); out_dir.mkdir(parents=True, exist_ok=True)
    report_path = out_dir / f"{head}-{time.strftime('%Y%m%dT%H%M%SZ', time.gmtime())}-{runid}.json"
    ghrec = {k: v for k, v in gh.items() if k in ("off", "line", "repo")} | ({"snapshot": {k: gh["meta"][k] for k in ("fetched_at", "counts", "capped", "absent")}} if "meta" in gh else {})
    done, caps = capture(ids, demos, head, text, stem, runid, report_path, nosb=nosb)
    if not rest:
        try:
            return settle(status, pr, ids, head, data, done, {"head": head, "ids": ids, "run_id": runid, "sandbox": not nosb,
                                                              "captures": caps}, report_path, 0, nosb=nosb, demos=demos)
        finally:
            restore(status)
    if nosb:
        print("qc: UNSANDBOXED (--no-sandbox): the judge runs with this shell's access; the status file will not change", file=sys.stderr)
    ghrec["misses"] = []
    raw: dict[str, Any] = {"head": head, "model": model, "ids": ids, "run_id": runid, "github": ghrec, "sandbox": not nosb,
                           "cap_s": FALLBACK_CAP_S, "fallback": {}}
    if caps:
        raw["captures"] = caps
    try:   # from here on a judge runs: never leave the status file modified and uncommitted
        for n, i in enumerate(rest):   # one fresh judge per criterion, one after another (each a Pi run)
            done[i] = fallback(i, n, head, spec, text, stem, model, runid, gh, raw, report_path, nosb=nosb)
        nmiss = raw["gh_misses"] = len(ghrec["misses"])
        bad = [f"{i} (record {done[i]['record'] or 'none'}): {'; '.join(done[i]['missing'])}" for i in rest if done[i]["evidence"] == "incomplete"]
        if bad:   # until #406 gives such a criterion the result insufficient evidence, as capture() does
            raw["results"] = [done[i] for i in ids]
            report_path.write_text(json.dumps(raw, indent=2))
            die(3, f"evidence incomplete, nothing judged: {' | '.join(bad)}; report {report_path}")
        return settle(status, pr, ids, head, data, done, raw, report_path, nmiss, nosb=nosb, demos=demos)
    finally:
        restore(status)


def fallback(i: str, n: int, head: str, spec: Path, text: dict[str, str], stem: str, model: str, runid: str, gh: dict[str, Any],
             raw: dict[str, Any], report_path: Path, *, nosb: bool) -> Result:
    """The agent fallback for I, a criterion its contract declares no demo for (quality spec #qc-fallback): a fresh qc judge
    from its own role, in its own qc sandbox, judging I alone under the fixed time cap; its report appended to the evidence
    store as I's record, and I's result read back from that record alone (fell_back). --no-sandbox: stored nowhere."""
    cid = f"{stem}#{i}"
    brief = BRIEF.format(repo=os.getcwd(), head=head, spec=spec, github=evidence(gh), criteria=f"- {i}: {text[i]}")
    cmd = ["timeout", "--foreground", "-k", "10", str(FALLBACK_CAP_S),   # --foreground: a killed qc's group signal reaches the judge
           str(KIT / "scripts" / "pi-role"), str(KIT / "agents" / "qc-judge.md"), "--model", model, *shlex.split(os.environ.get("OCTO_FEATHER_QC_ARGS", "")), "-p", brief]
    print(f"qc: agent fallback {cid}: a fresh qc judge, time cap {FALLBACK_CAP_S} s", file=sys.stderr)
    t0 = time.time()
    if nosb:
        miss = Path(tempfile.mkstemp(prefix=f"qc-ghmiss-{runid}-")[1])
        env = dict(os.environ, PATH=f"{KIT / '.agents' / 'skills' / 'github-pr' / 'scripts'}:{os.environ.get('PATH', '')}", OCTO_FEATHER_GHSNAP=gh.get("dir", ""),
                   OCTO_FEATHER_GHSNAP_OFF=gh.get("off", ""), OCTO_FEATHER_GHSNAP_MISS=str(miss))
        env.pop("LINEAR_API_KEY", None)
        try:
            run, sandbox = subprocess.run(cmd, capture_output=True, text=True, env=env), False
            misses = [json.loads(l) for l in miss.read_text().splitlines() if l.strip()]
        finally:
            miss.unlink(missing_ok=True)
    else:
        run, sandbox = sandboxed(cmd, f"qc-{head[:12]}-{runid}-j{n}", gh)
        if run is None:
            raw["fallback"][i] = {"sandbox": sandbox}
            report_path.write_text(json.dumps(raw, indent=2))
            die(66, f"sandbox proof failed or sandbox unavailable; judge of {cid} not started (report {report_path})")
        misses = sandbox.get("gh_miss_log", [])
    raw["github"]["misses"] += misses
    rec = raw["fallback"][i] = {"exit": run.returncode, "timed_out": run.returncode in CAPPED, "seconds": round(time.time() - t0),
                                "gh_misses": len(misses), "sandbox": sandbox, "stdout": run.stdout, "stderr": run.stderr[-4000:]}
    rep = verdict(i, head, run, rec, raw, report_path)
    capped = f"the judge hit its {FALLBACK_CAP_S} s time cap before reporting"
    if nosb:
        res: Result = {"id": i, "decision": "agent fallback", "record": None, "head": head}
        if rep is None:
            return res | {"evidence": "incomplete", "missing": [capped]}
        c = rep["criteria"][0]
        return res | {k: c[k] for k in ("verdict", "command", "output")} | {"why": c.get("why", ""), "evidence": "unrecorded (--no-sandbox)"}
    root = git("rev-parse", "--show-toplevel")
    with tempfile.TemporaryDirectory(prefix=f"qc-judge-{runid}-") as d:
        Path(d, "judge.exit").write_text(f"{run.returncode}\n")
        Path(d, "judge.stdout").write_text(run.stdout)
        if rep is not None:
            Path(d, "judge.report.json").write_text(json.dumps(rep, indent=2) + "\n")
        p = subprocess.run([str(EVIDENCE_TOOL), "append", "--repo", root, "--criterion", cid, "--criterion-text", text[i],
                            "--outputs", d], capture_output=True, text=True)
    if p.returncode:
        report_path.write_text(json.dumps(raw, indent=2))
        die(3, f"evidence record for {cid} not appended: {p.stderr.strip()}; report {report_path}")
    rec["record"] = rid = p.stdout.strip()
    return fell_back(i, cid, rid, head, text[i], root, capped)


def fell_back(i: str, cid: str, rid: str, head: str, text: str, root: str, capped: str) -> Result:
    """An agent fallback result from its stored record alone, as judged() reads a demo's: evidence complete when the record
    is at the head, clean, with the spec's criterion text hash and the judge's report; the verdict is that report's."""
    p = subprocess.run([str(EVIDENCE_TOOL), "read", "--repo", root, "--criterion", cid, "--commit", head, "--json"],
                       capture_output=True, text=True)
    found: list[Any] = [x for x in json.loads(p.stdout) if x["record"]["id"] == rid] if p.returncode == 0 else []
    res: Result = {"id": i, "evidence": "incomplete", "decision": "agent fallback", "record": rid, "head": head}
    if not found:
        return res | {"missing": [f"record not in the store at {head[:12]} ({p.stderr.strip() or 'no match'})"]}
    r: dict[str, Any] = found[0]["record"]
    d = Path(found[0]["dir"]) / "outputs"
    missing = [m for m, bad in (
        (f"captured at {r['revision'][:12]}, not the judged head", r["revision"] != head),
        ("captured from a dirty worktree", r["dirty"]),
        ("criterion text hash differs from the spec's at the head", r["criterion"]["text_sha256"] != hashlib.sha256(text.encode()).hexdigest()),
        (capped, "judge.exit" in r["outputs"] and (d / "judge.exit").read_text().strip() in {str(c) for c in CAPPED}),
        ("outputs missing: judge.report.json", "judge.report.json" not in r["outputs"]),
    ) if bad]
    if missing:
        return res | {"missing": missing}
    c = next(c for c in json.loads((d / "judge.report.json").read_text())["criteria"] if c["id"] == i)
    return res | {k: c[k] for k in ("verdict", "command", "output")} | {"why": c.get("why", ""), "evidence": "complete"}


def restore(status: Path) -> None:
    if git("status", "--porcelain", "--", str(status)):
        git("checkout", "HEAD", "--", str(status))
        print(f"qc: {status} restored to HEAD (not committed by this run)", file=sys.stderr)


def verdict(i: str, head: str, run: subprocess.CompletedProcess[str], rec: dict[str, Any], raw: dict[str, Any],
            report_path: Path) -> dict[str, Any] | None:
    """The judge's report on I, refused (exit 3) when the judge broke read-only or the report is unusable; None when the
    time cap stopped the judge first. REC: this judge's run in the run report RAW."""
    sandbox = rec["sandbox"]
    if sandbox:
        upper = sandbox.pop("upper", [])
        rec["discarded_writes"] = len(upper)
        rec["worktree_writes"] = wrote = worktree_writes(upper)
        print(f"qc: worktree overlay: {len(upper)} judge writes discarded with the run, {len(wrote)} outside ignored paths", file=sys.stderr)
        if wrote:
            report_path.write_text(json.dumps(raw, indent=2))
            die(3, f"the judge wrote into the worktree (discarded; real worktree unchanged): {'; '.join(wrote)}; read-only was broken (report {report_path})")
    if git("status", "--porcelain") or git("rev-parse", "HEAD") != head:
        report_path.write_text(json.dumps(raw, indent=2))
        die(3, f"the worktree or head changed during the run; read-only was broken (report {report_path})")
    if rec["timed_out"]:
        return None
    blocks = re.findall(r"```json\s*(\{.*?\})\s*```", run.stdout, re.S)
    try:
        rep = json.loads(blocks[-1])
        assert rep["head"] == head, f"report head {rep['head']!r} is not the judged head {head}"
        named = [c["id"] for c in rep["criteria"]]
        twice = sorted({i for i in named if named.count(i) > 1})
        assert not twice, f"judged more than once: {' '.join(map(str, twice))}"
        verdicts = {c["id"]: c for c in rep["criteria"]}
        assert sorted(verdicts) == [i], f"ids {sorted(verdicts)} != {[i]}"
        for c in verdicts.values():
            assert c.get("verdict") in ("pass", "fail"), f"{c.get('id')}: verdict {c.get('verdict')!r}"
            assert c.get("command") and "output" in c, f"{c['id']}: needs command and output"
    except (IndexError, ValueError, KeyError, TypeError, AssertionError) as e:
        report_path.write_text(json.dumps(raw, indent=2))
        die(3, f"judge report unusable ({e}); raw run in {report_path}")
    rec["report"] = rep
    return rep


def settle(status: Path, pr: int, ids: list[str], head: str, data: dict[str, Any], verdicts: dict[str, Result], raw: dict[str, Any],
           report_path: Path, nmiss: int, *, nosb: bool, demos: dict[str, dict[str, Any]]) -> int:
    """One result per claimed criterion (quality spec #qc-results) into the report, then, sandboxed, the status file:
    passed built, failed planned, one status-only commit."""
    raw["results"] = [verdicts[i] for i in ids]
    report_path.write_text(json.dumps(raw, indent=2))

    passed = [i for i in ids if verdicts[i]["verdict"] == "pass"]
    failed = [i for i in ids if i not in passed]
    if nosb:
        for i in ids:
            print(f"{verdicts[i]['verdict'].upper()} {i}: $ {verdicts[i]['command']}\n  {decided(verdicts[i])}")
        print(f"qc: UNSANDBOXED, {len(passed)}/{len(ids)} passed at {head[:12]}; offline gh refusals {nmiss}; status file not changed; report {report_path}")
        return 1
    for i in failed:
        data["criteria"][i] = {"status": "planned", "pr": None}
    status.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
    for i in passed:   # built with its evidence link (quality spec #qc-results): complete evidence was captured at the head
        tests = [a for t in demos.get(i, {}).get("tests", []) for a in ("--test", str(t))]
        b = subprocess.run([str(STATUS_TOOL), "built", str(status), str(pr), i, "--record", verdicts[i]["record"],
                            "--commit", verdicts[i]["head"], *tests], capture_output=True, text=True)
        if b.returncode:
            die(3, f"status entry for {i} not written: {b.stderr.strip()}; report {report_path}")
    chk = subprocess.run([str(STATUS_TOOL), "check", str(status.parent)], capture_output=True, text=True)
    if chk.returncode:
        die(3, chk.stderr.strip())
    if git("status", "--porcelain"):
        try:
            git("add", "--", str(status))
            git("commit", "-q", "-m", f"qc: built {' '.join(passed) or '(none)'} (judged {head[:12]})")
        except subprocess.CalledProcessError as e:
            die(3, f"status commit failed ({(e.stderr or '').strip()[:300]}); report {report_path}")
    for i in ids:
        v = verdicts[i]
        print(f"{v['verdict'].upper()} {i}: $ {v['command']}\n  {v.get('why', '')}\n  {decided(v)}")
    print(f"qc: {len(passed)}/{len(ids)} passed at {head[:12]}; offline gh refusals {nmiss}; head now {git('rev-parse', 'HEAD')[:12]}; report {report_path}")
    return 0 if not failed else 1


def decided(v: Result) -> str:
    """The result's evidence state, decision source and record, as the report line shows them."""
    return f"evidence {v['evidence'] or 'none'}; decision {v['decision']}; record {v['record'] or 'none'}"


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
