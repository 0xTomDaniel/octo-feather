#!/usr/bin/env python3
"""octo-feather-qa: the command's launcher. Its code, scripts/octo_feather_qa.py, is imported, so
Python caches its bytecode (scripts/__pycache__/), which it never does for the __main__ script; on
a read-only tree (the qc sandbox) it compiles the module each run instead. Code that needs qa's
functions imports octo_feather_qa, never this file. A loader of this file by path
(scripts/octo-feather-qc advise(), until it imports octo_feather_qa) runs nothing and gets the
module's names."""

import sys

import octo_feather_qa

if __name__ == "__main__":
    sys.exit(octo_feather_qa.main(sys.argv[1:]))
globals().update({k: v for k, v in vars(octo_feather_qa).items() if not k.startswith("__")})
