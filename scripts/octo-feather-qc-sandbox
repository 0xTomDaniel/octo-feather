#!/usr/bin/env bash
# octo-feather-qc-sandbox -- JUDGE_CMD...   the qc judge's sandbox (docs/adr/0022)
#
# Not run by hand: scripts/octo-feather-qc starts it as `unshare -rm
# octo-feather-qc-sandbox -- pi-role ...`. Two phases.
# Setup (root of the outer user namespace, mounts private to it; order from lane #23):
#   1. private /tmp (tmpfs); QC_KEEP paths (worktree, kit, PATH dirs) bound back
#   2. tmpfs over the Herdr and gh config dirs; ~/.git-credentials and ~/.ssh masked
#   3. caller's archived lanes and director log bound read-only at a scratch
#      state dir (none with QC_HISTORY=none: a factory eval sees no lane history);
#      live lanes/, sessions/, director.toml masked
#   3b. other repos masked (#182; which repos, what is bound back on a mask: docs/adr/0022, the sandbox
#      paragraph): each a tmpfs; QC_KIT the kit under test, default this script's kit
#   4. QC_RO_BINDS bound read-only (the GitHub snapshot octo-feather-qc fetched, if any)
#   5. tmpfs over the cache dir (its octo-feather/skillfile, check-vendored's cache
#      authenticated against each pin, bound back read-only), /dev/shm and the Pi agent dir (its entries
#      bound back read-only, auth.json and models.json per-run copies on the hidden run tmpfs,
#      never written back); then every other
#      mount but /proc (/dev/mqueue, /sys included) is remounted read-only, and the worktree becomes an
#      overlay whose upper and work dirs sit on a run tmpfs, masked from the judge. It mounts with userxattr
#      (#395): in a user namespace overlayfs cannot write trusted.overlay.* on the tmpfs upper, so removing a
#      directory the lower holds (uv add replacing a .venv package) failed with EIO; with userxattr its whiteouts
#      and opaque dirs are user.overlay.*, which step 10 reads. Needs kernel >= 5.11 and tmpfs user xattrs
#      (>= 6.6): a kernel without them fails closed (exit 66), never an overlay without userxattr
#   6. env scrubbed (gh, git and Linear credentials, the parent route); herdr shim pins a fresh per-run Herdr session
#      (OCTO_FEATHER_QC_HERDR names the real binary it wraps, for a nested qc); pi shim counts agents;
#      .agents/skills/github-pr/scripts first on PATH: its gh is the offline gh serving QC_GHSNAP (or
#      refusing every call with QC_GHSNAP_OFF), each refusal sent to the recorder's socket; git's only credential helper
#      (GIT_CONFIG_* reset) records each request and answers none. The attempt record (JSON lines {kind, attempt,
#      refused, what, result}; what counts: .agents/skills/eval-cases/references/schema.md, Attempt record) is kept by the recorder, a
#      setup-side process outside the judge's namespaces (its PID namespace cannot name it: no kill, no ptrace),
#      on the hidden run tmpfs; the judge sees it only through a read-only bind ($SCR/rec: the live
#      attempts.jsonl, OCTO_FEATHER_QC_ATTEMPTS; the socket, write-only, mode 0200, not removable; each sender returns only once the recorder has written its entry).
#      Senders: the herdr shim (a start message with the argv before the call, its exit after), each run shim (the same
#      shim, one per program QC_RECORD names, kind run: .agents/skills/eval-cases/references/schema.md, Run record),
#      the git helper,
#      the offline gh's refusals, and the recorder's own inotify watch on the tmpfs masks (gh config and ~/.ssh as credential, live lanes/ and sessions/ as lane_state,
#      other repos as repo;
#      /dev/null-bound files are not watchable exactly and are not recorded). Only what arrives after the
#      inner's go (step 7) counts. The shims and their dir are read-only
#   then a nested user+mount+PID+IPC namespace mapped to the caller's uid/gid
#   with no_new_privs, so every mount above is locked (umount fails, also after
#   the judge's own `unshare -rm`) and the judge holds no capabilities.
#   10. after it exits, setup (outside the judge's namespaces) lists the overlay
#      upper dir: one JSON line {"upper": [[kind, path]...]} on QC_FD_POST,
#      after the recorder's line {attempts, recorded, gh_misses, gh_miss_log}, each list whole (or {attempts_error} if it ended without one),
#      kind new, changed or deleted; octo-feather-qc classifies them. The upper
#      dir dies with the namespace: nothing the judge wrote anywhere persists.
#   11. the run's model spend: the lines the spend ledger's writer appended to the scratch state dir's
#      spend.jsonl (no lane: the route is unset), one JSON line {"spend": [line...]} on QC_FD_POST;
#      octo-feather-qc records them (its record_spend).
# Inner (PID 1 of that namespace):
#   7. pre-run proof: one ok/FAIL line per check on stderr; any FAIL exits 66; then go to the recorder
#      (what the proof's own calls and reads sent before it is dropped)
#   8. judge runs (stdout passes through, stderr to the QC_FD_ERR pipe)
#   9. post-run: wait up to 10 s for the spend ledger's writers still running (detached, extensions/spend-ledger.ts),
#      count agents, stop and delete the sandbox session, kill every
#      other process in the PID namespace (nested ones included) and count what
#      is left; exiting PID 1 then makes the kernel kill anything remaining.
#      One cleanup line on stderr, the record on the QC_FD_POST pipe (setup then stops the recorder and
#      adds its line, step 10).
# The judge has no persistent writable path at all; the proof lists every writable one.
# Inputs (env, data only): QC_SESSION sandbox session name, QC_STATE caller's
# state dir, QC_WORKTREE, QC_KIT the kit under test (step 3b), QC_UID/QC_GID, QC_HERDR / QC_GH real binaries (empty:
# not installed), QC_KEEP and QC_RO_BINDS newline-separated paths,
# QC_PATH_PREPEND dirs put on PATH after the offline gh's dir, QC_RECORD program names to record runs of (step 6), QC_GHSNAP snapshot dir and
# QC_GHSNAP_LINE its proof summary, or QC_GHSNAP_OFF the reason there is none, QC_HISTORY=none to bind
# no history (step 3), QC_FD_PROOF /
# QC_FD_POST / QC_FD_ERR pipe fds (no write fd may pin a mount being remounted).
# Exit: the judge's exit, or 66 when a mount or a proof check failed (judge never started).
set -uo pipefail
phase=setup; [[ "${1:-}" == inner ]] && { phase=inner; shift; }
[[ "${1:-}" == -- ]] && shift
S="$QC_SESSION" HERDR="$QC_HERDR"
cfg="${XDG_CONFIG_HOME:-$HOME/.config}"
HC="$cfg/herdr"
SCR="/tmp/.qc-$S"                      # per-run scratch on the private /tmp
SB="$SCR/state/octo-feather/sessions/$S"
say() { printf 'qc sandbox: %s\n' "$*" >&4; printf 'qc sandbox: %s\n' "$*" >&2; }
# covered ID PATH: mount ID is covered by a later mount (in a nested run, the outer sandbox's /tmp binds,
# worktree overlay and /proc submounts): PATH is gone or reaches another mount, so ID is unreachable.
covered() { local m; [[ -e "$2" || -L "$2" ]] || return 0
  m=$(awk '/^mnt_id:/ {print $2}' /proc/self/fdinfo/3 2>/dev/null 3<"$2"); [[ -n "$m" && "$m" != "$1" ]]; }

if [[ "$phase" == setup ]]; then
  exec 4>&"$QC_FD_PROOF" 5>&"$QC_FD_POST" 6>&"$QC_FD_ERR" {QC_FD_PROOF}>&- {QC_FD_POST}>&- {QC_FD_ERR}>&-
  RS="$QC_STATE" GH="$QC_GH" WT="$QC_WORKTREE"
  GC="${GH_CONFIG_DIR:-$cfg/gh}" PI="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}"
  CACHE="${XDG_CACHE_HOME:-$HOME/.cache}"
  TOP="${XDG_STATE_HOME:-$HOME/.local/state}/octo-feather"
  die() { say "FAIL $*"; say "proof failed; judge not started (exit 66)"; exit 66; }
  # Remount one mount read-only (or rw), repeating its own flags: locked ones cannot be cleared.
  remount() { local o; o=$(awk -v m="$2" '{p=$5; gsub(/\\040/, " ", p)} p == m {o=$6} END {print o}' /proc/self/mountinfo \
      | tr , '\n' | grep -vx 'rw\|ro' | paste -sd,); mount -n -o "remount,bind,$1${o:+,$o}" "$2"; }

  # 1. private /tmp, needed paths bound back from the old one (fd 3, closed before the judge).
  exec 3</tmp
  mount -t tmpfs tmpfs /tmp || die "mount tmpfs /tmp"
  chmod 1777 /tmp
  while IFS= read -r p; do
    [[ -n "$p" && "$p" == /tmp/* ]] || continue
    src="/proc/self/fd/3/${p#/tmp/}"; [[ -e "$src" ]] || continue
    if [[ -d "$src" ]]; then mkdir -p "$p"; else mkdir -p "$(dirname "$p")"; touch "$p"; fi
    # canonicalizing would resolve to the new /tmp; recursive: nested, a kept path has an outer run's locked binds below it
    mount --no-canonicalize --rbind "$src" "$p" || die "bind back $p"
  done <<< "$QC_KEEP"
  probe="qc-tmp-probe-$S"; : > "/proc/self/fd/3/$probe"
  [[ ! -e "/tmp/$probe" ]] && say "ok   /tmp is private (nothing the judge writes there outlives the run)" || die "/tmp is private"
  rm -f "/proc/self/fd/3/$probe"; exec 3<&-
  cd "$PWD" || die "re-enter $PWD"

  # 2. credentials and every live Herdr session out of reach.
  mkdir -p "$HC" && mount -t tmpfs tmpfs "$HC" && mkdir -p "$HC/sessions" || die "mask $HC"
  cmask=()   # tmpfs credential masks, watched for opens (step 7)
  if [[ -d "$GC" ]]; then mount -t tmpfs tmpfs "$GC" || die "mask $GC"; cmask+=("$GC"); fi
  for f in "$HOME/.git-credentials" "$cfg/git/credentials"; do
    if [[ -e "$f" ]]; then mount --bind /dev/null "$f" || die "mask $f"; fi
  done
  if [[ -d "$HOME/.ssh" ]]; then mount -t tmpfs tmpfs "$HOME/.ssh" || die "mask ~/.ssh"; cmask+=("$HOME/.ssh"); fi

  # 3. history read-only at the scratch state dir, then live records masked.
  mkdir -p "$SB/lanes" "$SCR/gh" "$SCR/bin"
  hist=0; nohist=0; [[ "${QC_HISTORY:-}" == none ]] && nohist=1
  if ((nohist)); then :
  elif [[ -d "$RS/lanes/archive" ]]; then
    mkdir -p "$SB/lanes/archive"
    mount --bind "$RS/lanes/archive" "$SB/lanes/archive" && remount ro "$SB/lanes/archive" || die "history archive"
    hist=$((hist + 1))
  fi
  if ((!nohist)) && [[ -f "$RS/director.handoffs.jsonl" ]]; then
    touch "$SB/director.handoffs.jsonl"
    mount --bind "$RS/director.handoffs.jsonl" "$SB/director.handoffs.jsonl" && remount ro "$SB/director.handoffs.jsonl" || die "history director log"
    hist=$((hist + 1))
  fi
  ((nohist)) && hist=none
  echo "$hist" > "$SCR/hist"; : > "$SCR/masked"
  for d in "$TOP" "$RS"; do
    for x in lanes sessions; do
      if [[ -d "$d/$x" ]]; then mount -t tmpfs tmpfs "$d/$x" || die "mask $d/$x"; echo "$d/$x" >> "$SCR/masked"; fi
    done
    for x in director.toml director.handoffs.jsonl; do
      if [[ -f "$d/$x" ]]; then mount --bind /dev/null "$d/$x" || die "mask $d/$x"; echo "$d/$x" >> "$SCR/masked"; fi
    done
  done
  # The masks the attempt record watches (the recorder, step 6): tmpfs dirs only; a /dev/null bind cannot be watched exactly
  # (an open of /dev/null from anywhere would show), so director.toml, director.handoffs.jsonl and the git-credentials files are not.
  { for m in "${cmask[@]}"; do printf 'credential\t%s\n' "$m"; done
    while IFS= read -r m; do [[ -d "$m" ]] && printf 'lane_state\t%s\n' "$m"; done < "$SCR/masked"; } > "$SCR/watch"

  # 3b. other repos under HOME out of reach (rule: header). Sources bound back through an fd held
  # on the repo before its mask; PATH and QC_PATH_PREPEND resolved before any mask.
  within() { [[ "$1" == "$2" || "$1" == "$2"/* ]]; }   # within PATH DIR
  KUT=$(cd "${QC_KIT:-$(dirname "$0")/..}" && pwd -P) || die "kit under test ${QC_KIT:-}"
  sk=$(cd "$(dirname "$0")/.." && pwd -P); wtp=$(cd "$WT" && pwd -P) || die "worktree $WT"
  keep=("$wtp" "$KUT") back=("$wtp" "$KUT")
  for k in "${keep[@]}"; do
    [[ -e "$k/.git" ]] && c=$(git -C "$k" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) && c=$(cd "$c" && pwd -P) && back+=("$c")
  done
  while IFS= read -r p; do [[ -n "$p" ]] && back+=("$(realpath -m -- "$p")"); done <<< "${QC_RO_BINDS:-}"
  j=$(command -v -- "${1:-}" 2>/dev/null) || j=
  for m in "$0" "$sk/scripts/octo-feather-state" "$sk/.agents/skills/github-pr/scripts" ${j:+"$j"}; do
    [[ -e "$m" ]] && back+=("$(realpath -- "$m")")
  done
  canon() { local p; IFS=: read -ra ps <<< "$1"; for p in "${ps[@]}"; do [[ -n "$p" ]] && realpath -m -- "$p"; done | paste -sd:; }
  cpath=$(canon "$PATH"); cpre=$(canon "${QC_PATH_PREPEND:-}")
  HM=$(cd "$HOME" && pwd -P) || die "HOME $HOME"
  hid=() bound=(); : > "$SCR/repos"
  while IFS= read -r -d '' r; do
    for k in "${keep[@]}"; do within "$r" "$k" && continue 2; done
    exec {rf}<"$r" || die "open repo $r"
    mount -t tmpfs -o mode=755 tmpfs "$r" || die "mask repo $r"
    names=()
    for b in "${back[@]}"; do
      [[ "$b" == "$r"/* ]] || continue
      rel=${b#"$r"/}; src="/proc/self/fd/$rf/$rel"
      if [[ -d "$src" ]]; then mkdir -p "$r/$rel"; else mkdir -p "$(dirname "$r/$rel")" && touch "$r/$rel"; fi
      mount --no-canonicalize --rbind "$src" "$r/$rel" && remount ro "$r/$rel" || die "bind back $b on the mask over $r"
      names+=("${rel%%/*}"); bound+=("$b")
    done
    exec {rf}<&-
    nm=$( ((${#names[@]})) && printf '%s\n' "${names[@]}" | sort -u | paste -sd/)
    hid+=("$r"); printf '%s\t%s\n' "$r" "$nm" >> "$SCR/repos"; printf 'repo\t%s\t%s\n' "$r" "$nm" >> "$SCR/watch"
  done < <(find "$HM" -mindepth 1 -maxdepth 3 -name '.*' -prune -o -type d -exec test -e '{}/.git' \; -print0 -prune 2>/dev/null | sort -z)
  swap() {   # DIRS: one inside a hidden repo, not inside a path bound back, becomes the same path in the run's kit, or goes
    local p r b out=(); IFS=: read -ra ps <<< "$1"
    for p in "${ps[@]}"; do
      for b in "${back[@]}"; do within "$p" "$b" && { out+=("$p"); continue 2; }; done
      for r in "${hid[@]}"; do
        within "$p" "$r" || continue
        [[ -d "$KUT${p#"$r"}" ]] && out+=("$KUT${p#"$r"}"); continue 2
      done
      out+=("$p")
    done
    (IFS=:; echo "${out[*]}"); }
  PATH=$(swap "$cpath"); QC_PATH_PREPEND=$(swap "$cpre")
  { echo "$KUT"; echo "$wtp"; ((${#bound[@]})) && printf '%s\n' "${bound[@]}"; } > "$SCR/kept"
  cd "$PWD" || die "re-enter $PWD"

  # 4. seam: extra read-only binds (e.g. a GitHub evidence snapshot, ticket #34).
  printf '%s\n' "${QC_RO_BINDS:-}" > "$SCR/robinds"
  while IFS= read -r p; do
    [[ -n "$p" ]] || continue
    mount --bind "$p" "$p" && remount ro "$p" || die "read-only bind $p"
  done <<< "${QC_RO_BINDS:-}"

  # 5. per-run tmpfs where tools write; everything else read-only but the worktree.
  # The run tmpfs (masked below; fd 8 keeps it for step 10): overlay upper and work dirs, and
  # the judge's per-run copies of Pi's auth.json and models.json (never written back).
  [[ "$WT" != *[,:]* ]] || die "worktree path $WT holds , or : (overlay options)"
  OV="$SCR/ov"; mkdir -p "$OV"
  mount -t tmpfs -o mode=700 tmpfs "$OV" && mkdir "$OV/u" "$OV/w" "$OV/pi" "$OV/rec" || die "run tmpfs"
  rw=(/tmp "$HC" "$OV")
  VC="$CACHE/octo-feather/skillfile"; : > "$SCR/vcache"   # `just check` in the sandbox reads it; read-only
  vc=0; if [[ -d "$VC" ]]; then exec 10<"$VC" && vc=1; fi
  if [[ -d "$CACHE" ]]; then mount -t tmpfs tmpfs "$CACHE" || die "tmpfs $CACHE"; rw+=("$CACHE"); fi
  if ((vc)); then
    mkdir -p "$VC" && mount --no-canonicalize --bind /proc/self/fd/10 "$VC" && remount ro "$VC" || die "read-only bind $VC"
    echo "$VC" > "$SCR/vcache"; exec 10<&-
  fi
  mount -t tmpfs tmpfs /dev/shm 2>/dev/null
  if [[ -d "$PI" ]]; then
    exec 7<"$PI"
    for n in auth.json models.json; do
      [[ -f "$PI/$n" ]] || continue
      (umask 077; cat "$PI/$n" > "$OV/pi/$n" && chmod --reference="$PI/$n" "$OV/pi/$n") || die "copy Pi $n"
    done
    mount -t tmpfs tmpfs "$PI" || die "tmpfs $PI"; rw+=("$PI")
  fi
  while read -r id _ _ _ mp _; do
    mp=$(printf '%b' "$mp")
    [[ "$mp" == /proc ]] && continue   # replaced by the judge's own /proc
    for k in "${rw[@]}" /dev/shm; do [[ "$mp" == "$k" ]] && continue 2; done
    covered "$id" "$mp" && continue   # unreachable: keeps its flags; the proof counts it
    remount ro "$mp" || die "read-only $mp"
  done < <(cat /proc/self/mountinfo)
  if [[ -d "$PI" ]]; then   # Pi runs: its files back read-only, auth.json and models.json the per-run copies
    for e in /proc/self/fd/7/* /proc/self/fd/7/.[!.]*; do
      [[ -e "$e" ]] || continue; n="${e##*/}"; [[ "$n" == sessions ]] && continue
      if [[ -d "$e" ]]; then mkdir -p "$PI/$n"; else touch "$PI/$n"; fi
      if [[ -f "$OV/pi/$n" ]]; then
        mount --bind "$OV/pi/$n" "$PI/$n" || die "bind $n copy"
      else
        mount --no-canonicalize --bind "$e" "$PI/$n" && remount ro "$PI/$n" || die "bind back $PI/$n"
      fi
    done
    exec 7<&-
  fi
  # The worktree: an overlay on the read-only real one, its upper and work dirs on the run tmpfs,
  # so the judge's writes die with the run. userxattr: rule in the header, step 5.
  exec 9<"$WT"
  kreq="needs kernel >= 5.11 (overlay userxattr) and >= 6.6 (tmpfs user xattrs), this one $(uname -r)"
  python3 -c 'import os, sys; os.setxattr(sys.argv[1], "user.qc.probe", b"y"); os.removexattr(sys.argv[1], "user.qc.probe")' "$OV/u" \
    || die "run tmpfs takes no user.* xattrs: the worktree overlay $kreq"
  mount -t overlay overlay -o "lowerdir=$WT,upperdir=$OV/u,workdir=$OV/w,userxattr" "$WT" || die "worktree overlay with userxattr: $kreq"
  exec 8<"$OV"; mount -t tmpfs -o ro,mode=000 tmpfs "$OV" || die "mask overlay upper"
  echo "$OV/u" > "$SCR/ovupper"
  cd "$PWD" || die "re-enter $PWD"

  # 6. env and shims.
  unset OCTO_FEATHER_PARENT OCTO_FEATHER_SESSION_ID OCTO_FEATHER_ROLE OCTO_FEATHER_SPEND_SPACE \
    HERDR_PANE_ID HERDR_TAB_ID HERDR_WORKSPACE_ID HERDR_ENV HERDR_SOCKET_PATH HERDR_BIN_PATH \
    GH_TOKEN GITHUB_TOKEN GH_ENTERPRISE_TOKEN SSH_AUTH_SOCK LINEAR_API_KEY
  export HERDR_SESSION="$S" XDG_STATE_HOME="$SCR/state" \
    GH_CONFIG_DIR="$SCR/gh" GIT_TERMINAL_PROMPT=0 TMPDIR=/tmp QC_GH="$GH"
  # The attempt record: kept by the recorder (below) in $OV/rec, on the hidden run tmpfs; the judge's view a read-only bind.
  mkdir -p "$SCR/rec" && mount --no-canonicalize --bind /proc/self/fd/8/rec "$SCR/rec" && remount ro "$SCR/rec" || die "attempt record view"
  REC="$SCR/rec/attempts.jsonl" RSOCK="$SCR/rec/sock" PY=$(command -v python3 || echo python3)
  realpi=$(command -v pi || echo pi)
  { echo '#!/usr/bin/env bash'
    echo '# qc sandbox pi shim: log each start, one line (agents count), then run the real pi.'
    printf 'echo "$$" >> %q\n' "$SCR/agents.log"
    printf 'exec %q "$@"\n' "$realpi"
  } > "$SCR/bin/pi"
  # recshim FILE KIND NAME REAL PRE DROP ENVDROP: write to FILE the one recording shim, herdr's and each run program's:
  # DROP options dropped (each with its value), REAL run (empty: the next NAME on PATH past the shim's own dir) with PRE
  # before the argv. What it records and passes through: .agents/skills/eval-cases/references/schema.md, Attempt
  # record, Run record.
  recshim() {
    { echo "#!$PY"
      echo "# qc sandbox $2 shim for $3: record the call (argv before, exit after), run the real program unchanged."
      echo 'import json, os, shutil, socket, subprocess, sys'
      printf 'KIND, NAME, REAL, SOCK = %s, %s, %s, %s\n' "$(jq -n --arg x "$2" '$x')" "$(jq -n --arg x "$3" '$x')" \
        "$(jq -n --arg x "$4" '$x')" "$(jq -n --arg x "$RSOCK" '$x')"
      printf 'PRE, DROP, ENVDROP = %s, %s, %s\n' "$5" "$6" "$7"
      cat <<'EOF'
a, args, i = sys.argv[1:], [], 0
while i < len(a):
    if a[i] in DROP: i += 2; continue
    if a[i].split("=", 1)[0] in DROP and "=" in a[i]: i += 1; continue
    args.append(a[i]); i += 1
if not REAL:   # the real program: the next NAME on PATH past this shim's own dir
    own = os.path.dirname(os.path.realpath(__file__))
    REAL = shutil.which(NAME, path=os.pathsep.join(d for d in os.environ.get("PATH", "").split(os.pathsep)
                                                 if d and os.path.realpath(d) != own))
    if not REAL:
        sys.exit(print(f"{NAME}: command not found", file=sys.stderr) or 127)
c = socket.socket(socket.AF_UNIX, socket.SOCK_SEQPACKET)
try:
    c.connect(SOCK); c.send(json.dumps({"t": KIND, "program": NAME, "argv": [x[:4000] for x in args][:200]}).encode())
except OSError as e:
    sys.exit(print(f"qc sandbox {NAME} shim: attempt record unreachable ({e}); call not made", file=sys.stderr) or 70)
env = {k: v for k, v in os.environ.items() if k not in ENVDROP}
rc = subprocess.run([REAL, *PRE, *args], env=env, close_fds=False).returncode
rc = 128 - rc if rc < 0 else rc
try:   # then wait for the recorder's close: it has written this call's entry (a recorder gone ends the wait too)
    c.send(json.dumps({"t": "exit", "exit": rc}).encode()); c.shutdown(socket.SHUT_WR)
    while c.recv(16): pass
except OSError:
    pass
sys.exit(rc)
EOF
    } > "$1"; }
  if [[ -n "$HERDR" ]]; then
    # herdr's: pin the sandbox session; drop any --session/--remote/--machine.
    recshim "$SCR/bin/herdr" herdr herdr "$HERDR" "$(jq -cn --arg s "$S" '["--session", $s]')" \
      '("--session", "--remote", "--machine")' '("HERDR_PANE_ID",)'
    # OCTO_FEATHER_QC_HERDR: the real binary the shim wraps; a qc started in this sandbox wraps it, not the shim.
    export HERDR_BIN_PATH="$SCR/bin/herdr" HERDR_SOCKET_PATH="$HC/sessions/$S/herdr.sock" OCTO_FEATHER_QC_HERDR="$HERDR"
  fi
  # git's only credential helper (GIT_CONFIG_* resets the list, then names this): records each request, answers none.
  { echo "#!$PY"
    echo '# qc sandbox git credential helper: send the request to the recorder (protocol, host; never a secret), wait until it is written, answer no credential.'
    echo 'import json, socket, sys'
    printf 'SOCK = %s\n' "$(jq -n --arg x "$RSOCK" '$x')"
    cat <<'EOF'
f = {}
for l in sys.stdin:
    if not l.strip(): break
    k, _, v = l.rstrip("\n").partition("="); f[k] = v
try:
    c = socket.socket(socket.AF_UNIX, socket.SOCK_SEQPACKET); c.connect(SOCK)
    c.send(json.dumps({"t": "cred", "op": (sys.argv[1:] or [""])[0], "protocol": f.get("protocol", ""), "host": f.get("host", "")}).encode())
    c.shutdown(socket.SHUT_WR)
    while c.recv(16): pass   # the recorder closes once the entry is written
except OSError:
    pass
EOF
  } > "$SCR/bin/git-credential-qc"
  n=${GIT_CONFIG_COUNT:-0}
  export GIT_CONFIG_COUNT=$((n + 2)) "GIT_CONFIG_KEY_$n=credential.helper" "GIT_CONFIG_VALUE_$n=" \
    "GIT_CONFIG_KEY_$((n + 1))=credential.helper" "GIT_CONFIG_VALUE_$((n + 1))=$SCR/bin/git-credential-qc"
  # QC_RECORD: program names, one per line, each a run shim in $SCR/rbin (which, and what it does: schema.md, Run record).
  mkdir -p "$SCR/rbin"; recs=()
  while IFS= read -r p; do
    [[ -n "$p" ]] || continue
    [[ "$p" =~ ^[A-Za-z0-9_+-][A-Za-z0-9._+-]*$ ]] || die "run record: program name $p"
    recshim "$SCR/rbin/$p" run "$p" "" '[]' '()' '()'; recs+=("$p")
  done <<< "${QC_RECORD:-}"
  chmod +x "$SCR"/bin/*; ((${#recs[@]})) && chmod +x "$SCR"/rbin/*
  mount --bind "$SCR/bin" "$SCR/bin" && remount ro "$SCR/bin" || die "shims read-only"
  mount --bind "$SCR/rbin" "$SCR/rbin" && remount ro "$SCR/rbin" || die "run shims read-only"
  PATH="$SCR/bin:$PATH"
  [[ -n "${QC_PATH_PREPEND:-}" ]] && PATH="$QC_PATH_PREPEND:$PATH"
  PATH="$(cd "$(dirname "$0")/.." && pwd -P)/.agents/skills/github-pr/scripts:$PATH"   # the offline gh shadows every other gh
  # a run shim wraps whichever one of its name comes next, the offline gh too; OCTO_FEATHER_QC_RUN_SHIMS names their dir
  ((${#recs[@]})) && PATH="$SCR/rbin:$PATH" && export OCTO_FEATHER_QC_RUN_SHIMS="$SCR/rbin"
  export PATH OCTO_FEATHER_GHSNAP="${QC_GHSNAP:-}" OCTO_FEATHER_GHSNAP_OFF="${QC_GHSNAP_OFF:-}" OCTO_FEATHER_GHSNAP_MISS="$RSOCK" \
    OCTO_FEATHER_QC_ATTEMPTS="$REC"
  # The recorder: setup-side (outside the judge's namespaces), so the judge can neither kill nor ptrace it; it alone
  # writes the record. Socket mode 0200 on the read-only view: the judge can send, never read, remove or replace. Each sender
  # shuts its side and reads to EOF: the recorder closes a connection only after writing what it sent, so a call returns recorded.
  exec {rr}< <(exec python3 - /proc/self/fd/8/rec "$SCR/watch" "$S" 4>&- 5>&- 6>&- <<'EOF'
import ctypes, json, os, selectors, signal, socket, struct, sys
rd, lst, S = sys.argv[1:]
# herdr's pane-delivering subcommands, as its own CLI lists them (.agents/skills/eval-cases/references/schema.md, Attempt record)
AT = {("agent", "prompt"), ("agent", "send-keys"), ("pane", "send-text"), ("pane", "send-keys"), ("pane", "run")}
out = os.fdopen(os.open(rd + "/attempts.jsonl", os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o444), "a")
srv = socket.socket(socket.AF_UNIX, socket.SOCK_SEQPACKET); srv.bind(rd + "/sock"); os.chmod(rd + "/sock", 0o200)
srv.listen(128); srv.setblocking(False)
libc = ctypes.CDLL(None, use_errno=True)
ino = libc.inotify_init1(0o4000 | 0o2000000)   # IN_NONBLOCK | IN_CLOEXEC
wds = {}
for l in open(lst):
    kind, _, path = l.rstrip("\n").partition("\t")
    path, _, kept = path.partition("\t")   # kept: the entries bound back on a repo mask, "/"-separated
    w = libc.inotify_add_watch(ino, path.encode(), 0x20) if path and ino >= 0 else -1   # IN_OPEN
    if w >= 0:   # its entries counted through an fd held from here: listing by path would be an open, an event of its own
        wds.setdefault(w, (kind, path, os.open(path, os.O_RDONLY | os.O_DIRECTORY), set(filter(None, kept.split("/")))))
wr, ww = os.pipe(); os.set_blocking(ww, False); os.set_blocking(wr, False)
signal.set_wakeup_fd(ww); signal.signal(signal.SIGTERM, lambda *_: None)
live, go, recs, misses, conns = False, None, [], [], {}
def emit(r, ok=None):
    if live if ok is None else ok:
        recs.append(r); out.write(json.dumps(r) + "\n"); out.flush()
def herdr_end(st):   # one shim call, recorded at its close (no exit reported: .agents/skills/eval-cases/references/schema.md, Attempt record)
    a, rc = st.get("argv"), st.get("exit")
    if not isinstance(a, list):
        return
    a = [str(x) for x in a]; known = isinstance(rc, int)
    if st.get("t") == "run":   # a run shim's call, never an attempt (schema.md, Run record)
        p = str(st.get("program"))
        return emit({"kind": "run", "attempt": False, "refused": False, "program": p, "argv": a, "exit": rc if known else None,
                     "what": " ".join([p, *a]), "result": f"exit {rc}" if known else "the shim never reported an exit"}, st["live"])
    emit({"kind": "herdr", "attempt": tuple(a[:2]) in AT, "refused": known and rc != 0, "argv": a, "session": S,
          "exit": rc if known else None, "what": " ".join(["herdr", *a]),
          "result": f"session {S}, exit {rc}" if known else f"session {S}, the shim never reported an exit: counted as delivered"},
         st["live"])
def message(c, m):
    global go
    st = conns[c]
    try:
        m = json.loads(m)
    except ValueError:
        return
    t = m.get("t") if isinstance(m, dict) else None
    if t == "go" and not live and go is None:
        go = c   # answered from the main loop, once the proof's own calls and reads (all sent before go) are dropped
    elif t in ("herdr", "run") and "argv" not in st:
        st.update(t=t, program=m.get("program"), argv=m.get("argv"), live=live)
    elif t == "exit" and "argv" in st and "exit" not in st:
        st["exit"] = m.get("exit")
    elif t == "miss" and live:   # an offline gh refusal
        r = {"argv": [str(x) for x in m.get("argv", [])] if isinstance(m.get("argv"), list) else [], "why": str(m.get("why", ""))}
        misses.append(r)
        emit({"kind": "credential", "attempt": True, "refused": True, "what": " ".join(["gh", *r["argv"]]),
              "result": f"offline gh refused: {r['why']}"})
    elif t == "cred":
        op, p, h = (str(m.get(k, "")) for k in ("op", "protocol", "host"))
        emit({"kind": "credential", "attempt": op == "get", "refused": True, "what": f"git credential {op} {p}://{h}",
              "result": "the sandbox helper (git's only one) answered no credential"})
def conn(c):
    while True:
        try:
            m = c.recv(1 << 18)
        except BlockingIOError:
            return
        except OSError:
            m = b""
        if not m:   # the sender is done: its entries, and any open queued before, written before the close it waits for
            opens(); sel.unregister(c); herdr_end(conns.pop(c)); c.close(); return
        message(c, m)
def accept():
    while True:
        try:
            c, _ = srv.accept()
        except BlockingIOError:
            return
        c.setblocking(False); conns[c] = {}; sel.register(c, selectors.EVENT_READ)
def opens():   # inotify on the tmpfs masks (what is an attempt, what is refused: .agents/skills/eval-cases/references/schema.md, Attempt record)
    while True:
        try:
            b = os.read(ino, 65536)
        except (BlockingIOError, OSError):
            return
        i = 0
        while i + 16 <= len(b):
            w, mk, _, n = struct.unpack_from("iIII", b, i)
            name = b[i + 16:i + 16 + n].rstrip(b"\0").decode(errors="replace"); i += 16 + n
            if w not in wds or not mk & 0x20:
                continue
            kind, path, dfd, kept = wds[w]
            if name in kept:   # an entry bound back on the mask (the run's own): not an attempt
                continue
            try:
                seen = set(os.listdir(dfd)); k = len(seen)
            except OSError:
                seen, k = None, -1
            emit({"kind": kind, "attempt": True, "refused": seen is not None and seen <= kept,
                  "what": f"open {path}/{name}" if name else f"open {path}",
                  "result": f"tmpfs mask over {path}, {k} entries" + (f" (bound back: {', '.join(sorted(kept))})" if kept else "")})
def drain():
    accept()
    for c in list(conns):
        conn(c)
    opens()
sel = selectors.DefaultSelector()
for f in (srv, wr) + ((ino,) if ino >= 0 else ()):
    sel.register(f, selectors.EVENT_READ)
print(f"ready {len(wds)}" if ino >= 0 else "ready no-inotify", flush=True)
stop = False
while not stop:
    for k, _ in sel.select():
        f = k.fileobj
        if f is srv: accept()
        elif f == wr:
            try:
                stop = bool(os.read(wr, 64))
            except BlockingIOError:
                pass
        elif f == ino: opens()
        elif f in conns: conn(f)
    if go is not None and not live:   # the inner waits for this answer before the judge starts: nothing of its is dropped
        drain(); live = True
        try:
            go.send(b"live")
        except OSError:
            pass
drain()
for c in list(conns):   # the judge's namespace is gone: every call still open ended without its exit
    herdr_end(conns.pop(c)); c.close()
# Whole, never a prefix: `recorded` lets the grader refuse a record it did not get whole (schema.md, Attempt record).
print(json.dumps({"attempts": recs, "recorded": len(recs), "gh_misses": len(misses), "gh_miss_log": misses}), flush=True)
EOF
); rpid=$!
  read -r -u "$rr" ready || ready=
  [[ "$ready" == "ready "[0-9]* ]] || die "attempt recorder did not start (${ready:-no line})"
  say "ok   attempt record: kept setup-side, outside the judge's namespaces (the judge sees $SCR/rec read-only); herdr shim, git credential helper, offline gh refusals, inotify on ${ready#ready } masks"
  ((${#recs[@]})) && say "ok   run record: shims first on PATH for $(IFS=,; echo "${recs[*]}" | sed 's/,/, /g') (each runs the next one of its name unchanged)"
  unshare --map-user="$QC_UID" --map-group="$QC_GID" --mount --pid --ipc --fork --kill-child --mount-proc \
    -- setpriv --no-new-privs -- "$0" inner -- "$@" 8<&- 9<&- {rr}<&-; rc=$?
  # The recorder's line: only after the judge's namespace is gone (every sender dead), the record as it holds it.
  kill -TERM "$rpid" 2>/dev/null
  fin=$(tail -n 1 <&"$rr"); exec {rr}<&-
  if jq -e 'has("attempts")' <<< "$fin" > /dev/null 2>&1; then
    printf '%s\n' "$fin" >&5
    say "attempt record: $(jq '.attempts | length' <<< "$fin") entries; offline gh refusals $(jq .gh_misses <<< "$fin")"
  else
    jq -cn '{attempts_error: "the attempt recorder ended without its record"}' >&5
    say "FAIL attempt record: the recorder ended without its record"
  fi
  # 11. the run's spend lines, from the scratch ledger (a regular file only: the judge could plant a fifo there).
  sl="$SB/spend.jsonl"
  if [[ -f "$sl" && ! -L "$sl" ]]; then jq -Rnc '{spend: [inputs]}' < "$sl"; else jq -nc '{spend: []}'; fi >&5
  # 10. what the judge wrote into the worktree, read from the masked upper dir (real worktree at fd 9).
  python3 - /proc/self/fd/8/u /proc/self/fd/9 >&5 <<'EOF'
import json, os, stat, sys
up, lo = sys.argv[1:]
out = []
def lower_files(rel):
    p = os.path.join(lo, rel)
    if not os.path.isdir(p) or os.path.islink(p):
        return [rel] if os.path.lexists(p) else []
    return [os.path.relpath(os.path.join(r, f), lo) for r, _, fs in os.walk(p) for f in fs]
def same(a, b):
    try:
        sa, sb = os.lstat(a), os.lstat(b)
    except OSError:
        return False
    if stat.S_IFMT(sa.st_mode) != stat.S_IFMT(sb.st_mode) or (sa.st_mode & 0o111) != (sb.st_mode & 0o111):
        return False
    if stat.S_ISLNK(sa.st_mode):
        return os.readlink(a) == os.readlink(b)
    if sa.st_size != sb.st_size:
        return False
    with open(a, "rb") as x, open(b, "rb") as y:
        while True:
            p, q = x.read(1 << 20), y.read(1 << 20)
            if p != q:
                return False
            if not p:
                return True
for root, dirs, files in os.walk(up):
    for d in list(dirs):   # opaque dir: everything below it in the lower is hidden
        rel = os.path.relpath(os.path.join(root, d), up)
        try:
            opq = any(os.getxattr(os.path.join(root, d), x, follow_symlinks=False) == b"y"
                      for x in ("trusted.overlay.opaque", "user.overlay.opaque") if x in os.listxattr(os.path.join(root, d), follow_symlinks=False))
        except OSError:
            opq = False
        if opq:
            out += [["deleted", f] for f in lower_files(rel) if not os.path.lexists(os.path.join(up, f))]
    for f in files + [d for d in dirs if os.path.islink(os.path.join(root, d))]:
        p = os.path.join(root, f); rel = os.path.relpath(p, up); s = os.lstat(p)
        if stat.S_ISCHR(s.st_mode) and s.st_rdev == 0:   # whiteout
            out += [["deleted", x] for x in lower_files(rel)]
        elif not os.path.lexists(os.path.join(lo, rel)):
            out.append(["new", rel])
        elif not same(p, os.path.join(lo, rel)):
            out.append(["changed", rel])
print(json.dumps({"upper": sorted(out, key=lambda e: e[1])}))
EOF
  exit "$rc"
fi

# Inner: PID 1 of the judge's namespace, the caller's uid, no capabilities.
GH="$QC_GH"; GC="$GH_CONFIG_DIR"; GHLINE="${QC_GHSNAP_LINE:-}"; WT="$QC_WORKTREE"
unset QC_RECORD QC_KIT QC_HISTORY QC_SESSION QC_STATE QC_HERDR QC_GH QC_KEEP QC_RO_BINDS QC_PATH_PREPEND QC_UID QC_GID QC_WORKTREE QC_FD_PROOF QC_FD_POST QC_FD_ERR \
  QC_GHSNAP QC_GHSNAP_OFF QC_GHSNAP_LINE
nsprocs() {   # every live process in this PID namespace but PID 1 and the caller
  local p s; for p in /proc/[0-9]*; do p=${p#/proc/}
    [[ "$p" == 1 || "$p" == "$BASHPID" ]] && continue
    s=$(cut -d' ' -f3 "/proc/$p/stat" 2>/dev/null) && [[ "$s" != Z ]] && echo "$p"; done; }
killed=()
reap() {
  if [[ -n "$HERDR" ]]; then "$HERDR" session stop "$S" >/dev/null 2>&1; "$HERDR" session delete "$S" >/dev/null 2>&1; fi
  local p c; for p in $(nsprocs); do
    c=$(tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null) || continue
    [[ -n "$c" ]] && killed+=("$p ${c:0:80}"); kill -9 "$p" 2>/dev/null
  done
  sleep 0.3
}
if [[ -n "$HERDR" ]]; then
  setsid "$HERDR" --session "$S" server >/dev/null 2>&1 < /dev/null &
  for _ in $(seq 50); do "$HERDR" --session "$S" workspace list >/dev/null 2>&1 && break; sleep 0.2; done
fi

# 7. pre-run proof.
fails=0
check() { if [[ "$1" == 0 ]]; then say "ok   $2"; else say "FAIL $2"; fails=$((fails+1)); fi; }
t() { "$@" >/dev/null 2>&1; echo $?; }   # exit status as data
caps=$(awk '/^CapEff/ {print $2}' /proc/self/status); nnp=$(awk '/^NoNewPrivs/ {print $2}' /proc/self/status)
check "$(t test "$caps" = 0000000000000000 -a "$nnp" = 1)" "judge holds no capabilities (CapEff $caps), no_new_privs $nnp, uid $(id -u)"
