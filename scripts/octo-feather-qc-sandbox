SRT_PKG = "@anthropic-ai/sandbox-runtime"
# srt run through its own library, as its CLI (dist/cli.js, the Linux path) runs a command: loadConfig, initialize,
# wrapWithSandbox of the quoted argv, spawn with the shell and stdio inherited, cleanupAfterCommand, then (unlike the CLI, which exits
# first) its reset() awaited, so its proxy bridges are reaped before exit. The bwrap argv is
# the CLI's for the same settings (checked: /proc/1/cmdline alike but for per-run ids and ports). Why not the CLI: it
# reports no violation; the library's violation store does (getSandboxViolationStore, subscribe), each event one line
# "QC-SRT-VIOLATION {json}" on this process's stderr, which the setup reads (srt_log).
# Stock Node numeric bridge kills cannot reserve identity across asynchronous reap.
# The maintained SDK adapter therefore uses this existing Recorder's self-pidfd
# channel; it adds only the lifetime/completion capability the SDK cannot supply.
SRT_SHIM = r"""
const [pkg, settings, , ...args] = process.argv.slice(1)
const { SandboxManager } = await import(`${pkg}/dist/index.js`)
const { loadConfig } = await import(`${pkg}/dist/utils/config-loader.js`)
const { quote } = await import(`${pkg}/dist/utils/shell-quote.js`)
const { spawn } = await import('node:child_process')
const { randomBytes } = await import('node:crypto')
if (SandboxManager.nativeBridgeLifecycleABI !== 1) {
  throw new Error('qc sandbox: retained native lifecycle ABI1 required before initialize; stock SDK refused')
}
const names = ['QC_NATIVE_SECRET', 'QC_NATIVE_SOCKET', 'QC_NATIVE_PYTHON', 'QC_NATIVE_COMMAND', 'QC_FD_CANCEL']
const control = Object.fromEntries(names.map(k => [k, process.env[k]]))
if (names.some(k => !control[k])) throw new Error('qc sandbox: native lifecycle setup unavailable')
const cancelFD = Number(control.QC_FD_CANCEL)
for (const k of names) delete process.env[k]
let deadline = 0n
function remaining() {
  // Node NEVER decodes the shared mutable FD. Existing Python control clients
  // validate the entire sealed publication under supported synchronization.
  // Linux CLOCK_MONOTONIC/hrtime correspondence remains a platform assumption.
  return deadline ? Math.max(0, Number(deadline-process.hrtime.bigint())/1e6) : null
}
function acceptBudget(text) {
  const row = JSON.parse(text)
  if (!row || Object.keys(row).sort().join(',') !== 'end_ns,signal' ||
      typeof row.end_ns !== 'string' || !/^[0-9]{20}$/.test(row.end_ns) ||
      !Number.isInteger(row.signal) || ![0,1,2,15].includes(row.signal)) throw new Error('invalid control budget')
  const end = BigInt(row.end_ns)
  if ((!end && row.signal) || (deadline && end !== deadline) || (cancelSig && !end)) throw new Error('unknown/changed cancellation budget')
  if (end) deadline = end
}
function spawnControl(mode, args, options = {}) {
  const io = Array.isArray(options.stdio) ? options.stdio : Array(3).fill(options.stdio ?? 'pipe')
  return spawn(control.QC_NATIVE_PYTHON, [control.QC_NATIVE_COMMAND, mode, ...args], {
    ...options, env: { ...(options.env ?? process.env), ...control, QC_FD_CANCEL: '7' },
    stdio: [...io.slice(0,3), 'ignore', 'ignore', 'ignore', 'ignore', cancelFD]
  })
}
const lifecycle = {
  abi: 1,
  start(file, argv, options, role = 'bridge') {
    const lease = randomBytes(32).toString('hex')
    const child = spawnControl('native-relay', [lease, role, file, ...argv], options)
    if (role === 'payload') {
      child.on('error', error => { rememberError(error); void completePayload() })
      child.once('close', (code, sig) => { void completePayload({ code, signal: sig }) })
    }
    return { child, lease }
  },
  stop(lease) { return this.request('native-control', lease) },
  ready(lease) { return this.request('native-ready', lease) },
  signal(lease, sig) { return this.request('native-signal', lease, sig) },
  request(mode, lease, phase, result) {
    return new Promise((resolve, reject) => {
      const args = [lease, ...(phase ? [phase] : []), ...(mode === 'native-progress' ? [JSON.stringify(result ?? null)] : [])]
      const client = spawnControl(mode, args, { stdio: ['ignore','pipe','ignore'] })
      let budget = ''
      client.stdout.setEncoding('utf8')
      client.stdout.on('data', chunk => { budget += chunk; if (budget.length > 4096) { clearInterval(timer); reject(new Error('control budget overflow')) } })
      const end = process.hrtime.bigint()+10000000000n
      const timer = setInterval(() => {
        const left = remaining()
        if ((left !== null && left <= 0) || process.hrtime.bigint() >= end) {
          clearInterval(timer); reject(new Error('qc native control completion timeout'))
        }
      }, 10)
      client.once('error', err => { clearInterval(timer); reject(err) })
      client.once('close', code => {
        clearInterval(timer)
        if (code !== 0) { reject(new Error(`qc native capability failed (client exit ${code})`)); return }
        try { acceptBudget(budget); resolve() } catch (err) { reject(err) }
      })
    })
  }
}
let budgetPromise = null
function requireBudget() {
  // No local grace is minted. Until full FD validation by the existing client,
  // the retained Python owner's original canonical deadline is the hard bound.
  return budgetPromise ??= lifecycle.request('native-budget', '').then(() => {
    const left = remaining()
    if (left === null || left <= 0) throw new Error('unknown/expired canonical cancellation budget')
  })
}
async function withinBudget(action) {
  let timer
  try {
    if (cancelSig && remaining() === null) await requireBudget()
    return await Promise.race([action(), new Promise((_, reject) => {
      timer = setInterval(() => {
        const left = remaining()
        if (left !== null && left <= 0) reject(new Error('SDK cancellation deadline exceeded'))
        else if (cancelSig && left === null) requireBudget().catch(reject)
      }, 10)
    })])
  } finally { clearInterval(timer) }
}
const UNSET = {} // private fresh identity, never exported or thrown
let progressError = UNSET
const secondaryErrors = []
function rememberError(error) {
  if (progressError === UNSET) progressError = error
  else secondaryErrors.push(error)
}
let cancelSig = null, payload = null, initialized = null, signalPromise = null
let completionPromise = null
function deliver() {
  if (payload && initialized && cancelSig && !signalPromise) {
    signalPromise = initialized.then(() => {
      if (progressError === UNSET) return lifecycle.signal(payload.lease, cancelSig)
    }).catch(rememberError)
  }
}
for (const sig of ['SIGINT','SIGTERM']) process.on(sig, () => {
  if (!cancelSig) { cancelSig = sig; deliver() }
})
const loaded = loadConfig(settings)
if (loaded.kind !== 'ok') { console.error(`qc sandbox: srt settings ${settings}: ${loaded.reason ?? loaded.kind}`); process.exit(1) }
await withinBudget(() => SandboxManager.initialize(loaded.config, undefined, false, { nativeBridgeLifecycle: lifecycle }))
const store = SandboxManager.getSandboxViolationStore()
let seen = store.getTotalCount()
store.subscribe(vs => {
  const total = store.getTotalCount()
  const fresh = vs.slice(Math.max(0, vs.length - (total - seen)))
  seen = total
  for (const v of fresh) process.stderr.write(`QC-SRT-VIOLATION ${JSON.stringify({ line: v.line })}\n`)
})
function completePayload(closed = null) {
  return completionPromise ??= (async () => {
  try {
    await initialized
    if (signalPromise) await signalPromise
    if (progressError === UNSET && closed !== null) await lifecycle.request('native-progress', payload.lease, 'payload_exit', closed)
  } catch (err) { rememberError(err) }
  try { SandboxManager.cleanupAfterCommand() } catch (err) { rememberError(err) }
  try {
    await withinBudget(() => SandboxManager.reset()) // attempted even if command cleanup failed
    if (progressError === UNSET) await lifecycle.request('native-progress', payload.lease, 'reset_completed')
  } catch (err) { rememberError(err) }
  if (progressError !== UNSET) {
    const errors = [progressError, ...secondaryErrors]
    function report(index) {
      if (index === errors.length) return
      try { console.error(index ? 'qc lifecycle secondary:' : 'qc lifecycle primary:', errors[index]) }
      finally { report(index + 1) }
    }
    try { report(0) } finally { process.exit(70) }
  }
  process.exit(closed === null ? 70 : (cancelSig ? 128 + (cancelSig === 'SIGINT' ? 2 : 15) : (closed.signal ? 1 : (closed.code ?? 0))))
  })()
}
payload = lifecycle.start('/bin/sh', ['-c', await withinBudget(() => SandboxManager.wrapWithSandbox(quote(args)))], { stdio: 'inherit' }, 'payload')
initialized = lifecycle.ready(payload.lease).then(() => {
  if (progressError === UNSET) return lifecycle.request('native-progress', payload.lease, 'initialized')
}).catch(rememberError)
deliver()
"""
PAYLOAD_EXIT_PHASE = 3
PID_NAMESPACE_TYPE = 0x20000000
BOOTSTRAP_FD_COUNT = 6
NATIVE_SIGNAL_ARITY = 2
NATIVE_PROGRESS_ARITY = 3
NATIVE_RELAY_MIN_ARITY = 3
REPO_DEPTH = 3  # other repos: git repos up to this many levels below HOME (docs/adr/0022)
OUT: dict[str, int | None] = {"proof": None, "post": None, "err": None}


def say(m: str) -> None:
    line = f"qc sandbox: {m}\n"
    if OUT["proof"] is not None:
        os.write(OUT["proof"], line.encode())
    sys.stderr.write(line)
    sys.stderr.flush()


def post(rec: Mapping[str, object]) -> None:
    line = json.dumps(rec) + "\n"
    if OUT["post"] is not None:
        os.write(OUT["post"], line.encode())
    else:  # by hand: the records on stderr
        sys.stderr.write("qc sandbox: record " + line)
        sys.stderr.flush()


def die(m: str) -> NoReturn:
    say(f"FAIL {m}")
    say("proof failed; judge not started (exit 66)")
    sys.exit(66)


def mount(
    src: str | None, tgt: str, fs: str | None = None, flags: int = 0, data: str | None = None
) -> None:
    def b(s: str | None) -> bytes | None:
        return s.encode() if s is not None else None

    if libc.mount(b(src), b(tgt), b(fs), flags, b(data)) != 0:
        e = ctypes.get_errno()
        raise OSError(e, os.strerror(e), tgt)


def ro(p: str) -> None:
    """Remount P's bind read-only, repeating the flags a user namespace cannot clear (locked)."""
    f = os.statvfs(p).f_flag
    keep = sum(
        m
        for st, m in (
            (os.ST_NOSUID, MS_NOSUID),
            (os.ST_NODEV, MS_NODEV),
            (os.ST_NOEXEC, MS_NOEXEC),
            (os.ST_NOATIME, 1024),
            (os.ST_NODIRATIME, 2048),
            (os.ST_RELATIME, 1 << 21),
        )
        if f & st
    )
    mount(None, p, None, MS_REMOUNT | MS_BIND | MS_RDONLY | keep)


def run(*a: str, **k: Any) -> subprocess.CompletedProcess[str]:  # noqa: ANN401  # subprocess.run's own keywords
    return subprocess.run(list(a), capture_output=True, text=True, **k)


def within(p: str, d: str) -> bool:
    return p == d or p.startswith(d.rstrip("/") + "/")


def touchable(p: str) -> bool:
    """A write at P succeeds (the probe removed)."""
    try:
        os.close(os.open(p, os.O_WRONLY | os.O_CREAT, 0o600))
        os.unlink(p)
    except OSError:
        return False
    return True


# The recorder (R).
AT = {
    ("agent", "prompt"),
    ("agent", "send-keys"),
    ("pane", "send-text"),
    ("pane", "send-keys"),
    ("pane", "run"),
}


class NativeTask(TypedDict):
    fd: int
    waiters: list[socket.socket]
    done: bool
    exec_crossed: bool
    role: object
    kill_at: NotRequired[float]
    deadline: NotRequired[float]
    killed: NotRequired[bool]
    expired: NotRequired[bool]


class NativeProgress(TypedDict):
    initialized: bool | None
    ready: int
    signal_acked: bool | None
    payload_exit: bool | None
    reset_completed: bool | None
    signal: str | None
    payload_code: object
    payload_signal: object
    native_forced: bool


class NativeRecord(TypedDict):
    native_lifecycle: dict[str, object]
    native_cleanup_errors: list[str]
    attempts: Sequence[Mapping[str, object]]
    recorded: int
    gh_misses: int
    gh_miss_log: Sequence[Mapping[str, object]]


class Recorder:
    """The attempt record (R): one thread, outside the judge's namespaces; it alone writes $SCR/rec/attempts.jsonl."""

    def __init__(
        self, rd: str, watch: list[tuple[str, str, list[str]]], session: str, fds: list[int]
    ) -> None:
        self.S, self.watch, self.fds = session, watch, fds  # fds: handed once, to the inner's hello
        self.out = os.fdopen(
            os.open(rd + "/attempts.jsonl", os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o444), "a"
        )
        self.srv = socket.socket(socket.AF_UNIX, socket.SOCK_SEQPACKET)
        self.srv.bind(rd + "/sock")
        os.chmod(rd + "/sock", 0o200)
        self.srv.listen(128)
        self.srv.setblocking(False)  # noqa: FBT003  # socket's own positional flag
        self.ino = libc.inotify_init1(0o4000 | 0o2000000)  # IN_NONBLOCK | IN_CLOEXEC
        self.wds: dict[int, tuple[str, str, int, set[str]]] = {}
        self.live = False
        self.go: socket.socket | None = None
        self.recs: list[dict[str, Any]] = []
        self.misses: list[dict[str, Any]] = []
        self.conns: dict[socket.socket, dict[str, Any]] = {}
        self.net: set[str] = set()
        self.hello = False
        # Lifecycle auth is an explicit extension; ordinary attempts stay unchanged.
        self.native_secret = secrets.token_hex(32)
        self.native: dict[str, NativeTask] = {}
        self.native_closing = False
        self.native_done = threading.Event()
        self.native_errors: list[str] = []
        self.native_progress: NativeProgress = {
            "initialized": None,
            "ready": 0,
            "signal_acked": None,
            "payload_exit": None,
            "reset_completed": None,
            "signal": None,
            "payload_code": None,
            "payload_signal": None,
            "native_forced": False,
        }
        self.native_payload: str | None = None
        self.native_phase = 0
        self.wr, self.ww = os.pipe()
        self.stop = False
        self.sel = selectors.DefaultSelector()
        for f in (self.srv, self.wr) + ((self.ino,) if self.ino >= 0 else ()):
            self.sel.register(f, selectors.EVENT_READ)
        self.quiescent = threading.Event()

        def run() -> None:
            try:
                self.loop()
            finally:
                # Sole worker publication, after its last Recorder state/FD use.
                self.quiescent.set()

        self.th = threading.Thread(target=run, daemon=True)

    def watches(self, masks: list[int]) -> int:
        """Watch retained inner directory capabilities, never a peer PID lookup."""
        n = 0
        for (kind, path, kept), fd in zip(self.watch, masks, strict=True):
            if not stat.S_ISDIR(os.fstat(fd).st_mode):
                failure_message = "mask capability is not a directory"
                raise OSError(failure_message)
            p = f"/proc/self/fd/{fd}"
            w = (
                libc.inotify_add_watch(self.ino, p.encode(), 0x20) if self.ino >= 0 else -1
            )  # IN_OPEN
            # its entries counted through an fd held from here: listing by path would be an open itself
            if w >= 0:
                try:
                    self.wds.setdefault(
                        w, (kind, path, os.open(p, os.O_RDONLY | os.O_DIRECTORY), set(kept))
                    )
                    n += 1
                except OSError:
                    pass
        return n

    def emit(self, r: dict[str, Any], ok: bool | None = None) -> None:  # noqa: FBT001  # a call's own liveness
        if self.live if ok is None else ok:
            self.recs.append(r)
            self.out.write(json.dumps(r) + "\n")
            self.out.flush()

    def call_end(self, st: dict[str, Any]) -> None:
        """One shim call, recorded at its close (schema.md, Attempt record; Run record)."""
        raw, rc = st.get("argv"), st.get("exit")
        if not isinstance(raw, list):
            return None
        a = [str(x) for x in cast("list[object]", raw)]
        known = isinstance(rc, int)
        S = self.S
        if st.get("t") == "run":
            p = str(st.get("program"))
            return self.emit(
                {
                    "kind": "run",
                    "attempt": False,
                    "refused": False,
                    "program": p,
                    "argv": a,
                    "exit": rc if known else None,
                    "what": " ".join([p, *a]),
                    "result": f"exit {rc}" if known else "the shim never reported an exit",
                },
                st["live"],
            )
        self.emit(
            {
                "kind": "herdr",
                "attempt": tuple(a[:2]) in AT,
                "refused": known and rc != 0,
                "argv": a,
                "session": S,
                "exit": rc if known else None,
                "what": " ".join(["herdr", *a]),
                "result": f"session {S}, exit {rc}"
                if known
                else f"session {S}, the shim never reported an exit: counted as delivered",
            },
            st["live"],
        )
        return None

    def native_deadlines(self, state: NativeTask) -> tuple[float, float] | None:
        if "deadline" not in state and "kill_at" not in state:
            return None
        if "deadline" not in state or "kill_at" not in state:
            self.native_errors.append("native stopping deadline pair incomplete")
            failure_message = "native stopping deadline pair incomplete"
            raise OSError(failure_message)
        return state["kill_at"], state["deadline"]

    def native_arm(self, state: NativeTask) -> None:
        if self.native_deadlines(state) is None:
            now = time.monotonic()
            state.update(kill_at=now + cancel_budget(1.5, 2), deadline=now + cancel_budget(5, 1))
            with contextlib.suppress(ProcessLookupError):
                signal.pidfd_send_signal(state["fd"], signal.SIGTERM)

    def native_message(self, c: socket.socket, m: dict[str, object], received: list[int]) -> None:
        _, uid, _ = struct.unpack("3i", c.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12))
        lease, op, secret = m.get("lease"), m.get("op"), m.get("secret")
        signal_name = m.get("signal")
        if (
            uid != os.getuid()
            or not isinstance(secret, str)
            or re.fullmatch("[0-9a-f]{64}", secret) is None
            or not secrets.compare_digest(secret, self.native_secret)
            or not isinstance(lease, str)
            or re.fullmatch("[0-9a-f]{64}", lease) is None
            or set(m)
            != (
                {"t", "lease", "op", "secret"}
                | (
                    {"signal"}
                    if op == "signal"
                    else {"phase", "result"}
                    if op == "progress"
                    else {"role"}
                    if op == "register"
                    else set()
                )
            )
        ):
            failure_message = "native lifecycle authentication refused"
            raise OSError(failure_message)
        if (
            op == "register"
            and len(received) == 1
            and lease not in self.native
            and not self.native_closing
        ):
            role = m.get("role")
            if role not in ("bridge", "payload") or (
                role == "payload" and self.native_payload is not None
            ):
                failure_message = "duplicate or invalid native role"
                raise OSError(failure_message)
            if role == "payload":
                self.native_payload = lease
            signal.pidfd_send_signal(
                received[0], 0
            )  # kernel validates actual live pidfd, no numeric lookup
            fd = os.dup(
                received[0]
            )  # Python duplicates non-inheritable, retained across sender exit/reap
            self.native[lease] = {
                "fd": fd,
                "waiters": [],
                "done": False,
                "exec_crossed": False,
                "role": role,
            }
            self.conns[c]["native_lease"] = lease
            self.sel.register(fd, selectors.EVENT_READ)
            c.send(b"registered")
        elif op == "progress" and not received:
            if lease not in self.native:
                c.send(b"pending")
                return
            phase = m.get("phase")
            if lease != self.native_payload or phase not in (
                "initialized",
                "payload_exit",
                "reset_completed",
            ):
                self.native_errors.append("mixed native progress role/lease")
                failure_message = "progress is not from the designated payload"
                raise OSError(failure_message)
            self.native_tick()
            state = self.native[lease]
            if phase == "initialized":
                valid = (
                    self.native_phase == 0
                    and state["exec_crossed"]
                    and not state["done"]
                    and m["result"] is None
                )
                next_phase = 1
            elif phase == "payload_exit":
                result = m["result"]
                valid = (
                    self.native_phase in (1, 2)
                    and state["done"]
                    and is_json_object(result)
                    and set(result) == {"code", "signal"}
                )
                if valid and is_json_object(result):
                    self.native_progress["payload_code"] = result["code"]
                    self.native_progress["payload_signal"] = result["signal"]
                    sig = self.native_progress["signal"]
                    if sig:
                        n = getattr(signal, sig)
                        valid = (result["signal"] == sig and result["code"] is None) or (
                            result["signal"] is None
                            and type(result["code"]) is int
                            and result["code"] in (0, 128 + n)
                        )
                next_phase = 3
            else:
                valid = (
                    self.native_phase == PAYLOAD_EXIT_PHASE
                    and m["result"] is None
                    and not self.native_errors
                    and all(s["done"] and not s.get("killed") for s in self.native.values())
                )
                next_phase = 4
            if not valid or not cancel_budget(1):
                self.native_errors.append("invalid/replayed/out-of-order native progress")
                failure_message = "native phase transition refused"
                raise OSError(failure_message)
            self.native_phase = next_phase
            if phase == "initialized":
                self.native_progress["initialized"] = True
            elif phase == "payload_exit":
                self.native_progress["payload_exit"] = True
            else:
                self.native_progress["reset_completed"] = True
            c.send(b"recorded")
        elif op == "ready" and not received and lease not in self.native:
            # Authentication and exact operation keys were checked above. A relay
            # may not yet be enrolled; only the existing bounded client may retry.
            c.send(b"error" if self.native_closing or self.native_errors else b"pending")
        elif op == "ready" and not received and lease in self.native:
            state = self.native[lease]
            if (
                self.native_closing
                or self.native_errors
                or self.native_deadlines(state) is not None
                or state["done"]
            ):
                c.send(b"error")
                return
            poll = selectors.DefaultSelector()
            try:
                poll.register(state["fd"], selectors.EVENT_READ)
                dead = bool(poll.select(0))
            finally:
                poll.close()
            if (
                not dead
                and not self.native_errors
                and state["exec_crossed"]
                and lease == self.native_payload
            ):
                self.native_progress["ready"] = 1
            c.send(
                b"error"
                if dead or self.native_errors
                else (b"live" if state["exec_crossed"] else b"pending")
            )
        elif op == "stop" and not received and lease in self.native:
            state = self.native[lease]
            state["waiters"].append(c)
            self.native_arm(state)
        elif (
            op == "signal"
            and not received
            and lease in self.native
            and isinstance(signal_name, str)
            and signal_name in ("SIGINT", "SIGTERM")
        ):
            if lease != self.native_payload or self.native_phase != 1:
                self.native_errors.append("replayed/mixed native signal")
                failure_message = "signal is not for the initialized payload"
                raise OSError(failure_message)
            _end, sig = cancel_stamp()
            if sig != getattr(signal, signal_name) or not cancel_budget(1):
                failure_message = "signal/deadline mismatch"
                raise OSError(failure_message)
            # Signal forwarding preserves intent; this ACK is NOT a death witness.
            try:
                signal.pidfd_send_signal(self.native[lease]["fd"], getattr(signal, signal_name))
            except ProcessLookupError:
                c.send(b"not-signallable")  # not a death/completion claim
            else:
                self.native_progress["signal_acked"] = True
                self.native_progress["signal"] = signal_name
                self.native_phase = 2
                c.send(b"signalled")
        elif op == "exec-error" and not received and lease in self.native:
            self.native_errors.append("native relay exec failed")
            self.native_arm(self.native[lease])
        else:
            failure_message = "native lifecycle operation refused"
            raise OSError(failure_message)

    def native_tick(self) -> None:
        now = time.monotonic()
        for state in self.native.values():
            stopping = self.native_deadlines(state)
            if not state["done"]:
                poll = selectors.DefaultSelector()
                try:
                    poll.register(state["fd"], selectors.EVENT_READ)
                    dead = bool(poll.select(0))
                finally:
                    poll.close()
                if dead:
                    state["done"] = True
                    self.sel.unregister(state["fd"])
                elif stopping is not None:
                    kill_at, deadline = stopping
                    if now >= kill_at and not state.get("killed"):
                        with contextlib.suppress(ProcessLookupError):
                            signal.pidfd_send_signal(state["fd"], signal.SIGKILL)
                        state["killed"] = True
                        self.native_errors.append("native bridge forced SIGKILL")
                        self.native_progress["native_forced"] = True
                    if now >= deadline and not state.get("expired"):
                        state["expired"] = True
                        self.native_errors.append("native retained-task cleanup incomplete")
            if state["done"] or state.get("expired"):
                reply = (
                    b"exited"
                    if state["done"] and not self.native_errors
                    else b"error native cleanup incomplete"
                )
                for peer in state["waiters"]:
                    with contextlib.suppress(OSError):
                        peer.send(reply)
                state["waiters"].clear()
        if self.native_closing and all(s["done"] or s.get("expired") for s in self.native.values()):
            self.native_done.set()

    def finalize_native(self) -> bool:
        os.write(self.ww, b"n")
        return self.native_done.wait(cancel_budget(10, 0.5)) and not self.native_errors

    def message(self, c: socket.socket, raw: bytes, received: list[int]) -> None:
        st = self.conns[c]
        try:
            got: object = json.loads(raw)
        except (ValueError, RecursionError) as error:
            if "native_lease" in st:
                failure_message = "invalid registered native relay frame"
                raise OSError(failure_message) from error
            return
        if not isinstance(got, dict):
            if "native_lease" in st:
                failure_message = "invalid registered native relay object"
                raise OSError(failure_message)
            return
        m = cast("dict[str, Any]", got)
        if "native_lease" in st and (m.get("t") != "native" or m.get("op") != "exec-error"):
            failure_message = "unexpected registered native relay frame"
            raise OSError(failure_message)
        t = m.get("t")
        if t == "native":
            self.native_message(c, m, received)
            return
        if t == "mask" and not self.hello and len(received) == 1:
            masks = st.setdefault("masks", [])
            if len(masks) < len(self.watch):
                masks.append(os.dup(received[0]))
        elif t == "hello" and not self.hello:
            masks = st.get("masks", [])
            if len(received) != 1 or len(masks) != len(self.watch):
                failure_message = "missing inner namespace or mask capabilities"
                raise OSError(failure_message)
            own, peer = os.stat("/proc/self/ns/pid"), os.fstat(received[0])
            if (own.st_dev, own.st_ino) == (peer.st_dev, peer.st_ino):
                failure_message = "inner did not enter a separate PID namespace"
                raise OSError(failure_message)
            if (
                fcntl.ioctl(received[0], 0xB703) != PID_NAMESPACE_TYPE
            ):  # NS_GET_NSTYPE, CLONE_NEWPID
                failure_message = "inner capability is not a PID namespace"
                raise OSError(failure_message)
            self.hello = True
            n = self.watches(masks) if self.ino >= 0 else None
            socket.send_fds(
                c, [(f"ready {n}" if n is not None else "ready no-inotify").encode()], self.fds
            )
        elif t == "go" and not self.live and self.go is None:
            self.go = c
        elif t in ("herdr", "run") and "argv" not in st:
            st.update(t=t, program=m.get("program"), argv=m.get("argv"), live=self.live)
        elif t == "exit" and "argv" in st and "exit" not in st:
            st["exit"] = m.get("exit")
        elif t == "miss" and self.live:  # an offline gh refusal
            av = m.get("argv")
            argv = [str(x) for x in cast("list[object]", av)] if isinstance(av, list) else []
            r: dict[str, Any] = {"argv": argv, "why": str(m.get("why", ""))}
            self.misses.append(r)
            self.emit(
                {
                    "kind": "credential",
                    "attempt": True,
                    "refused": True,
                    "what": " ".join(["gh", *argv]),
                    "result": f"offline gh refused: {r['why']}",
                }
            )
        elif t == "net" and self.live:
            # an srt violation (srt_log): a refused host recorded once per host, any other violation whole
            host = f"{m.get('host', '')}:{m.get('port', '')}" if "host" in m else ""
            if host and host not in self.net:
                self.net.add(host)
                self.emit(
                    {
                        "kind": "network",
                        "attempt": True,
                        "refused": True,
                        "what": f"connect {host}",
                        "result": f"srt refused: {m.get('why', '')}",
                    }
                )
            elif not host:
                self.emit(
                    {
                        "kind": "network",
                        "attempt": True,
                        "refused": True,
                        "what": str(m.get("line", "")),
                        "result": "srt violation (no host in srt's line)",
                    }
                )
        elif t == "cred":
            op, p, h = (str(m.get(k, "")) for k in ("op", "protocol", "host"))
            self.emit(
                {
                    "kind": "credential",
                    "attempt": op == "get",
                    "refused": True,
                    "what": f"git credential {op} {p}://{h}",
                    "result": "the sandbox helper (git's only one) answered no credential",
                }
            )

    def disconnect(self, c: socket.socket, *, provenance: Literal["eof", "uncertain"]) -> None:
        # Only normal descriptor-free EOF on the authenticated relay is the
        # existing trusted CLOEXEC witness. Transport uncertainty is negative.
        if provenance == "uncertain":
            self.native_errors.append("uncertain Recorder transport completion")
        self.opens()
        self.sel.unregister(c)
        st = self.conns.pop(c)
        if (
            provenance == "eof"
            and not self.native_errors
            and (lease := st.get("native_lease")) is not None
        ):
            self.native[lease]["exec_crossed"] = True
        self.call_end(st)
        for fd in st.get("masks", []):
            os.close(fd)
        c.close()

    def conn(self, c: socket.socket) -> None:
        while True:
            try:
                m, received, flags, _ = socket.recv_fds(c, 1 << 18, 1, socket.MSG_CMSG_CLOEXEC)
            except BlockingIOError:
                return
            except OSError:
                self.disconnect(c, provenance="uncertain")
                return
            # Only actual successful recv descriptors enter this finally, including
            # truncation and empty frames. Never fabricate an empty received set.
            try:
                if flags & (socket.MSG_TRUNC | socket.MSG_CTRUNC) or (not m and received):
                    self.disconnect(c, provenance="uncertain")
                    return
                if not m:
                    self.disconnect(c, provenance="eof")
                    return
                try:
                    self.message(c, m, received)
                except OSError:
                    # Protocol refusal cannot later become a trusted exec EOF.
                    self.disconnect(c, provenance="uncertain")
                    return
            finally:
                for fd in received:
                    os.close(fd)

    def accept(self) -> None:
        while True:
            try:
                c, _ = self.srv.accept()
            except BlockingIOError:
                return
            c.setblocking(False)  # noqa: FBT003  # socket's own positional flag
            self.conns[c] = {}
            self.sel.register(c, selectors.EVENT_READ)

    def opens(self) -> None:  # inotify on the tmpfs masks (schema.md, Attempt record)
        while self.ino >= 0:
            try:
                b = os.read(self.ino, 65536)
            except OSError:
                return
            i = 0
            while i + 16 <= len(b):
                w, mk, _, n = struct.unpack_from("iIII", b, i)
                name = b[i + 16 : i + 16 + n].rstrip(b"\0").decode(errors="replace")
                i += 16 + n
                if w not in self.wds or not mk & 0x20:
                    continue
                kind, path, dfd, kept = self.wds[w]
                if name in kept:  # an entry bound back on the mask (the run's own): not an attempt
                    continue
                try:
                    seen = set(os.listdir(dfd))
                    k = len(seen)
                except OSError:
                    seen, k = None, -1
                self.emit(
                    {
                        "kind": kind,
                        "attempt": True,
                        "refused": seen is not None and seen <= kept,
                        "what": f"open {path}/{name}" if name else f"open {path}",
                        "result": f"tmpfs mask over {path}, {k} entries"
                        + (f" (bound back: {', '.join(sorted(kept))})" if kept else ""),
                    }
                )

    def drain(self) -> None:
        self.accept()
        for c in list(self.conns):
            self.conn(c)
        self.opens()

    def loop(self) -> None:
        while not self.stop:
            stopping = self.native_closing or any(
                "deadline" in s and not s["done"] for s in self.native.values()
            )
            for k, _ in self.sel.select(0.05 if stopping else None):
                f = k.fileobj
                if f is self.srv:
                    self.accept()
                elif f == self.wr:
                    if os.read(self.wr, 1) == b"n":
                        self.native_closing = True
                        for state in self.native.values():
                            self.native_arm(state)
                    else:
                        self.stop = True
                elif f == self.ino:
                    self.opens()
                elif isinstance(f, socket.socket) and f in self.conns:
                    self.conn(f)
            self.native_tick()
            # the inner waits for this answer before the judge starts
            if self.go is not None and not self.live:
                self.drain()
                self.live = True
                with contextlib.suppress(OSError):
                    self.go.send(b"live")

    def require_quiescent(self) -> None:
        if not self.quiescent.is_set():
            failure_message = (
                "Recorder quiescence unproved; retaining worker descriptors "
                "for process exit/outer QC ownership"
            )
            raise RuntimeError(failure_message)

    def finish(self) -> NativeRecord:
        """The record whole: the judge's namespace is gone, every call still open ended without its exit."""
        errors: list[tuple[str, BaseException]] = []
        quiescent = False
        try:
            os.write(self.ww, b"x")
            self.th.join(cancel_budget(10, 0.25))
            # An interrupted join/is_alive observation is not ownership transfer.
            self.require_quiescent()
            quiescent = True
            self.drain()
            for st in self.conns.values():
                self.call_end(st)
        # completion/drain failure is primary; retain resources if quiescence is absent.
        except BaseException as error:  # noqa: BLE001
            if not quiescent:
                error.add_note(
                    "Recorder resources retained untouched: quiescence not established; "
                    "process exit/outer QC cleanup required"
                )
            errors.append(("Recorder record completion", error))
        finally:
            # Without positive quiescence leave the worker's state/FDs untouched.
            # Fatal process exit, not unsafe close, is the ownership fallback.
            if quiescent:
                for c, st in list(self.conns.items()):
                    for fd in st.get("masks", []):
                        try:
                            os.close(fd)
                        # mask-FD close failure must not skip connection/native closes.
                        except BaseException as error:  # noqa: BLE001
                            errors.append(("Recorder mask descriptor close", error))
                    try:
                        c.close()
                    # connection-close failure must not skip other connection/native closes.
                    except BaseException as error:  # noqa: BLE001
                        errors.append(("Recorder connection close", error))
                    self.conns.pop(c, None)
                for state in list(self.native.values()):
                    try:
                        os.close(state["fd"])
                    # one retained native-FD close failure must not skip remaining closes.
                    except BaseException as error:  # noqa: BLE001
                        errors.append(("Recorder native descriptor close", error))
        if errors:
            stage, primary = errors[0]
            primary.add_note(f"qc sandbox cleanup phase: {stage}")
            for stage, error in errors[1:]:
                primary.add_note(
                    f"secondary cleanup failure ({stage}): {type(error).__name__}: {error}"
                )
            raise primary
        return {
            "native_lifecycle": dict(self.native_progress),
            "native_cleanup_errors": self.native_errors,
            "attempts": self.recs,
            "recorded": len(self.recs),
            "gh_misses": len(self.misses),
            "gh_miss_log": self.misses,
        }


# The shims (6).
def recshim(  # noqa: PLR0913, PLR0917  # the shim's own fields
    py: str,
    kind: str,
    name: str,
    real: str,
    shape: tuple[list[str], list[str], list[str]],
    sock: str,
) -> str:
    """The one recording shim, herdr's and each run program's (schema.md, Attempt record, Run record)."""
    return (
        f"""#!{py}
# qc sandbox {kind} shim for {name}: record the call (argv before, exit after), run the real program unchanged.
import json, os, shutil, socket, subprocess, sys
KIND, NAME, REAL, SOCK = {json.dumps(kind)}, {json.dumps(name)}, {json.dumps(real)}, {json.dumps(sock)}
PRE, DROP, ENVDROP = {json.dumps(shape[0])}, {json.dumps(shape[1])}, {json.dumps(shape[2])}
"""
        r"""a, args, i = sys.argv[1:], [], 0
while i < len(a):
    if a[i] in DROP: i += 2; continue
    if a[i].split("=", 1)[0] in DROP and "=" in a[i]: i += 1; continue
    args.append(a[i]); i += 1
if not REAL:   # the real program: the next NAME on PATH past this shim's own dir
    own = os.path.dirname(os.path.realpath(__file__))
    REAL = shutil.which(NAME, path=os.pathsep.join(d for d in os.environ.get("PATH", "").split(os.pathsep)
                                                 if d and os.path.realpath(d) != own))
    if not REAL:
        sys.exit(print(f"{NAME}: command not found", file=sys.stderr) or 127)
c = socket.socket(socket.AF_UNIX, socket.SOCK_SEQPACKET)
try:
    c.connect(SOCK); c.send(json.dumps({"t": KIND, "program": NAME, "argv": [x[:4000] for x in args][:200]}).encode())
except OSError as e:
    sys.exit(print(f"qc sandbox {NAME} shim: attempt record unreachable ({e}); call not made", file=sys.stderr) or 70)
env = {k: v for k, v in os.environ.items() if k not in ENVDROP}
rc = subprocess.run([REAL, *PRE, *args], env=env, close_fds=False).returncode
rc = 128 - rc if rc < 0 else rc
try:   # then wait for the recorder's close: it has written this call's entry (a recorder gone ends the wait too)
    c.send(json.dumps({"t": "exit", "exit": rc}).encode()); c.shutdown(socket.SHUT_WR)
    while c.recv(16): pass
except OSError:
    pass
sys.exit(rc)
"""
    )


def credhelper(py: str, sock: str) -> str:
    return (
        f"""#!{py}
# qc sandbox git credential helper: send the request to the recorder (protocol, host; never a secret), wait until it is written, answer no credential.
import json, socket, sys
SOCK = {json.dumps(sock)}
"""
        r"""f = {}
for l in sys.stdin:
    if not l.strip(): break
    k, _, v = l.rstrip("\n").partition("="); f[k] = v
try:
    c = socket.socket(socket.AF_UNIX, socket.SOCK_SEQPACKET); c.connect(SOCK)
    c.send(json.dumps({"t": "cred", "op": (sys.argv[1:] or [""])[0], "protocol": f.get("protocol", ""), "host": f.get("host", "")}).encode())
    c.shutdown(socket.SHUT_WR)
    while c.recv(16): pass   # the recorder closes once the entry is written
except OSError:
    pass
"""
    )


def pishim(realpi: str, scr: str) -> str:
    q = shlex.quote
    lines = [
        "#!/usr/bin/env bash",
        "# qc sandbox pi shim: run only a real pi; log each start, one line (agents count), then run it.",
    ]
    if not realpi:
        lines.append(
            'echo "qc sandbox: pi not on PATH (the pi shim runs only a real pi)" >&2; exit 127'
        )
    lines += [
        f'[[ "${{QC_PI_SHIM:-}}" != "$$ "{q(scr)} ]] || {{ echo "qc sandbox: pi leads back to the qc sandbox pi shim ({realpi} ran it again); refused" >&2; exit 127; }}',
        f'export QC_PI_SHIM="$$ "{q(scr)}',
        f'echo "$$" >> {q(scr + "/agents.log")}',
        f'exec {q(realpi)} "$@"',
    ]
    return "\n".join(lines) + "\n"


# ---------------------------------------------------------------- setup
def hosts_for_pi(pi_dir: str) -> list[str]:
    """The network allowlist of a Pi run (S): each models.json baseUrl host, each auth.json provider's built-in host,
    each web MCP server of the kit's web-mcp.json (docs/specs/roles.spec.html#launch-web)."""
    hs: set[str] = set()

    def urls(x: object) -> None:
        if isinstance(x, dict):
            for k, v in cast("dict[str, object]", x).items():
                if k in ("baseUrl", "url") and isinstance(v, str) and "://" in v:
                    h = v.split("://", 1)[1].split("/", 1)[0].split("@")[-1]
                    if h:
                        hs.add(h)
                else:
                    urls(v)
        elif isinstance(x, list):
            for v in cast("list[object]", x):
                urls(v)

    for f in (f"{pi_dir}/models.json", f"{SK}/web-mcp.json"):
        with contextlib.suppress(OSError, ValueError):
            urls(json.load(open(f)))
    try:
        auth: object = json.load(open(f"{pi_dir}/auth.json"))
        names = list(cast("dict[str, object]", auth)) if isinstance(auth, dict) else []
        hs.update(PI_HOSTS[p] for p in names if p in PI_HOSTS)
    except (OSError, ValueError):
        pass
    return sorted(hs)


def srt_js() -> tuple[str, str, str]:
    """srt as the kit pins it (package.json, exact, locked in pnpm-lock.yaml): its cli in the kit's node_modules, its
    version, and the node_modules dir it loads from (read on the host, before any namespace: a kit's node_modules may
    live under /tmp, which the discard stage makes private, so that dir is kept). Missing, or at another version
    than the pin: exit 66 naming the install command."""
    try:
        dev: dict[str, Any] = json.load(open(f"{SK}/package.json")).get("devDependencies", {})
    except (OSError, ValueError):
        dev = {}
    pin = dev.get(SRT_PKG)
    got = ""
    with contextlib.suppress(OSError, ValueError):
        got = json.load(open(f"{SK}/node_modules/{SRT_PKG}/package.json")).get("version", "")
    js = os.path.realpath(
        f"{SK}/node_modules/{SRT_PKG}/dist/cli.js"
    )  # the package's own entry, there iff installed
    if not pin or got != pin or not os.path.isfile(js):
        die(
            f"srt ({SRT_PKG} {pin or 'unpinned'}, the kit's package.json and pnpm-lock.yaml) not installed in "
            f"{SK}/node_modules (found: {got or 'none'}): run pnpm install --frozen-lockfile --dir {SK}"
        )
    return os.path.dirname(os.path.dirname(js)), got, os.path.realpath(f"{SK}/node_modules")


def srt_node(data: str) -> str:
    """The node srt runs on: the kit's mise.toml pin in mise's data dir DATA, else the first on PATH."""
    try:
        nv = tomllib.load(open(f"{SK}/mise.toml", "rb")).get("tools", {}).get("node")
    except (OSError, ValueError):
        nv = None
    node = f"{data}/installs/node/{nv}/bin/node" if nv and data else ""
    node = node if os.path.exists(node) else (shutil.which("node") or "")
    if not node:
        die(
            f"node (the kit's mise.toml pin {nv}) not installed: run {SK}/scripts/octo-feather-mise-install {SK}"
        )
    return node


def srt_log(p: subprocess.Popen[bytes], sock: str, early: list[str], rec: Recorder) -> None:
    """srt's stderr: each violation line (SRT_SHIM) sent to the recorder as {"t": "net"}, a network refusal's host,
    port and srt's reason read from it, any other violation sent whole (recorded, never dropped); srt's other lines
    kept for the caller until the inner has started (shown when srt never started it), passed through after."""
    deny = re.compile(r"deny network-outbound (\S+):(\d+) \((.*)\)$")
    assert p.stderr is not None
    for ln in p.stderr:
        if not ln.startswith(b"QC-SRT-VIOLATION "):
            if rec.hello:
                sys.stderr.write(ln.decode(errors="replace"))
            else:
                early.append(ln.decode(errors="replace"))
            continue
        try:
            line = str(json.loads(ln[len(b"QC-SRT-VIOLATION ") :]).get("line", ""))
        except ValueError:
            line = ln.decode(errors="replace").strip()
        m = deny.search(line)
        msg = (
            {"t": "net", "host": m.group(1), "port": m.group(2), "why": m.group(3)}
            if m
            else {"t": "net", "line": line}
        )
        c = socket.socket(socket.AF_UNIX, socket.SOCK_SEQPACKET)
        try:
            c.connect(sock)
            c.send(json.dumps(msg).encode())
            c.shutdown(socket.SHUT_WR)
            while c.recv(16):
                pass
        except OSError:
            pass
        finally:
            c.close()


# Operational capability carried by the existing trusted FD bootstrap only.
# The anonymous bytes have no path/cache/store; POSIX process locks serialize first mint.
# One anonymous capability in the existing FD bootstrap. No unlocked snapshot readers.
# Python threads use a nonblocking local lock; processes use POSIX record locks.
# Linux memfd seals distinguish idle, in-progress/failed publication, immutable commit.
def is_json_object(value: object) -> TypeGuard[dict[str, object]]:
    """Narrow an object from json.loads; JSON object keys are strings."""
    return isinstance(value, dict)


class CancellationState:
    def __init__(self) -> None:
        self.fd: int | None = None
        self.signal = 0
        self.end = 0
        self.fault: BaseException | None = None
        self.lock = threading.Lock()
        self.armed = False


_cancellation = CancellationState()
CANCEL_SIZE = 4096
CANCEL_BASE_SEALS = fcntl.F_SEAL_GROW | fcntl.F_SEAL_SHRINK
CANCEL_CLAIM_SEAL = 0x10  # Linux UAPI F_SEAL_FUTURE_WRITE (kernel >=5.1; kit requires >=6.6)
CANCEL_FINAL_SEALS = CANCEL_BASE_SEALS | CANCEL_CLAIM_SEAL | fcntl.F_SEAL_WRITE | fcntl.F_SEAL_SEAL


class Cancelled(BaseException):
    def __init__(self, signum: int) -> None:
        self.signum = signum
        super().__init__(f"cancelled by signal {signum}")


def cancel_fault(error: BaseException) -> None:
    if _cancellation.fault is None:
        _cancellation.fault = error  # irreversible for this invocation; never retry it into grace
    elif _cancellation.fault is not error:
        _cancellation.fault.add_note(
            f"secondary capability failure: {type(error).__name__}: {error}"
        )


def cancel_image(state: str, end: int, signum: int) -> bytes:
    raw = json.dumps(
        {"v": 1, "state": state, "end_ns": f"{end:020d}", "signal": signum},
        sort_keys=True,
        separators=(",", ":"),
    ).encode()
    return raw + b"\0" * (CANCEL_SIZE - len(raw))


def initialize_capability(fd: int) -> None:
    image = cancel_image("idle", 0, 0)
    if os.write(fd, image) != len(image) or os.pread(fd, CANCEL_SIZE + 1, 0) != image:
        failure_message = "cancellation capability initialization incomplete"
        raise OSError(failure_message)
    fcntl.fcntl(fd, fcntl.F_ADD_SEALS, CANCEL_BASE_SEALS)
    if fcntl.fcntl(fd, fcntl.F_GET_SEALS) != CANCEL_BASE_SEALS:
        failure_message = "cancellation capability initialization seals invalid"
        raise OSError(failure_message)


def require_capability_lock(*, locked: bool) -> None:
    if not locked:
        failure_message = "cancellation capability thread contention"
        raise BlockingIOError(failure_message)


def validate_commit(fd: int, end: int, sig: int) -> None:
    if cancel_decode(fd) != (end, sig):
        failure_message = "cancellation capability commit readback failed"
        raise OSError(failure_message)


def cancel_create() -> int:
    fd = os.memfd_create("qc-cancellation", os.MFD_CLOEXEC | os.MFD_ALLOW_SEALING)
    try:
        initialize_capability(fd)
        # Return stays inside the owned FD close/poison enrollment, including fatal interruption.
        return fd  # noqa: TRY300
    except BaseException as error:
        try:
            os.close(fd)
        # failed initial capability close must not replace creation failure.
        except BaseException as close_error:  # noqa: BLE001
            error.add_note(f"initial capability close failed: {close_error}")
        raise


def cancel_decode(fd: int) -> tuple[int, int]:
    seals = fcntl.fcntl(fd, fcntl.F_GET_SEALS)
    raw = os.pread(fd, CANCEL_SIZE + 1, 0)
    if len(raw) != CANCEL_SIZE:
        failure_message = "cancellation capability size invalid"
        raise OSError(failure_message)
    row: object = json.loads(raw.rstrip(b"\0"))
    if (
        not is_json_object(row)
        or set(row) != {"v", "state", "end_ns", "signal"}
        or type(row["v"]) is not int
        or row["v"] != 1
        or not isinstance(row["end_ns"], str)
        or re.fullmatch("[0-9]{20}", row["end_ns"]) is None
        or type(row["signal"]) is not int
        or row["signal"] not in (0, 1, 2, 15)
    ):
        failure_message = "cancellation capability codec invalid"
        raise OSError(failure_message)
    end, sig = int(row["end_ns"]), row["signal"]
    state = "idle" if seals == CANCEL_BASE_SEALS and end == 0 and sig == 0 else "committed"
    if (
        state == "committed" and (seals != CANCEL_FINAL_SEALS or not end or sig not in (1, 2, 15))
    ) or raw != cancel_image(state, end, sig):
        failure_message = "cancellation capability publication incomplete/poisoned"
        raise OSError(failure_message)
    if fcntl.fcntl(fd, fcntl.F_GET_SEALS) != seals:
        failure_message = "cancellation publication changed during validation"
        raise OSError(failure_message)
    return end, sig


def poison_optional(fd: int | None) -> None:
    """Poison only the current optional capability, inside its owner's catch."""
    if fd is not None:
        fcntl.fcntl(fd, fcntl.F_ADD_SEALS, fcntl.F_SEAL_WRITE | fcntl.F_SEAL_SEAL)


def require_unpoisoned() -> None:
    if _cancellation.fault is not None:
        raise _cancellation.fault


def cancel_without_capability(signum: int, *, mint: bool) -> tuple[int, int]:
    if mint:
        error = OSError("cancellation capability unavailable")
        cancel_fault(error)
        raise error
    return _cancellation.end, signum


def cancel_stamp(signum: int = 0, *, mint: bool = False) -> tuple[int, int]:
    # These preflight checks remain before acquiring either lock, as before.
    require_unpoisoned()
    if _cancellation.fd is None:
        return cancel_without_capability(signum, mint=mint)
    locked = False
    primary = None
    mapping = None
    try:
        locked = _cancellation.lock.acquire(blocking=False)
        require_capability_lock(locked=locked)
        fcntl.lockf(_cancellation.fd, (fcntl.LOCK_EX if mint else fcntl.LOCK_SH) | fcntl.LOCK_NB)
        end, sig = cancel_decode(_cancellation.fd)
        if mint and not end:
            # Claim BEFORE publication. A failed/partial commit is never an idle retry:
            # future writes/maps are prohibited once the kernel accepts this seal.
            end, sig = time.monotonic_ns() + 12_000_000_000, signum
            _cancellation.end = end  # original attempt bound, retained even if publication fails
            mapping = mmap.mmap(_cancellation.fd, CANCEL_SIZE, access=mmap.ACCESS_WRITE)
            fcntl.fcntl(_cancellation.fd, fcntl.F_ADD_SEALS, CANCEL_CLAIM_SEAL)
            mapping[:] = cancel_image("committed", end, sig)
            mapping.close()
            mapping = None
            fcntl.fcntl(_cancellation.fd, fcntl.F_ADD_SEALS, CANCEL_FINAL_SEALS)
            validate_commit(_cancellation.fd, end, sig)
        _cancellation.end = end
        # Return stays inside the owned FD close/poison enrollment, including fatal interruption.
        return end, sig  # noqa: TRY300
    except BaseException as error:
        primary = error
        cancel_fault(error)
        # Best effort terminal poison. If even seals fail, local poison and forced
        # ownership remain authoritative; no failed actor can retry/forward grace.
        if mapping is not None:
            try:
                mapping.close()
            # mapping-close failure must not replace publication failure.
            except BaseException as close_error:  # noqa: BLE001
                error.add_note(f"capability mapping close: {close_error}")
        if mint:
            try:
                poison_optional(_cancellation.fd)
            # terminal-poison failure remains secondary, no renewal.
            except BaseException as poison_error:  # noqa: BLE001
                error.add_note(f"shared terminal poison unproved: {poison_error}")
        raise
    finally:
        if locked:
            try:
                fcntl.lockf(_cancellation.fd, fcntl.LOCK_UN)
            except BaseException as unlock_error:
                cancel_fault(unlock_error)
                if primary is None:
                    raise
                primary.add_note(f"capability unlock failed: {unlock_error}")
            finally:
                _cancellation.lock.release()


def cancel_budget(limit: float, reserve: float = 0) -> float:
    if _cancellation.fd is None:
        # Terminal caller closure consumes only the original bound, never re-mints.
        if _cancellation.end:
            return min(limit, max(0, (_cancellation.end - time.monotonic_ns()) / 1e9 - reserve))
        return 0 if _cancellation.signal or _cancellation.fault is not None else limit
    try:
        end, _ = cancel_stamp()
    # budget validation latches any fatal and keeps only original bound.
    except BaseException as error:  # noqa: BLE001
        cancel_fault(error)
        end = _cancellation.end  # only a previously validated bound; never a new relative remedy
    if end:
        return min(limit, max(0, (end - time.monotonic_ns()) / 1e9 - reserve))
    return 0 if _cancellation.signal or _cancellation.fault is not None else limit


def cancel_entry(n: int, _frame: object) -> None:
    if not _cancellation.signal:
        _cancellation.signal = n
        try:
            cancel_stamp(n, mint=True)
        except BaseException as error:
            cancel_fault(error)
            if _cancellation.armed:
                raise  # actual mint/lock/read/write failure remains primary
        else:
            if _cancellation.armed:
                raise Cancelled(n)


def raise_if_cancelled() -> None:
    if _cancellation.signal:
        raise (
            _cancellation.fault
            if _cancellation.fault is not None
            else Cancelled(_cancellation.signal)
        )


def require_owned_node(node: subprocess.Popen[bytes] | None) -> subprocess.Popen[bytes]:
    if node is None:
        failure_message = "owned Node process identity unavailable"
        raise RuntimeError(failure_message)
    return node


def validate_readiness(msg: bytes, fds: list[int], flags: int) -> None:
    if not msg.startswith(b"ready ") or len(fds) != BOOTSTRAP_FD_COUNT or flags & socket.MSG_CTRUNC:
        for fd in fds:
            os.close(fd)
        failure_message = "missing recorder readiness or descriptors"
        raise OSError(failure_message)


def setup(judge: list[str]) -> NoReturn:
    if _cancellation.fd is None:
        _cancellation.fd = int(E["QC_FD_CANCEL"]) if E.get("QC_FD_CANCEL") else cancel_create()
    raise_if_cancelled()
    hand = "QC_SESSION" not in E  # by hand: every input defaulted
    S = E.get("QC_SESSION") or f"qc-hand-{secrets.token_hex(3)}"
    for k, n in (("proof", "QC_FD_PROOF"), ("post", "QC_FD_POST"), ("err", "QC_FD_ERR")):
        OUT[k] = int(E[n]) if E.get(n) else None
    HOME = E["HOME"]
    cfg = E.get("XDG_CONFIG_HOME") or f"{HOME}/.config"
    HC, GC = f"{cfg}/herdr", E.get("GH_CONFIG_DIR") or f"{cfg}/gh"
    PI = E.get("PI_CODING_AGENT_DIR") or f"{HOME}/.pi/agent"
    CACHE = E.get("XDG_CACHE_HOME") or f"{HOME}/.cache"
    TOP = (E.get("XDG_STATE_HOME") or f"{HOME}/.local/state") + "/octo-feather"
    RS = E.get("QC_STATE") or run(f"{SK}/scripts/octo-feather-state").stdout.strip()
    WT = E.get("QC_WORKTREE") or (
        run("git", "rev-parse", "--show-toplevel").stdout.strip() or os.getcwd()
    )
    HERDR = (
        E.get("QC_HERDR")
        if "QC_HERDR" in E
        else (E.get("OCTO_FEATHER_QC_HERDR") or shutil.which("herdr") or "")
    )
    GH = E.get("QC_GH") if "QC_GH" in E else (shutil.which("gh") or "")
    uid, gid = int(E.get("QC_UID") or os.getuid()), int(E.get("QC_GID") or os.getgid())
    nohist = E.get("QC_HISTORY", "none" if hand else "") == "none"
    nopi = E.get("QC_PI", "none" if hand else "") == "none"
    ghoff = E.get("QC_GHSNAP_OFF") or ("" if E.get("QC_GHSNAP") else "github: none (run by hand)")
    ro_binds = [p for p in E.get("QC_RO_BINDS", "").split("\n") if p]
    SCR = f"/tmp/.qc-{S}"
    SB = f"{SCR}/state/octo-feather/sessions/{S}"
    OV = f"{SCR}/ov"
    if hand:  # what octo-feather-qc sandboxed() keeps: the paths under /tmp the run needs back
        want = [WT, SK, RS, TOP, HOME, *E.get("PATH", "").split(":")]
        keep = sorted({os.path.realpath(p) for p in want if p and os.path.exists(p)})
        E["QC_KEEP"] = "\n".join(p for p in keep if p.startswith("/tmp/"))

    # Host facts, read before any namespace or mask.
    sjs, srtv, snm = srt_js()
    if snm.startswith("/tmp/"):  # srt's node_modules, bound back on the private /tmp (step 1)
        E["QC_KEEP"] = "\n".join([*E.get("QC_KEEP", "").split("\n"), snm]).strip("\n")
    os.makedirs(HC, exist_ok=True)
    try:
        KUT = os.path.realpath(E.get("QC_KIT") or SK, strict=True)
        wtp = os.path.realpath(WT, strict=True)
    except OSError as e:
        die(f"kit under test or worktree: {e}")
    keep = [wtp, KUT]
    back = [wtp, KUT]
    for k in keep:
        if os.path.exists(k + "/.git"):
            r = run("git", "-C", k, "rev-parse", "--path-format=absolute", "--git-common-dir")
            if r.returncode == 0 and r.stdout.strip():
                back.append(os.path.realpath(r.stdout.strip()))
    back += [os.path.realpath(p) for p in ro_binds]
    j = shutil.which(judge[0]) if judge else None
    for m in (
        SELF,
        f"{SK}/scripts/octo-feather-state",
        f"{SK}/scripts/octo-feather-mise-install",
        f"{SK}/.agents/skills/github-pr/scripts",
        j,
    ):
        if m and os.path.exists(m):
            back.append(os.path.realpath(m))
    # srt's own node_modules (the sandbox's machinery, as the script itself): where it lies inside another repo (a kit
    # copy linking a checkout's), bound back on that mask, as srt reads its own files back through any deny.
    back.append(snm)

    def canon(s: str) -> list[str]:
        return [os.path.realpath(p) for p in s.split(":") if p]

    cpath, cpre = canon(E.get("PATH", "")), canon(E.get("QC_PATH_PREPEND", ""))
    HM = os.path.realpath(HOME)
    repos: list[
        str
    ] = []  # git repos up to 3 levels below HOME, dot-dirs aside, symlinks not followed

    def scan(d: str, depth: int) -> None:
        try:
            es = sorted(os.scandir(d), key=lambda e: e.name)
        except OSError:
            return
        for e in es:
            if e.name.startswith(".") or not e.is_dir(follow_symlinks=False):
                continue
            if os.path.lexists(e.path + "/.git"):
                if not any(within(e.path, k) for k in keep):
                    repos.append(e.path)
                continue
            if depth < REPO_DEPTH:
                scan(e.path, depth + 1)

    scan(HM, 1)
    repos.sort()
    rmask: list[
        tuple[str, list[str], list[str]]
    ] = []  # (repo, its bound-back paths, the names they show on the mask)
    for r in repos:
        bs = sorted({b for b in back if b.startswith(r + "/")})
        for b in bs:
            if not os.path.lexists(b):
                die(f"bind back {b} on the mask over {r}")
        rmask.append((r, bs, sorted({b[len(r) + 1 :].split("/")[0] for b in bs})))
    hid = [r for r, _, _ in rmask]

    def swap(ps: list[str]) -> list[str]:
        """A PATH dir inside a hidden repo, not inside a path bound back: the same path in the run's kit, or gone."""
        out: list[str] = []
        for p in ps:
            if any(within(p, b) for b in back):
                out.append(p)
                continue
            r = next((r for r in hid if within(p, r)), None)
            if r is None:
                out.append(p)
            elif os.path.isdir(KUT + p[len(r) :]):
                out.append(KUT + p[len(r) :])
        return out

    jpath, jpre = swap(cpath), swap(cpre)
    # uv's cache, asked of uv itself, uncoloured (#637: under FORCE_COLOR uv colours even a path). A path that is not
    # absolute, or names no dir, fails naming what uv printed; an absolute one not there yet (uv never ran under this
    # HOME) is named in the proof, nothing bound.
    ucr = run("uv", "--color", "never", "cache", "dir") if shutil.which("uv") else None
    got = ucr.stdout.rstrip("\n") if ucr and ucr.returncode == 0 else ""
    absent = bool(got) and not os.path.lexists(got)
    bad = not got.startswith("/") or any(ch < " " or ch == "\x7f" for ch in got)
    if got and (bad or not (os.path.isdir(got) or absent)):
        die(f"uv --color never cache dir printed {got!r}: not a directory")
    UC = got if got and not absent else ""
    ucn = got if absent else ""
    shimless = ":".join(p for p in E.get("PATH", "").split(":") if p and p != f"{SCR}/bin")
    realpi = shutil.which("pi", path=shimless) or ""
    if realpi and os.path.realpath(realpi).startswith(f"{SCR}/bin/"):
        realpi = ""
    pis = [n for n in ("auth.json", "models.json") if os.path.isfile(f"{PI}/{n}")]
    pient = sorted(os.listdir(PI)) if os.path.isdir(PI) else []
    wfd = os.open(WT, os.O_RDONLY | os.O_DIRECTORY)  # the real worktree, for the upper list (10)
    cwd = os.getcwd()

    # D. the discard stage: own user (the caller's uid), mount and IPC namespace.
    ou, og = os.geteuid(), os.getegid()

    def put(f: str, s: str) -> None:
        fd = os.open(f, os.O_WRONLY)
        try:
            os.write(fd, s.encode())
        finally:
            os.close(fd)

    try:
        os.unshare(os.CLONE_NEWUSER | os.CLONE_NEWNS | os.CLONE_NEWIPC)
        put("/proc/self/uid_map", f"{uid} {ou} 1")
        put("/proc/self/setgroups", "deny")
        put("/proc/self/gid_map", f"{gid} {og} 1")
        mount(None, "/", None, MS_REC | MS_PRIVATE)
    except OSError as e:
        die(f"discard stage: user and mount namespace ({e})")
    # 1. private /tmp, kept paths bound back from the old one (through an fd held on it).
    tfd = os.open("/tmp", os.O_RDONLY | os.O_DIRECTORY)
    try:
        mount("tmpfs", "/tmp", "tmpfs", 0, "mode=1777")
    except OSError as e:
        die(f"mount tmpfs /tmp ({e})")
    for p in E.get("QC_KEEP", "").split("\n"):
        if not p.startswith("/tmp/"):
            continue
        src = f"/proc/self/fd/{tfd}/{p[5:]}"
        if not os.path.exists(src):
            continue
        if os.path.isdir(src):
            os.makedirs(p, exist_ok=True)
        else:
            os.makedirs(os.path.dirname(p), exist_ok=True)
            open(p, "a").close()
        try:  # recursive: nested, a kept path has an outer run's binds below it
            mount(src, p, None, MS_BIND | MS_REC)
        except OSError as e:
            die(f"bind back {p} ({e})")
    probe = f"qc-tmp-probe-{S}"
    open(f"/proc/self/fd/{tfd}/{probe}", "w").close()
    ok = not os.path.exists(f"/tmp/{probe}")
    os.unlink(f"/proc/self/fd/{tfd}/{probe}")
    os.close(tfd)
    if not ok:
        die("/tmp is private")
    say("ok   /tmp is private (nothing the judge writes there outlives the run)")
    os.chdir(cwd)

    # mise doctor writes nothing that outlives the run: it runs with the cache dir (or its nearest existing parent)
    # read-only in its own mount namespace, as it reports the real dirs.
    def cache_masked() -> None:
        os.unshare(os.CLONE_NEWNS)
        a = CACHE
        while not os.path.exists(a):
            a = os.path.dirname(a)
        mount(a, a, None, MS_BIND | MS_REC)
        ro(a)

    menv: dict[str, str] = {}
    # 6b: mise's dirs from doctor's JSON whatever its exit (#493); none fails closed
    if shutil.which("mise"):
        ms = f"/tmp/.qc-mise-{S}"  # a throwaway state dir: the judge's per-run MISE_STATE_DIR starts empty
        os.makedirs(ms)
        r = run("mise", "doctor", "--json", env=dict(E, MISE_STATE_DIR=ms), preexec_fn=cache_masked)
        try:
            dd: object = json.loads(r.stdout).get("dirs", {})
        except (ValueError, AttributeError):
            dd = {}
        for d in ("data", "cache", "config"):
            x = cast("dict[str, object]", dd).get(d) if isinstance(dd, dict) else None
            if not isinstance(x, str) or not x:
                die(
                    f"mise doctor --json (exit {r.returncode}) printed no dirs.{d}: mise's dirs unknown"
                )
            menv[f"MISE_{d.upper()}_DIR"] = E.get(f"MISE_{d.upper()}_DIR") or x
    srt = [srt_node(menv.get("MISE_DATA_DIR", "")), "--input-type=module", "-e", SRT_SHIM, sjs]
    # 2. the run tmpfs: overlay upper and work dirs, Pi copies.
    for c in (",", ":"):
        if c in WT:
            die(f"worktree path {WT} holds , or : (overlay options)")
        if c in UC:
            die(f"uv cache dir {UC} holds , or : (overlay options)")
    os.makedirs(OV)
    mount("tmpfs", OV, "tmpfs", 0, "mode=700")
    for d in ("u", "w", "uvu", "uvw", "pi"):
        os.mkdir(f"{OV}/{d}")
    kreq = f"needs kernel >= 5.11 (overlay userxattr) and >= 6.6 (tmpfs user xattrs), this one {os.uname().release}"
    try:
        os.setxattr(f"{OV}/u", "user.qc.probe", b"y")
        os.removexattr(f"{OV}/u", "user.qc.probe")
    except OSError:
        die(f"run tmpfs takes no user.* xattrs: the worktree overlay {kreq}")
    try:
        mount(
            "overlay", WT, "overlay", 0, f"lowerdir={WT},upperdir={OV}/u,workdir={OV}/w,userxattr"
        )
    except OSError:
        die(f"worktree overlay with userxattr: {kreq}")
    if UC:
        try:
            mount(
                "overlay",
                UC,
                "overlay",
                0,
                f"lowerdir={UC},upperdir={OV}/uvu,workdir={OV}/uvw,userxattr",
            )
        except OSError:
            die(f"uv cache overlay {UC} with userxattr: {kreq}")
    if not nopi:
        for n in pis:
            try:
                shutil.copyfile(f"{PI}/{n}", f"{OV}/pi/{n}")
                shutil.copymode(f"{PI}/{n}", f"{OV}/pi/{n}")
                mount(f"{OV}/pi/{n}", f"{PI}/{n}", None, MS_BIND)
            except OSError as e:
                die(f"copy Pi {n} ({e})")
    os.chdir(cwd)
    # history at the scratch state dir (step 2, read-only through srt's allowRead below).
    os.makedirs(f"{SB}/lanes")
    os.makedirs(f"{SCR}/bin")
    os.makedirs(f"{SCR}/rbin")
    os.makedirs(f"{SCR}/rec")
    hist, hro = 0, cast("list[str]", [])
    try:
        if not nohist and os.path.isdir(f"{RS}/lanes/archive"):
            os.mkdir(f"{SB}/lanes/archive")
            mount(f"{RS}/lanes/archive", f"{SB}/lanes/archive", None, MS_BIND)
            hist += 1
            hro.append(f"{SB}/lanes/archive")
        if not nohist and os.path.isfile(f"{RS}/director.handoffs.jsonl"):
            open(f"{SB}/director.handoffs.jsonl", "w").close()
            mount(f"{RS}/director.handoffs.jsonl", f"{SB}/director.handoffs.jsonl", None, MS_BIND)
            hist += 1
            hro.append(f"{SB}/director.handoffs.jsonl")
        # The box onboarding file read-only at the scratch state dir's top, where a role launch inside (pi-role, under
        # this XDG_STATE_HOME) reads the factory commit identity it applies (scripts/pi-role --help, Commit identity).
        # A bind at another path: srt cannot (its schema binds a path only at itself).
        if os.path.isfile(f"{TOP}/onboarding.toml"):
            ob = f"{SCR}/state/octo-feather/onboarding.toml"
            open(ob, "w").close()
            mount(f"{TOP}/onboarding.toml", ob, None, MS_BIND)
            hro.append(ob)
    except OSError as e:
        die(f"history or onboarding file ({e})")

    # A repo mask with paths bound back on it (a --kit-ref run's head-kit machinery): made here, a tmpfs with each path
    # bound back through an fd held on the repo, so srt's read-only root covers mask and binds alike. srt cannot: its
    # denyRead mask is a writable tmpfs mounted after the read-only root, and its denyWrite does not reach inside one.
    for r, bs, _ in rmask:
        if not bs:
            continue
        rf, b = os.open(r, os.O_RDONLY | os.O_DIRECTORY), r
        try:
            mount("tmpfs", r, "tmpfs", 0, "mode=755")
            for b in bs:
                rel = b[len(r) + 1 :]
                src = f"/proc/self/fd/{rf}/{rel}"
                if os.path.isdir(src):
                    os.makedirs(f"{r}/{rel}", exist_ok=True)
                else:
                    os.makedirs(os.path.dirname(f"{r}/{rel}"), exist_ok=True)
                    open(f"{r}/{rel}", "a").close()
                mount(src, f"{r}/{rel}", None, MS_BIND | MS_REC)
        except OSError as e:
            die(f"bind back {b} on the mask over {r} ({e})")
        finally:
            os.close(rf)
    os.chdir(cwd)

    # S. srt's policy.
    deny: list[str] = ["/tmp", HC]
    allow_r: list[str] = []
    allow_w: list[str] = []
    watch: list[tuple[str, str, list[str]]] = []
    masked: list[str] = []
    cmask: list[str] = []
    if os.path.isdir(GC):
        deny.append(GC)
        cmask.append(GC)
    deny += [
        f for f in (f"{HOME}/.git-credentials", f"{cfg}/git/credentials") if os.path.lexists(f)
    ]
    if os.path.isdir(f"{HOME}/.ssh"):
        deny.append(f"{HOME}/.ssh")
        cmask.append(f"{HOME}/.ssh")
    # Live records masked, each once: a path inside a mask already listed (a named session's state dir RS lies inside
    # the top's sessions/, as in a nested run, where the outer sandbox's session is the caller's) is hidden by that
    # mask; denied again, srt would make its mount point inside the outer mask, an entry the proof counts as visible.
    for d in dict.fromkeys((TOP, RS)):
        for x, isit in (
            ("lanes", os.path.isdir),
            ("sessions", os.path.isdir),
            ("director.toml", os.path.isfile),
            ("director.handoffs.jsonl", os.path.isfile),
        ):
            m = f"{d}/{x}"
            if isit(m) and not any(within(m, k) for k in masked):
                deny.append(m)
                masked.append(m)
    watch += [("credential", m, []) for m in cmask] + [
        ("lane_state", m, []) for m in masked if os.path.isdir(m)
    ]
    for r, bs, names in rmask:
        if not bs:
            deny.append(r)  # one with paths bound back is masked above
        watch.append(("repo", r, names))
    # kept /tmp paths read-only, but the worktree (writable, below) and any inside a mask (a repo, a live record, a
    # credential dir; nested, the outer run's state dir is the caller's): the mask wins there
    allow_r += [
        p
        for p in E.get("QC_KEEP", "").split("\n")
        if p.startswith("/tmp/")
        and os.path.exists(p)
        and not within(p, wtp)
        and not any(within(p, r) for r in hid + masked + cmask)
    ]
    # srt's own temp dir (its proxy bridge sockets): carved back read-only, as its denyRead /tmp would cover the sockets it binds
    allow_r += [f"{SCR}/bin", f"{SCR}/rbin", f"{SCR}/rec", f"{SCR}/srt", *hro]
    VC = f"{CACHE}/octo-feather/skillfile"
    if os.path.isdir(CACHE):
        deny.append(CACHE)
        if os.path.isdir(VC):
            allow_r.append(VC)
    if os.path.isdir(PI):
        deny.append(PI)
        for n in pient:
            if n == "sessions" or (n in ("auth.json", "models.json")):
                continue
            allow_r.append(f"{PI}/{n}")
        if not nopi:
            allow_w += [f"{PI}/{n}" for n in pis]
    # srt's convenience write dirs: masks, never the real dirs
    deny += [f"{HOME}/.npm/_logs", f"{HOME}/.claude/debug"]
    allow_w += [wtp] + ([UC] if UC else [])
    allow_r += [p for p in ro_binds if any(within(p, d) for d in deny)]
    hosts = [] if nopi else hosts_for_pi(PI)
    settings: dict[str, Any] = {
        "network": {"allowedDomains": hosts, "deniedDomains": [], "allowAllUnixSockets": True},
        "filesystem": {
            "denyRead": deny,
            "allowRead": allow_r,
            "allowWrite": allow_w,
            "denyWrite": [],
        },
        "allowNestedUserNamespaces": True,
    }
    json.dump(settings, open(f"{SCR}/srt.json", "w"))

    # 6. env and shims.
    jenv = {k: v for k, v in E.items() if k not in SCRUB and k not in INPUTS}
    py = sys.executable or shutil.which("python3") or "python3"
    RSOCK, REC = f"{SCR}/rec/sock", f"{SCR}/rec/attempts.jsonl"
    jenv.update(
        MISE_STATE_DIR=f"{SCR}/mise/state",
        HERDR_SESSION=S,
        XDG_STATE_HOME=f"{SCR}/state",
        GH_CONFIG_DIR=f"{SCR}/gh",
        GIT_TERMINAL_PROMPT="0",
        TMPDIR="/tmp",
        MISE_OFFLINE="1",
        MISE_AUTO_INSTALL="0",
        MISE_NOT_FOUND_AUTO_INSTALL="0",
        MISE_NOT_FOUND_SYSTEM_FALLBACK="0",
        **menv,
    )
    open(f"{SCR}/bin/pi", "w").write(pishim(realpi, SCR))
    if HERDR:
        open(f"{SCR}/bin/herdr", "w").write(
            recshim(
                py,
                "herdr",
                "herdr",
                HERDR,
                (["--session", S], ["--session", "--remote", "--machine"], ["HERDR_PANE_ID"]),
                RSOCK,
            )
        )
        # The per-run server's config: no background version or agent-manifest check (herdr's own [update] keys); the
        # sandbox's network refuses herdr.dev anyway, and each check was a curl, a refusal and srt's handling of it.
        open(f"{SCR}/bin/herdr.toml", "w").write(
            "[update]\nversion_check = false\nmanifest_check = false\n"
        )
        jenv.update(
            HERDR_BIN_PATH=f"{SCR}/bin/herdr",
            HERDR_SOCKET_PATH=f"{HC}/sessions/{S}/herdr.sock",
            HERDR_CONFIG_PATH=f"{SCR}/bin/herdr.toml",
            OCTO_FEATHER_QC_HERDR=HERDR,
        )
    open(f"{SCR}/bin/git-credential-qc", "w").write(credhelper(py, RSOCK))
    n = int(E.get("GIT_CONFIG_COUNT") or 0)
    jenv.update(
        {
            "GIT_CONFIG_COUNT": str(n + 2),
            f"GIT_CONFIG_KEY_{n}": "credential.helper",
            f"GIT_CONFIG_VALUE_{n}": "",
            f"GIT_CONFIG_KEY_{n + 1}": "credential.helper",
            f"GIT_CONFIG_VALUE_{n + 1}": f"{SCR}/bin/git-credential-qc",
        }
    )
    recs: list[str] = []
    for p in E.get("QC_RECORD", "").split("\n"):
        if not p:
            continue
        if not re.fullmatch(r"[A-Za-z0-9_+-][A-Za-z0-9._+-]*", p):
            die(f"run record: program name {p}")
        open(f"{SCR}/rbin/{p}", "w").write(recshim(py, "run", p, "", ([], [], []), RSOCK))
        recs.append(p)
    for d in ("bin", "rbin"):
        for f in os.listdir(f"{SCR}/{d}"):
            os.chmod(f"{SCR}/{d}/{f}", 0o755)
    path = (
        [f"{SK}/.agents/skills/github-pr/scripts"]
        + ([f"{SCR}/rbin"] if recs else [])
        + jpre
        + [f"{SCR}/bin"]
        + jpath
    )
    if recs:  # a run shim wraps whichever one of its name comes next, the offline gh too
        path = [
            f"{SCR}/rbin",
            f"{SK}/.agents/skills/github-pr/scripts",
            *jpre,
            f"{SCR}/bin",
            *jpath,
        ]
        jenv["OCTO_FEATHER_QC_RUN_SHIMS"] = f"{SCR}/rbin"
    jenv.update(
        PATH=":".join(path),
        OCTO_FEATHER_GHSNAP=E.get("QC_GHSNAP", ""),
        OCTO_FEATHER_GHSNAP_OFF=ghoff,
        OCTO_FEATHER_GHSNAP_MISS=RSOCK,
        OCTO_FEATHER_QC_ATTEMPTS=REC,
    )
    if E.get("QC_SHOTS"):
        jenv["QC_SCREENSHOTS"] = f"{SCR}/shots"
    inner = {
        "S": S,
        "SCR": SCR,
        "SB": SB,
        "HC": HC,
        "HERDR": HERDR,
        "GH": GH,
        "GC": f"{SCR}/gh",
        "WT": WT,
        "OV": f"{OV}/u",
        "UC": UC,
        "UCU": f"{OV}/uvu" if UC else "",
        "UCN": ucn,
        "VC": VC if VC in allow_r else "",
        "PI": PI,
        "nopi": nopi,
        "hist": "none" if nohist else hist,
        "masked": masked,
        "repos": [[r, "/".join(nm)] for r, _, nm in rmask],
        "kept": [KUT, wtp, *sorted({b for _, bs, _ in rmask for b in bs}, key=back.index)],
        "robinds": ro_binds,
        "ghline": E.get("QC_GHSNAP_LINE", ""),
        "browser": E.get("QC_BROWSER", ""),
        "shots": bool(E.get("QC_SHOTS")),
        "recs": recs,
        "watch": [path for _, path, _ in watch],
        "env": jenv,
        "srt": srtv,
        "hosts": hosts,
        "bwrap": (run("bwrap", "--version").stdout.strip() or "bwrap ?"),
        "cwd": cwd,
        "hand": OUT["proof"] is None,
    }
    json.dump(inner, open(f"{SCR}/bin/run.json", "w"))
    os.chmod(f"{SCR}/bin/run.json", 0o444)

    # R. the recorder, then srt.
    # The inner's pipes, and the caller's stdin, stdout and stderr: handed over the recorder's socket, never to srt's
    # Node, which sets O_NONBLOCK on the stdio it inherits (libuv), on the open file description itself, shared by the
    # caller and every writer in the sandbox: a judge writing a burst into a full pipe then failed with EAGAIN (#690's
    # eval runs). srt gets /dev/null and its own stderr pipe.
    fds = [*(o if (o := OUT[k]) is not None else 2 for k in ("proof", "post", "err")), 2, 0, 1]
    # This process the child subreaper of everything the run starts: bubblewrap's monitor exits before the sandbox's
    # init (the inner, the proof, the judge) is reaped, and that init would go to the box's init, its CPU counted by no
    # caller (quality #acceptance-qc-sandbox-cost: every process); here each orphan is reaped (orphans(), below).
    if libc.prctl(36, 1, 0, 0, 0) != 0:  # PR_SET_CHILD_SUBREAPER
        die("native lifecycle requires the owning child subreaper")
    rec = Recorder(f"{SCR}/rec", watch, S, fds)
    rec.th.start()
    os.makedirs(f"{SCR}/srt")
    # Node's own compile cache (module.enableCompileCache, NODE_COMPILE_CACHE) for srt's modules, setup-side under the
    # cache dir (the judge's view masks it): loading srt's library was most of its CPU per run.
    senv = dict(
        jenv,
        PATH=E.get("PATH", ""),
        TMPDIR=f"{SCR}/srt",
        NODE_COMPILE_CACHE=f"{E.get('XDG_CACHE_HOME') or HOME + '/.cache'}/octo-feather/node-compile-cache",
        QC_NATIVE_SECRET=rec.native_secret,
        QC_NATIVE_SOCKET=f"{SCR}/rec/sock",
        QC_NATIVE_PYTHON=py,
        QC_NATIVE_COMMAND=SELF,
        QC_FD_CANCEL=str(_cancellation.fd),
    )
    # srt runs from an empty dir of the private /tmp, which the judge cannot write: its built-in write denies (shell rc
    # files, .git/hooks and .git/config, .vscode ... in and below its working dir, within the writable paths) would
    # otherwise be made as empty mount points in the worktree overlay, each a new untracked file; every write there is
    # discarded with the overlay anyway. The inner enters the caller's dir.
    os.makedirs(f"{SCR}/cwd")
    # srt's violations (SRT_SHIM) on its stderr, read here, each sent to the recorder. The inner takes this process's
    # stderr over the recorder's socket, so what reaches srt's stderr past its start is srt's own.
    node: subprocess.Popen[bytes] | None = None
    node_fd = None
    rc: int | None = None
    th: threading.Thread | None = None
    early: list[str] = []
    primary: BaseException | None = None
    secondary: list[tuple[str, BaseException]] = []
    native_ok = False
    owner_forced = False
    left: list[str] | None = None
    fin: NativeRecord | None = None

    def cleanup_error(stage: str, error: BaseException) -> None:
        nonlocal primary
        if primary is None:
            primary = error
            primary.add_note(f"qc sandbox cleanup phase: {stage}")
        else:
            secondary.append((stage, error))

    try:
        raise_if_cancelled()
        node = subprocess.Popen(
            [
                *srt,
                f"{SCR}/srt.json",
                "--",
                py,
                SELF,
                "inner",
                f"{SCR}/bin/run.json",
                "--",
                *judge,
            ],
            env=senv,
            cwd=f"{SCR}/cwd",
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            close_fds=True,
            pass_fds=(_cancellation.fd,),
        )
        # Deliver deferred early/repeated signals only after BOTH Popen and pidfd enrollment.
        node_fd = os.pidfd_open(node.pid)
        _cancellation.armed = True
        raise_if_cancelled()
        th = threading.Thread(
            target=srt_log, args=(node, f"{SCR}/rec/sock", early, rec), daemon=True
        )
        th.start()
        rc = node.wait()
        th.join(cancel_budget(10, 1))
    # setup primary captures ANY fatal after ownership enrollment.
    except BaseException as error:  # noqa: BLE001
        primary = error
        if (
            isinstance(error, Cancelled)
            and _cancellation.fault is None
            and node_fd is not None
            and node is not None
        ):
            previous = signal.signal(signal.SIGINT, signal.SIG_IGN)
            try:
                _cancel_end, cancel_sig = cancel_stamp()
                with contextlib.suppress(ProcessLookupError):
                    signal.pidfd_send_signal(node_fd, cancel_sig)
                node.wait(timeout=cancel_budget(9, 3))
            # graceful Node cancellation failure is secondary, forced cleanup continues.
            except BaseException as graceful_error:  # noqa: BLE001
                cleanup_error("graceful Node cancellation", graceful_error)
            finally:
                signal.signal(signal.SIGINT, previous)
        owner_forced = node is not None and node.returncode is None
        try:
            with contextlib.suppress(ProcessLookupError):
                if owner_forced and node_fd is not None:
                    signal.pidfd_send_signal(node_fd, signal.SIGKILL)
                elif owner_forced:
                    os.kill(
                        require_owned_node(node).pid, signal.SIGKILL
                    )  # direct root, no wait/reap yet
        # Node-stop failure must not skip bounded wait/finalization.
        except BaseException as error:  # noqa: BLE001
            cleanup_error("Node stop", error)
        try:
            if node is not None:
                node.wait(timeout=cancel_budget(5, 1))
        # bounded Node-wait failure must not skip native/descendant cleanup.
        except BaseException as error:  # noqa: BLE001
            cleanup_error("bounded Node wait", error)
    finally:
        _cancellation.armed = (
            False  # first late/repeated signal records intent, never interrupts handoff
        )
        # Keep Recorder and the retained Node FD alive across every independent
        # attempt. Failed waits/finalization do not prove completion or ECHILD.
        try:
            native_ok = rec.finalize_native()
        # native-finalization failure must not skip adopted-child drainage.
        except BaseException as error:  # noqa: BLE001
            cleanup_error("native finalization", error)
        try:
            left = orphans()
        # failed adopted-child drainage must not skip Recorder finish/FD close.
        except BaseException as error:  # noqa: BLE001
            cleanup_error("adopted-child drainage; ECHILD unproved", error)
        try:
            fin = rec.finish()
        # Recorder finish failure must not skip Node-FD close/publication.
        except BaseException as error:  # noqa: BLE001
            cleanup_error("Recorder finish/descriptor closure", error)
        finally:
            if node_fd is not None:
                try:
                    os.close(node_fd)
                # Node-FD close failure must not replace primary or skip publication.
                except BaseException as error:  # noqa: BLE001
                    cleanup_error("Node descriptor close", error)
    if _cancellation.signal and primary is None:
        primary = Cancelled(_cancellation.signal)
    try:
        if fin is not None:
            fin["native_lifecycle"].update(
                owner_forced=owner_forced or bool(left),
                native_finalized=native_ok,
                adopted_reaped=left == [],
                node_exit=node.returncode if node is not None else None,
                deadline_ok=cancel_budget(1) > 0 and _cancellation.fault is None,
                cancel_deadline_ns=_cancellation.end or None,
            )
            fin["native_lifecycle"]["capability_error"] = (
                str(_cancellation.fault) if _cancellation.fault is not None else None
            )
            fin["native_lifecycle"]["owner_received_signal"] = _cancellation.signal or None
            owner_errors = [f"{stage}: {error}" for stage, error in secondary]
            fin["native_lifecycle"]["owner_errors"] = owner_errors
            if primary is not None and not isinstance(primary, Cancelled):
                owner_errors.append(str(primary))
            fin["native_lifecycle"]["node_log_drained"] = th is not None and not th.is_alive()
            post(fin)  # existing trusted report pipe, including actual cancellation
    # terminal publication failure must retain original primary identity.
    except BaseException as error:  # noqa: BLE001
        cleanup_error("terminal publication", error)
    if _cancellation.signal and primary is None:
        primary = Cancelled(
            _cancellation.signal
        )  # intent arriving during publication is still observed
    if primary is not None:
        if not native_ok:
            primary.add_note("retained native completion unproved")
        if left:
            primary.add_note(f"adopted-child survivors observed: {', '.join(left)}")
        for stage, error in secondary:
            primary.add_note(
                f"secondary cleanup failure ({stage}): {type(error).__name__}: {error}"
            )
            for note in getattr(error, "__notes__", []):
                primary.add_note(note)
        # SystemExit does not normally display notes. Emit them explicitly too,
        # only after all cleanup attempts, without replacing the original fatal.
        try:
            sys.stderr.write("\n".join(getattr(primary, "__notes__", [])) + "\n")
        # failed diagnostic write must not replace the retained fatal.
        except BaseException as error:  # noqa: BLE001
            primary.add_note(f"cleanup diagnostics failed: {type(error).__name__}: {error}")
        raise primary
    if left is None or fin is None or rc is None:
        failure_message = "owned cleanup or actual Node wait completion unproved"
        raise RuntimeError(failure_message)
    if not rec.hello:
        sys.stderr.write("".join(early))
    if not native_ok or fin["native_cleanup_errors"]:
        say("FAIL retained native lifecycle completion unproved")
        rc = 66
    if not rec.hello:
        say(f"FAIL srt sandbox did not start the inner (srt exit {rc})")
        say("proof failed; judge not started (exit 66)")
        rc = 66
    say(f"attempt record: {len(fin['attempts'])} entries; offline gh refusals {fin['gh_misses']}")
    post({"upper": upper(f"{OV}/u", f"/proc/self/fd/{wfd}")})
    if (
        left
    ):  # a process the run started still running outside the sandbox's PID namespace: never silent
        say(f"FAIL processes the run started still running after it: {', '.join(left)}")
        post({"orphans_left": left})
        rc = 66
    sys.exit(rc)


def orphans(wait_s: float = 5.0) -> list[str]:
    """Reap every process the run left to this subreaper (its CPU then counted by whoever waits for this one), for up
    to WAIT_S s; terminate and reap survivors, returning each "PID CMDLINE" as a fatal diagnostic.
    Only ECHILD proves completion: Linux's task children snapshots can omit children during exits."""
    now = time.monotonic()
    end = now + cancel_budget(wait_s, 1)
    cleanup_end = now + cancel_budget(2 * wait_s)
    out: list[str] = []
    while True:
        try:
            pid, _ = os.waitpid(-1, os.WNOHANG)
        except ChildProcessError:
            return out
        if pid:
            continue
        if time.monotonic() < end:
            time.sleep(0.02)
            continue
        # Every task belongs to us; only its explicitly owned children are inspected. No
        # other thread reaps them, so their PIDs cannot be reused before pidfd_open below.
        children: set[int] = set()
        try:
            for tid in os.listdir("/proc/self/task"):
                try:
                    children.update(
                        map(int, open(f"/proc/self/task/{tid}/children").read().split())
                    )
                except FileNotFoundError:
                    # A vanished own thread can race enumeration. The main task's missing
                    # children file is an observation failure, not evidence of no children.
                    if tid == str(os.getpid()):
                        raise
        except (OSError, ValueError) as e:
            error = f"owned children observation failed: {e}"
            if error not in out:
                out.append(error)
        for child in children:
            try:
                fd = os.pidfd_open(child)
                try:
                    try:
                        cl = (
                            open(f"/proc/{child}/cmdline", "rb")
                            .read()
                            .replace(b"\0", b" ")
                            .decode(errors="replace")
                        )
                    except OSError as e:
                        cl = f"cmdline observation failed: {e}"
                    diagnostic = f"{child} {cl.strip()[:80]}"
                    if diagnostic not in out:
                        out.append(diagnostic)
                    # Already exited children still must be waited for.
                    with contextlib.suppress(ProcessLookupError):
                        signal.pidfd_send_signal(fd, signal.SIGKILL)
                finally:
                    os.close(fd)
            except OSError as e:
                error = f"{child} owned pidfd cleanup failed: {e}"
                if error not in out:
                    out.append(error)
        # An empty snapshot is not success. Drain deaths and newly adopted descendants
        # until waitpid reports ECHILD, counting all their CPU in this process's caller.
        if time.monotonic() >= cleanup_end:
            out.append(
                "owned cleanup incomplete: live children remain; complete CPU accounting not proved"
            )
            return out  # fatal, never presented as successful cleanup or complete accounting
        time.sleep(0.02)


def upper(up: str, lo: str) -> list[list[str]]:
    """10: what the judge wrote into the worktree, from the upper dir (whiteouts, opaque dirs: user.overlay.*)."""
    out: list[list[str]] = []

    def lower_files(rel: str) -> list[str]:
        p = os.path.join(lo, rel)
        if not os.path.isdir(p) or os.path.islink(p):
            return [rel] if os.path.lexists(p) else []
        return [os.path.relpath(os.path.join(r, f), lo) for r, _, fs in os.walk(p) for f in fs]

    def same(a: str, b: str) -> bool:
        try:
            sa, sb = os.lstat(a), os.lstat(b)
        except OSError:
            return False
        if stat.S_IFMT(sa.st_mode) != stat.S_IFMT(sb.st_mode) or (sa.st_mode & 0o111) != (
            sb.st_mode & 0o111
        ):
            return False
        if stat.S_ISLNK(sa.st_mode):
            return os.readlink(a) == os.readlink(b)
        if sa.st_size != sb.st_size:
            return False
        with open(a, "rb") as x, open(b, "rb") as y:
            while True:
                p, q = x.read(1 << 20), y.read(1 << 20)
                if p != q:
                    return False
                if not p:
                    return True

    for root, dirs, files in os.walk(up):
        for d in list(dirs):  # opaque dir: everything below it in the lower is hidden
            rel = os.path.relpath(os.path.join(root, d), up)
            pd = os.path.join(root, d)
            try:
                opq = any(
                    os.getxattr(pd, x, follow_symlinks=False) == b"y"
                    for x in ("trusted.overlay.opaque", "user.overlay.opaque")
                    if x in os.listxattr(pd, follow_symlinks=False)
                )
            except OSError:
                opq = False
            if opq:
                out += [
                    ["deleted", f]
                    for f in lower_files(rel)
                    if not os.path.lexists(os.path.join(up, f))
                ]
        for f in files + [d for d in dirs if os.path.islink(os.path.join(root, d))]:
            p = os.path.join(root, f)
            rel = os.path.relpath(p, up)
            s = os.lstat(p)
            if stat.S_ISCHR(s.st_mode) and s.st_rdev == 0:  # whiteout
                out += [["deleted", x] for x in lower_files(rel)]
            elif not os.path.lexists(os.path.join(lo, rel)):
                out.append(["new", rel])
            elif not same(p, os.path.join(lo, rel)):
                out.append(["changed", rel])
    return sorted(out, key=lambda e: e[1])


# ---------------------------------------------------------------- inner
def mise_tools(wt: str, kit: str, env: Mapping[str, str]) -> tuple[bool, str]:
    """6b: (ok, proof line): the worktree's and the kit's own mise tools installed in env's MISE_DATA_DIR, each dir's
    tools as scripts/octo-feather-mise-install names them (its own_tools(), loaded here: one Python start less per
    dir than its --list --json command), asked with a throwaway state dir."""
    helper = f"{kit}/scripts/octo-feather-mise-install"
    loader = importlib.machinery.SourceFileLoader("octo_feather_mise_install", helper)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    assert spec is not None
    mod = importlib.util.module_from_spec(spec)
    sys.dont_write_bytecode = True  # never a __pycache__ in the kit's scripts/
    loader.exec_module(mod)
    ms = tempfile.mkdtemp()
    saved, want = dict(os.environ), dict(env, MISE_STATE_DIR=ms)  # env may be os.environ itself
    os.environ.clear()
    os.environ.update(want)
    miss: list[str] = []
    judged: list[str] = []
    fix: list[str] = []
    asked: dict[str, dict[str, Any] | str] = {}  # one ask per dir: the kit judging itself asks once
    try:
        for d in (wt, kit):
            dr = os.path.realpath(d)
            if dr not in asked:
                mise = shutil.which("mise")
                try:
                    asked[dr] = mod.own_tools(mise, dr) if mise else "mise is not on PATH"
                except SystemExit as e:  # its failure, named as its command names it
                    asked[dr] = str(e.code)
            got = asked[dr]
            own: list[tuple[str, dict[str, Any]]] = []
            if isinstance(got, str):
                m = [f"{helper} --list --json failed: {' '.join(got.split())[:300] or 'no output'}"]
            else:
                own = [(tn, v) for tn, vs in got.items() for v in vs]
                m = [f"{tn}@{v.get('version')}" for tn, v in own if not v.get("installed")]
            if m:
                miss.append(f"{dr}: {' '.join(m)}")
                fix.append(f"{shlex.quote(helper)} {shlex.quote(dr)}")
            names = " ".join(f"{tn}@{v.get('version')}" for tn, v in own)
            judged.append(f"{dr}: {names or 'none'}")
    finally:
        os.environ.clear()
        os.environ.update(saved)
        shutil.rmtree(ms, ignore_errors=True)
    line = f"mise offline, auto-install off; tools of the worktree and the kit installed in {env.get('MISE_DATA_DIR', '')}"
    if miss:
        line += f" (NOT installed: {' '.join(miss)}; the sandbox installs nothing: run outside it: {'; '.join(dict.fromkeys(fix))})"
    return not miss, f"{line}; judged, each from its own mise config only: {'; '.join(judged)}"


def mounts() -> list[tuple[str, str, str, str, str]]:
    """/proc/self/mountinfo rows: (id, mountpoint, options, fstype, superoptions)."""
    rows: list[tuple[str, str, str, str, str]] = []
    for ln in open("/proc/self/mountinfo"):
        a = ln.split()
        i = a.index("-")
        rows.append(
            (
                a[0],
                re.sub(r"\\([0-7]{3})", lambda m: chr(int(m.group(1), 8)), a[4]),
                a[5],
                a[i + 1],
                a[i + 3] if len(a) > i + 3 else "",
            )
        )
    return rows


def covered(mid: str, path: str) -> bool:
    """Mount MID is covered by a later one: PATH is gone or reaches another mount."""
    try:
        fd = os.open(path, os.O_PATH)
    except OSError:
        return True
    try:
        m = re.search(r"^mnt_id:\s*(\d+)", open(f"/proc/self/fdinfo/{fd}").read(), re.MULTILINE)
    finally:
        os.close(fd)
    return bool(m) and m.group(1) != mid


def srt_set(k: str) -> bool:
    """K is one of the variables srt sets in its sandbox for its network proxy (sandbox-utils.ts generateProxyEnvVars,
    the Linux wrapper's --setenv), whose value inside is srt's own."""
    return (
        "proxy" in k.lower()
        or k.startswith(("CLOUDSDK_PROXY_", "CLAUDE_CODE_HOST_"))
        or k in ("SANDBOX_RUNTIME", "GIT_SSH_COMMAND", "GIT_CONFIG_PARAMETERS", "JAVA_TOOL_OPTIONS")
    )


def inner(cfgp: str, judge: list[str]) -> NoReturn:
    c: dict[str, Any] = json.load(open(cfgp))
    S, SCR, SB, HC, HERDR, WT = c["S"], c["SCR"], c["SB"], c["HC"], c["HERDR"], c["WT"]
    env = {k: v for k, v in os.environ.items() if k not in INPUTS}
    # The judge's env over srt's, but srt's own network plumbing (its proxy vars, set by bwrap --setenv) kept: a caller
    # inside an outer sandbox carries the outer srt's, which point at no proxy of this one (nested: a 407, no record).
    env.update({k: v for k, v in c["env"].items() if not (k in os.environ and srt_set(k))})
    if c["shots"]:
        env["QC_SCREENSHOTS"] = c["env"]["QC_SCREENSHOTS"]
    # A loopback model host on the allowlist (a local provider): srt's NO_PROXY names loopback, which would send the
    # call to the sandbox's own loopback; dropped, it goes through srt's proxy to the host's, which the list allows.
    loop = {h.rsplit(":", 1)[0].strip("[]") for h in c["hosts"]} & {"127.0.0.1", "localhost", "::1"}
    if loop:
        for k in ("NO_PROXY", "no_proxy"):
            if k in env:
                env[k] = ",".join(
                    x for x in env[k].split(",") if x not in ("127.0.0.1", "localhost", "::1")
                )
    # Node's fetch takes the proxy srt sets only when told to (Node >= 22.21)
    env.setdefault("NODE_USE_ENV_PROXY", "1")
    os.environ.clear()
    os.environ.update(env)
    # NSpid is self metadata relative to the procfs mount's PID namespace.
    # Exactly our one coordinate excludes an ancestor procfs. The recorder checks
    # a distinct actual namespace FD before allowing process enumeration.
    nspid = next(
        (line.split()[1:] for line in open("/proc/self/status") if line.startswith("NSpid:")),
        list[str](),
    )
    if nspid != [str(os.getpid())]:
        sys.exit(
            print(
                "qc sandbox: FAIL procfs not scoped to inner PID namespace (exit 66)",
                file=sys.stderr,
            )
            or 66
        )
    sk = socket.socket(socket.AF_UNIX, socket.SOCK_SEQPACKET)
    try:
        sk.connect(f"{SCR}/rec/sock")
        for path in c["watch"]:
            # O_PATH retains even a mode-000 mask; setup opens its own received
            # capability for listing, under the same credentials as before.
            fd = os.open(path, os.O_PATH | os.O_DIRECTORY | os.O_CLOEXEC)
            try:
                socket.send_fds(sk, [b'{"t":"mask"}'], [fd])
            finally:
                os.close(fd)
        fd = os.open("/proc/self/ns/pid", os.O_RDONLY | os.O_CLOEXEC)
        try:
            socket.send_fds(sk, [b'{"t":"hello"}'], [fd])
        finally:
            os.close(fd)
        msg, fds, flags, _ = socket.recv_fds(sk, 64, BOOTSTRAP_FD_COUNT, socket.MSG_CMSG_CLOEXEC)
        validate_readiness(msg, fds, flags)
        base = {str(os.getpid())} | {
            p for p in os.listdir("/proc") if p.isdigit()
        }  # verified private procfs: srt's own processes and ours
        # the caller's stderr, stdin and stdout for this process and its children (srt's own stdio aside), blocking
        for f, to in ((fds[3], 2), (fds[4], 0), (fds[5], 1)):
            os.dup2(f, to)
            os.close(f)
        fds = fds[:3]
        for f in (0, 1, 2, *fds):
            with contextlib.suppress(OSError):
                fcntl.fcntl(f, fcntl.F_SETFL, fcntl.fcntl(f, fcntl.F_GETFL) & ~os.O_NONBLOCK)
    except OSError as e:
        sys.exit(
            print(
                f"qc sandbox: FAIL attempt record unreachable ({e}); judge not started (exit 66)",
                file=sys.stderr,
            )
            or 66
        )
    OUT["proof"], OUT["post"], OUT["err"] = fds
    if c["hand"]:  # by hand: the proof goes to stderr once, the records there too
        OUT["proof"] = OUT["post"] = None
    os.chdir(c["cwd"])
    for f in fds:
        os.set_inheritable(f, False)  # noqa: FBT003  # os's own positional flag
    ready = msg.decode()
    for d in (f"{SB}/lanes", c["GC"], f"{SCR}/mise/state", f"{HC}/sessions") + (
        (c["env"]["QC_SCREENSHOTS"],) if c["shots"] else ()
    ):
        os.makedirs(d, exist_ok=True)
    fails = 0

    def check(ok: bool, m: str) -> None:  # noqa: FBT001  # one proof check: its result, its line
        nonlocal fails
        say(f"{'ok  ' if ok else 'FAIL'} {m}")
        fails += 0 if ok else 1

    def t(*a: str) -> int:
        """A's exit status, as data."""
        try:
            return subprocess.run(
                list(a), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
            ).returncode
        except OSError:
            return 127

    if not ready.startswith("ready "):
        check(ok=False, m=f"attempt recorder did not start ({ready or 'no line'})")
    say(
        f"ok   attempt record: kept setup-side, outside the judge's namespaces (the judge sees {SCR}/rec read-only); herdr shim, git credential helper, offline gh refusals, inotify on {ready[6:]} masks"
    )
    if c["recs"]:
        say(
            f"ok   run record: shims first on PATH for {', '.join(c['recs'])} (each runs the next one of its name unchanged)"
        )
    if HERDR:
        subprocess.Popen(
            [HERDR, "--session", S, "server"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        for _ in range(50):
            if t(HERDR, "--session", S, "workspace", "list") == 0:
                break
            time.sleep(0.2)
    # 7. pre-run proof.
    pid1 = open("/proc/1/cmdline", "rb").read().split(b"\0")[0].decode(errors="replace")
    check(
        os.path.basename(pid1) == "bwrap" and os.environ.get("SANDBOX_RUNTIME") == "1",
        f"judge runs in the srt sandbox (@anthropic-ai/sandbox-runtime {c['srt']}, {c['bwrap']}; PID 1 {os.path.basename(pid1)}): own user, mount, PID and network namespaces; "
        f"network allowlist: {', '.join(c['hosts']) or 'none'}"
        "; kit discard stage (srt and bwrap 0.9 have no overlay): worktree and uv cache overlays, Pi copies, own IPC namespace",
    )
    st = dict(ln.split(":", 1) for ln in open("/proc/self/status") if ":" in ln)
    caps, nnp = st["CapEff"].strip(), st["NoNewPrivs"].strip()
    check(
        caps == "0000000000000000" and nnp == "1",
        f"judge holds no capabilities (CapEff {caps}), no_new_privs {nnp}, uid {os.getuid()}",
    )
    r1, r2 = t("umount", HC), t("unshare", "-rm", "umount", HC)
    check(
        r1 != 0 and r2 != 0,
        f"masks locked: umount of the Herdr mask exits {r1}, after its own unshare -rm {r2}",
    )
    kit = SK
    rol, dirs = ["HOME", "/var/tmp"], [os.environ["HOME"], "/var/tmp"]
    wtr = os.path.realpath(WT)
    if (kit + "/").startswith(wtr + "/"):
        kitn = "the kit is the judged worktree (on the overlay: writes discarded, a tracked change fails the run)"
    else:
        rol.append("the kit")
        dirs.append(kit + "/scripts")
        kitn = ""
    w = any(touchable(f"{d}/.qc-ro-{S}") for d in dirs)
    check(not w, f"{', '.join(rol)} read-only" + (f"; {kitn}" if kitn else ""))
    ov, ucu, uc = c["OV"], c["UCU"], c["UC"]
    wt = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True
    ).stdout.strip()
    last: dict[str, tuple[str, str, str, str, str]] = {}
    for row in mounts():
        last[row[1]] = row
    # Every writable mount, by its own flags: tmpfs and /proc die with the run, the overlays' upper dirs are on the run
    # tmpfs; a device node bound in (srt's /dev: null, zero, tty...) and devpts hold no file a write could leave behind.
    pers: list[str] = []
    unreach = 0
    for mp, (mid, _, o, fs, so) in last.items():
        if (
            "ro" in o.split(",")
            or fs in ("tmpfs", "proc", "devpts")
            or (
                fs == "overlay"
                and (f"upperdir={ov}," in so + "," or (ucu and f"upperdir={ucu}," in so + ","))
            )
        ):
            continue
        try:
            if stat.S_ISCHR(os.stat(mp).st_mode):
                continue
        except OSError:
            pass
        if covered(mid, mp):
            unreach += 1
        else:
            pers.append(mp)
    ovl = any(
        mp == wt and fs == "overlay" and f"upperdir={ov}," in so + ","
        for _, mp, _, fs, so in mounts()
    )
    check(
        ovl and not os.path.exists(ov),
        f"worktree {wt} is an overlay, upper dir on the run tmpfs and hidden from the judge",
    )
    check(not pers, f"writable persistent paths: {' '.join(pers) or 'none'}")
    if uc:
        ucl = any(
            mp == uc and fs == "overlay" and f"upperdir={ucu}," in so + ","
            for _, mp, _, fs, so in mounts()
        )
        check(
            ucl and touchable(f"{uc}/.qc-w-{S}") and not os.path.exists(ucu),
            f"uv cache {uc} is an overlay, upper dir {ucu} on the run tmpfs and hidden from the judge (writable; its writes discarded with the run)",
        )
    elif c["UCN"]:
        say(f"ok   uv cache: {c['UCN']} (uv --color never cache dir) absent, nothing bound")
    else:
        say("ok   uv cache: none on the box (no uv, or uv cache dir exits non-zero), nothing bound")
    if unreach:
        say(
            f"ok   {unreach} writable mounts covered by later ones, unreachable by any path (an outer sandbox's, in a nested run, or below the old /proc)"
        )
    vc = c["VC"]
    if vc:
        vro = "ro" in last.get(vc, ("", "", "rw"))[2].split(",")
        check(
            vro and not touchable(f"{vc}/.qc-ro-{S}") and vc not in pers,
            f"vendored-skill cache {vc} bound read-only (not writable, not in the writable list)",
        )
    else:
        say("ok   vendored-skill cache: none on the box, nothing bound")
    if HERDR:
        r = t(HERDR, "--session", "default", "workspace", "list")
        check(
            r != 0, f"live Herdr unreachable: raw herdr --session default workspace list exits {r}"
        )
        a = subprocess.run(
            [
                "herdr",
                "--session",
                "default",
                "--remote",
                "x",
                "--machine",
                "y",
                "workspace",
                "list",
            ],
            capture_output=True,
            text=True,
        )
        b = subprocess.run(
            [HERDR, "--session", S, "workspace", "list"], capture_output=True, text=True
        )
        ab, bb = (a.stdout + a.stderr).rstrip("\n"), (b.stdout + b.stderr).rstrip("\n")
        check(
            bool(bb) and ab == bb,
            f"herdr shim pins sandbox session {S} despite --session default --remote --machine",
        )
        ls_s = " ".join(sorted(os.listdir(f"{HC}/sessions")))
        check(ls_s == S, f"Herdr config shows only the sandbox session: [{ls_s}]")
    else:
        say("ok   herdr not installed: no Herdr session reachable")
    cfgc = os.environ.get("XDG_CONFIG_HOME") or os.environ["HOME"] + "/.config"
    tok = sum(1 for k in os.environ if k in ("GH_TOKEN", "GITHUB_TOKEN", "GH_ENTERPRISE_TOKEN"))
    ghls = sum(
        len(ds) + len(fs)
        for g in (c["GC"], f"{cfgc}/gh")
        if os.path.isdir(g)
        for _, ds, fs in os.walk(g)
    )
    cred = 0
    for f in (os.environ["HOME"] + "/.git-credentials", f"{cfgc}/git/credentials"):
        with contextlib.suppress(OSError):
            cred += len(open(f, "rb").read())
    r = t(c["GH"], "auth", "status") if c["GH"] else 1
    check(
        tok == 0 and ghls == 0 and cred == 0 and r != 0,
        f"no gh or git creds: tokens {tok}, gh config entries {ghls}, git-credentials {cred} bytes, gh auth status exits {r}",
    )
    lin = int("LINEAR_API_KEY" in os.environ)
    check(lin == 0, f"no tracker credential: LINEAR_API_KEY set {lin} times")
    pid, pis = (
        c["PI"],
        [n for n in ("auth.json", "models.json") if os.path.lexists(f"{c['PI']}/{n}")],
    )
    if c["nopi"]:
        rd = False
        for n in ("auth.json", "models.json"):
            try:
                open(f"{pid}/{n}").read()
                rd = True
            except OSError:
                pass
        check(
            not pis and not rd,
            f"no Pi model credentials (no Pi runs here): auth.json and models.json absent from {pid}"
            + (f" (NOT: {' '.join(pis)} present)" if pis else ""),
        )
    else:
        say(
            f"ok   Pi model credentials: {' '.join(pis) or 'none on the box'}"
            + (" per-run copies on the hidden run tmpfs, never written back" if pis else "")
        )
    route = sum(
        1
        for k in (
            "OCTO_FEATHER_PARENT",
            "OCTO_FEATHER_SESSION_ID",
            "OCTO_FEATHER_ROLE",
            "OCTO_FEATHER_SPEND_SPACE",
            "HERDR_PANE_ID",
            "HERDR_TAB_ID",
            "HERDR_WORKSPACE_ID",
            "HERDR_ENV",
        )
        if k in os.environ
    )
    check(
        route == 0,
        f"parent route unset: {route} of OCTO_FEATHER_PARENT/SESSION_ID/ROLE/SPEND_SPACE, HERDR_PANE/TAB/WORKSPACE_ID, HERDR_ENV set",
    )
    msd = os.environ["MISE_STATE_DIR"]
    me = len(os.listdir(msd))
    check(
        msd == f"{SCR}/mise/state"
        and touchable(f"{msd}/.qc-w-{S}")
        and me == 0
        and subprocess.run(
            ["stat", "-f", "-c", "%T", msd], capture_output=True, text=True
        ).stdout.strip()
        == "tmpfs",
        f"mise state dir per-run: {msd} (tmpfs on the private /tmp, started empty: {me} entries; mise trust writes there and it dies with the run)",
    )
    stp = subprocess.run(
        [f"{SK}/scripts/octo-feather-state"], capture_output=True, text=True
    ).stdout.strip()
    check(stp == SB, f"state dir is per-run scratch: {stp}")
    w = os.path.isdir(f"{SB}/lanes/archive") and touchable(f"{SB}/lanes/archive/.w")
    if os.path.isfile(f"{SB}/director.handoffs.jsonl"):
        try:
            open(f"{SB}/director.handoffs.jsonl", "a").close()
            w = True
        except OSError:
            pass
    live = 0
    masks: list[str] = c["masked"]
    for m in masks:
        if os.path.isdir(m):
            live += len(os.listdir(m))
        elif os.path.isfile(m):
            with contextlib.suppress(OSError):
                live += len(open(m, "rb").read())
    got = int(os.path.isdir(f"{SB}/lanes/archive")) + int(
        os.path.isfile(f"{SB}/director.handoffs.jsonl")
    )
    nm = len(c["masked"])
    if c["hist"] == "none":
        check(
            not w and live == 0 and got == 0,
            f"history none ({got} bound: no archived lanes, no director log; a factory eval sees no lane history); live records masked ({nm} paths, {live} bytes or entries visible)",
        )
    else:
        af = sum(len(fs) for _, _, fs in os.walk(f"{SB}/lanes/archive"))
        try:
            dl = open(f"{SB}/director.handoffs.jsonl").read().count("\n")
        except OSError:
            dl = 0
        check(
            not w and live == 0 and got == c["hist"],
            f"history read-only ({got} of {c['hist']} bound: archive {af} files, director log {dl} lines); live records masked ({nm} paths, {live} bytes or entries visible)",
        )
    HM = os.path.realpath(os.environ["HOME"])
    rbad: list[str] = []
    rl: list[str] = []
    repo_masks: list[tuple[str, str]] = c["repos"]
    for r, nmn in repo_masks:
        try:
            g = "/".join(sorted(os.listdir(r)))
        except OSError as e:
            g = str(e)
        if g != nmn:
            rbad.append(f"{r} shows [{g}]")
        rel = r[len(HM) + 1 :] if r.startswith(HM + "/") else r
        rl.append(rel + (f" [{nmn.replace('/', ' ')}]" if nmn else ""))
    kept = c["kept"]
    vis = f"visible: kit under test {kept[0]}, worktree {kept[1]}" + (
        f"; bound back read-only: {', '.join(kept[2:])}" if len(kept) > len(kept[:2]) else ""
    )
    if c["repos"]:
        check(
            not rbad,
            f"other repos hidden: {len(c['repos'])} git repos under {HM} (up to 3 levels down, dot-dirs aside), each a tmpfs mask listing only what is bound back"
            + (f" (NOT: {' '.join(rbad)})" if rbad else "")
            + f": {', '.join(rl)}; {vis}",
        )
    else:
        say(
            f"ok   other repos: none under {HM} (git repos up to 3 levels down, dot-dirs aside); {vis}"
        )
    if c["robinds"]:
        check(not any(touchable(f"{p}/.w") for p in c["robinds"]), "extra binds read-only")
    offgh = f"{SK}/.agents/skills/github-pr/scripts/gh"
    snap = os.environ.get("OCTO_FEATHER_GHSNAP", "")
    if snap:
        r = subprocess.run(
            ["gh", "repo", "view", "--json", "nameWithOwner", "-q", ".nameWithOwner"],
            capture_output=True,
            text=True,
        )
        rr = (r.stdout + r.stderr).rstrip("\n")
        try:
            repo = json.load(open(f"{snap}/meta.json")).get("repo")
        except (OSError, ValueError):
            repo = None
        check(
            shutil.which("gh") == offgh and not touchable(f"{snap}/.w") and bool(rr) and rr == repo,
            f"github: {c['ghline']}; read-only, served by the offline gh ({shutil.which('gh')}), which refuses writes",
        )
    else:
        r = t("gh", "issue", "list")
        check(
            shutil.which("gh") == offgh and r == 1,
            f"{os.environ.get('OCTO_FEATHER_GHSNAP_OFF', '')}; the offline gh refuses every call (exit {r})",
        )
    br = c["browser"]
    if br:  # a browser demo: the box's headless shell, read-only; the cache dir stays masked
        sh = sorted(glob.glob(f"{br}/chromium_headless_shell-*/INSTALLATION_COMPLETE"))
        check(
            not touchable(f"{br}/.qc-ro-{S}") and bool(sh),
            f"browser: PLAYWRIGHT_BROWSERS_PATH={br} read-only, headless shell {sh[0].rsplit('/', 1)[0] if sh else ''}",
        )
    if shutil.which("mise"):  # 6b: the worktree's and the kit's mise tools installed
        check(*mise_tools(WT, kit, os.environ))
    # Go to the recorder: what the proof's own calls and reads sent before it is dropped; its answer comes once it has.
    try:
        sk.send(b'{"t": "go"}')
        go = sk.recv(16).decode()
    except OSError as e:
        go = str(e)
    check(
        go == "live",
        f"attempt record live from here (recorder answered: {go or 'nothing'}); the judge's view of it read-only: {SCR}/rec",
    )
    gs = subprocess.run(["git", "status", "--porcelain"], capture_output=True, text=True)
    hd = subprocess.run(["git", "rev-parse", "--short=12", "HEAD"], capture_output=True, text=True)
    dirty = (gs.stdout + gs.stderr + hd.stdout + hd.stderr).rstrip("\n")
    check(dirty.count("\n") == 0, f"worktree clean at {dirty}")
    if fails:
        say(f"proof failed ({fails} checks); judge not started (exit 66)")
        reap(base, HERDR, S)
        sys.exit(66)

    # 8. the judge.
    try:
        rc = subprocess.run(judge, stderr=OUT["err"]).returncode
    except OSError:
        rc = 127
    rc = 128 - rc if rc < 0 else rc

    # 9. post-run. The spend ledger's writers run detached: up to 10 s for each live `spend record` to end.
    def writer(p: str) -> bool:
        try:
            return open(f"/proc/{p}/stat").read().split(" ")[2] != "Z" and b"spend record" in open(
                f"/proc/{p}/cmdline", "rb"
            ).read().replace(b"\0", b" ")
        except OSError:
            return False

    for _ in range(100):
        if not any(writer(p) for p in os.listdir("/proc") if p.isdigit() and p not in base):
            break
        time.sleep(0.1)
    panes = 0
    if HERDR:
        panes = subprocess.run(
            [HERDR, "--session", S, "pane", "list"], capture_output=True, text=True
        ).stdout.count('"pane_id"')
    try:
        # the first pi start is the judge itself
        headless = max(0, len(open(f"{SCR}/agents.log").read().splitlines()) - 1)
    except OSError:
        headless = 0
    killed = reap(base, HERDR, S)
    left = len(nsprocs(base))
    say(
        f"cleanup: agents started {headless + panes} (headless pi {headless}, Herdr panes {panes}); leftover processes killed {len(killed)}, left {left} (the kernel kills those as PID 1 exits); session {S} stopped and deleted"
    )
    post(
        {
            "session": S,
            "agents_started": headless + panes,
            "headless_pi": headless,
            "herdr_panes": panes,
            "killed": killed,
            "left_after_kill": left,
        }
    )
    sl = f"{SB}/spend.jsonl"  # a regular file only: the judge could plant a fifo there
    post(
        {
            "spend": open(sl).read().splitlines()
            if os.path.isfile(sl) and not os.path.islink(sl)
            else []
        }
    )
    if c["shots"]:
        d: str = c["env"]["QC_SCREENSHOTS"]
        out: list[list[str]] = []
        for root, dirs, files in os.walk(d):
            dirs.sort()
            for f in sorted(files):
                p = os.path.join(root, f)
                if stat.S_ISREG(os.lstat(p).st_mode):
                    out.append(
                        [os.path.relpath(p, d), base64.b64encode(open(p, "rb").read()).decode()]
                    )
        post({"shots": out})
    sys.exit(rc)


def nsprocs(base: set[str]) -> list[str]:
    """Every live process in this PID namespace but srt's own and this one."""
    out: list[str] = []
    for p in os.listdir("/proc"):
        if p.isdigit() and p not in base:
            try:
                if open(f"/proc/{p}/stat").read().rsplit(")", 1)[1].split()[0] != "Z":
                    out.append(p)
            except OSError:
                pass
    return out


def reap(base: set[str], herdr: str, session: str) -> list[str]:
    if herdr:
        for a in (("session", "stop", session), ("session", "delete", session)):
            subprocess.run([herdr, *a], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    killed: list[str] = []
    for p in nsprocs(base):
        try:
            cl = (
                open(f"/proc/{p}/cmdline", "rb")
                .read()
                .replace(b"\0", b" ")
                .decode(errors="replace")
                .strip()
            )
        except OSError:
            continue
        if cl:
            killed.append(f"{p} {cl[:80]}")
        with contextlib.suppress(OSError):
            os.kill(int(p), 9)
    time.sleep(0.3)
    return killed


def native_client(mode: str, args: list[str]) -> None:
    """One-shot client of the SAME Recorder, never a second listener/manager."""
    names = (
        "QC_NATIVE_SECRET",
        "QC_NATIVE_SOCKET",
        "QC_NATIVE_PYTHON",
        "QC_NATIVE_COMMAND",
        "QC_FD_CANCEL",
    )
    _cancellation.fd = int(os.environ["QC_FD_CANCEL"])

    def completed() -> None:
        end, sig = cancel_stamp()
        sys.stdout.write(json.dumps({"end_ns": f"{end:020d}", "signal": sig}))

    if mode == "native-budget":
        # Exact actual Node argv, deliberately lease-free, never a fake lease.
        if args != [""]:
            sys.exit(print("qc native: invalid budget arguments", file=sys.stderr) or 64)
        completed()
        return
    if (
        (mode in ("native-control", "native-ready") and len(args) != 1)
        or (
            mode == "native-signal"
            and (len(args) != NATIVE_SIGNAL_ARITY or args[1] not in ("SIGINT", "SIGTERM"))
        )
        or (
            mode == "native-progress"
            and (
                len(args) != NATIVE_PROGRESS_ARITY
                or args[1] not in ("initialized", "payload_exit", "reset_completed")
            )
        )
        or (
            mode == "native-relay"
            and (len(args) < NATIVE_RELAY_MIN_ARITY or args[1] not in ("bridge", "payload"))
        )
    ):
        sys.exit(print("qc native: missing operation arguments", file=sys.stderr) or 64)
    lease = args[0]
    if re.fullmatch("[0-9a-f]{64}", lease) is None:
        sys.exit(print("qc native: invalid lease", file=sys.stderr) or 64)
    authority = {k: os.environ[k] for k in names}
    clean = {k: v for k, v in os.environ.items() if k not in names}
    message = {"t": "native", "secret": authority["QC_NATIVE_SECRET"], "lease": lease}
    cancel_stamp()  # no relay or control operation on an invalid/uncertain capability

    with socket.socket(socket.AF_UNIX, socket.SOCK_SEQPACKET) as peer:
        peer.settimeout(cancel_budget(8))
        peer.connect(authority["QC_NATIVE_SOCKET"])
        if mode == "native-progress":
            end = time.monotonic() + cancel_budget(5)
            while time.monotonic() < end and cancel_budget(1):
                peer.settimeout(cancel_budget(max(0, end - time.monotonic())))
                peer.send(
                    json.dumps(
                        message
                        | {"op": "progress", "phase": args[1], "result": json.loads(args[2])}
                    ).encode()
                )
                reply = peer.recv(256)
                if reply == b"recorded":
                    completed()
                    return
                if reply != b"pending":
                    failure_message = "native progress refused"
                    raise OSError(failure_message)
                time.sleep(0.01)
            failure_message = "native progress registration"
            raise TimeoutError(failure_message)
        if mode == "native-ready":
            end = time.monotonic() + cancel_budget(5)
            while time.monotonic() < end and cancel_budget(1):
                peer.settimeout(cancel_budget(max(0, end - time.monotonic())))
                peer.send(json.dumps(message | {"op": "ready"}).encode())
                reply = peer.recv(256)
                if reply == b"live":
                    completed()
                    return
                if reply != b"pending":
                    sys.exit(
                        print("qc native: exec/liveness readiness refused", file=sys.stderr) or 70
                    )
                time.sleep(0.02)
            failure_message = "native exec readiness"
            raise TimeoutError(failure_message)
        if mode in ("native-control", "native-signal"):
            operation = (
                {"op": "stop"} if mode == "native-control" else {"op": "signal", "signal": args[1]}
            )
            peer.send(json.dumps(message | operation).encode())
            expected = b"exited" if mode == "native-control" else b"signalled"
            reply = peer.recv(256)
            if reply != expected:
                sys.exit(
                    print("qc native: retained-task request incomplete", file=sys.stderr) or 71
                )
            completed()
            return
        executable = shutil.which(args[2], path=clean.get("PATH"))
        if not executable:
            sys.exit(print("qc native: native executable unavailable", file=sys.stderr) or 69)
        fd = os.pidfd_open(os.getpid())
        try:
            socket.send_fds(
                peer, [json.dumps(message | {"op": "register", "role": args[1]}).encode()], [fd]
            )
        finally:
            os.close(fd)
        if peer.recv(256) != b"registered":
            sys.exit(
                print("qc native: registration refused; native not executed", file=sys.stderr) or 70
            )
        # Python sockets are CLOEXEC. EOF alone is not successful exec evidence;
        # failed exec reports explicitly, and SDK still requires real socket readiness.
        try:
            inherit_cancel_fd = False
            os.set_inheritable(_cancellation.fd, inherit_cancel_fd)
            # Same-task exec preserves the registered kernel identity after its
            # self-pidfd ACK and CANCEL_FD CLOEXEC; not executable-origin approval.
            os.execve(executable, args[2:], clean)  # noqa: S606
        except OSError:
            with contextlib.suppress(OSError):
                peer.send(json.dumps(message | {"op": "exec-error"}).encode())
            sys.exit(print("qc native: exec failed", file=sys.stderr) or 127)


def main(a: list[str]) -> None:
    if a[:1] in (
        ["native-relay"],
        ["native-control"],
        ["native-signal"],
        ["native-ready"],
        ["native-progress"],
        ["native-budget"],
    ):
        try:
            native_client(a[0], a[1:])
        except TimeoutError:
            sys.exit(print("qc native: authenticated transport timeout", file=sys.stderr) or 75)
        except (OSError, ValueError) as error:
            sys.exit(
                print(
                    f"qc native: authenticated transport/capability failed ({type(error).__name__}: {error})",
                    file=sys.stderr,
                )
                or 74
            )
        return
    if a[:1] == ["inner"]:
        cfgp, rest = a[1], a[2:]
        inner(cfgp, rest[1:] if rest[:1] == ["--"] else rest)
    if a[:1] in (["-h"], ["--help"]):
        sys.stdout.write(__doc__ or "")
        return
    if a[:1] == ["--"]:
        a = a[1:]
    if not a:
        sys.exit(print("usage: octo-feather-qc-sandbox [--] JUDGE_CMD...", file=sys.stderr) or 64)
    _cancellation.fd = int(E["QC_FD_CANCEL"]) if E.get("QC_FD_CANCEL") else cancel_create()
    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, cancel_entry)
    try:
        setup(a)
    except Cancelled as _error:
        if _cancellation.fault is not None:
            # Rethrow the actual stored fault without overwriting its identity or cause.
            raise _cancellation.fault  # noqa: B904
        _, first_signal = cancel_stamp()
        sys.exit(128 + first_signal)


if __name__ == "__main__":
    main(sys.argv[1:])
