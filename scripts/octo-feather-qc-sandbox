# Every writable mount, by its own flags: tmpfs and /proc die with the run, the worktree overlay's
# upper dir is on the run tmpfs; anything else is persistent (Pi's auth.json and models.json are binds of run tmpfs files).
ov=$(cat "$SCR/ovupper"); wt=$(git rev-parse --show-toplevel 2>/dev/null)
mapfile -t pers < <(awk -v ov="upperdir=$ov," '
  { for (i = 7; $i != "-"; i++); fs = $(i+1); so = $(i+3) ","; mp = $5; gsub(/\\040/, " ", mp); w[mp] = ""
    if (!(("," $6 ",") ~ /,ro,/ || fs == "tmpfs" || fs == "proc" || (fs == "overlay" && index(so, ov)))) w[mp] = $1 " " mp }
  END { for (m in w) if (w[m] != "") print w[m] }' /proc/self/mountinfo)   # last mount on a path wins: covered ones are unreachable
reach=(); unreach=0   # writable but covered under another path (nested run): unreachable, counted apart
for e in "${pers[@]}"; do if covered "${e%% *}" "${e#* }"; then unreach=$((unreach + 1)); else reach+=("${e#* }"); fi; done
pers=("${reach[@]}")
ovl=$(awk -v wt="$wt" -v ov="upperdir=$ov," '{ for (i = 7; $i != "-"; i++); mp = $5; gsub(/\\040/, " ", mp) }
  mp == wt && $(i+1) == "overlay" && index($(i+3) ",", ov) { n++ } END { print n + 0 }' /proc/self/mountinfo)
check "$(t test "$ovl" -ge 1 -a ! -e "$ov")" "worktree $wt is an overlay, upper dir on the run tmpfs and hidden from the judge"
check "$(t test "${#pers[@]}" = 0)" "writable persistent paths: ${pers[*]:-none}"
((unreach == 0)) || say "ok   $unreach writable mounts covered by later ones, unreachable by any path (an outer sandbox's, in a nested run)"
vc=$(cat "$SCR/vcache")
