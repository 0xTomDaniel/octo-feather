  w=0; touch "$OCTO_FEATHER_GHSNAP/.w" 2>/dev/null && w=1
  r=$(gh repo view --json nameWithOwner -q .nameWithOwner 2>&1)
  check "$(t test "$(command -v gh)" = "$offgh" -a "$w" = 0 -a -n "$r" -a "$r" = "$(jq -r .repo "$OCTO_FEATHER_GHSNAP/meta.json")")" \
    "github: $GHLINE; read-only, served by the offline gh ($(command -v gh)), which refuses writes"
else
  r=$(t gh issue list)
  check "$(t test "$(command -v gh)" = "$offgh" -a "$r" = 1)" "$OCTO_FEATHER_GHSNAP_OFF; the offline gh refuses every call (exit $r)"
fi
# Go to the recorder: what the proof's own calls and reads sent before it is dropped; its answer comes once it has.
go=$(python3 -c 'import socket, sys
c = socket.socket(socket.AF_UNIX, socket.SOCK_SEQPACKET); c.connect(sys.argv[1]); c.send(b"{\"t\": \"go\"}"); print(c.recv(16).decode())' "$SCR/rec/sock" 2>&1)
check "$(t test "$go" = live)" "attempt record live from here (recorder answered: ${go:-nothing}); the judge's view of it read-only: $SCR/rec"
dirty=$(git status --porcelain 2>&1 && git rev-parse --short=12 HEAD); check "$(t test "$(wc -l <<< "$dirty")" = 1)" "worktree clean at $dirty"
((fails == 0)) || { say "proof failed ($fails checks); judge not started (exit 66)"; reap; exit 66; }

# 8. the judge.
"$@" 2>&6 4>&- 5>&- 6>&-; rc=$?

# 9. post-run cleanup. The spend ledger's writers run detached: the kill below would lose their lines.
python3 - <<'EOF'
# Up to 10 s for every live `spend record` in this PID namespace (but PID 1, this shell, and itself) to end.
import os, time
def writer(p):
    try:
        if open(f"/proc/{p}/stat").read().split(" ")[2] == "Z":
            return False
        return b"spend record" in open(f"/proc/{p}/cmdline", "rb").read().replace(b"\0", b" ")
    except OSError:
        return False
for _ in range(100):
    if not any(writer(p) for p in os.listdir("/proc") if p.isdigit() and p not in ("1", str(os.getpid()))):
        break
    time.sleep(0.1)
EOF
panes=0
[[ -n "$HERDR" ]] && panes=$("$HERDR" --session "$S" pane list 2>/dev/null | grep -o '"pane_id"' | wc -l)
headless=$(( $(wc -l < "$SCR/agents.log" 2>/dev/null || echo 0) ))
((headless > 0)) && headless=$((headless - 1))   # the first pi start is the judge itself
reap
left=$(nsprocs); left=$(wc -w <<< "$left")
say "cleanup: agents started $((headless + panes)) (headless pi $headless, Herdr panes $panes); leftover processes killed ${#killed[@]}, left $left (the kernel kills those as PID 1 exits); session $S stopped and deleted"
python3 - "$headless" "$panes" "$left" "$S" "${killed[@]}" >&5 <<'EOF'
import json, sys
a = sys.argv
print(json.dumps({"session": a[4], "agents_started": int(a[1]) + int(a[2]), "headless_pi": int(a[1]), "herdr_panes": int(a[2]),
                  "killed": a[5:], "left_after_kill": int(a[3])}))
EOF
exit "$rc"
