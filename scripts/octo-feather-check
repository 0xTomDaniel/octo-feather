#!/usr/bin/env python3
"""Run a gate as timed steps, one after another, and record each run (issue #201, #204).

Usage: octo-feather-check [--step STEP | --glob PATTERN]...

Steps run in the order given. A STEP holding a `/` is an executable file run
directly (tests/x.sh); any other STEP is a recipe of the repo's justfile, run as
`just STEP`. --glob PATTERN adds every file PATTERN matches (sorted) as file
steps, in its place. Nothing here names a repo's steps: the justfile's check
recipe passes them, so the same command serves the kit and any target repo.

Each step's output passes through as it runs. The run stops at the first
failing step, whose exit status becomes the run's. It then prints a fixed
summary: one line per step run, wall seconds and ok or FAIL, slowest first,
then the total. Timing is reported only; it never changes the exit status.

Each run appends one JSON line to check-runs.jsonl in the state dir: the
output of `octo-feather-state` when that command is on PATH, else
${XDG_STATE_HOME:-~/.local/state}/octo-feather. Fields: start (UTC), repo
(git top level of the working dir), head, total_s, exit, steps (name, seconds,
result), not_run (steps never started). A state dir that cannot be written is a
warning on stderr, never a failure.

Steps see TMPDIR as its real path (macOS: mktemp paths under the /var symlink
would not match the pwd -P paths tests compare them with). Stdlib only.
"""
import argparse, datetime, glob, json, os, shutil, subprocess, sys, time

TREND = "check-runs.jsonl"


def parse(argv):
    p = argparse.ArgumentParser(prog="octo-feather-check", description="Run gate steps one after another, timed; "
                                "print a summary and append one JSON line to the state dir's " + TREND + ".")
    p.add_argument("--step", dest="items", action="append", type=lambda s: ("step", s), metavar="STEP",
                   help="a justfile recipe, or an executable file when it holds a /")
    p.add_argument("--glob", dest="items", action="append", type=lambda s: ("glob", s), metavar="PATTERN",
                   help="every file PATTERN matches, sorted, each a step")
    a = p.parse_args(argv)
    steps = []
    for kind, v in a.items or []:
        if kind == "step":
            steps.append(v)
        else:
            hits = sorted(glob.glob(v))
            if not hits:
                p.error(f"--glob {v} matches no file")
            steps += [h if "/" in h else "./" + h for h in hits]
    if not steps:
        p.error("no steps: give --step or --glob")
    return steps


def git(*args):
    r = subprocess.run(["git", *args], capture_output=True, text=True)
    return (r.stdout.strip() or None) if r.returncode == 0 else None


def state_dir():
    if shutil.which("octo-feather-state"):
        r = subprocess.run(["octo-feather-state"], capture_output=True, text=True)
        if r.returncode == 0 and r.stdout.strip():
            return r.stdout.strip()
    base = os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state")
    return os.path.join(base, "octo-feather")


def record(entry):
    try:
        d = state_dir()
        os.makedirs(d, exist_ok=True)
        with open(os.path.join(d, TREND), "a") as f:
            f.write(json.dumps(entry, separators=(",", ":")) + "\n")
    except OSError as e:
        print(f"octo-feather-check: warning: trend line not written ({e}); the verdict stands", file=sys.stderr)


def main():
    steps = parse(sys.argv[1:])
    env = dict(os.environ, TMPDIR=os.path.realpath(os.environ.get("TMPDIR") or "/tmp"))
    start = datetime.datetime.now(datetime.timezone.utc)
    t0 = time.monotonic()
    parent = os.getppid()
    done, status = [], 0
    for i, step in enumerate(steps):
        cmd = [step] if "/" in step else ["just", step]
        sys.stdout.flush(); sys.stderr.flush()
        s0 = time.monotonic()
        try:
            rc = subprocess.run(cmd, env=env).returncode
        except OSError as e:
            print(f"octo-feather-check: {step}: {e}", file=sys.stderr)
            rc = 127
        except KeyboardInterrupt:
            rc = 130
        rc = 128 - rc if rc < 0 else rc   # killed by a signal: the shell's 128+N
        done.append({"name": step, "seconds": round(time.monotonic() - s0, 3), "result": "ok" if rc == 0 else "FAIL"})
        if rc != 0:
            status = rc
            break
        if os.getppid() != parent:   # the caller (a just stopped by a refusal) is gone: stop here, failed
            print("octo-feather-check: the calling process exited; stopping", file=sys.stderr)
            status = 1
            break
    total = round(time.monotonic() - t0, 3)
    not_run = steps[len(done):]
    print("octo-feather-check: step times, slowest first")
    for s in sorted(done, key=lambda s: -s["seconds"]):
        print(f"{s['seconds']:9.1f}s  {s['result']:<4}  {s['name']}")
    if not_run:
        print(f"{'':10}  {'-':<4}  {len(not_run)} steps not run (stopped at the first failure)")
    print(f"{total:9.1f}s  {'ok' if status == 0 else 'FAIL':<4}  total ({len(done)} of {len(steps)} steps, exit {status})")
    sys.stdout.flush()
    record({"start": start.strftime("%Y-%m-%dT%H:%M:%SZ"), "repo": git("rev-parse", "--show-toplevel") or os.getcwd(),
            "head": git("rev-parse", "HEAD"), "total_s": total, "exit": status, "steps": done, "not_run": not_run})
    return status


if __name__ == "__main__":
    sys.exit(main())
