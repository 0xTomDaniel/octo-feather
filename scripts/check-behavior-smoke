#!/usr/bin/env python3
"""A role-behaviour change on a branch ships with its smoke and owed eval (rule: docs/adr/0008).

Correction lane #26 (finding class missing-behavior-smoke). A presence gate,
read-only git only: whether the smoke is adequate is review's judgment.

- Range: merge-base(BASE, HEAD)..HEAD.
- Role paths: files the range diff changes under agents/*.md, .agents/skills/**.md,
  .skillfile/patches/**.
- Opt-out: a role path is exempt when every non-merge commit in the range touching it
  carries a non-empty `Behaviour-neutral: <reason>` trailer (at least one such commit).
  Each opt-out is printed on every run.
- Any other role path: the range diff must add or modify an evidence/*.md and change
  docs/future.md, else exit 1 naming the fix.

Base: --base REF, else $OCTO_FEATHER_BASE, else origin/$GITHUB_BASE_REF (CI pull
request), else origin/main, else main. No resolvable base or merge base: skip with a
note locally, fail in CI ($CI or $GITHUB_ACTIONS set; checkout needs fetch-depth: 0).

Usage: check-behavior-smoke [--base REF] [--head REF] [--repo DIR]
Run by `just check`, tested by tests/check-behavior-smoke.sh.
"""
import argparse, os, re, subprocess, sys

ROLE = re.compile(r"^(agents/[^/]+\.md|\.agents/skills/.+\.md|\.skillfile/patches/.+)$")
EVIDENCE = re.compile(r"^evidence/[^/]+\.md$")
FUTURE = "docs/future.md"
TRAILER = re.compile(r"^Behaviour-neutral:[ \t]*(\S.*)$", re.M)
TAG = "check-behavior-smoke"

ap = argparse.ArgumentParser()
ap.add_argument("--base"); ap.add_argument("--head", default="HEAD"); ap.add_argument("--repo")
a = ap.parse_args()
root = os.path.abspath(a.repo or os.path.join(os.path.dirname(__file__), ".."))
ci = bool(os.environ.get("CI") or os.environ.get("GITHUB_ACTIONS"))


def git(*args):
    r = subprocess.run(["git", "-C", root, *args], capture_output=True, text=True)
    return r.stdout if r.returncode == 0 else None


def no_base(why):
    if ci:
        sys.exit(f"{TAG}: {why}; CI needs the PR base: actions/checkout with fetch-depth: 0 (.github/workflows/check.yml)")
    print(f"behavior smoke: skipped, {why} (CI checks it against the PR base; locally: git fetch origin main, or --base REF)")
    sys.exit(0)


def commit(ref):
    out = git("rev-parse", "--verify", "-q", f"{ref}^{{commit}}")
    return out.strip() if out else None


head = commit(a.head) or no_base(f"no commit {a.head}")
if a.base:
    cands = [a.base]
elif os.environ.get("OCTO_FEATHER_BASE"):
    cands = [os.environ["OCTO_FEATHER_BASE"]]
else:
    cands = ([f"origin/{os.environ['GITHUB_BASE_REF']}"] if os.environ.get("GITHUB_BASE_REF") else []) + ["origin/main", "main"]
    cands = list(dict.fromkeys(cands))
base = next((c for c in cands if commit(c)), None) or no_base(f"no base ref ({', '.join(cands)})")
mb = (git("merge-base", base, head) or "").strip() or no_base(f"no merge base of {base} and {a.head} (shallow clone?)")
rng = f"{mb}..{head}"

changed = git("diff", "--name-only", mb, head).split()
roles = [f for f in changed if ROLE.match(f)]
if not roles:
    print(f"behavior smoke: ok (no role path changed since {mb[:7]})")
    sys.exit(0)

# One pass over the range's non-merge commits: sha, message trailer, files.
log = git("log", "--no-merges", "--name-only", "--format=%x00%H%x01%B%x01", rng)
touching = {f: [] for f in roles}  # role path -> [(sha, reason or None)]
for rec in log.split("\0")[1:]:
    sha, body, files = rec.split("\x01", 2)
    m = TRAILER.search(body)
    for f in files.split():
        if f in touching:
            touching[f].append((sha, m.group(1).strip() if m else None))

exempt = sorted(f for f, cs in touching.items() if cs and all(r for _, r in cs))
seen = set()
for f in exempt:
    for sha, why in touching[f]:
        if sha not in seen:
            seen.add(sha)
            print(f"behavior smoke: opt-out {sha[:7]} Behaviour-neutral: {why}")
need = [f for f in roles if f not in exempt]
if not need:
    print(f"behavior smoke: ok ({len(roles)} role paths, all opted out)")
    sys.exit(0)

evidence = [f for f in git("diff", "--name-only", "--diff-filter=AM", mb, head).split() if EVIDENCE.match(f)]
owed = FUTURE in changed
if evidence and owed:
    print(f"behavior smoke: ok ({len(need)} role paths, evidence {', '.join(evidence)}, {FUTURE} changed"
          f"{f', {len(exempt)} opted out' if exempt else ''})")
    sys.exit(0)

print(f"{TAG}: role paths changed since {mb[:7]} with no smoke or owed eval in the same diff "
      f"(#26 missing-behavior-smoke; rule: docs/adr/0008):", file=sys.stderr)
for f in need:
    plain = [s[:7] for s, r in touching[f] if not r]
    print(f"  {f}" + (f" ({', '.join(plain)} without Behaviour-neutral)" if plain else " (changed only in a merge)"), file=sys.stderr)
print(f"  missing: {' and '.join(x for x, ok in (('an added or modified evidence/*.md', evidence), (f'a {FUTURE} change', owed)) if not ok)}.",
      file=sys.stderr)
print(f"Fix: record the live smoke in evidence/<date>-<slug>.md and its owed eval in {FUTURE} on this branch (docs/adr/0008). "
      f"A behaviour-neutral commit (path repair, pointer-only rewrite) instead carries the trailer "
      f"`Behaviour-neutral: <reason>` (git rebase -i, reword); the supervisor lists each opt-out in the merge ask.", file=sys.stderr)
sys.exit(1)
