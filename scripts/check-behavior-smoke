#!/usr/bin/env python3
"""A role-behaviour change on a branch ships with its smoke and owed eval (rule: docs/adr/0008).

Correction lane #26 (finding class missing-behavior-smoke). A presence gate,
read-only git only: whether the smoke is adequate is review's judgment.

- Range: merge-base(BASE, HEAD)..HEAD.
- Role paths: files the range diff changes under agents/*.md, .agents/skills/**.md,
  .skillfile/patches/** (a rename counts as its old path deleted, #121 N5; names read
  NUL-separated, so spaces and non-ASCII hold, N6).
- Opt-out: a role path is exempt when every non-merge commit in the range touching it
  carries a non-empty `Behaviour-neutral: <reason>` trailer (at least one such commit).
  Each opt-out is printed on every run.
- Any other role path: the range diff must add or modify an evidence/*.md and a
  docs/owed-evals/*.md (one file per issue, #80), else exit 1 naming the fix.
- Pruning habit (#67): when such a path is agents/*.md or under .skillfile/patches/, one
  of those evidence files must also hold a `Removed: <text>` line (what the change
  deleted, or the incident that justifies it). A fact, never its meaning.
- Per-path smoke (#93): every such path is named on a `Smoke: <path> ...` line of one of
  those evidence files (a token equal to the path, or a token ending in `/` that is its
  directory prefix, matched literally so a path may hold spaces; bounded by line start,
  whitespace, a backtick, comma or semicolon, and ended by whitespace or the line end after
  an optional backtick, a comma or semicolon, or `.:!?` that ends a sentence). One evidence file no longer covers
  every path: lanes gh71 (director.md, evidence ran only the corrector) and gh67
  (implementer.md, corrector.md, no run at all) passed with an unrelated smoke file.
  Whether the named run exercised the path stays with review.

Base: --base REF, else $OCTO_FEATHER_BASE, else origin/$GITHUB_BASE_REF (CI pull
request), else origin/main, else main. No resolvable base or merge base: skip with a
note locally, fail in CI ($CI or $GITHUB_ACTIONS set; checkout needs fetch-depth: 0).

Usage: check-behavior-smoke [--base REF] [--head REF] [--repo DIR]
Run by `just check`, tested by tests/check-behavior-smoke.sh.
"""
import argparse, os, re, subprocess, sys

ROLE = re.compile(r"^(agents/[^/]+\.md|\.agents/skills/.+\.md|\.skillfile/patches/.+)$")
EVIDENCE = re.compile(r"^evidence/[^/]+\.md$")
OWED = re.compile(r"^docs/owed-evals/[^/]+\.md$")
OWED_FIX = "docs/owed-evals/<issue>.md"
TRAILER = re.compile(r"^Behaviour-neutral:[ \t]*(\S.*)$", re.M)
PRUNE = re.compile(r"^(agents/[^/]+\.md|\.skillfile/patches/.+)$")
REMOVED = re.compile(r"^Removed:[ \t]*\S", re.M)
SMOKE = re.compile(r"^Smoke:[ \t]*(.*)$", re.M)
TAG = "check-behavior-smoke"

ap = argparse.ArgumentParser()
ap.add_argument("--base"); ap.add_argument("--head", default="HEAD"); ap.add_argument("--repo")
a = ap.parse_args()
root = os.path.abspath(a.repo or os.path.join(os.path.dirname(__file__), ".."))
ci = bool(os.environ.get("CI") or os.environ.get("GITHUB_ACTIONS"))


def git(*args):
    r = subprocess.run(["git", "-C", root, *args], capture_output=True, encoding="utf-8", errors="surrogateescape")
    return r.stdout if r.returncode == 0 else None


def no_base(why):
    if ci:
        sys.exit(f"{TAG}: {why}; CI needs the PR base: actions/checkout with fetch-depth: 0 (.github/workflows/check.yml)")
    print(f"behavior smoke: skipped, {why} (CI checks it against the PR base; locally: git fetch origin main, or --base REF)")
    sys.exit(0)


def commit(ref):
    out = git("rev-parse", "--verify", "-q", f"{ref}^{{commit}}")
    return out.strip() if out else None


head = commit(a.head) or no_base(f"no commit {a.head}")
if a.base:
    cands = [a.base]
elif os.environ.get("OCTO_FEATHER_BASE"):
    cands = [os.environ["OCTO_FEATHER_BASE"]]
else:
    cands = ([f"origin/{os.environ['GITHUB_BASE_REF']}"] if os.environ.get("GITHUB_BASE_REF") else []) + ["origin/main", "main"]
    cands = list(dict.fromkeys(cands))
base = next((c for c in cands if commit(c)), None) or no_base(f"no base ref ({', '.join(cands)})")
mb = (git("merge-base", base, head) or "").strip() or no_base(f"no merge base of {base} and {a.head} (shallow clone?)")
rng = f"{mb}..{head}"

changed = [f for f in git("diff", "--name-only", "--no-renames", "-z", mb, head).split("\0") if f]
roles = [f for f in changed if ROLE.match(f)]
if not roles:
    print(f"behavior smoke: ok (no role path changed since {mb[:7]})")
    sys.exit(0)

# One pass over the range's non-merge commits: sha, message trailer, files.
log = git("log", "--no-merges", "--no-renames", "-z", "--name-only", "--format=%x02%H%x01%B%x01", rng)
touching = {f: [] for f in roles}  # role path -> [(sha, reason or None)]
for rec in log.split("\x02")[1:]:
    sha, body, files = rec.split("\x01", 2)
    m = TRAILER.search(body)
    for f in files.partition("\0\n")[2].split("\0"):
        if f in touching:
            touching[f].append((sha, m.group(1).strip() if m else None))

exempt = sorted(f for f, cs in touching.items() if cs and all(r for _, r in cs))
seen = set()
for f in exempt:
    for sha, why in touching[f]:
        if sha not in seen:
            seen.add(sha)
            print(f"behavior smoke: opt-out {sha[:7]} Behaviour-neutral: {why}")
need = [f for f in roles if f not in exempt]
if not need:
    print(f"behavior smoke: ok ({len(roles)} role paths, all opted out)")
    sys.exit(0)

am = [f for f in git("diff", "--name-only", "--no-renames", "-z", "--diff-filter=AM", mb, head).split("\0") if f]
evidence = [f for f in am if EVIDENCE.match(f)]
owed = [f for f in am if OWED.match(f)]
pruned = [f for f in need if PRUNE.match(f)]
texts = {f: git("show", f"{head}:{f}") or "" for f in evidence}
removed = not pruned or any(REMOVED.search(t) for t in texts.values())
lines = [line for t in texts.values() for line in SMOKE.findall(t)]


def named(p):  # p literally, as a whole token: a path may hold spaces; a sentence may end after it (#121 N7)
    return re.compile(r"(?:^|(?<=[\s`,;]))" + re.escape(p) + r"`?(?:[,;]|[.:!?]*`?(?=\s|$))")


unsmoked = [f for f in need if not any(named(p).search(line) for p in [f] + [f[:i + 1] for i, c in enumerate(f) if c == "/"]
                                       for line in lines)]
if evidence and owed and removed and not unsmoked:
    print(f"behavior smoke: ok ({len(need)} role paths, evidence {', '.join(evidence)}, owed evals {', '.join(owed)}"
          f"{f', {len(exempt)} opted out' if exempt else ''})")
    sys.exit(0)

if evidence and owed:
    if not removed:
        print(f"{TAG}: role or patch paths changed since {mb[:7]} and no evidence file says what they removed "
              f"(#67 pruning habit; rule: docs/adr/0008): {', '.join(pruned)}", file=sys.stderr)
        print(f"Fix: add a line `Removed: <what this change deleted, or the incident that justifies it>` "
              f"to {' or '.join(evidence)} (docs/adr/0008).", file=sys.stderr)
    if unsmoked:
        print(f"{TAG}: role paths changed since {mb[:7]} that no evidence file names on a `Smoke:` line "
              f"(#93 missing-behavior-smoke: a smoke of one role does not cover another; rule: docs/adr/0008):", file=sys.stderr)
        for f in unsmoked:
            print(f"  {f}", file=sys.stderr)
        print(f"Fix: run a live smoke that exercises each path above and record it in evidence/<date>-<slug>.md "
              f"with a line `Smoke: <path> ...` naming the paths that run exercised "
              f"(a directory like `.agents/skills/<name>/` covers the files under it). "
              f"Name only paths the recorded run loaded; a path no run exercised needs its own run, "
              f"or the trailer `Behaviour-neutral: <reason>` when it changes no behaviour (docs/adr/0008).", file=sys.stderr)
    sys.exit(1)
print(f"{TAG}: role paths changed since {mb[:7]} with no smoke or owed eval in the same diff "
      f"(#26 missing-behavior-smoke; rule: docs/adr/0008):", file=sys.stderr)
for f in need:
    plain = [s[:7] for s, r in touching[f] if not r]
    print(f"  {f}" + (f" ({', '.join(plain)} without Behaviour-neutral)" if plain else " (changed only in a merge)"), file=sys.stderr)
print(f"  missing: {' and '.join(x for x, ok in (('an added or modified evidence/*.md', evidence), (f'an added or modified {OWED_FIX}', owed)) if not ok)}.",
      file=sys.stderr)
print(f"Fix: record the live smoke in evidence/<date>-<slug>.md with a `Smoke: <path> ...` line naming each path it ran"
      f"{' and a `Removed: <what it deleted, or the incident>` line' if pruned else ''}"
      f" and its owed eval in {OWED_FIX} on this branch (docs/adr/0008). "
      f"A behaviour-neutral commit (path repair, pointer-only rewrite) instead carries the trailer "
      f"`Behaviour-neutral: <reason>` (git rebase -i, reword); the supervisor lists each opt-out in the merge ask.", file=sys.stderr)
sys.exit(1)
