#!/usr/bin/env python3
"""Pi itself, not a parse of ours, answers for every skill (skills spec #loading-refuse, #558):
every .agents/skills/*/SKILL.md loads in Pi with a non-empty name in its frontmatter, as Pi's own
parser reads it (skills spec #acceptance-skill-frontmatter), and every role in agents/*.md, launched
as `pi-role --json` hands it to Pi, gets each skill it lists (#acceptance-only-listed). Both ask
through the extension every launch loads (extensions/skills-loaded.ts), with Pi in RPC mode: no
model call, no network, a private home. Also: the five role contracts exist; every tracker skill
the kit has (scripts/pi-role's TRACKERS) holds each tracker script as an executable in its
scripts/ (skills spec #acceptance-tracker-scripts).

Stdlib only. Fails closed: an unreadable skill, a Pi that gives no answer or an internal error fails
the gate, never reads as ok. Run by `just check`.
"""
import glob, importlib.machinery, importlib.util, json, os, shutil, subprocess, sys, tempfile
from types import ModuleType
from pathlib import Path
from typing import Any

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
ROLES = ["director", "supervisor", "implementer", "code-reviewer", "corrector"]
# Spec skills#tracker-scripts: the same names in every tracker skill.
TRACKER_SCRIPTS = ("lane-key", "key-from-branch", "issue-view", "issue-create", "issue-comment", "issue-done", "pr-line")


def pi_role():
    loader = importlib.machinery.SourceFileLoader("pi_role", os.path.join(ROOT, "scripts", "pi-role"))
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader("pi_role", loader))
    loader.exec_module(mod)
    return mod


def tracker_problems():
    """(skill, problem) for each tracker script a tracker skill the kit has lacks; the default tracker must exist."""
    pr = pi_role()
    root = os.path.join(ROOT, ".agents", "skills")
    have = pr.kit_trackers(root)
    out = []
    if pr.DEFAULT_TRACKER not in have:
        out.append((pr.TRACKERS[pr.DEFAULT_TRACKER], f"default tracker {pr.DEFAULT_TRACKER} has no skill"))
    for t in have:
        skill = pr.TRACKERS[t]
        for s in TRACKER_SCRIPTS:
            p = os.path.join(root, skill, "scripts", s)
            if not os.path.isfile(p):
                out.append((skill, f"missing tracker script {s} (.agents/skills/{skill}/scripts/{s})"))
            elif not os.access(p, os.X_OK):
                out.append((skill, f"tracker script {s} is not executable (chmod +x .agents/skills/{skill}/scripts/{s})"))
    return out, have


# Pi as a launch runs it, minus everything that is not skills: RPC mode with no prompt (no model call), no network,
# no session, discovered extension, context file, template or theme; only the --skill folders and the launch's
# skills-loaded extension with its request.
PI_FLAGS = ("--mode", "rpc", "--offline", "--no-session", "--no-extensions", "--no-context-files",
            "--no-prompt-templates", "--no-themes", "--no-skills")


def private_env(tmp: Path) -> dict[str, str]:
    """The caller's PATH (the `pi` pi-role execs) and a private home, agent dir and caches under tmp."""
    env = {"PATH": os.environ.get("PATH", ""), "TMPDIR": str(tmp), "PI_OFFLINE": "1", "PI_SKIP_VERSION_CHECK": "1", "PI_TELEMETRY": "0"}
    for k in ("HOME", "PI_CODING_AGENT_DIR", "XDG_CACHE_HOME", "XDG_STATE_HOME", "XDG_CONFIG_HOME"):
        d = tmp / k.lower()
        d.mkdir(parents=True, exist_ok=True)
        env[k] = str(d)
    return env


def ask_pi(pi: str, pr: ModuleType, dirs: list[str], tmp: Path) -> list[dict[str, Any]]:
    """The skills-loaded extension's problems ({skill, path, reason, loaded}) for one Pi run handed every folder in
    dirs, named required: Pi's answer for each folder."""
    report = tmp / "report.json"
    request = json.dumps({"listed": dirs, "named": True, "report": str(report)})
    args = [a for d in dirs for a in ("--skill", d)]
    args += ["--extension", str(Path(ROOT, "extensions", pr.SKILLS_EXTENSION)), pr.SKILLS_FLAG, request]
    r = subprocess.run([pi, *PI_FLAGS, *args], input="", capture_output=True, text=True,
                       cwd=tmp, env=private_env(tmp), timeout=120, check=False)
    if not report.is_file():
        raise RuntimeError(f"pi gave no skills report (exit {r.returncode}): {r.stderr.strip()[-500:]}")
    problems: list[dict[str, Any]] = json.loads(report.read_text(encoding="utf-8"))
    return problems


def launch_skills(pr: ModuleType, role: str, tmp: Path) -> tuple[list[str], str]:
    """The skill folders the role's launch hands Pi (the listed of its --octo-feather-skills-loaded request), `pi-role --json` run
    outside any repo (default tracker); or pi-role's error."""
    r = subprocess.run([str(Path(ROOT, "scripts", "pi-role")), "--json", str(Path(ROOT, "agents", f"{role}.md"))],
                       capture_output=True, text=True, cwd=tmp, env=private_env(tmp), timeout=60, check=False)
    if r.returncode != 0:
        return [], r.stderr.strip() or f"exit {r.returncode}"
    args: list[str] = json.loads(r.stdout)["args"]
    if pr.SKILLS_FLAG not in args:
        return [], f"its launch has no {pr.SKILLS_FLAG}"
    listed: list[str] = json.loads(args[args.index(pr.SKILLS_FLAG) + 1])["listed"]
    return listed, ""


def pi_problems(dirs: list[Path], pr: ModuleType) -> tuple[list[str], int]:
    """Messages for each kit skill Pi does not load or that has no name, and each role skill Pi would not load;
    the role count.

    One Pi process answers for every folder: the kit's skills and every folder a role's launch hands Pi. Pi loads a
    skill folder on its own (only a name collision ties two, and a collision among a role's folders is one among all
    of them), so a folder loaded here loads in each role's launch, and one not loaded carries Pi's reason."""
    pi = shutil.which("pi")
    if not pi:
        return ["check-skills: pi not on PATH; the check asks Pi which skills it loads (install the pin in pi-version)"], 0
    root = Path(ROOT)
    roles = sorted(p.stem for p in root.glob("agents/*.md"))
    out: list[str] = []
    with tempfile.TemporaryDirectory() as t:
        tmp = Path(t)
        handed: dict[str, list[str]] = {}
        for role in roles:
            listed, err = launch_skills(pr, role, tmp)
            if err:
                out.append(f"check-skills: role {role}: pi-role --json failed: {err}")
            handed[role] = [str(Path(d).resolve()) for d in listed]
        every = list(dict.fromkeys([str(d) for d in dirs] + [d for ds in handed.values() for d in ds]))
        problems = {str(Path(p["path"]).parent.resolve()): p for p in ask_pi(pi, pr, every, tmp)}
    kit = {str(d) for d in dirs}
    for d, p in problems.items():
        if d in kit:
            rel = Path(p["path"]).resolve().relative_to(root.resolve())
            out.append(f"check-skills: {rel}: {p['reason']}" if p["loaded"] else f"check-skills: {rel}: Pi does not load it: {p['reason']}")
    for role in roles:
        out += [f"check-skills: role {role} (agents/{role}.md): Pi does not offer its skill {problems[d]['skill']} "
                f"({problems[d]['path']}): {problems[d]['reason']}" for d in handed[role] if d in problems and not problems[d]["loaded"]]
    return out, len(roles)


def main():
    os.chdir(ROOT)
    bad = 0
    dirs: list[Path] = []
    for path in sorted(glob.glob(".agents/skills/*/SKILL.md")):
        try:
            with open(path, encoding="utf-8") as fh:
                fh.read()
        except (OSError, UnicodeDecodeError) as e:
            print(f"check-skills: {path}: cannot read: {e}", file=sys.stderr)
            bad += 1
            continue
        dirs.append(Path(path).parent.resolve())
    if not dirs and not bad:
        print("check-skills: no .agents/skills/*/SKILL.md found", file=sys.stderr)
        return 1
    for r in ROLES:
        if not os.path.isfile(f"agents/{r}.md"):
            print(f"check-skills: missing role contract agents/{r}.md", file=sys.stderr)
            bad += 1
    found, trackers = tracker_problems()
    for skill, p in found:
        print(f"check-skills: tracker skill {skill}: {p}; every tracker skill holds {', '.join(TRACKER_SCRIPTS)} (skills spec #tracker-scripts)", file=sys.stderr)
        bad += 1
    said, n_roles = pi_problems(dirs, pi_role())
    for p in said:
        print(p, file=sys.stderr)
    if bad or said:
        return 1
    print(f"skills: ok ({len(dirs)} skills, {len(ROLES)} roles, Pi loads each skill and offers {n_roles} role files their listed skills, "
          f"trackers {', '.join(trackers)})")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as e:  # fail closed: an internal error is never ok
        print(f"check-skills: error: {type(e).__name__}: {e}", file=sys.stderr)
        sys.exit(2)
