#!/usr/bin/env python3
"""Kit tests drive scripts through their public surface, never load one as a module (AGENTS.md Rules, docs/adr/0002).

Correction lane #104 (finding classes internal-test-coupling, internal-test-surface). A syntax gate:
in tests/*.sh, a Python module loader (importlib, runpy, exec_module, SourceFileLoader, __import__,
exec(open(...))) or a shell `source`/`.` statement fails, naming the line and the fix. Kit scripts are
commands, so loading one reaches its private helpers: tests/accepted.sh did it twice (#96, review-serve.py
_spec_page and session_state) and a rename of either would have turned the gate red.

Reading a script's or the justfile's source as text (#38: a sed on a private perl statement; #40: a
constant parsed out of octo-feather-qc-ghsnap) is not decided here: it has the same shape as a test
feeding a justfile to the command that reads it (tests/check-gate-free.sh), so it is AGENTS.md prose and
review's call (docs/adr/0008).

Comment lines are skipped. Usage: check-test-surface [--repo DIR] [FILE...]; no FILE: DIR/tests/*.sh.
Run by `just check` (check-tests), tested by tests/check-test-surface.sh.
"""
import argparse, glob, os, re, sys

LOAD = re.compile(r"\b(importlib|runpy|exec_module|SourceFileLoader)\b|\b__import__\s*\(|\bexec\s*\(\s*open\s*\(")
SOURCE = re.compile(r"(^|;|&&|\|\||\bthen\b|\bdo\b|\{)\s*(source|\.)\s+[^\s=]")
FIX = ("test it through its public surface: run the script as a command or server and assert on its output, "
       "exit, files or HTTP answer (AGENTS.md Rules, docs/adr/0002); e.g. tests/accepted.sh reads review-serve's "
       "served version from the ETag of a running review-serve.py, not its _spec_page()")

ap = argparse.ArgumentParser()
ap.add_argument("--repo"); ap.add_argument("files", nargs="*")
a = ap.parse_args()
root = os.path.abspath(a.repo or os.path.join(os.path.dirname(__file__), ".."))
files = a.files or sorted(glob.glob(os.path.join(root, "tests", "*.sh")))
bad = 0
for path in files:
    try:
        lines = open(path, encoding="utf-8").read().splitlines()
    except OSError as e:
        print(f"check-test-surface: cannot read {path}: {e}", file=sys.stderr); sys.exit(2)
    shown = os.path.relpath(path, root) if os.path.abspath(path).startswith(root + os.sep) else path
    for n, line in enumerate(lines, 1):
        if line.lstrip().startswith("#"):
            continue
        m = LOAD.search(line) or SOURCE.search(line)
        if m:
            what = m.group(0).strip(" ;&|{")
            print(f"{shown}:{n}: loads code as a module ({what}); {FIX}", file=sys.stderr); bad = 1
if bad:
    sys.exit(1)
print(f"test surface: ok ({len(files)} test files load no script as a module)")
