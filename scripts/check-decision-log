#!/usr/bin/env python3
"""check-decision-log: the decision-log rule over the kit's tracked files; `just check` runs it.

The rule: check_decision_logs in scripts/decision_log.py, imported by name (Python puts this
script's own directory, symlinks resolved, first on sys.path; never a load by file path). It needs
the kit's locked jsonschema: missing, this command re-execs itself once under `uv run --locked
--offline` in the kit's environment. This command lists the files (`git ls-files -z`), prints the
Report's lines, each to its stream, and exits with its code: 0 ok, 1 a bad or unreadable log, 2 an
unusable schema, node, git or an internal error (fails closed, never ok).
"""

import os
import subprocess
import sys
from pathlib import Path

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))  # noqa: PTH100, PTH120
REEXEC = "OCTO_FEATHER_DECISION_LOG_KIT_ENV"


def say(stream: str, line: bytes) -> None:
    """LINE to stdout (STREAM out) or stderr, flushed: in order when both go to one place."""
    out = sys.stdout.buffer if stream == "out" else sys.stderr.buffer
    out.write(line + b"\n")
    out.flush()


try:
    from decision_log import check_decision_logs
except ImportError:
    sync = f"uv sync --locked --project {ROOT}"
    if os.environ.get(REEXEC):
        why = "jsonschema is not importable in the kit's environment"
        why = f"{why}; sync it once, with network: {sync}"
        say("err", f"check-decision-log: {why}".encode())
        sys.exit(2)
    env = {k: v for k, v in os.environ.items() if k != "VIRTUAL_ENV"}
    env[REEXEC] = "1"
    uv = ["uv", "run", "--project", ROOT, "--locked", "--offline", "--no-dev", "--quiet", "python"]
    try:
        script = os.path.abspath(__file__)  # noqa: PTH100
        sys.exit(subprocess.run([*uv, script, *sys.argv[1:]], env=env, check=False).returncode)
    except OSError as e:
        why = f"cannot run uv for the kit's locked jsonschema ({e}); install uv, then: {sync}"
        say("err", f"check-decision-log: {why}".encode())
        sys.exit(2)


def main() -> int:
    git = subprocess.run(["git", "-C", ROOT, "ls-files", "-z"], capture_output=True, check=False)  # noqa: S607
    if git.returncode != 0:
        sys.stderr.buffer.write(git.stderr)
        why = f"git ls-files exited {git.returncode}; the check cannot pass"
        say("err", f"check-decision-log: {why}".encode())
        return 2
    report = check_decision_logs(Path(ROOT), [os.fsdecode(p) for p in git.stdout.split(b"\0") if p])
    for stream, line in report.lines:
        say(stream, line)
    return report.code


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as e:  # noqa: BLE001  fail closed: an internal error is never ok
        say("err", f"check-decision-log: error: {type(e).__name__}: {e}".encode())
        sys.exit(2)
