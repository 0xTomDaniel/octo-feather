#!/usr/bin/env python3
"""Every tracked file named decisions.jsonl, anywhere in the repo, holds one JSON
object per line that satisfies schemas/decision-log.schema.json (quality spec
#acceptance-decision-log-schema, #decision-log, docs/adr/0010). Each failure names
FILE:LINE and the field. The schema file is the one source for the field list.

The validator honours exactly the schema keywords below and refuses any other, so a
schema edit it cannot enforce fails the gate instead of passing silently.
Stdlib only, deterministic. Fails closed: a git error, an unreadable log or schema,
or an internal error fails the gate, never reads as ok. Run by `just check`.
"""
import json, os, re, subprocess, sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
SCHEMA = "schemas/decision-log.schema.json"
NAME = "decisions.jsonl"
TOP_KEYS = {"$schema", "$id", "title", "description", "type", "required", "properties", "additionalProperties"}
FIELD_KEYS = {"description", "type", "minLength", "pattern"}
TYPES = {"string": str}
# The schema's patterns (ECMA-262, its $schema dialect) are parsed against the subset below and
# emitted as an equivalent Python re: classes as explicit code point ranges, so no Python escape
# or flag can reinterpret them. Anything else is refused naming the construct.
MAX = 0x10FFFF
# ECMA-262 WhiteSpace (Zs spelled out) and LineTerminator: what \s matches.
WS = [(0x9, 0xD), (0x20, 0x20), (0xA0, 0xA0), (0x1680, 0x1680), (0x2000, 0x200A), (0x2028, 0x2029),
      (0x202F, 0x202F), (0x205F, 0x205F), (0x3000, 0x3000), (0xFEFF, 0xFEFF)]
LINE_END = [(0xA, 0xA), (0xD, 0xD), (0x2028, 0x2029)]
DIGIT = [(0x30, 0x39)]
WORD = [(0x30, 0x39), (0x41, 0x5A), (0x5F, 0x5F), (0x61, 0x7A)]
SYNTAX = "^$\\.*+?()[]{}|/"
CONTROL = {"t": 9, "n": 10, "v": 11, "f": 12, "r": 13}
HEX = re.compile(r"x([0-9A-Fa-f]{2})|u([0-9A-Fa-f]{4})|u\{([0-9A-Fa-f]+)\}|c([A-Za-z])")
QUANT = re.compile(r"[*+?]|\{(\d+)(,(\d*))?\}")


class SchemaError(Exception):
    pass


def load_schema():
    with open(os.path.join(ROOT, SCHEMA), encoding="utf-8") as fh:
        s = json.load(fh, object_pairs_hook=no_duplicates)
    if not isinstance(s, dict):
        raise SchemaError("not a JSON object")
    if extra := sorted(set(s) - TOP_KEYS):
        raise SchemaError(f"unsupported keyword {extra[0]}")
    if s.get("type") != "object":
        raise SchemaError('type must be "object"')
    req, props = s.get("required", []), s.get("properties", {})
    if not isinstance(req, list) or not all(isinstance(r, str) for r in req) or len(set(req)) != len(req):
        raise SchemaError("required must be a list of distinct names")
    if not isinstance(props, dict):
        raise SchemaError("properties must be an object")
    if not isinstance(s.get("additionalProperties", True), bool):
        raise SchemaError("additionalProperties must be true or false")
    for name, p in props.items():
        if not isinstance(p, dict) or (extra := sorted(set(p) - FIELD_KEYS)):
            raise SchemaError(f"property {name}: unsupported {'keyword ' + extra[0] if isinstance(p, dict) else 'form'}")
        if "type" in p and (not isinstance(p["type"], str) or p["type"] not in TYPES):
            raise SchemaError(f"property {name}: unsupported type {p['type']!r}")
        if "minLength" in p and (type(p["minLength"]) is not int or p["minLength"] < 0):
            raise SchemaError(f"property {name}: minLength must be a non-negative integer")
        if "pattern" in p:
            if not isinstance(p["pattern"], str):
                raise SchemaError(f"property {name}: pattern must be a string")
            try:
                p["pattern"] = ecma(p["pattern"])
            except SchemaError as e:
                raise SchemaError(f"property {name}: {e}") from None
    return s


def ecma(src):
    """An Ecma for the schema pattern src (Unicode mode), or SchemaError naming the construct."""
    n, pos = len(src), 0

    def fail(why):
        raise SchemaError(f"pattern {src!r} at offset {pos}: {why}")

    def ranges(rs):  # a set of code point ranges as one Python atom
        body = "".join(f"\\U{lo:08x}" + (f"-\\U{hi:08x}" if hi > lo else "") for lo, hi in rs)
        return f"[{body}]" if body else "(?!)"

    def invert(rs):
        out, lo = [], 0
        for a, b in sorted(rs):
            if a > lo:
                out.append((lo, a - 1))
            lo = max(lo, b + 1)
        return out + [(lo, MAX)] if lo <= MAX else out

    def escape(in_class):
        """At a backslash: a list of ranges for a class escape, else one code point."""
        nonlocal pos
        e = src[pos + 1:pos + 2]
        sets = {"d": DIGIT, "w": WORD, "s": WS}
        if e.lower() in sets:
            pos += 2
            return sets[e.lower()] if e.islower() else invert(sets[e.lower()])
        if e in CONTROL or (in_class and e in "b-"):
            pos += 2
            return CONTROL.get(e) or (8 if e == "b" else 0x2D)
        if e and e in SYNTAX:
            pos += 2
            return ord(e)
        if e == "0" and not src[pos + 2:pos + 3].isdigit():
            pos += 2
            return 0
        if e.isdigit() or e == "k":
            fail(f"backreference \\{e} is outside the supported subset")
        if e in ("p", "P"):
            fail(f"property escape \\{e} is outside the supported subset")
        m = HEX.match(src, pos + 1)
        if not m:
            fail(f"invalid escape \\{e}" if e else "lone backslash at the end")
        cp = ord(m.group(4)) % 32 if m.group(4) else int(next(g for g in m.groups() if g), 16)
        pos = m.end()
        if cp > MAX:
            fail("code point escape above U+10FFFF")
        if 0xD800 <= cp <= 0xDFFF:
            fail("surrogate escape is outside the supported subset")
        return cp

    def klass():
        nonlocal pos
        pos += 1
        neg = src[pos:pos + 1] == "^"
        pos += neg
        rs = []

        def atom():
            nonlocal pos
            if pos >= n:
                fail("unterminated class")
            if src[pos] == "\\":
                return escape(True)
            pos += 1
            return ord(src[pos - 1])

        while src[pos:pos + 1] != "]":
            lo = atom()
            if src[pos:pos + 1] == "-" and src[pos + 1:pos + 2] not in ("]", ""):
                pos += 1
                hi = atom()
                if isinstance(lo, list) or isinstance(hi, list):
                    fail("class escape as a range end")
                if lo > hi:
                    fail("class range out of order")
                rs.append((lo, hi))
            else:
                rs += lo if isinstance(lo, list) else [(lo, lo)]
        pos += 1
        return ranges(invert(rs) if neg else rs)

    def term():
        """(python text, quantifiable) for the term at pos."""
        nonlocal pos
        c = src[pos]
        if c in "^$":
            pos += 1
            return ("\\A" if c == "^" else "\\Z"), False
        if src.startswith(("\\b", "\\B"), pos):
            pos += 2
            w = ranges(WORD)  # explicit: Python's \B never matches the empty string
            either = f"(?<={w})(?={w})|(?<!{w})(?!{w})" if src[pos - 1] == "B" else f"(?<={w})(?!{w})|(?<!{w})(?={w})"
            return f"(?:{either})", False
        if src.startswith(("(?=", "(?!", "(?:"), pos) or c == "(":
            g = src[pos:pos + 3] if src.startswith("(?", pos) else "(?:"
            if src.startswith("(?", pos) and g not in ("(?=", "(?!", "(?:"):
                fail(f"group {src[pos:pos + 4]} is outside the supported subset")
            pos += 3 if src.startswith("(?", pos) else 1
            body = disjunction()
            if src[pos:pos + 1] != ")":
                fail("unterminated group")
            pos += 1
            return g + body + ")", g == "(?:"
        if c == "[":
            return klass(), True
        if c == ".":
            pos += 1
            return ranges(invert(LINE_END)), True
        if c == "\\":
            cp = escape(False)
            return ranges(cp if isinstance(cp, list) else [(cp, cp)]), True
        if c in "*+?{}]":
            fail(f"{c} with nothing to repeat" if c in "*+?{" else f"lone {c}")
        pos += 1
        return re.escape(c), True

    def disjunction():
        nonlocal pos
        out = []
        while pos < n and src[pos] != ")":
            if src[pos] == "|":
                out.append("|")
                pos += 1
                continue
            text, quantifiable = term()
            m = QUANT.match(src, pos)
            if m:
                if not quantifiable:
                    fail(f"quantifier {m.group(0)} on an assertion")
                if m.group(3) and int(m.group(1)) > int(m.group(3)):
                    fail(f"quantifier {m.group(0)} out of order")
                pos = m.end()
                lazy = src[pos:pos + 1] == "?"
                pos += lazy
                text = f"(?:{text}){m.group(0)}" + "?" * lazy
            out.append(text)
        return "".join(out)

    out = disjunction()
    if pos < n:
        fail("unmatched )")
    return Ecma(src, re.compile(out))


class Ecma:
    """A schema pattern: its ECMA source and a search with ECMA's meaning."""

    def __init__(self, src, rx):
        self.pattern, self.search = src, rx.search


def no_duplicates(pairs):
    seen = {}
    for k, v in pairs:
        if k in seen:
            raise ValueError(f"duplicate key {k}")
        seen[k] = v
    return seen


def no_constant(name):
    raise ValueError(f"{name} is not JSON")


def line_problems(raw, schema):
    try:
        obj = json.loads(raw.decode("utf-8"), object_pairs_hook=no_duplicates, parse_constant=no_constant)
    except UnicodeDecodeError:
        return ["not UTF-8"]
    except ValueError as e:  # json.JSONDecodeError is a ValueError
        return [f"invalid JSON: {e}"]
    if not isinstance(obj, dict):
        return [f"not a JSON object (a {type(obj).__name__})"]
    props = schema.get("properties", {})
    out = [f"missing {r}" for r in schema.get("required", []) if r not in obj]
    for name, p in props.items():
        if name not in obj:
            continue
        v = obj[name]
        if "type" in p and not isinstance(v, TYPES[p["type"]]):
            out.append(f"{name} must be a {p['type']}")
            continue
        if isinstance(v, str):
            if len(v) < p.get("minLength", 0):
                out.append(f"empty {name}")
            elif "pattern" in p and not p["pattern"].search(v):
                out.append(f"{name} does not match {p['pattern'].pattern}")
    if schema.get("additionalProperties", True) is False:
        out += [f"unknown field {k}" for k in sorted(set(obj) - set(props))]
    return out


def main():
    try:
        schema = load_schema()
    except (OSError, ValueError, SchemaError, re.error) as e:
        print(f"check-decision-log: {SCHEMA}: unusable schema: {e}; fix the schema, the check cannot pass", file=sys.stderr)
        return 2
    git = subprocess.run(["git", "-C", ROOT, "ls-files", "-z"], capture_output=True)
    if git.returncode != 0:
        sys.stderr.write(git.stderr.decode("utf-8", "replace"))
        print(f"check-decision-log: git ls-files exited {git.returncode}; the check cannot pass", file=sys.stderr)
        return 2
    logs = sorted(p for p in git.stdout.decode("utf-8", "surrogateescape").split("\0") if p and os.path.basename(p) == NAME)
    fields = ", ".join(schema.get("required", []))
    bad = 0
    for path in logs:
        try:
            with open(os.path.join(ROOT, path), "rb") as fh:
                data = fh.read()
        except OSError as e:
            print(f"check-decision-log: {path}: cannot read: {e}", file=sys.stderr)
            bad += 1
            continue
        lines = data.split(b"\n")
        if lines[-1] == b"":
            lines.pop()  # the final newline ends the last line, it is not a line
        for n, raw in enumerate(lines, 1):
            for p in line_problems(raw, schema):
                print(f"check-decision-log: {path}:{n}: {p} (each line is one JSON object with string fields {fields}; {SCHEMA})", file=sys.stderr)
                bad += 1
    if bad:
        return 1
    print(f"decision-log: ok ({len(logs)} files)")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as e:  # fail closed: an internal error is never ok
        print(f"check-decision-log: error: {type(e).__name__}: {e}", file=sys.stderr)
        sys.exit(2)
