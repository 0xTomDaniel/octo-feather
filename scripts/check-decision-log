#!/usr/bin/env python3
"""Every tracked file named decisions.jsonl, anywhere in the repo, holds one JSON
object per line that satisfies schemas/decision-log.schema.json (quality spec
#acceptance-decision-log-schema, #decision-log, docs/adr/0010). Each failure names
FILE:LINE and the field. The schema file is the one source for the field list.

The validator honours exactly the schema keywords below and refuses any other, so a
schema edit it cannot enforce fails the gate instead of passing silently.
Stdlib only, deterministic. Fails closed: a git error, an unreadable log or schema,
or an internal error fails the gate, never reads as ok. Run by `just check`.
"""
import json, os, re, subprocess, sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
SCHEMA = "schemas/decision-log.schema.json"
NAME = "decisions.jsonl"
TOP_KEYS = {"$schema", "$id", "title", "description", "type", "required", "properties", "additionalProperties"}
FIELD_KEYS = {"description", "type", "minLength", "pattern"}
TYPES = {"string": str}
# ECMA-262 WhiteSpace and LineTerminator, the set \s matches (Space_Separator spelled out).
WS = "\t\n\v\f\r \xa0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff"
LINE_END = "\n\r\u2028\u2029"
SYNTAX = "^$\\.*+?()[]{}|/-"
CONTROL = {"t": "\t", "n": "\n", "v": "\v", "f": "\f", "r": "\r"}
HEX = re.compile(r"x([0-9A-Fa-f]{2})|u([0-9A-Fa-f]{4})|u\{([0-9A-Fa-f]{1,6})\}|c([A-Za-z])")


class SchemaError(Exception):
    pass


def load_schema():
    with open(os.path.join(ROOT, SCHEMA), encoding="utf-8") as fh:
        s = json.load(fh, object_pairs_hook=no_duplicates)
    if not isinstance(s, dict):
        raise SchemaError("not a JSON object")
    if extra := sorted(set(s) - TOP_KEYS):
        raise SchemaError(f"unsupported keyword {extra[0]}")
    if s.get("type") != "object":
        raise SchemaError('type must be "object"')
    req, props = s.get("required", []), s.get("properties", {})
    if not isinstance(req, list) or not all(isinstance(r, str) for r in req) or len(set(req)) != len(req):
        raise SchemaError("required must be a list of distinct names")
    if not isinstance(props, dict):
        raise SchemaError("properties must be an object")
    if not isinstance(s.get("additionalProperties", True), bool):
        raise SchemaError("additionalProperties must be true or false")
    for name, p in props.items():
        if not isinstance(p, dict) or (extra := sorted(set(p) - FIELD_KEYS)):
            raise SchemaError(f"property {name}: unsupported {'keyword ' + extra[0] if isinstance(p, dict) else 'form'}")
        if "type" in p and (not isinstance(p["type"], str) or p["type"] not in TYPES):
            raise SchemaError(f"property {name}: unsupported type {p['type']!r}")
        if "minLength" in p and (type(p["minLength"]) is not int or p["minLength"] < 0):
            raise SchemaError(f"property {name}: minLength must be a non-negative integer")
        if "pattern" in p:
            if not isinstance(p["pattern"], str):
                raise SchemaError(f"property {name}: pattern must be a string")
            p["pattern"] = ecma(p["pattern"])
    return s


def ecma(src):
    """Compile an ECMA-262 pattern (JSON Schema 2020-12 `pattern`) to a Python re with ECMA's meaning:
    \\s \\S over ECMA white space, \\d \\w \\b ASCII (re.ASCII), . stops at every line terminator,
    $ only at the end. A construct outside the ECMA syntax handled here is refused, never guessed."""
    out, i, n = [], 0, len(src)

    def escape(i, in_class):
        """(python text, next index, kind) for the escape at src[i] == '\\'; kind 'S' for \\S."""
        if i + 1 >= n:
            raise SchemaError(f"pattern {src!r}: ends in a lone backslash")
        e = src[i + 1]
        if e == "s":
            return WS, i + 2, "s"
        if e == "S":
            return "", i + 2, "S"
        if e in "dDwW":
            return "\\" + e, i + 2, ""
        if e in "bB":
            return ("\\x08" if e == "b" else None) if in_class else "\\" + e, i + 2, ""
        if e in CONTROL:
            return re.escape(CONTROL[e]), i + 2, ""
        if e == "0" and not src[i + 2:i + 3].isdigit():
            return "\\x00", i + 2, ""
        if e in "123456789" and not in_class:
            j = i + 1
            while j < n and src[j].isdigit():
                j += 1
            return f"(?:\\{src[i + 1:j]})", j, ""
        if e in SYNTAX:
            return re.escape(e), i + 2, ""
        m = HEX.match(src, i + 1)
        if m:
            cp = int(next(g for g in m.groups() if g), 16) if not m.group(4) else ord(m.group(4).upper()) % 32
            return re.escape(chr(cp)), m.end(), ""
        return None, i + 2, ""

    while i < n:
        c = src[i]
        if c == "\\":
            text, j, kind = escape(i, False)
            if text is None:
                raise SchemaError(f"pattern {src!r}: unsupported escape {src[i:j]}")
            out.append(f"[{WS}]" if kind == "s" else f"[^{WS}]" if kind == "S" else text)
            i = j
        elif c == "[":
            i += 1
            neg = src[i:i + 1] == "^"
            i += neg
            body, nonws = [], False
            while i < n and src[i] != "]":
                if src[i] == "\\":
                    text, j, kind = escape(i, True)
                    if text is None:
                        raise SchemaError(f"pattern {src!r}: unsupported escape {src[i:j]} in a class")
                    nonws = nonws or kind == "S"
                    body.append(text)
                    i = j
                else:
                    body.append(src[i] if src[i] == "-" else re.escape(src[i]))
                    i += 1
            if i >= n:
                raise SchemaError(f"pattern {src!r}: unterminated class")
            i += 1
            b = "".join(body)
            if not nonws:  # ECMA: [] matches nothing, [^] any character
                out.append((f"[^{b}]" if b else "[\\s\\S]") if neg else (f"[{b}]" if b else "(?!)"))
            elif neg:  # not in the rest and not non-white: white, minus the rest
                out.append(f"(?![{b}])[{WS}]" if b else f"[{WS}]")
            else:
                out.append(f"(?:[{b}]|[^{WS}])" if b else f"[^{WS}]")
        elif c == ".":
            out.append(f"[^{LINE_END}]")
            i += 1
        elif c == "$":
            out.append(r"\Z")
            i += 1
        elif c == "(" and src.startswith("(?", i):
            g = next((g for g in ("(?:", "(?=", "(?!", "(?<=", "(?<!") if src.startswith(g, i)), None)
            if g is None:
                raise SchemaError(f"pattern {src!r}: unsupported group {src[i:i + 4]}")
            out.append(g)
            i += len(g)
        else:
            out.append(c)
            i += 1
    return Ecma(src, re.compile("".join(out), re.ASCII))


class Ecma:
    """A schema pattern: its ECMA source and a search with ECMA's meaning."""

    def __init__(self, src, rx):
        self.pattern, self.search = src, rx.search


def no_duplicates(pairs):
    seen = {}
    for k, v in pairs:
        if k in seen:
            raise ValueError(f"duplicate key {k}")
        seen[k] = v
    return seen


def no_constant(name):
    raise ValueError(f"{name} is not JSON")


def line_problems(raw, schema):
    try:
        obj = json.loads(raw.decode("utf-8"), object_pairs_hook=no_duplicates, parse_constant=no_constant)
    except UnicodeDecodeError:
        return ["not UTF-8"]
    except ValueError as e:  # json.JSONDecodeError is a ValueError
        return [f"invalid JSON: {e}"]
    if not isinstance(obj, dict):
        return [f"not a JSON object (a {type(obj).__name__})"]
    props = schema.get("properties", {})
    out = [f"missing {r}" for r in schema.get("required", []) if r not in obj]
    for name, p in props.items():
        if name not in obj:
            continue
        v = obj[name]
        if "type" in p and not isinstance(v, TYPES[p["type"]]):
            out.append(f"{name} must be a {p['type']}")
            continue
        if isinstance(v, str):
            if len(v) < p.get("minLength", 0):
                out.append(f"empty {name}")
            elif "pattern" in p and not p["pattern"].search(v):
                out.append(f"{name} does not match {p['pattern'].pattern}")
    if schema.get("additionalProperties", True) is False:
        out += [f"unknown field {k}" for k in sorted(set(obj) - set(props))]
    return out


def main():
    try:
        schema = load_schema()
    except (OSError, ValueError, SchemaError, re.error) as e:
        print(f"check-decision-log: {SCHEMA}: unusable schema: {e}; fix the schema, the check cannot pass", file=sys.stderr)
        return 2
    git = subprocess.run(["git", "-C", ROOT, "ls-files", "-z"], capture_output=True)
    if git.returncode != 0:
        sys.stderr.write(git.stderr.decode("utf-8", "replace"))
        print(f"check-decision-log: git ls-files exited {git.returncode}; the check cannot pass", file=sys.stderr)
        return 2
    logs = sorted(p for p in git.stdout.decode("utf-8", "surrogateescape").split("\0") if p and os.path.basename(p) == NAME)
    fields = ", ".join(schema.get("required", []))
    bad = 0
    for path in logs:
        try:
            with open(os.path.join(ROOT, path), "rb") as fh:
                data = fh.read()
        except OSError as e:
            print(f"check-decision-log: {path}: cannot read: {e}", file=sys.stderr)
            bad += 1
            continue
        lines = data.split(b"\n")
        if lines[-1] == b"":
            lines.pop()  # the final newline ends the last line, it is not a line
        for n, raw in enumerate(lines, 1):
            for p in line_problems(raw, schema):
                print(f"check-decision-log: {path}:{n}: {p} (each line is one JSON object with string fields {fields}; {SCHEMA})", file=sys.stderr)
                bad += 1
    if bad:
        return 1
    print(f"decision-log: ok ({len(logs)} files)")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as e:  # fail closed: an internal error is never ok
        print(f"check-decision-log: error: {type(e).__name__}: {e}", file=sys.stderr)
        sys.exit(2)
