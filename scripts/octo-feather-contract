#!/usr/bin/env python3
"""octo-feather-contract [REPO-OR-QC.TOML]

Validate a target's app-driver contract, qc.toml at its root (quality spec #qc-contract,
docs/adr/0025), against the kit's versioned schema: its `format` key picks
schemas/qc.v<format>.schema.json. With no argument, ./qc.toml. Prints
`octo-feather-contract: <file>: ok (format N)` and exits 0, or names each problem
(FILE: KEY: what is wrong) and exits 1. Usage or an unusable schema exits 2.

The schema is enforced by jsonschema (python-jsonschema, every keyword of the draft the
schema's $schema names), pinned in the kit's pyproject.toml and uv.lock. Run from any
python without it (PATH in a target repo, the qc sandbox, CI), this script re-runs itself
in the kit's project environment through scripts/kit_env.py (its docstring: the locked
dependencies offline, uv started in the kit, the caller's directory kept).
"""
import glob, json, os, re, sys, tomllib

from kit_env import kit_python

ME = "octo-feather-contract"
KIT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
SCHEMAS = os.path.join(KIT, "schemas")
REEXEC = "OCTO_FEATHER_CONTRACT_KIT_ENV"

try:
    import jsonschema
except ImportError:
    if os.environ.get(REEXEC):
        print(f"{ME}: jsonschema is not importable in the kit's environment; sync it once, with network: uv sync --locked --project {KIT}", file=sys.stderr)
        sys.exit(2)
    try:
        sys.exit(kit_python(os.path.abspath(__file__), *sys.argv[1:], env={**os.environ, REEXEC: "1"}).returncode)
    except OSError as e:
        print(f"{ME}: cannot run uv for the kit's locked jsonschema ({e}); install uv, then: uv sync --locked --project {KIT}", file=sys.stderr)
        sys.exit(2)


def supported():
    found = (re.fullmatch(r"qc\.v(\d+)\.schema\.json", os.path.basename(p)) for p in glob.glob(os.path.join(SCHEMAS, "qc.v*.schema.json")))
    return sorted(int(m[1]) for m in found if m)


def problems(doc, schema):
    """Each problem of DOC against SCHEMA, one line each, keyed by its dotted path ('' at the top)."""
    validator = jsonschema.validators.validator_for(schema)
    validator.check_schema(schema)
    out = []
    for e in sorted(validator(schema).iter_errors(doc), key=lambda e: (list(map(str, e.absolute_path)), e.validator)):
        where = ".".join(map(str, e.absolute_path))
        name, prefix = where or "the contract", f"{where}: " if where else ""
        if e.validator == "required":
            out += [f"{prefix}missing {r}" for r in e.validator_value if r not in e.instance]
        elif e.validator == "additionalProperties" and e.validator_value is False:
            known = e.schema.get("properties", {})
            out += [f"{prefix}unknown key {k}" for k in e.instance if k not in known]
        elif e.validator == "type":
            article = "an" if str(e.validator_value)[0] in "aeiou" else "a"
            out.append(f"{name} must be {article} {e.validator_value}")
        elif e.validator == "const":
            out.append(f"{name} must be {e.validator_value!r}")
        elif e.validator == "minLength" and e.validator_value == 1:
            out.append(f"{name} must not be empty")
        elif e.validator == "pattern":
            out.append(f"{name} must match {e.validator_value}")
        else:
            out.append(f"{name}: {e.message}")
    return list(dict.fromkeys(out))


def main(argv):
    if len(argv) > 1 or (argv and argv[0] in ("-h", "--help")):
        print(f"usage: {ME} [REPO-OR-QC.TOML]   (default ./qc.toml)", file=sys.stderr)
        return 0 if argv and argv[0] in ("-h", "--help") else 2
    path = argv[0] if argv else "."
    if os.path.isdir(path):
        path = os.path.join(path, "qc.toml")
    try:
        with open(path, "rb") as fh:
            doc = tomllib.load(fh)
    except FileNotFoundError:
        print(f"{ME}: no qc.toml at {path}: write the app-driver contract at the repo root (quality spec #qc-contract)", file=sys.stderr)
        return 1
    except (OSError, UnicodeDecodeError, tomllib.TOMLDecodeError) as e:
        print(f"{ME}: {path}: not TOML: {e}", file=sys.stderr)
        return 1
    versions = supported()
    have = ", ".join(map(str, versions)) or "none"
    if "format" not in doc:
        print(f"{ME}: {path}: missing format (the contract's format version; supported: {have})", file=sys.stderr)
        return 1
    fmt = doc["format"]
    if type(fmt) is not int:
        print(f"{ME}: {path}: format must be an integer (the contract's format version; supported: {have})", file=sys.stderr)
        return 1
    if fmt not in versions:
        print(f"{ME}: {path}: format {fmt} is not a supported format version (supported: {have})", file=sys.stderr)
        return 1
    schema_path = os.path.join(SCHEMAS, f"qc.v{fmt}.schema.json")
    try:
        with open(schema_path, encoding="utf-8") as fh:
            schema = json.load(fh)
        found = problems(doc, schema)
    except (OSError, ValueError, jsonschema.exceptions.SchemaError, jsonschema.exceptions.UnknownType) as e:
        why = e.message if isinstance(e, jsonschema.exceptions.SchemaError) else e
        print(f"{ME}: {schema_path}: unusable schema: {why}; fix the schema, the contract cannot be validated", file=sys.stderr)
        return 2
    if not found:   # what the schema cannot say: a criterion's fixtures are this contract's own (format 2)
        declared: dict[str, object] = doc.get("fixture") or {}
        demos: dict[str, dict[str, list[str]]] = doc.get("demo") or {}
        found = [f"demo.{cid}.fixtures: {n} is no declared fixture; declare it under [fixture.{n}]"
                 for cid, d in demos.items() for n in d.get("fixtures", []) if n not in declared]
    for p in found:
        print(f"{ME}: {path}: {p}", file=sys.stderr)
    if found:
        return 1
    print(f"{ME}: {path}: ok (format {fmt})")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
