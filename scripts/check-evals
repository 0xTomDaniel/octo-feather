#!/usr/bin/env python3
"""check-evals: the command's launcher. Its code, scripts/check_evals.py, is imported, so Python
caches its bytecode (scripts/__pycache__/), which it never does for the __main__ script; on a
read-only tree (the qc sandbox) it compiles the module each run instead. Code that needs its
functions imports check_evals, never this file."""

import sys

import check_evals

if __name__ == "__main__":
    sys.exit(check_evals.main(sys.argv[1:]))
