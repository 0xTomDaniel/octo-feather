#!/usr/bin/env bash
# octo-feather's published start command (ported from octo-lite's start command,
# varelaseb/octo-lite@cc6fa4e, Apache-2.0).
#
#   octo-feather-start --director [--cwd DIR]
#     the director in Herdr workspace `director`, tab `director`
#   octo-feather-start --issue TICKET [--cwd WORKTREE]
#     one supervisor in its own workspace named by the lane key, tab `supervisor`:
#     TICKET as the target's tracker writes it (12 or ENG-123), the key from that
#     tracker skill's lane-key (gh12, eng-123; roles spec #lane-key)
#
# Layout per docs/adr/0011. Workers later get their own tab
# in the lane workspace, spawned by the supervisor with herdr-spawn.
# On macOS, started outside Herdr with no HERDR_SESSION, the session is the
# project's: the basename of the target's git top (one Herdr server per project).
# It must already run (`herdr --session <name>` in a terminal). A director start
# prints the kickoff brief template to fill and send (docs/kickoff-brief.md).
# --name and --resume SESSION continue a parked supervisor: in a new tab of the
# workspace labelled --name when it still exists (a worker tab kept it open),
# else in a new lane workspace (comms spec #roles-park). A resume repoints the agent's
# record to its new pane: octo-feather-handoff --help, repoint. A --director --resume while a live
# Pi holds that session starts nothing, exit 73 (director_relaunch.py held).
# --director --relaunch [--wait SECONDS] [--resume SESSION] relaunches the running director on
# its own session in a new pane, from outside the director's pane (comms spec #director-relaunch):
# its steps, refusals and exits, scripts/director_relaunch.py (--wait default 1800).
# --director --replace [--wait SECONDS] replaces it with a fresh director the same way, the old one's
# tab left open under an outgoing name (same rule; scripts/director_relaunch.py, replace). Its
# --fresh-tab is that script's own call back here: a fresh director in a new tab of an existing
# workspace `director`, director.toml repointed to it.
set -euo pipefail

cwd="$PWD"; name=""; issue=""; label=""; role="supervisor"; model=(); resume=(); parent=(); relaunch=""; wait=1800
replace=""; fresh=""
usage() {
  echo "usage: octo-feather-start (--director [--relaunch|--replace [--wait SECONDS]] | --issue TICKET | --name LANE) [--cwd DIR]" \
       "[--label LABEL] [--operating-model FILE] [--resume SESSION] [--parent PANE]" >&2
  exit 64
}
while (($#)); do
  case "$1" in
    --director) name="director"; label="director"; role="director"; shift ;;
    --issue) issue="${2:?}"; shift 2 ;;
    --cwd) cwd="${2:?}"; shift 2 ;;
    --name) name="${2:?}"; shift 2 ;;
    --label) label="${2:?}"; shift 2 ;;
    --runtime) [[ "${2:?}" == pi ]] || usage; shift 2 ;;   # pi only, kept for callers
    --operating-model) model=(--operating-model "${2:?}"); shift 2 ;;
    --resume) resume=(--resume "${2:?}"); shift 2 ;;
    --parent) parent=(--parent "$2"); shift 2 ;;
    --relaunch) relaunch=1; shift ;;
    --replace) replace=1; shift ;;
    --fresh-tab) fresh=1; shift ;;
    --wait) wait="${2:?}"; [[ "$wait" =~ ^[0-9]+$ ]] || usage; shift 2 ;;
    *) usage ;;
  esac
done
[[ -n "$name$issue" ]] || usage
[[ -z "$relaunch$replace$fresh" || "$role" == director ]] || usage
[[ -z "$replace$fresh" ]] || { [[ -z "$relaunch" ]] && ((${#resume[@]} == 0)); } || usage
[[ -n "$label" ]] || label="supervisor"

root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd -P)"
[[ -d "$cwd" ]] || { echo "octo-feather-start: no such directory: $cwd" >&2; exit 66; }
cwd="$(cd "$cwd" && pwd -P)"
# The role must start in the target at --cwd: pi-role resolves its {tracker} skill there, and an unknown
# tracker refuses here, before any workspace exists (spec skills#acceptance-tracker-unknown).
# Its launch env too: a role that would commit refuses here without the factory commit identity (pi-role --help).
(cd "$cwd" && "$root/scripts/pi-role" --json "$root/agents/$role.md" >/dev/null && "$root/scripts/pi-role" --print-env "$root/agents/$role.md" >/dev/null) \
  || { echo "octo-feather-start: $role not started: pi-role refused its role file in $cwd (reason above)" >&2; exit 65; }
# The lane key comes from the tracker pi-role resolved above (one mechanism: its tracker_skill), via that
# tracker skill's lane-key (docs/adr/0011).
if [[ -n "$issue" ]]; then
  skill="$(cd "$cwd" && python3 -c 'import importlib.machinery as m, importlib.util as u, sys
l = m.SourceFileLoader("pi_role", sys.argv[1]); p = u.module_from_spec(u.spec_from_loader("pi_role", l)); l.exec_module(p)
print(p.tracker_skill(sys.argv[2]))' "$root/scripts/pi-role" "$root/.agents/skills")" || exit 65
  name="$("$root/.agents/skills/$skill/scripts/lane-key" "$issue")" \
    || { echo "octo-feather-start: --issue $issue has no lane key in this target's tracker ($skill, reason above)" >&2; exit 64; }
fi
# Review state never lands in the target's tracked tree (docs/adr/0017).
! git -C "$cwd" rev-parse --is-inside-work-tree >/dev/null 2>&1 || "$root/scripts/octo-feather-exclude" "$cwd" >&2
if [[ "$(uname -s)" == Darwin && -z "${HERDR_SESSION:-}" && -z "${HERDR_PANE_ID:-}" ]]; then
  top="$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null || (cd "$cwd" && pwd -P))"
  export HERDR_SESSION="${top##*/}"
  echo "octo-feather-start: HERDR_SESSION=$HERDR_SESSION (the project's; set HERDR_SESSION to choose another)" >&2
  herdr session list 2>/dev/null | awk -v s="$HERDR_SESSION" '$1 == s && $2 == "running" {f=1} END {exit !f}' \
    || { echo "octo-feather-start: Herdr session $HERDR_SESSION is not running; start it in a terminal with: herdr --session $HERDR_SESSION" >&2; exit 69; }
fi
# The relaunch parks the director and comes back here as --director --resume (director_relaunch.py).
[[ -z "$relaunch" ]] || exec "$root/scripts/director_relaunch.py" relaunch --cwd "$cwd" --wait "$wait" \
  "${model[@]}" "${resume[@]}"
[[ -z "$replace" ]] || exec "$root/scripts/director_relaunch.py" replace --cwd "$cwd" --wait "$wait" "${model[@]}"
# A start runs the director reflection when due (comms spec #reflection-director), in the background so
# the start never waits on it; its output goes to director-reflection.out in the state dir.
reflect_due() {
  local state; state="$("$root/scripts/octo-feather-state")"; mkdir -p "$state"
  (cd "$cwd" && exec nohup "$root/scripts/octo-feather-lane" reflect --director --due) \
    >>"$state/director-reflection.out" 2>&1 </dev/null &
  # The director's old result files of gone workers: octo-feather-handoff --help, prune-results.
  "$root/scripts/octo-feather-handoff" prune-results >&2 || true
}
spawn() { # $1: workspace id; run in the target, where pi-role resolves {tracker}
  cd "$cwd" && "$root/.agents/skills/herdr-comms/assets/herdr-spawn" --workspace "$1" --name "$name" \
    --label "$label" --cwd "$cwd" --role "$role" "${model[@]}" "${resume[@]}" "${parent[@]}" -- pi
}
repoint() { # $1: herdr-spawn's line; a resume or a --fresh-tab only
  ((${#resume[@]})) || [[ -n "$fresh" ]] || return 0
  "$root/scripts/octo-feather-handoff" repoint "$name" <<<"$1" ||
    echo "octo-feather-start: $name's record not repointed to its new pane (error above); the agent runs" >&2
}
kickoff() { # a fresh director's next step
  [[ "$role" != director ]] || ((${#resume[@]})) || echo "octo-feather-start: next, send the director its /goal, then a kickoff brief filled from $root/docs/kickoff-brief.md" >&2
}

# One workspace per name: refuse a second director or a second lane of one lane key.
# A resume instead lands a new tab in the existing one; a director's, refused while a live Pi holds its
# session (one director per session: comms spec #director-relaunch).
[[ "$role" != director ]] || ((${#resume[@]} == 0)) || "$root/scripts/director_relaunch.py" held "${resume[1]}" || exit $?
existing="$(herdr workspace list 2>/dev/null | jq -r --arg n "$name" \
  '[.result.workspaces[]? | select(.label == $n) | .workspace_id] | first // empty' 2>/dev/null || true)"
if [[ -n "$existing" ]]; then
  ((${#resume[@]})) || [[ -n "$fresh" ]] || {
    echo "octo-feather-start: workspace $name already exists$([[ "$role" != director ]] ||
      echo "; relaunch the director on its own session with --director --relaunch, or start a fresh one with --director --replace")" >&2
    exit 73; }
  spawned="$(spawn "$existing")"
  repoint "$spawned"
  reflect_due
  echo "workspace=$existing $spawned"; kickoff; exit 0
fi

out="$(herdr workspace create --label "$name" --cwd "$cwd" --no-focus)"
workspace="$(jq -r '.result.workspace.workspace_id // empty' <<<"$out")"
seed="$(jq -r '.result.tab.tab_id // empty' <<<"$out")"
[[ -n "$workspace" && -n "$seed" ]] || { echo "octo-feather-start: workspace create returned no workspace or tab" >&2; exit 1; }
spawned="$(spawn "$workspace")" || {
  rc=$?; herdr workspace close "$workspace" >/dev/null 2>&1 || true; exit "$rc"; }
# The workspace's seed tab is a bare shell; the agent's tab is the only one left.
herdr tab close "$seed" >/dev/null
repoint "$spawned"
reflect_due
echo "workspace=$workspace $spawned"
kickoff
