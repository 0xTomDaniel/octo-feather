#!/usr/bin/env python3
"""octo-feather-lane: the command's launcher. Its code, scripts/octo_feather_lane.py, is
imported, so Python caches its bytecode (scripts/__pycache__/), which it never does for the
__main__ script; on a read-only tree it compiles the module each run instead. Code that needs
the lane's functions imports octo_feather_lane, never this file."""

import sys

from octo_feather_lane import main

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
