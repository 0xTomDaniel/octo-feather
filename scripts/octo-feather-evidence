#!/usr/bin/env python3
"""octo-feather-evidence: a target's evidence store (quality spec #evidence-store, docs/adr/0025)

  octo-feather-evidence append --criterion SPEC#ANCHOR --outputs DIR [--criterion-text TEXT] [--repo DIR]
  octo-feather-evidence read [--criterion SPEC#ANCHOR] [--commit REV] [--repo DIR | --target KEY] [--json]
  octo-feather-evidence where [--repo DIR | --target KEY]

One store per target, append-only, in the box's local state and never in git:
  ${XDG_STATE_HOME:-~/.local/state}/octo-feather/evidence/<target>/records/<id>/{record.json,outputs/}
shared by every Herdr session (evidence belongs to the target, not to a session). <target> is the
target's root commit (the smallest of `git rev-list --max-parents=0 HEAD`): the same on every clone and
box, unlike its path or origin URL. A record is never rewritten: append writes a new record folder
(files read-only) and moves it in whole; nothing here deletes or edits one.

append (the verify skill runs it once per drive) records the repo at --repo (default: the current
directory's) and copies every file under --outputs DIR into the record; prints the record id. Each key,
and where its value comes from (--criterion-text: see criterion.text_from there):
schemas/evidence.v1.schema.json.

read lists the records of the target, filtered by criterion id and by commit (a revision --repo resolves,
else a hex prefix of the recorded revision), oldest first: each with its keys and its outputs' content.
--json prints a JSON array of {"record": <record.json>, "dir": <its folder>}. No match prints zero
records and exits 0. where prints the target's store folder.

Exit 0 on success; 1 on a refusal (named, with the fix); 2 on usage.
"""
import argparse, datetime, hashlib, html.parser, json, os, re, secrets, shutil, subprocess, sys, tomllib

ME = "octo-feather-evidence"
FORMAT = 1
SCHEMAS = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "schemas")
CRITERION = re.compile(r"^([a-z0-9][a-z0-9._-]*)#([A-Za-z0-9][A-Za-z0-9._-]*)$")
SHOW_LINES = 40


class Refused(Exception):
    pass


def git(repo, *args):
    p = subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True)
    if p.returncode:
        raise Refused(f"git {' '.join(args)} in {repo}: {p.stderr.strip() or 'failed'}")
    return p.stdout


def target_of(repo):
    try:
        roots = git(repo, "rev-list", "--max-parents=0", "HEAD").split()
    except Refused as e:
        raise Refused(f"{repo} is not a git repo with a commit, so it has no target key ({e})") from None
    return min(roots)


def store_of(target):
    base = os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state")
    return os.path.join(base, "octo-feather", "evidence", target)


def sha256(data):
    return hashlib.sha256(data).hexdigest()


def norm(text):
    return " ".join(text.split())


class AnchorText(html.parser.HTMLParser):
    """Text of the first element whose data-anchor (or id) is ANCHOR."""
    VOID = {"area", "base", "br", "col", "embed", "hr", "img", "input", "link", "meta", "source", "track", "wbr"}

    def __init__(self, anchor):
        super().__init__(convert_charrefs=True)
        self.anchor, self.depth, self.found, self.parts = anchor, 0, False, []

    def handle_starttag(self, tag, attrs):
        if self.depth:
            self.depth += tag not in self.VOID
        elif not self.found and tag not in self.VOID and self.anchor in (dict(attrs).get("data-anchor"), dict(attrs).get("id")):
            self.found, self.depth = True, 1

    def handle_endtag(self, tag):
        if self.depth and tag not in self.VOID:
            self.depth -= 1

    def handle_data(self, data):
        if self.depth:
            self.parts.append(data)


def criterion_text(repo, cid, given):
    spec, anchor = CRITERION.match(cid).groups()
    path = os.path.join(repo, "docs", "specs", f"{spec}.spec.html")
    if os.path.isfile(path):
        p = AnchorText(anchor)
        with open(path, encoding="utf-8") as fh:
            p.feed(fh.read())
        if p.found and norm("".join(p.parts)):
            return norm("".join(p.parts)), "spec"
    if given is not None and norm(given):
        return norm(given), "caller"
    raise Refused(f"no text for criterion {cid}: docs/specs/{spec}.spec.html in the repo has no element with anchor "
                  f"{anchor}; pass the caller's copy with --criterion-text")


def tree_hash(path):
    h = hashlib.sha256()
    if os.path.isfile(path):
        with open(path, "rb") as fh:
            h.update(fh.read())
    elif os.path.isdir(path):
        for d, dirs, files in os.walk(path):
            dirs.sort()
            for f in sorted(files):
                p = os.path.join(d, f)
                h.update(os.path.relpath(p, path).encode() + b"\0")
                with open(p, "rb") as fh:
                    h.update(sha256(fh.read()).encode() + b"\0")
    else:
        h.update(b"missing")
    return h.hexdigest()


def contract_and_fixture(repo):
    path = os.path.join(repo, "qc.toml")
    try:
        with open(path, "rb") as fh:
            raw = fh.read()
    except FileNotFoundError:
        return None, None
    try:
        doc = tomllib.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, tomllib.TOMLDecodeError) as e:
        raise Refused(f"{path}: not TOML ({e}); validate it with octo-feather-contract") from None
    fmt = doc.get("format") if type(doc.get("format")) is int else None
    fixtures = doc.get("fixture") if isinstance(doc.get("fixture"), dict) else {}
    fixture = None
    if fixtures:
        h = hashlib.sha256()
        for name in sorted(fixtures):
            f = fixtures[name] if isinstance(fixtures[name], dict) else {}
            h.update(json.dumps([name, f.get("reset"), f.get("path")]).encode() + b"\0")
            if isinstance(f.get("path"), str):
                h.update(tree_hash(os.path.join(repo, f["path"])).encode() + b"\0")
        fixture = {"sha256": h.hexdigest(), "names": sorted(fixtures)}
    return {"format": fmt, "sha256": sha256(raw)}, fixture


def output_files(root):
    if not os.path.isdir(root):
        raise Refused(f"--outputs {root} is not a folder: pass the drive's evidence folder")
    found = []
    for d, dirs, files in os.walk(root):
        dirs.sort()
        for f in sorted(files):
            p = os.path.join(d, f)
            if not os.path.isfile(p) or os.path.islink(p):
                raise Refused(f"{p}: not a regular file; outputs are plain files")
            found.append((os.path.relpath(p, root).replace(os.sep, "/"), p))
    if not found:
        raise Refused(f"--outputs {root} holds no file: a drive's record holds its captured outputs")
    return found


def repo_root(arg):
    try:
        return git(arg or ".", "rev-parse", "--show-toplevel").strip()
    except Refused:
        raise Refused(f"{os.path.abspath(arg or '.')} is not in a git repo: pass --repo, the target's checkout") from None


def append(a):
    if not CRITERION.match(a.criterion):
        raise Refused(f"criterion {a.criterion!r} is not SPEC#ANCHOR (e.g. templates#acceptance-cli-json)")
    repo = repo_root(a.repo)
    target, revision = target_of(repo), git(repo, "rev-parse", "HEAD").strip()
    dirty = bool(git(repo, "status", "--porcelain=v1").strip())
    text, text_from = criterion_text(repo, a.criterion, a.criterion_text)
    contract, fixture = contract_and_fixture(repo)
    files = output_files(a.outputs)
    now = datetime.datetime.now(datetime.timezone.utc)
    rid = f"{now:%Y%m%dT%H%M%SZ}-{secrets.token_hex(4)}"
    store = store_of(target)
    stage = os.path.join(store, ".staging", rid)
    final = os.path.join(store, "records", rid)
    os.makedirs(os.path.join(stage, "outputs"))
    try:
        outputs = write_stage(stage, files)
        record = {"format": FORMAT, "id": rid, "target": target, "revision": revision, "dirty": dirty,
                  "criterion": {"id": a.criterion, "text_sha256": sha256(text.encode()), "text_from": text_from},
                  "contract": contract, "fixture": fixture, "outputs": outputs, "time": f"{now:%Y-%m-%dT%H:%M:%SZ}"}
        with open(os.path.join(stage, "record.json"), "x", encoding="utf-8") as fh:
            json.dump(record, fh, indent=2, sort_keys=True)
            fh.write("\n")
        os.chmod(os.path.join(stage, "record.json"), 0o444)
        os.makedirs(os.path.dirname(final), exist_ok=True)
        if os.path.exists(final):
            raise Refused(f"record {rid} already exists; append again")
        os.rename(stage, final)
    finally:
        if os.path.exists(stage):
            shutil.rmtree(stage)
    print(rid)


def write_stage(stage, files):
    """Copy each (name, source) into STAGE/outputs/name, read-only; return the record's outputs."""
    outputs = {}
    for name, src in files:
        dst = os.path.join(stage, "outputs", name)
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        shutil.copyfile(src, dst)
        with open(dst, "rb") as fh:
            data = fh.read()
        outputs[name] = {"sha256": sha256(data), "bytes": len(data)}
        os.chmod(dst, 0o444)
    return outputs


def supported():
    return {int(m[1]) for f in os.listdir(SCHEMAS) if (m := re.fullmatch(r"evidence\.v(\d+)\.schema\.json", f))}


def target_arg(a):
    if a.target:
        if not re.fullmatch(r"[0-9a-f]{40,64}", a.target):
            raise Refused(f"--target {a.target!r} is not a root commit id (`{ME} where` in its checkout prints its store)")
        return a.target, None
    repo = repo_root(a.repo)
    return target_of(repo), repo


def read(a):
    if a.criterion and not CRITERION.match(a.criterion):
        raise Refused(f"criterion {a.criterion!r} is not SPEC#ANCHOR (e.g. templates#acceptance-cli-json)")
    target, repo = target_arg(a)
    want = None
    if a.commit:
        full = None
        if repo:
            p = subprocess.run(["git", "-C", repo, "rev-parse", "--verify", "--quiet", a.commit + "^{commit}"], capture_output=True, text=True)
            full = p.stdout.strip() if p.returncode == 0 else None
        if full:
            want = lambda rev: rev == full  # noqa: E731
        elif re.fullmatch(r"[0-9a-f]{4,64}", a.commit):
            want = lambda rev: rev.startswith(a.commit)  # noqa: E731
        else:
            raise Refused(f"commit {a.commit!r} names no commit" + (" in the repo" if repo else "") + ": pass a commit id")
    formats, records = supported(), []
    root = os.path.join(store_of(target), "records")
    for rid in sorted(os.listdir(root)) if os.path.isdir(root) else []:
        d = os.path.join(root, rid)
        try:
            with open(os.path.join(d, "record.json"), encoding="utf-8") as fh:
                r = json.load(fh)
        except (OSError, ValueError) as e:
            raise Refused(f"record {d}: unreadable ({e})") from None
        if r.get("format") not in formats:
            raise Refused(f"record {d}: format {r.get('format')!r} is not one this kit reads ({sorted(formats)}); update the kit")
        if a.criterion and r["criterion"]["id"] != a.criterion:
            continue
        if want and not want(r["revision"]):
            continue
        records.append({"record": r, "dir": d})
    if a.json:
        print(json.dumps(records, indent=2))
        return
    what = ", ".join(x for x in (a.criterion and f"criterion {a.criterion}", a.commit and f"commit {a.commit}") if x) or "all"
    print(f"{ME}: target {target[:12]}, {what}: {len(records)} record(s)")
    for item in records:
        r, d = item["record"], item["dir"]
        c, k, f = r["criterion"], r["contract"], r["fixture"]
        print(f"record {r['id']}")
        print(f"  revision {r['revision']}" + (" (dirty work tree)" if r["dirty"] else ""))
        print(f"  criterion {c['id']} text sha256 {c['text_sha256']} (text from {c['text_from']})")
        print("  contract none" if k is None else f"  contract qc.toml format {k['format']} sha256 {k['sha256']}")
        print("  fixture none" if f is None else f"  fixture sha256 {f['sha256']} ({', '.join(f['names'])})")
        print(f"  time {r['time']}")
        print(f"  outputs {len(r['outputs'])} in {d}/outputs")
        for name, o in sorted(r["outputs"].items()):
            print(f"    {name} ({o['bytes']} bytes, sha256 {o['sha256'][:12]})")
            try:
                with open(os.path.join(d, "outputs", name), encoding="utf-8") as fh:
                    lines = fh.read().splitlines()
            except UnicodeDecodeError:
                print("      (binary)")
                continue
            for line in lines[:SHOW_LINES]:
                print(f"      | {line}")
            if len(lines) > SHOW_LINES:
                print(f"      ... {len(lines) - SHOW_LINES} more lines")


def where(a):
    print(store_of(target_arg(a)[0]))


def main(argv):
    ap = argparse.ArgumentParser(prog=ME, description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("append", help="append one record for a drive; prints its id")
    p.add_argument("--criterion", required=True)
    p.add_argument("--criterion-text")
    p.add_argument("--outputs", required=True)
    p.add_argument("--repo")
    for name, fn in (("read", "list records by criterion and commit"), ("where", "print the target's store folder")):
        q = sub.add_parser(name, help=fn)
        g = q.add_mutually_exclusive_group()
        g.add_argument("--repo")
        g.add_argument("--target")
        if name == "read":
            q.add_argument("--criterion")
            q.add_argument("--commit")
            q.add_argument("--json", action="store_true")
    a = ap.parse_args(argv)
    try:
        {"append": append, "read": read, "where": where}[a.cmd](a)
    except Refused as e:
        print(f"{ME}: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
