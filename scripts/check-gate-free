#!/usr/bin/env python3
"""The gate never reaches the product judge (qc, octo-feather-qc, Jev) or the
factory evals (qa): quality spec #acceptance-gate-no-model.

Run by the justfile's top-level guard assignment, which just evaluates before
any recipe runs, so a gate that would reach them fails before running one.
Reads the parsed justfile (`just --dump --dump-format json`), takes every
recipe named check or check-* plus everything they reach through just's own
dependency edges (before and after `&&`), and fails when that closure holds qa
or qc. What a recipe body, parameter default or dependency argument runs (a
nested `just qa`, octo-feather-qc, a repo script) is caught at run time by the
marker below, where the launch itself happens; no word or token in the text
stands in for it (a proxy for reachability, docs/adr/0008, #118).

The justfile: the one beside this script's scripts/ dir, or, where /proc shows
the parent just's argv, the --justfile/-f it was given (`just --justfile X
--working-directory Y` runs backticks in Y, not beside X).

Stdout is exactly `gate-free: ok` on pass; the justfile treats anything else
as failure. Fails closed: a just error, unparsable dump or unexpected shape
exits 2 with a message, never ok. Stdlib only.

The static scan cannot see what a repo script a gate recipe runs does, so a
check run also carries a runtime marker:

  check-gate-free --run   prints OCTO_FEATHER_CHECK_RUN for this just run,
      which the justfile exports to every recipe (and so to any nested just,
      script or tool they start): an inherited marker naming a live just is
      kept, so the outermost check run owns it however deep a nested just asks
      for check-*; else, when the just that ran this backtick runs a check or
      check-* recipe (dependencies included, as just itself answers: just_runs
      below), a new marker naming that just's pid; when just cannot answer for
      that argv (`just -q check`: -q conflicts with the dry run), fails closed:
      a new marker too, carrying just's reason, so qa and the judge refuse
      under it; else the inherited marker, if any.
  check-gate-free --refuse WHAT   run where qa or the judge would start:
      outside a check run prints `gate-free: ok`; inside one, whatever it would
      launch, names WHAT on stderr, stops the outermost check run (SIGTERM to
      its just, so a script that swallows the refusal still fails the gate) and
      exits 1. A caller treats anything but the ok line as refusal. The qc capture of tagged tests
      (octo-feather-qc --capture-case, --capture-store) runs inside the full gate by design and never
      asks: it calls no model and decides nothing (quality spec #qc-capture); the marker stays set.
  check-gate-free --with-run   the scan, then, only when it passed, the --run marker on a second line:
      one process answering the justfile's two values (#692: a python start each was most of their cost).

Stated limit: like `env -i`, a script that deliberately clears or forges the
marker starts outside the check run, and nothing here can tell it from one
that does not; a test harness that runs qa or the judge clears it at its own
boundary, visibly.
"""
import json, os, re, signal, subprocess, sys

FORBIDDEN_RECIPES = ("qa", "qc")
FIX = "just check stays deterministic and free: the gate never runs the product judge or the factory evals (docs/future.md)"


def die(msg):
    print(f"check-gate-free: error: {msg}; the gate cannot pass", file=sys.stderr)
    sys.exit(2)


MARKER = "OCTO_FEATHER_CHECK_RUN"
CHECK_RECIPE = re.compile(r"check(-[A-Za-z0-9_-]+)?")
RUNNING = re.compile(r"^===> Running recipe `([^`]+)`\.\.\.$", re.M)


def just_runs(args, cwd=None):
    """(the recipes `just ARGS` run in CWD runs, in order, dependencies included, as just itself answers; or None
    and the reason just gave no such answer). There is no "runs no recipe" answer: a dry run that names no
    recipe (another just's wording, mise.toml pins it) is unanswered, so callers fail closed. The one source of what a just command line runs, shared with
    octo-feather-lane; no model of just's options or recipe arities here (docs/adr/0008). Executes nothing:
    just first parses ARGS beside --completions, which reads no justfile, and only when its one objection is
    the recipe words and overrides themselves (`--completions` used with unexpected ...), so no subcommand
    such as --show, --list or --command is among them, dry-runs ARGS with --verbose: just resolves recipes
    and their parameters, names each recipe it would run, and evaluates no backtick. Anything else, an
    option that conflicts with --dry-run (-q) included, is just's reason, never a guess."""
    def just(*a):
        p = subprocess.run(["just", *a, *args], cwd=cwd, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=60)
        err = re.sub(r"\x1b\[[0-9;]*m", "", p.stderr)
        return p.returncode, err, (err.strip().splitlines() or [f"exit {p.returncode}"])[0]
    rc, err, line = just("--completions", "bash")
    if rc and not err.startswith("error: `--completions` used with unexpected "):
        return None, line
    rc, err, line = just("--dry-run", "--verbose")
    if rc:
        return None, line
    names = RUNNING.findall(err)
    return (names, "") if names else (None, "its dry run named no recipe it runs (mise.toml pins the just whose answer this reads)")


def argv_of(pid):
    """A process's argv: /proc where there is one, else ps (macOS: split on whitespace); None if gone."""
    try:
        return open(f"/proc/{pid}/cmdline", "rb").read().decode(errors="replace").split("\0")[:-1]
    except FileNotFoundError:
        if os.path.isdir("/proc/self"):
            return None
    except OSError:
        return None
    p = subprocess.run(["ps", "-o", "args=", "-p", str(pid)], capture_output=True, text=True)
    return p.stdout.split() if p.returncode == 0 and p.stdout.strip() else None


def is_just(argv):
    return bool(argv) and os.path.basename(argv[0]).startswith("just")


def asks_check(argv, cwd=None):
    """(True when a just argv, run in CWD, runs a check or check-* recipe, as just itself answers (just_runs);
    just's reason when it cannot answer, which counts as a check run: the gate fails closed.)"""
    try:
        names, why = just_runs(argv[1:], cwd)
    except (OSError, subprocess.TimeoutExpired) as e:
        return True, f"{type(e).__name__}: {e}"
    if names is None:
        return True, why
    return any(CHECK_RECIPE.fullmatch(n) for n in names), ""


def marker_just(raw):
    """The check run's just pid a marker names; ValueError, KeyError or TypeError when unreadable."""
    return int(json.loads(raw)["just"])


def run_marker():
    inherited = os.environ.get(MARKER, "")
    try:
        if inherited and is_just(argv_of(marker_just(inherited))):
            print(inherited); return   # the outermost check run owns the marker
    except (ValueError, KeyError, TypeError):
        pass
    ppid = os.getppid()
    argv = argv_of(ppid)
    try:
        cwd = os.readlink(f"/proc/{ppid}/cwd")
    except OSError:
        cwd = None
    check, why = asks_check(argv, cwd) if is_just(argv) else (False, "")
    if check:
        print(json.dumps({"just": ppid, **({"unanswered": why} if why else {})}, separators=(",", ":")))
    else:
        print(inherited)


def refuse(args):
    what = args[0] if len(args) == 1 else ""
    if not what:
        die("usage: check-gate-free --refuse WHAT")
    raw = os.environ.get(MARKER, "")
    if not raw:
        print("gate-free: ok"); return
    try:
        root = marker_just(raw)
    except (ValueError, KeyError, TypeError) as e:
        print(f"check-gate-free: unreadable {MARKER} ({type(e).__name__}); refusing {what}", file=sys.stderr)
        root = None
    try:
        why = json.loads(raw).get("unanswered", "")
    except (ValueError, AttributeError):
        why = ""
    if why:
        print(f"check-gate-free: just pid {root} counts as a check run: just cannot say what its command line runs ({why})", file=sys.stderr)
    print(f"check-gate-free: a check run (just pid {root}) reached {what}; {FIX}", file=sys.stderr)
    if root and is_just(argv_of(root)):
        try:
            os.kill(root, signal.SIGTERM)   # just finishes the running recipe, then exits non-zero
        except OSError:
            pass
    sys.exit(1)


def parent_justfile():
    """The --justfile/-f of the just that ran this backtick, when /proc shows it; else None."""
    ppid = os.getppid()
    try:
        argv = open(f"/proc/{ppid}/cmdline", "rb").read().decode().split("\0")[:-1]
        cwd = os.readlink(f"/proc/{ppid}/cwd")
    except OSError:
        return None
    if not argv or not os.path.basename(argv[0]).startswith("just"):
        return None
    for i, a in enumerate(argv[1:], 1):
        if a == "--":
            break
        if a in ("--justfile", "-f") and i + 1 < len(argv):
            return os.path.join(cwd, argv[i + 1])
        if a.startswith("--justfile="):
            return os.path.join(cwd, a.split("=", 1)[1])
        if a.startswith("-f") and len(a) > 2:
            return os.path.join(cwd, a[2:])
    return None


def main():
    with_run = sys.argv[1:2] == ["--with-run"]
    if with_run:
        del sys.argv[1]
    if sys.argv[1:2] == ["--run"]:
        return run_marker()
    if sys.argv[1:2] == ["--refuse"]:
        return refuse(sys.argv[2:])
    root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    path = sys.argv[1] if len(sys.argv) > 1 else parent_justfile() or os.path.join(root, "justfile")
    try:
        p = subprocess.run(["just", "--justfile", path, "--dump", "--dump-format", "json"],
                           capture_output=True, text=True)
    except OSError as e:
        die(f"cannot run just: {e}")
    if p.returncode != 0:
        sys.stderr.write(p.stderr)
        die(f"just --dump exited {p.returncode}")
    try:
        dump = json.loads(p.stdout)
        recipes = dump["recipes"]
        edges = {name: [d["recipe"] for d in r["dependencies"]] for name, r in recipes.items()}
    except (ValueError, KeyError, TypeError, AttributeError) as e:
        die(f"unexpected just --dump JSON ({type(e).__name__}: {e})")

    roots = sorted(n for n in recipes if n == "check" or n.startswith("check-"))
    if "check" not in recipes:
        die("no check recipe in the justfile")
    via = {r: [r] for r in roots}
    queue = list(roots)
    while queue:
        n = queue.pop(0)
        for m in edges.get(n, []):
            if m not in via:
                via[m] = via[n] + [m]
                queue.append(m)
    bad = []
    for n in sorted(via):
        chain = " -> ".join(via[n])
        if n in FORBIDDEN_RECIPES:
            bad.append(f"recipe {chain} reaches `{n}`")
    if bad:
        for b in dict.fromkeys(bad):
            print(f"check-gate-free: {b}", file=sys.stderr)
        print(f"check-gate-free: the gate recipes above reach the product judge or factory evals; {FIX}", file=sys.stderr)
        sys.exit(1)
    print("gate-free: ok")
    if with_run:
        run_marker()


if __name__ == "__main__":
    try:
        main()
    except SystemExit:
        raise
    except Exception as e:  # noqa: BLE001  fail closed on any internal error
        die(f"{type(e).__name__}: {e}")
