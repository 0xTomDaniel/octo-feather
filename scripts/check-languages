#!/usr/bin/env python3
"""Every language in the kit's tracked files has its lint and type step in `just check`.

Owner rulings: issue #225 (2026-10-27: every tracked language gated, from a declared mapping) and
issue #261 (2026-10-29: scc classifies, a small comparison checks, mise owns the native pins).

Inputs, each the tool's own answer: `git ls-files`; scc (pinned in mise.toml) walking the repo;
each gate tool's own file list (ruff: `octo-feather-lint files`, which basedpyright gets whole;
ShellCheck: `just shell-files`; tsc: `tsc --showConfig`, which eslint gets whole in check-ts);
GATE_RECIPES from `just --dump`; `mise ls --local --json`; package.json. The mapping (LANGUAGES,
DATA, LOCKFILES, EXEMPT) is declared below.

Fails, naming each file and its fix, when:
  1. scc names a tracked file's type Unknown (LOCKFILES, tool-written lockfiles, excepted);
  2. scc finds a language that is neither mapped to gate tools nor declared DATA;
  3. a mapped tool's own file list misses a file of its language;
  4. a mapped tool's recipe is not in GATE_RECIPES;
  5. a tracked file scc does not list starts with `#!`: scc cannot read that shebang (it drops
     `env -S` forms), so its language is unknown;
  6. mise.toml pins pnpm and package.json has `packageManager`: two pnpm pins.
Passes by design: a tracked file scc does not list and that does not start with `#!` (justfile,
.gitignore, LICENSE, version files): no language is found in it, and the ruling gates the
languages found. Paths under EXEMPT are not scanned. scc walks the directory, never a file list:
scc 4.1.0 skips the shebang of a file named on its command line under a dot directory.
"""

import json
import shutil
import subprocess
import sys
from pathlib import Path
from typing import cast

# Each language scc can name -> the gate tools that must cover its files (scc's language names).
LANGUAGES = {
    "Python": ("ruff", "basedpyright"),
    "Shell": ("shellcheck",),
    "BASH": ("shellcheck",),
    "TypeScript": ("tsc", "eslint"),
    "JavaScript": ("tsc", "eslint"),
}
# Languages that are data, with no lint or type step: a new one is a decision, made here.
DATA = {
    "Markdown",
    "JSON",
    "JSONL",
    "TOML",
    "YAML",
    "HTML",
    "CSS",
    "Patch",
    "Plain Text",
    "License",
}
# Tool-written lockfiles scc calls Unknown (a .lock extension), by file name: never hand-edited.
LOCKFILES = {"uv.lock", "mise.lock", "Skillfile.lock"}
# Each gate tool: the GATE_RECIPES recipe that runs it, and the fix when its list misses a file.
RECIPES = {
    "ruff": "check-lint",
    "basedpyright": "check-types",
    "shellcheck": "check-scripts",
    "tsc": "check-ts",
    "eslint": "check-ts",
}
FIX = {
    "ruff": "name it in pyproject.toml [tool.ruff] extend-include, or out of its extend-exclude",
    "basedpyright": "name it in pyproject.toml [tool.ruff] extend-include (it gets ruff's list)",
    "shellcheck": "give it the `shell` attribute in .gitattributes",
    "tsc": "add it to tsconfig.json include (a dot path by name), or out of its exclude",
    "eslint": "add it to tsconfig.json include: eslint gets tsc's list (check-ts)",
}
# Trees not scanned, each with its reason; vendored skills (Skillfile `github` entries) join them.
EXEMPT = {
    "templates/": "each template is a target repo with its own gate and check-languages",
    "evals/": "eval fixtures and judgment sources: deliberately flawed data the cases grade",
    "evidence/": "frozen records of past runs",
    "docs/specs/.viz/": "Spec Chat's vendored runtime (NOTICE)",
    "docs/specs/.style/": "Spec Chat's vendored style (NOTICE)",
}
UV = ["uv", "run", "--locked", "--offline", "--no-sync"]
SCC = ["scc", "--by-file", "--format", "json", "--count-unsupported", "--no-config"]
SKILLFILE_NAME = 2  # Skillfile columns: kind, type, name, ...


class UnansweredError(Exception):
    """A tool gave no usable answer: the check cannot pass."""


def missing_tool(tool: str) -> str:
    """The fix for a tool not on PATH, as mise answers for this repo's mise.toml."""
    mise = shutil.which("mise")
    if mise is None:
        return "mise is not on PATH: install mise at mise-version, then: mise install --locked"
    r = subprocess.run([mise, "which", tool], capture_output=True, text=True, check=False)
    if r.returncode == 0:
        return (
            f"{tool} is installed ({r.stdout.strip()}) but not on PATH: run this through just"
            " (the justfile puts this repo's mise tools on PATH), or put mise's shims first"
        )
    return f"{tool} is not installed: mise install --locked (mise.toml, mise.lock)"


def ask(cmd: list[str], fix: str) -> str:
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, check=False)
    except OSError as e:
        msg = f"cannot run {cmd[0]}: {e}; {missing_tool(cmd[0])}"
        raise UnansweredError(msg) from e
    if r.returncode != 0:
        msg = f"{' '.join(cmd)} exited {r.returncode}: {r.stderr.strip()}; {fix}"
        raise UnansweredError(msg)
    return r.stdout


def vendored() -> set[str]:
    rows = (line.split() for line in Path("Skillfile").read_text(encoding="utf-8").splitlines())
    return {f".agents/skills/{w[SKILLFILE_NAME]}/" for w in rows if w[:1] == ["github"]}


def scc_languages(scanned: set[str]) -> dict[str, str]:
    out = ask([*SCC, "--no-scc-ignore", "."], "scc failed")
    found: dict[str, str] = {}
    rows: list[dict[str, object]] = json.loads(out)
    for lang in rows:
        files = cast("list[dict[str, object]]", lang.get("Files") or [])
        for f in files:
            path = str(f["Location"]).removeprefix("./")
            if path in scanned:
                found[path] = str(lang["Name"])
    return found


def tool_files() -> dict[str, set[str]]:
    python = set(ask([*UV, "octo-feather-lint", "files"], "fetch: uv sync --locked").split())
    shell = set(ask(["just", "--justfile", "justfile", "shell-files"], "fix the recipe").split())
    fetch = "fetch the kit's TypeScript tools once, with network: pnpm install --frozen-lockfile"
    cfg = json.loads(ask(["pnpm", "exec", "tsc", "--showConfig"], fetch))
    ts = {str(f).removeprefix("./") for f in cfg.get("files", [])}
    return {"ruff": python, "basedpyright": python, "shellcheck": shell, "tsc": ts, "eslint": ts}


def gate_recipes() -> set[str]:
    cmd = ["just", "--justfile", "justfile", "--dump", "--dump-format", "json"]
    value = json.loads(ask(cmd, "fix the justfile"))["assignments"]["GATE_RECIPES"]["value"]
    if not isinstance(value, str):
        msg = "justfile: GATE_RECIPES must be a literal list of recipe names"
        raise UnansweredError(msg)
    return set(value.split())


def both_pnpm_pins() -> list[str]:
    pins = json.loads(ask(["mise", "ls", "--local", "--json"], "mise failed"))
    package = Path("package.json")
    manifest: dict[str, object] = (
        json.loads(package.read_text(encoding="utf-8")) if package.is_file() else {}
    )
    if "pnpm" not in pins or "packageManager" not in manifest:
        return []
    return [
        (
            "package.json: packageManager and mise.toml [tools] pnpm both pin pnpm; delete"
            " packageManager: mise owns pnpm (owner ruling, issue #261), and pnpm's switch to"
            " packageManager would override it and need the network"
        )
    ]


def unreadable_shebangs(unlisted: set[str]) -> list[str]:
    bad: list[str] = []
    for f in sorted(unlisted):
        with Path(f).open("rb") as h:
            if h.read(2) == b"#!":
                bad.append(
                    f"{f}: scc cannot name the language of its shebang (it drops `env -S` forms);"
                    " start it with #!/usr/bin/env <interpreter> or give it an extension"
                )
    return bad


def language_findings(
    lang: str, files: list[str], lists: dict[str, set[str]], gate: set[str]
) -> list[str]:
    if lang in DATA:
        return []
    if lang == "Unknown":
        return [
            f"{f}: scc does not know this file type; give it a known extension, or exempt its"
            " tree in scripts/check-languages EXEMPT with the reason"
            for f in sorted(files)
            if Path(f).name not in LOCKFILES
        ]
    if lang not in LANGUAGES:
        return [
            (
                f"{lang} ({', '.join(sorted(files))}) has no lint or type step: add its tools to"
                " the gate and to LANGUAGES in scripts/check-languages, or declare it DATA there"
            )
        ]
    bad: list[str] = []
    for tool in LANGUAGES[lang]:
        if RECIPES[tool] not in gate:
            bad.append(
                f"{tool} gates {lang}, but its recipe {RECIPES[tool]} is not in the justfile's"
                " GATE_RECIPES"
            )
        bad.extend(
            f"{f}: {lang}, but {tool}'s own file list misses it; {FIX[tool]}"
            for f in sorted(set(files) - lists[tool])
        )
    return bad


def main() -> int:
    tracked = set(ask(["git", "ls-files", "-z"], "run in the repo").split("\0")) - {""}
    exempt = (*EXEMPT, *sorted(vendored()))
    scanned = {
        f
        for f in tracked
        if not f.startswith(exempt) and Path(f).is_file() and not Path(f).is_symlink()
    }
    found = scc_languages(scanned)
    lists, gate = tool_files(), gate_recipes()
    by_lang: dict[str, list[str]] = {}
    for f, lang in found.items():
        by_lang.setdefault(lang, []).append(f)
    bad = unreadable_shebangs(scanned - found.keys())
    for lang, files in sorted(by_lang.items()):
        bad += language_findings(lang, files, lists, gate)
    bad += both_pnpm_pins()
    for line in bad:
        sys.stderr.write(f"check-languages: {line}\n")
    if bad:
        return 1
    counts = ", ".join(f"{lang}={len(files)}" for lang, files in sorted(by_lang.items()))
    sys.stdout.write(f"languages: ok ({len(scanned)} tracked files scanned; {counts})\n")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (UnansweredError, OSError, ValueError, KeyError) as e:
        sys.exit(f"check-languages: {e}")
