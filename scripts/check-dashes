#!/usr/bin/env python3
"""check-dashes: the dash rule (#121 D7) over the kit's tracked files; `just check-dashes` runs it.

The rule and its carve-outs: check_dashes in scripts/check_rules.py, imported by name (Python puts
this script's own directory, symlinks resolved, first on sys.path; never a load by file path).
This command lists the files (`git ls-files -z`), prints the Report's lines, each to its stream,
and exits with its code: 0 ok, 1 dashes found or a file unreadable, 2 git or an internal error
(fails closed, never ok).
"""

import os
import subprocess
import sys
from pathlib import Path

from check_rules import Stream, check_dashes

ROOT = Path(__file__).resolve().parent.parent


def say(stream: Stream, line: bytes) -> None:
    out = sys.stdout.buffer if stream == "out" else sys.stderr.buffer
    out.write(line + b"\n")
    out.flush()  # each line in order when both streams go to one place


def main() -> int:
    git = subprocess.run(["git", "-C", ROOT, "ls-files", "-z"], capture_output=True, check=False)  # noqa: S607
    if git.returncode != 0:
        sys.stderr.buffer.write(git.stderr)
        why = f"check-dashes: git ls-files exited {git.returncode}; the check cannot pass"
        say("err", why.encode())
        return 2
    report = check_dashes(ROOT, [os.fsdecode(p) for p in git.stdout.split(b"\0") if p])
    for stream, line in report.lines:
        say(stream, line)
    return report.code


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as e:  # noqa: BLE001  fail closed: an internal error is never ok
        say("err", f"check-dashes: error: {type(e).__name__}: {e}".encode())
        sys.exit(2)
