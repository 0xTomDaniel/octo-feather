#!/usr/bin/env bash
# issue-view KEY: one issue as JSON {key, title, body, state, url, parent, children, blocked_by}; keys are strings,
# state open or done (a completed or canceled state is done), parent null when it has none, children its
# sub-issues' keys. Wraps `linear api`. --notes adds notes: [{at, edited_at, url, body}], the description first, then
# each comment by creation: at its creation, edited_at its last edit (null: never edited). Linear keeps no edit time for
# a description: its edited_at is the issue's updatedAt when that differs from createdAt, an upper bound (a later
# state move counts too), so a reader comparing times may refuse a description in time, never pass a late one.
set -euo pipefail
notes=0; [[ $# == 2 && "$2" == --notes ]] && { notes=1; set -- "$1"; }
[[ $# == 1 ]] || { echo "usage: issue-view KEY [--notes]" >&2; exit 64; }
[[ "$1" =~ ^[A-Za-z][A-Za-z0-9]*-[0-9]+$ ]] || { echo "issue-view: $1 is not a Linear issue key (TEAM-123)" >&2; exit 1; }
# Blocked by: relations of type blocks pointing at this issue (its inverseRelations), as `linear issue relation list` reads them.
query='query IssueView($id: String!) { issue(id: $id) { identifier title description url state { type }
  parent { identifier } children(first: 250) { nodes { identifier } pageInfo { hasNextPage } }
  inverseRelations(first: 250) { nodes { type issue { identifier } } } } }'
out="$(linear api --no-input --variable "id=${1^^}" "$query" 2>&1)" || { echo "issue-view: $out" >&2; exit 1; }
# A partial sub-issue list would read as the whole: refuse it.
if jq -e '.data.issue.children.pageInfo.hasNextPage == true' <<<"$out" >/dev/null 2>&1; then
  echo "issue-view: ${1^^} has more than 250 sub-issues; split the parent" >&2; exit 1
fi
view="$(jq -e '(.data.issue // empty) | {key: .identifier, title, body: (.description // ""),
  state: (if .state.type == "completed" or .state.type == "canceled" or .state.type == "duplicate" then "done" else "open" end),
  url, parent: (.parent.identifier // null), children: [.children.nodes[].identifier], blocked_by: [.inverseRelations.nodes[] | select(.type == "blocks") | .issue.identifier]}' \
  <<<"$out" 2>/dev/null)" || { echo "issue-view: linear api printed no issue ${1^^}: $out" >&2; exit 1; }
((notes)) || { printf '%s\n' "$view"; exit 0; }
query='query IssueNotes($id: String!) { issue(id: $id) { url createdAt updatedAt description
  comments(first: 250) { nodes { url createdAt editedAt body } pageInfo { hasNextPage } } } }'
out="$(linear api --no-input --variable "id=${1^^}" "$query" 2>&1)" || { echo "issue-view: ${1^^} notes: $out" >&2; exit 1; }
# A partial comment list would read as the whole: refuse it.
jq -e '.data.issue.comments.pageInfo.hasNextPage == false' <<<"$out" >/dev/null 2>&1 \
  || { echo "issue-view: ${1^^}: linear api printed no issue or a partial comment list: $(head -c 300 <<<"$out")" >&2; exit 1; }
jq -c --argjson v "$view" '.data.issue as $i | $v + {notes: ([$i | {at: .createdAt, edited_at: (if .updatedAt == .createdAt then null else .updatedAt end),
  url, body: (.description // "")}] + [$i.comments.nodes | sort_by(.createdAt)[] | {at: .createdAt, edited_at: .editedAt, url, body}])}' <<<"$out"
