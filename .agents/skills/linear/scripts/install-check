#!/usr/bin/env bash
# install-check: the linear CLI the tracker scripts run (schpet/linear-cli), at the release this skill pins
# in ../cli-version (the vendored linear-cli skill's release, Skillfile). Run by the kit's `just install-check`
# for a target whose tracker is linear. One line; exit 0 when `linear --version` reports the pin, else 1 with
# the pinned version and the install path. Reads no key: LINEAR_API_KEY comes only from the environment.
set -uo pipefail
pin="$(tr -d '[:space:]' <"$(dirname "$(readlink -f "$0")")/../cli-version")"
how="install schpet/linear-cli v$pin: its release binary (https://github.com/schpet/linear-cli/releases/tag/v$pin) on PATH as linear, or a linear on PATH that runs npx @schpet/linear-cli@$pin"
if ! p="$(command -v linear)"; then
  printf 'linear MISSING (want v%s); %s\n' "$pin" "$how"; exit 1
fi
v="$(linear --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)"
if [[ "$v" == "$pin" ]]; then printf 'linear ok  %s (v%s)\n' "$p" "$v"; exit 0; fi
printf 'linear WRONG VERSION %s reports %s, want v%s; %s\n' "$p" "${v:-no version}" "$pin" "$how"; exit 1
