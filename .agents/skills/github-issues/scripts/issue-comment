#!/usr/bin/env bash
# issue-comment KEY [--body-file FILE|-]: adds a comment (body from FILE, standard input by default); prints its url.
# Wraps `gh issue comment`.
set -euo pipefail
[[ $# == 1 || ($# == 3 && "$2" == --body-file) ]] || { echo "usage: issue-comment KEY [--body-file FILE|-]" >&2; exit 64; }
[[ "$1" =~ ^#?([0-9]+)$ ]] || { echo "issue-comment: $1 is not a GitHub issue key" >&2; exit 1; }
exec gh issue comment "${BASH_REMATCH[1]}" --body-file "${3:--}"
