#!/usr/bin/env bash
# Close one Herdr tab or space and end everything it ran, or park one idle
# Pi agent.
#
# Ported from octo-lite (varelaseb/octo-lite@cc6fa4e, Apache-2.0).
#
# Closing a tab or space kills its panes, but a detached command child (setsid)
# survives, reparented: plain close then ends each closed pane's own agent
# scope, never reading another process (herdr_scope.py close; the rule:
# herdr-comms SKILL.md, Close an agent or a lane space).
# A tab id is <space>:<tab>; an id without a colon is a space. A pane id
# (<space>:p<n>) is mapped to its tab the way --park maps one (herdr agent get)
# and that tab is closed; one it cannot map fails with nothing closed. Run it
# from outside what it closes: the spawner owns teardown.
#
# --park PANE reads the Pi session id and role herdr-spawn exported into PANE's
# tab (OCTO_FEATHER_SESSION_ID, OCTO_FEATHER_ROLE), closes its tab, or its
# space when that tab is the space's only one (a supervisor in its own space),
# and prints one parked hand-off line, even when the close fails. An agent Herdr
# does not report idle or done, or one not spawned by herdr-spawn, is refused
# with nothing closed.
set -uo pipefail

usage() { echo "usage: herdr-close TAB|SPACE|PANE | --park PANE" >&2; exit 64; }
# True when the process behind environ file $1 carries the line $2 and runs in
# the caller's Herdr session. Unreadable entries are silently not ours.
ours() {
  local vars
  vars="$(tr '\0' '\n' 2>/dev/null <"$1")" && grep -qxF "$2" <<<"$vars" &&
    [[ "$(sed -n 's/^HERDR_SESSION=//p' <<<"$vars")" == "${HERDR_SESSION:-}" ]]
}
line=""
# Finding a pane's processes reads /proc, which macOS lacks.
procfs=1; [[ -d /proc/self ]] || procfs=0
if [[ "${1:-}" == --park ]]; then
  (($# == 2)) && [[ "$2" == *:* ]] || usage
  ((procfs)) || { echo "herdr-close --park: not on macOS (it reads the pane's Pi session from /proc); not parked. Leave the agent running, or close its tab with herdr-close and relaunch it fresh when needed" >&2; exit 69; }
  pane="$2"; session=""; role=""; cwd=""; parent=""
  for env in /proc/[0-9]*/environ; do
    ours "$env" "HERDR_PANE_ID=$pane" || continue
    vars="$(tr '\0' '\n' 2>/dev/null <"$env")" || continue
    session="$(sed -n 's/^OCTO_FEATHER_SESSION_ID=//p' <<<"$vars")"
    [[ -n "$session" ]] || continue
    role="$(sed -n 's/^OCTO_FEATHER_ROLE=//p' <<<"$vars")"
    parent="$(sed -n 's/^OCTO_FEATHER_PARENT=//p' <<<"$vars")"
    pid="${env#/proc/}"; cwd="$(readlink "/proc/${pid%/environ}/cwd" 2>/dev/null || true)"
    break
  done
  [[ -n "$session" ]] || { echo "herdr-close: no herdr-spawn Pi session in $pane; not parked" >&2; exit 65; }
  agent="$(herdr agent get "$pane")" || { printf '%s\n' "$agent" >&2; exit 1; }
  [[ "$(jq -r .result.agent.agent_status <<<"$agent")" == @(idle|done) ]] || { echo "herdr-close: $pane is not idle; not parked" >&2; exit 75; }
  name="$(jq -r .result.agent.name <<<"$agent")"
  space="$(jq -r '.result.agent.workspace_id // empty' <<<"$agent")"
  tabs="$(herdr workspace get "$space" 2>/dev/null | jq -r '.result.workspace.tab_count // empty')"
  label="$(herdr tab get "$(jq -r '.result.agent.tab_id // empty' <<<"$agent")" 2>/dev/null | jq -r '.result.tab.label // empty')"
  [[ "$tabs" == 1 ]] && set -- "$space" || set -- "$(jq -r '.result.agent.tab_id // empty' <<<"$agent")"
  line="$("$(dirname "$(readlink -f "$0")")/../../../../scripts/octo-feather-handoff" encode \
    --field at "$(date -u +%FT%TZ)" --field kind parked --field pane "$pane" --field name "$name" \
    --field role "$role" --field cwd "$cwd" --field session "$session" --field label "$label" --field parent "$parent")"
fi

id="${1:-}"
[[ -n "$id" && "$id" != -* && $# -eq 1 ]] || usage

if [[ "$id" == *:p* ]]; then
  tab="$(herdr agent get "$id" 2>/dev/null | jq -r '.result.agent.tab_id // empty' 2>/dev/null)" || tab=""
  [[ -n "$tab" ]] || { echo "herdr-close: cannot map pane $id to its tab (no Herdr agent there); give TAB|SPACE|PANE: a tab (w5:t2), a space (w5), or an agent's pane (w5:p3); nothing closed" >&2; exit 65; }
  id="$tab"
fi

scope="$(dirname "$(readlink -f "$0")")/herdr_scope.py"
[[ -n "$line" ]] || exec "$scope" close "$id"
rc=0; "$scope" close "$id" >&2 || rc=$?
echo "$line"
exit "$rc"
