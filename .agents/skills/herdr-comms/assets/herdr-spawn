#!/usr/bin/env bash
# Spawn one Pi agent in its own Herdr tab, at a given worktree, under a role.
#
# Ported from octo-lite (varelaseb/octo-lite@cc6fa4e, Apache-2.0); Pi only.
#
# This is a thin wrapper over two native Herdr commands:
#   herdr tab create   -> a tab and root pane at the worktree
#   herdr agent start  -> the agent adopts that pane
# Everything else here exists because those two have real failure modes: a
# freshly created pane is not yet at a shell prompt, and the agent may open a
# trust dialog that traps the session. Both are handled and verified.
#
# The role is this kit's agents/<role>.md. pi-role turns its frontmatter into
# Pi flags (model, thinking, tool allowlist, skills, system prompt); every agent
# launches this way (docs/adr/0016).
set -euo pipefail

root="$(cd "$(dirname "$(readlink -f "$0")")/../../../.." && pwd -P)"
workspace=""; name=""; label=""; cwd="$PWD"; role=""; resume=""
# The parent is the pane that spawns: the only pane this agent may report to
# (docs/adr/0015). A resume passes the parked parent back with --parent.
parent="${HERDR_PANE_ID:-}"
# The operating model is inherited: each spawn exports it into the tab it creates,
# so every child spawned from there defaults to the same file.
model="${OCTO_FEATHER_OPERATING_MODEL:-}"

usage() {
  cat <<'EOF'
usage:
  herdr-spawn --workspace ID --name NAME --label LABEL --cwd DIR --role ROLE \
    [--operating-model FILE] [--resume SESSION] [--parent PANE] [-- pi]

Spawn bare, then send the brief with herdr-say. The runtime is always pi.
--resume SESSION continues a parked Pi session (its --session-id).

Prints: name= role= tab= pane= cwd= contract= provider_session_id=
EOF
}

while (($#)); do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --workspace) workspace="${2:?}"; shift 2 ;;
    --name) name="${2:?}"; shift 2 ;;
    --label) label="${2:?}"; shift 2 ;;
    --cwd) cwd="${2:?}"; shift 2 ;;
    --role) role="${2:?}"; shift 2 ;;
    --operating-model) model="${2:?}"; shift 2 ;;
    --resume) resume="${2:?}"; shift 2 ;;
    --parent) parent="$2"; shift 2 ;;
    --direct) shift ;;                 # accepted and ignored; kept for callers
    --) shift; break ;;
    *) echo "herdr-spawn: unknown option $1" >&2; exit 64 ;;
  esac
done
[[ -n "$workspace" && -n "$name" && -n "$role" ]] || { usage >&2; exit 64; }
[[ -n "$label" ]] || label="$name"
[[ -d "$cwd" ]] || { echo "herdr-spawn: no such worktree: $cwd" >&2; exit 66; }
cwd="$(cd "$cwd" && pwd -P)"
if [[ -n "$model" ]]; then
  [[ -f "$model" ]] || { echo "herdr-spawn: no such operating model: $model" >&2; exit 66; }
  model="$(cd "$(dirname "$model")" && pwd -P)/$(basename "$model")"
fi

# Pi is the only runtime (docs/adr/0001). `-- pi` is accepted for callers.
if (($#)); then
  [[ "$(basename "$1")" == pi ]] || { echo "herdr-spawn: pi is the only runtime, got $1" >&2; exit 65; }
  # An inline prompt makes herdr agent start wait for a readiness it never sees
  # and time out, so the runtime takes no arguments.
  (($# == 1)) || { echo "herdr-spawn: no args after the runtime; spawn bare, then send the brief with herdr-say" >&2; exit 64; }
fi

# The role file lives in this kit, never in a per-user profile.
contract_file="$root/agents/$role.md"
[[ -f "$contract_file" ]] || { echo "herdr-spawn: no $role role file at $contract_file" >&2; exit 66; }
role_json="$(cd "$cwd" && "$root/scripts/pi-role" --json "$contract_file")" || { echo "herdr-spawn: pi-role rejected $contract_file" >&2; exit 65; }
contract="pi-role"

# A known session id makes the agent parkable: herdr-close --park records it
# and a resume passes it back.
session="$resume"
[[ -n "$session" ]] || session="$(cat /proc/sys/kernel/random/uuid 2>/dev/null || uuidgen | tr "[:upper:]" "[:lower:]")"

# pi-role --json puts the role prompt in a file, so every arg is one line.
mapfile -t launch_argv < <(jq -r '.args[]' <<<"$role_json")
# An optional operating model is appended after the role prompt.
[[ -z "$model" ]] || launch_argv+=(--append-system-prompt "$model")
launch_argv+=(--session-id "$session")

# A tab starts with the Herdr server's environment, not the caller's. HOME is
# forwarded so the agent and every descendant keep the caller's git identity
# and sessions; PATH gains the kit commands (herdr-say, octo-feather-state). The rest is the caller's PATH, or
# pi-role's "path" when given: that PATH with mise's shims before its system dirs (a repo with mise.toml; agent
# shells run no mise activate hook, #261).
rest="$(jq -r '.path // empty' <<<"$role_json")"
tab_env=(--env "HOME=$HOME"
  --env "PATH=$root/.agents/skills/herdr-comms/assets:$root/scripts:$HOME/.local/bin:${rest:-$PATH}"
  --env "OCTO_FEATHER_ROLE=$role" --env "OCTO_FEATHER_SESSION_ID=$session"
  --env "OCTO_FEATHER_PARENT=$parent")
[[ -z "$model" ]] || tab_env+=(--env "OCTO_FEATHER_OPERATING_MODEL=$model")
# The Linear key comes only from the caller's environment (spec remote#host-tracker-key): passed
# on when set, never written to any file; unset in the caller means unset in the tab.
[[ -z "${LINEAR_API_KEY:-}" ]] || tab_env+=(--env "LINEAR_API_KEY=$LINEAR_API_KEY")
out="$(herdr tab create --workspace "$workspace" --label "$label" --cwd "$cwd" "${tab_env[@]}" --no-focus)"
tab="$(jq -r '.result.tab.tab_id // empty' <<<"$out")"
pane="$(jq -r '.result.root_pane.pane_id // empty' <<<"$out")"
[[ -n "$tab" && -n "$pane" ]] || { echo "herdr-spawn: tab create returned no tab or pane" >&2; exit 1; }

close_orphan_tab() { herdr tab close "$tab" >/dev/null 2>&1 || true; }

# A new root pane may not have reached its shell prompt yet; herdr reports that
# as the structured error agent_pane_busy. Only that code retries. Any other
# failure, or exhausting the retries, closes the tab so no orphan survives.
retries="${HERDR_SPAWN_START_RETRIES:-8}"; delay="0.5"; attempt=0
while :; do
  attempt=$((attempt + 1)); rc=0
  err="$(herdr agent start "$name" --kind pi --pane "$pane" -- "${launch_argv[@]}" 2>&1 >/dev/null)" || rc=$?
  [[ "$rc" == 0 ]] && break
  code="$(jq -r '.error.code // empty' <<<"$err" 2>/dev/null || true)"
  # herdr registers the agent but reports agent_not_ready while a trust dialog
  # is open. That is a started agent waiting on a keystroke, not a failed
  # start; the dialog step below is what clears it.
  [[ "$code" == agent_not_ready ]] && break
  if [[ "$code" != agent_pane_busy ]]; then
    [[ -n "$err" ]] && printf '%s\n' "$err" >&2
    echo "herdr-spawn: agent start failed; closing tab $tab" >&2
    close_orphan_tab; exit "$rc"
  fi
  if (( attempt >= retries )); then
    printf '%s\n' "$err" >&2
    echo "herdr-spawn: pane still busy after $retries attempts; closing tab $tab" >&2
    close_orphan_tab; exit "$rc"
  fi
  sleep "$delay"; [[ "$delay" == 0.5 ]] && delay=1 || delay=2
done

# Answer a startup trust dialog, then verify it actually cleared.
#
# Never confirm blindly. The highlighted row is whatever the CLI last left
# selected, and for a previously declined directory it is the refusal, so a bare
# Enter kills the agent being spawned. Read the row, move onto the affirmative,
# verify it moved, and only then confirm.
#
# Four states matter: a dialog is open (0), verified clear (1), read failed
# (2), Pi's project trust dialog is open (3). A failed read is not evidence of
# clearing, so it retries and then fails closed rather than reporting a session
# that is really still trapped.
#
# Pi's trust dialog is never answered. pi-role launches with --approve, so it
# should not open; if it does, every row (including "Trust parent folder")
# would widen or persist trust, so no key is sent and the spawn fails closed
# (issue #3).
pane_text() { herdr pane read "$pane" --source visible --lines 60 2>/dev/null; }

# dialog_state keeps the last text it read in seen_text, so a fail-closed
# report shows what was detected without a second read that could fail.
seen_text=""
dialog_state() {
  local text
  text="$(pane_text)" || return 2
  seen_text="$text"
  grep -qiE 'Trust project folder\?|Trust parent folder|Do not trust \(this session only\)' <<<"$text" && return 3
  grep -qiE 'Quick safety check|trust this (folder|project)|trust the contents of this directory|Trust and continue|Press t to trust' <<<"$text" && return 0
  return 1
}

# The row the CLI has highlighted.
selected_row() { pane_text | grep -E '^[[:space:]]*(❯|›|>)' | head -1; }

send_key() {
  herdr pane send-keys "$pane" "$1" >/dev/null 2>&1 || {
    echo "herdr-spawn: dialog keystroke failed; closing tab $tab" >&2
    close_orphan_tab; exit 69; }
}

fail_dialog() {
  # Print what was actually on screen: an unrecognised dialog shape is a
  # fixable report, where a bare "did not clear" is a guessing game.
  # The report is best-effort: nothing in it may skip the close or exit 69.
  { echo "herdr-spawn: $1; failing closed. Pane showed:"
    grep -vE '^[[:space:]]*$' <<<"$seen_text" | tail -12; } >&2 || true
  close_orphan_tab; exit 69
}

cleared=0
for _ in $(seq 1 "${HERDR_SPAWN_TRUST_RETRIES:-14}"); do
  state=0; dialog_state || state=$?
  [[ "$state" == 1 ]] && { cleared=1; break; }
  [[ "$state" == 3 ]] && fail_dialog "Pi's project trust dialog opened (launch lacks --approve?); it is never answered"
  if [[ "$state" == 0 ]]; then
    if pane_text | grep -qiE 'Press t to trust'; then
      herdr pane send-text "$pane" "t" >/dev/null 2>&1 || send_key t
    elif selected_row | grep -qiE 'trust (this|the contents)|Yes, continue|Trust and continue|^[^A-Za-z]*[0-9]+\. *Yes'; then
      send_key Enter
    else
      send_key Down
    fi
  fi
  sleep 1
done
if [[ "$cleared" != 1 ]]; then
  state=0; dialog_state || state=$?
  case "$state" in
    1) : ;;
    2) echo "herdr-spawn: could not read the pane to verify the dialog; failing closed" >&2
       close_orphan_tab; exit 69 ;;
    3) fail_dialog "Pi's project trust dialog opened (launch lacks --approve?); it is never answered" ;;
    *) fail_dialog "a startup dialog did not clear" ;;
  esac
fi

# The dialog clearing does not mean the agent can accept a prompt yet: it may
# still be booting, and a prompt fired into that window is never reacted to.
# Herdr reports `agent_prompt_stalled` and the message is lost. Wait until the
# agent reports its own status before calling the spawn done.
agent_status=""
for _ in $(seq 1 "${HERDR_SPAWN_READY_RETRIES:-20}"); do
  info="$(herdr agent get "$name" 2>/dev/null || true)"
  agent_status="$(jq -r '.result.agent.agent_status // empty' <<<"$info" 2>/dev/null || true)"
  [[ -n "$agent_status" ]] && break
  sleep 1
done
if [[ -z "$agent_status" ]]; then
  echo "herdr-spawn: agent never reported a status; it is not ready for prompts" >&2
  close_orphan_tab; exit 69
fi

echo "name=$name role=$role tab=$tab pane=$pane cwd=$cwd contract=$contract provider_session_id=$session"
