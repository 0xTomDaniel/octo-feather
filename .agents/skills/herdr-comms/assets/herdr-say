#!/usr/bin/env bash
# Send one message to a Herdr agent, and confirm it actually landed.
# Ported from octo-lite (varelaseb/octo-lite@cc6fa4e, Apache-2.0).
#
# This is a thin wrapper over a single native Herdr command:
#   herdr agent prompt TARGET TEXT --wait --until working --until idle
#
# Native Herdr already solves what this script used to solve by hand. It
# refuses a blocked agent outright (`agent_blocked`) rather than typing into an
# open dialog, so no modal guard is needed; and `--wait --until` returns only on
# an observed state change, so delivery is confirmed by Herdr rather than by an
# acknowledgement the agent sends about itself.
#
# Exit codes are the contract callers rely on, including
# `herdr-wake`, Spec Chat's wake provider:
#   0   delivered, and Herdr observed the agent change state
#   75  not delivered now because the target is blocked on interactive input;
#       the caller should retry once the target is free
#   69  the up-chain guard's `herdr agent get` lookup failed (named on stderr)
#   >0  anything else
#
# A send never hangs or fails silently (#666; owner rulings #585, #619): the
# --timeout bound and the stalled and timed-out failures, herdr-comms SKILL.md,
# Send a message.
#
# A target Herdr does not find may be parked: the latest parked line naming it,
# in any lane hand-off log of the caller's Herdr session (octo-feather-state),
# decides; another session's lanes repeat its ids. A live agent under the
# line's name gets the message; otherwise the agent is resumed first (a supervisor,
# the lane's name, in its lane workspace when that still exists, else a new one; a
# worker in the caller's space), its new pane= is printed, and the message it
# receives starts "Resumed from park as pane=PANE. ".
# `herdr-say --parked TARGET` prints that line, or exits 1 when there is none.
#
# Up-chain accident guard (docs/adr/0015, not security): a kit agent may message
# only up its own chain. `--parent` targets the pane that spawned the caller
# (OCTO_FEATHER_PARENT). A worker (implementer, code-reviewer, corrector) may
# reach only its parent, or the director pane in director.toml when its parent
# is unreachable; a supervisor only its parent (the director) and agents in its
# own lane workspace, or a parked agent whose latest parked line sits in its
# lane's hand-off log or names it as parent. Anything else exits 77. The director and callers that are
# not kit agents (an owner shell, Spec Chat's wake) are not limited.
set -euo pipefail

usage() { echo "usage: herdr-say [--kind KIND] [--artifact REF] [--timeout SECONDS] (TARGET | --parent) MESSAGE | --parked TARGET" >&2; }
here="$(dirname "$(readlink -f "$0")")"

# The latest parked line naming TARGET by pane or name. A line without name is
# the supervisor: the lane's name, its log's stem.
parked() {
  "$here/../../../../scripts/octo-feather-handoff" parked "$1" \
    "$("$here/../../../../scripts/octo-feather-state")/lanes"
}

while (($#)); do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --kind|--artifact) shift 2 ;;   # accepted for caller compatibility, unused
    --timeout) [[ "${2:-}" =~ ^[1-9][0-9]*$ ]] || { echo "herdr-say: --timeout needs whole seconds, got ${2:-nothing}" >&2; exit 64; }
               bound="$2"; shift 2 ;;
    --parked) (($# == 2)) || { usage; exit 64; }; parked "$2"; exit ;;
    --parent) [[ -n "${OCTO_FEATHER_PARENT:-}" ]] || { echo "herdr-say: no parent recorded for this pane" >&2; exit 64; }
              shift; set -- "$OCTO_FEATHER_PARENT" "$@"; break ;;
    --) shift; break ;;
    -*) echo "herdr-say: unknown option $1" >&2; exit 64 ;;
    *) break ;;
  esac
done
(($# == 2)) || { usage; exit 64; }
target="$1"; message="$2"; bound="${bound:-900}"

# The up-chain guard. Resolves TARGET to a pane and workspace through Herdr.
allowed() {
  local role="${OCTO_FEATHER_ROLE:-}" parent="${OCTO_FEATHER_PARENT:-}" info pane space director line lane
  looked=""
  case "$role" in implementer|code-reviewer|corrector|supervisor) ;; *) return 0 ;; esac
  [[ -n "$parent" && "$target" == "$parent" ]] && return 0
  info="$(herdr agent get "$target" 2>&1)" && looked="" || looked="$(tail -1 <<<"$info")"
  pane="$(jq -r '.result.agent.pane_id // empty' <<<"$info" 2>/dev/null || true)"
  [[ -n "$pane" || -n "$looked" ]] || looked="no pane in: $(tail -1 <<<"$info")"
  space="$(jq -r '.result.agent.workspace_id // empty' <<<"$info" 2>/dev/null || true)"
  [[ -n "$pane" && "$pane" == "$parent" ]] && return 0
  director="$(sed -n 's/^pane *= *"\(.*\)"/\1/p' "$("$here/../../../../scripts/octo-feather-state")/director.toml" 2>/dev/null | head -1)"
  [[ -n "$director" && ( "$target" == "$director" || "$pane" == "$director" ) ]] && return 0
  [[ "$role" == supervisor && -n "$space" && "$space" == "${HERDR_WORKSPACE_ID:-}" ]] && return 0
  # A supervisor's own parked agent: not live, its latest parked line in the
  # caller's lane log (the caller's agent name) or naming the caller as parent.
  if [[ "$role" == supervisor && -z "$pane" && -n "${HERDR_PANE_ID:-}" ]] && line="$(parked "$target")"; then
    [[ "$(jq -r '.parent // empty' <<<"$line")" == "$HERDR_PANE_ID" ]] && return 0
    lane="$(herdr agent get "$HERDR_PANE_ID" 2>/dev/null | jq -r '.result.agent.name // empty' 2>/dev/null || true)"
    [[ -n "$lane" && "$(jq -r .lane <<<"$line")" == "$lane" ]] && return 0
  fi
  # A lookup that failed is no answer: an error naming it, never "not in your
  # chain" (#666). One Herdr answers agent_not_found is an answer.
  if [[ -z "$pane" && "$looked" != *'"agent_not_found"'* ]]; then
    echo "herdr-say: herdr agent get $target failed (${looked:-no output}): cannot check $target is up the chain of $role; not sent" >&2
    exit 69
  fi
  return 1
}
allowed || { echo "herdr-say: $OCTO_FEATHER_ROLE may message only up its chain (its parent ${OCTO_FEATHER_PARENT:-none}; docs/adr/0015), not $target${looked:+ (herdr agent get: $looked)}" >&2; exit 77; }

prompt() { rc=0; out="$(herdr agent prompt "$1" "$message" --wait --until working --until idle --timeout "$((bound * 1000))" 2>&1)" || rc=$?; }
code() { jq -r '.error.code // empty' <<<"$out" 2>/dev/null || true; }

prompt "$target"
if [[ "$rc" != 0 && "$(code)" == agent_not_found ]] && line="$(parked "$target")"; then
  name="$(jq -r .name <<<"$line")"
  if ! herdr agent get "$name" >/dev/null 2>&1; then
    resume=(--cwd "$(jq -r .cwd <<<"$line")" --name "$name" --resume "$(jq -r .session <<<"$line")"
      --parent "$(jq -r '.parent // empty' <<<"$line")")
    if [[ "$name" == "$(jq -r .lane <<<"$line")" ]]; then
      started="$("$here/../../../../scripts/octo-feather-start" "${resume[@]}")"
    else
      started="$("$here/herdr-spawn" --workspace "${HERDR_WORKSPACE_ID:-}" --label "$(jq -r '.label // .name' <<<"$line")" \
        --role "$(jq -r '.role // empty' <<<"$line")" "${resume[@]}" -- pi)"
    fi
    name="$(sed -n 's/.* pane=\([^ ]*\).*/\1/p' <<<"$started")"
    echo "pane=$name"
    message="Resumed from park as pane=$name. $message"
  fi
  prompt "$name"
fi
[[ "$rc" == 0 ]] && exit 0

# A blocked target is a retry, not a failure: it is sitting on a dialog and
# Herdr correctly declined to type past it.
[[ "$(code)" == agent_blocked ]] && {
  echo "herdr-say: $target is blocked on interactive input; not delivered" >&2; exit 75; }

printf '%s\n' "$out" >&2
# Stalled or still unconfirmed at the bound: loud, naming the pane and its state.
case "$(code)" in
  agent_prompt_stalled|timeout)
    info="$(herdr agent get "${name:-$target}" 2>/dev/null || true)"
    pane="$(jq -r '.result.agent.pane_id // empty' <<<"$info" 2>/dev/null || true)"
    state="$(jq -r '.result.agent.agent_status // empty' <<<"$info" 2>/dev/null || true)"
    if [[ "$(code)" == timeout ]]; then
      echo "herdr-say: $target (pane ${pane:-unknown}) still ${state:-unknown} after ${bound}s: Herdr saw the prompt neither start nor finish a turn; delivery not confirmed" >&2
    else
      echo "herdr-say: prompt to $target (pane ${pane:-unknown}, state ${state:-unknown}) stalled: typed but never seen to land (agent_prompt_stalled); it may sit unsent in that pane" >&2
    fi
    exit 1 ;;
esac
exit "${rc:-1}"
