#!/usr/bin/env bash
# verify-octo-feather: drive the octo-feather kit's own commands the way an owner or agent runs them, and keep the proof.
# Usage: verify-octo-feather launch|doctor|drive <feature>|cleanup|run [feature]
# Run state: $VERIFY_OCTO_FEATHER_RUN_DIR. Evidence: $VERIFY_OCTO_FEATHER_EVIDENCE_DIR.
# Both default outside the git dir, under ${TMPDIR:-/tmp}. What a drive may touch: ../SKILL.md.
set -euo pipefail

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
repo=$(cd "$script_dir/../../../.." && pwd -P)
repo_key=$(printf '%s' "$repo" | cksum | cut -d' ' -f1)
base="${TMPDIR:-/tmp}/verify-octo-feather.$(id -u).$repo_key"
run_dir="${VERIFY_OCTO_FEATHER_RUN_DIR:-$base/run}"
evidence_dir="${VERIFY_OCTO_FEATHER_EVIDENCE_DIR:-$base/evidence}"
state="$run_dir/state"
created="$run_dir/created"
contract="$repo/qc.toml"
features="new-repo install-check contract evidence"

say() { printf 'verify-octo-feather: %s\n' "$*"; }
die() {
    printf 'verify-octo-feather: %s\n' "$*" >&2
    exit 1
}

# Prove a folder is writable by writing to it; `test -w` lies under some sandboxes.
writable() {
    local dir=$1 probe
    mkdir -p "$dir" 2>/dev/null || return 1
    probe="$dir/.verify-octo-feather-probe.$$"
    { : >"$probe"; } 2>/dev/null || return 1
    rm -f "$probe"
}

load_state() {
    [[ -f $state ]] || die "no run state at $state: run 'verify-octo-feather launch' first"
    # shellcheck source=/dev/null
    . "$state"
}

# The kit's contract, qc.toml at the kit root (format 1), as shell assignments: QC_SETUP, QC_ENTRY, QC_SERVICES,
# QC_FIXTURES and QC_RESETS, QC_VALUES and QC_VALUES_JSON. The helper enters the kit only through these.
read_contract() {
    command -v python3 >/dev/null || die "python3 (3.11+) not on PATH: verify-octo-feather reads $contract with its tomllib"
    python3 - "$contract" <<'EOF_PY'
import json, shlex, sys
try:
    import tomllib
except ImportError:
    sys.exit("verify-octo-feather: python3 3.11+ needed: it reads qc.toml with tomllib")
path = sys.argv[1]
try:
    with open(path, "rb") as fh:
        c = tomllib.load(fh)
except (OSError, ValueError) as e:
    sys.exit(f"verify-octo-feather: cannot read the kit's contract {path}: {e}")
if c.get("format") != 1:
    sys.exit(f"verify-octo-feather: {path}: format {c.get('format')!r}; this helper reads format 1 (validate: octo-feather-contract)")
entry, services, fixture, values = (c.get(k) for k in ("entry", "services", "fixture", "values"))
if not (isinstance(entry, dict) and isinstance(entry.get("command"), str) and isinstance(services, dict)
        and isinstance(fixture, dict) and all(isinstance(f, dict) and isinstance(f.get("reset"), str) for f in fixture.values())
        and isinstance(values, dict) and all(isinstance(v, str) for v in values.values())):
    sys.exit(f"verify-octo-feather: {path} does not match format 1 (validate: octo-feather-contract)")
q, arr = shlex.quote, lambda xs: "(" + " ".join(shlex.quote(x) for x in xs) + ")"
print(f"QC_SETUP={q(c.get('setup', ''))}")
print(f"QC_ENTRY={q(entry['command'])}")
print(f"QC_SERVICES={arr(services)}")
print(f"QC_FIXTURES={arr(fixture)}")
print(f"QC_RESETS={arr(f['reset'] for f in fixture.values())}")
print("declare -gA QC_VALUES=(" + " ".join(f"[{q(k)}]={q(v)}" for k, v in values.items()) + ")")
print(f"QC_VALUES_JSON={q(json.dumps(values))}")
EOF_PY
}

cmd_launch() {
    writable "$run_dir" || die "cannot write run state folder: $run_dir"
    writable "$evidence_dir" || die "cannot write evidence folder: $evidence_dir"
    local contract_sh
    contract_sh=$(read_contract) || exit 1
    eval "$contract_sh"
    # Short-lived commands: this helper starts no service. A contract that declares one needs a helper that readies it.
    [[ ${#QC_SERVICES[@]} == 0 ]] || die "qc.toml declares services (${QC_SERVICES[*]}); this helper starts none: extend it to start and ready them"
    if [[ -n $QC_SETUP ]]; then
        say "setup in $repo (qc.toml setup): $QC_SETUP"
        (cd "$repo" && QC_REPO=$repo sh -c "$QC_SETUP") || die "qc.toml setup failed: $QC_SETUP"
    fi
    local kit rev
    # The kit command: qc.toml's entry with the user's command appended.
    kit="$run_dir/bin/kit"
    mkdir -p "$run_dir/bin" "$run_dir/scratch" || die "cannot write run state folder: $run_dir"
    printf '#!/usr/bin/env bash\nexport QC_REPO=%q\nexec sh -c %q kit "$@"\n' "$repo" "$QC_ENTRY \"\$@\"" >"$kit" || die "cannot write kit command: $kit"
    chmod +x "$kit"
    rev=$(git -C "$repo" rev-parse --short HEAD 2>/dev/null || echo unknown)
    {
        printf '%s\n' "$contract_sh"
        printf 'KIT=%q\n' "$kit"
        printf 'REPO=%q\n' "$repo"
        printf 'REV=%q\n' "$rev"
        printf 'LAUNCHED=%q\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    } >"$state" || die "cannot write run state file: $state"
    [[ -s $state ]] || die "run state file is empty: $state"
    say "ready: kit=$kit entry=$QC_ENTRY rev=$rev"
    say "run state: $run_dir"
    say "evidence:  $evidence_dir"
}

# KIT, REPO, REV and the contract's QC_* come from the state file.
# shellcheck disable=SC2153
cmd_doctor() {
    load_state
    local ok=0 out t rev installer
    report() { printf '%-8s %s\n' "$1" "$2"; }
    if [[ -x $KIT ]]; then report ok "kit command $KIT"; else
        report FAIL "kit command missing: $KIT"
        ok=1
    fi
    report info "entry (qc.toml): $QC_ENTRY"
    for t in just git python3; do
        if command -v "$t" >/dev/null; then report ok "$t on PATH"; else
            report FAIL "$t not on PATH: the kit's commands need it"
            ok=1
        fi
    done
    for t in octo-feather-new-repo octo-feather-contract octo-feather-evidence; do
        out=$("$KIT" sh -c 'command -v "$1"' sh "$t" 2>&1 || true)
        if [[ $out == "$REPO/scripts/$t" ]]; then report ok "$t resolves to this checkout"; else
            report FAIL "$t resolves to '$out', not $REPO/scripts/$t"
            ok=1
        fi
    done
    if out=$("$KIT" just --justfile "$REPO/justfile" --summary 2>&1) && grep -qw new-repo <<<"$out" && grep -qw install-check <<<"$out"; then
        report ok "kit justfile lists new-repo and install-check"
    else
        report FAIL "'just --summary' failed or lacks new-repo, install-check: $out"
        ok=1
    fi
    if out=$("$KIT" octo-feather-contract "$REPO" 2>&1); then report ok "$out"; else
        report FAIL "$out"
        ok=1
    fi
    rev=$(git -C "$REPO" rev-parse --short HEAD 2>/dev/null || echo unknown)
    if [[ $rev == "$REV" ]]; then report ok "checkout at launch rev $REV"; else
        report WARN "checkout moved: launched at $REV, now $rev (relaunch)"
    fi
    installer="${SPEC_CHAT_CLONE:-$HOME/src/spec-chat}/scripts/install-spec-chat"
    if [[ -x $installer ]]; then report ok "Spec Chat installer $installer (new-repo links it)"; else
        report WARN "no Spec Chat installer at $installer: the new-repo drive fails (features/new-repo.md Gotchas)"
    fi
    if unshare -Un --map-current-user true 2>/dev/null; then report ok "unshare -Un: install-check drives without network"; else
        report WARN "no network namespace (unshare -Un): the install-check drive fails (features/install-check.md Gotchas)"
    fi
    if [[ -d $run_dir/scratch ]]; then report ok "scratch $run_dir/scratch"; else
        report FAIL "scratch missing"
        ok=1
    fi
    return "$ok"
}

# One isolated case: fresh empty cwd, the command as typed, stdout, stderr, exit code, files left in cwd, and the
# kit checkout's git status before and after (a drive changes nothing in the kit).
# case_run <dir> <name> <arg>...; case_env (VAR=value...) and case_pre (a wrapper such as unshare) apply when set.
case_env=()
case_pre=()
case_run() {
    local dir=$1 name=$2
    shift 2
    local cwd="$run_dir/scratch/cwd/$name" code=0 before
    rm -rf "$cwd" && mkdir -p "$cwd"
    { printf '%q ' "${case_env[@]}" "${case_pre[@]}" "$@" && echo; } >"$dir/$name.cmd"
    before=$(git -C "$REPO" status --porcelain=v1)
    (cd "$cwd" && env "${case_env[@]}" "${case_pre[@]}" "$KIT" "$@") >"$dir/$name.stdout" 2>"$dir/$name.stderr" || code=$?
    echo "$code" >"$dir/$name.exit"
    find "$cwd" -mindepth 1 >"$dir/$name.files"
    diff <(printf '%s\n' "$before") <(git -C "$REPO" status --porcelain=v1) >"$dir/$name.kit-status" || true
}

# obs <dir> <case> <key> <cmd>...: an observed fact, the command's stdout (and its stderr), for the check as o[key].
obs() {
    local dir=$1 name=$2 key=$3
    shift 3
    "$@" >"$dir/$name.obs.$key" 2>&1 || true
}

# check <dir> <name> <python-expr over out, err, code, j (stdout JSON or None), o (observations), v (qc.toml values)>
# A case passes when the expression holds, it left no files in its cwd and the kit's git status did not change.
check() {
    local dir=$1 name=$2 expr=$3 verdict
    verdict=$(
        python3 - "$dir" "$name" "$expr" "$QC_VALUES_JSON" "$REPO" <<'EOF'
import json, pathlib, re, sys
d, n, expr, kit = pathlib.Path(sys.argv[1]), sys.argv[2], sys.argv[3], sys.argv[5]
v = json.loads(sys.argv[4])
out = (d / f"{n}.stdout").read_text()
err = (d / f"{n}.stderr").read_text()
code = int((d / f"{n}.exit").read_text())
o = {p.name[len(n) + 5:]: p.read_text() for p in d.glob(f"{n}.obs.*")}
clean = (d / f"{n}.files").read_text() == "" and (d / f"{n}.kit-status").read_text() == ""
try:
    j = json.loads(out)
except ValueError:
    j = None
try:
    ok = bool(eval("(" + expr + "\n)"))
except Exception as e:
    print(f"check error: {type(e).__name__}: {e}", file=sys.stderr)
    ok = False
print("PASS" if ok and clean else "FAIL")
EOF
    )
    printf '%s %s: %s\n' "$verdict" "$name" "$(cat "$dir/$name.cmd")" | tee -a "$dir/summary.txt"
    sed 's/^/    stdout: /' "$dir/$name.stdout"
    sed 's/^/    stderr: /' "$dir/$name.stderr"
    printf '    exit: %s\n' "$(cat "$dir/$name.exit")"
    [[ $verdict == PASS ]]
}

# A path a drive creates; cleanup removes it, and only it. Refuses a path that already holds anything.
fresh_path() {
    local p=$1
    [[ ! -e $p || -z "$(ls -A "$p" 2>/dev/null)" ]] || die "$p exists and is not empty: pick a new path (VERIFY_OCTO_FEATHER_NEW_REPO_DEST)"
    printf '%s\n' "$p" >>"$created"
}

drive_new_repo() {
    local dir="$evidence_dir/new-repo" fails=0 lang dest bad kitjust
    [[ -n ${QC_VALUES[lang]+set} ]] || die "qc.toml [values] has no lang: the new-repo drive creates a repo from templates/<lang>"
    lang=${QC_VALUES[lang]}
    dest=$(realpath -m -- "${VERIFY_OCTO_FEATHER_NEW_REPO_DEST:-$run_dir/scratch/new-repo/$lang}")
    bad="$run_dir/scratch/new-repo/bad-lang"
    kitjust="$REPO/justfile"
    fresh_path "$dest"
    fresh_path "$bad"
    say "new-repo dest: $dest"
    # The template's tracked files, which the new repo must hold exactly.
    git -C "$REPO/templates/$lang" ls-files | sort >"$dir/create.obs.template-files"
    printf '%s\n' "$dest" >"$dir/create.obs.dest"
    # Spec Chat's installer writes its onboarding state under XDG_STATE_HOME: a scratch one, never the box's.
    case_env=("XDG_STATE_HOME=$run_dir/scratch/state")

    case_run "$dir" create just --justfile "$kitjust" new-repo "$lang" "$dest"
    obs "$dir" create log git -C "$dest" log --format=%s main
    obs "$dir" create branch git -C "$dest" branch --show-current
    obs "$dir" create status git -C "$dest" status --porcelain=v1
    obs "$dir" create files sh -c 'git -C "$1" ls-files | sort' sh "$dest"
    obs "$dir" create repo-skills grep '^Repo skills:' "$dest/AGENTS.md"
    obs "$dir" create verify-skill sh -c 'ls "$1"/.agents/skills/verify-*/SKILL.md' sh "$dest"
    obs "$dir" create contract "$KIT" octo-feather-contract "$dest"
    check "$dir" create 'code == 0 and o["dest"].strip() + " from templates/" + v["lang"] in out
        and re.fullmatch(r"Initial commit from octo-feather templates/" + v["lang"] + r" @ [0-9a-f]+\n", o["log"])
        and o["branch"] == "main\n" and o["status"] == "" and o["files"] == o["template-files"]
        and re.search(r"\bverify-\w+", o["repo-skills"]) and o["verify-skill"].strip()
        and o["contract"].endswith(": ok (format 1)\n")' || fails=1

    # Over the repo just made: refused, the repo untouched.
    obs "$dir" refuse-nonempty head-before git -C "$dest" rev-parse HEAD
    case_run "$dir" refuse-nonempty just --justfile "$kitjust" new-repo "$lang" "$dest"
    obs "$dir" refuse-nonempty head-after git -C "$dest" rev-parse HEAD
    check "$dir" refuse-nonempty 'code == 1 and "exists and is not empty" in err
        and o["head-before"] == o["head-after"] and len(o["head-after"]) > 7' || fails=1

    case_run "$dir" refuse-lang just --justfile "$kitjust" new-repo no-such-lang "$bad"
    obs "$dir" refuse-lang made sh -c 'if [ -e "$1" ]; then echo made; fi' sh "$bad"
    check "$dir" refuse-lang 'code == 1 and "unknown LANG" in err and o["made"] == ""' || fails=1
    case_env=()
    say "new-repo evidence: $dir"
    return "$fails"
}

drive_install_check() {
    local dir="$evidence_dir/install-check" fails=0
    # No network: gh auth status cannot reach GitHub, so the gh line is deterministic (features/install-check.md).
    unshare -Un --map-current-user true 2>/dev/null || {
        echo "FAIL offline: no network namespace (unshare -Un) on this box; install-check's gh auth status would reach GitHub" | tee -a "$dir/summary.txt"
        return 1
    }
    case_pre=(unshare -Un --map-current-user)
    case_run "$dir" offline just --justfile "$REPO/justfile" install-check "$REPO"
    case_pre=()
    check "$dir" offline 'code == 1
        and all(re.search(r"(?m)^" + t + r" +(ok  /|MISSING$)", out) for t in ("herdr", "pi", "gh", "jq", "git", "just", "python3", "node"))
        and re.search(r"(?m)^pi +(version \S+ ok|WRONG VERSION)", out)
        and re.search(r"(?m)^gh +NOT authenticated \(gh auth login\)$", out)
        and re.search(r"(?m)^tracker \S+ \(target " + re.escape(kit) + r"\)$", out)' || fails=1
    say "install-check evidence: $dir"
    return "$fails"
}

drive_contract() {
    local dir="$evidence_dir/contract" fails=0 in="$run_dir/scratch/contract"
    rm -rf "$in" && mkdir -p "$in/missing-entry" "$in/none"
    printf 'format = 1\n[services]\n[fixture]\n[values]\n' >"$in/missing-entry/qc.toml"

    case_run "$dir" kit octo-feather-contract "$REPO"
    check "$dir" kit 'code == 0 and out == f"octo-feather-contract: {kit}/qc.toml: ok (format 1)\n"' || fails=1
    case_run "$dir" missing-entry octo-feather-contract "$in/missing-entry"
    check "$dir" missing-entry 'code == 1 and "missing entry" in out + err and "ok" not in out' || fails=1
    case_run "$dir" no-contract octo-feather-contract "$in/none"
    check "$dir" no-contract 'code == 1 and "no qc.toml at" in out + err' || fails=1
    say "contract evidence: $dir"
    return "$fails"
}

drive_evidence() {
    local dir="$evidence_dir/evidence" fails=0 sc="$run_dir/scratch/evidence" r crit text a b first
    [[ -n ${QC_VALUES[scratch_criterion]+set} && -n ${QC_VALUES[scratch_criterion_text]+set} ]] ||
        die "qc.toml [values] needs scratch_criterion and scratch_criterion_text: the evidence drive's scratch records serve it"
    crit=${QC_VALUES[scratch_criterion]}
    text=${QC_VALUES[scratch_criterion_text]}
    r="$sc/repo"
    rm -rf "$sc" && mkdir -p "$r" "$sc/outputs" "$sc/state"
    # A scratch target and a scratch store (XDG_STATE_HOME): the box's evidence stores are never touched.
    git -C "$r" init -q -b main
    gitc() { git -C "$r" -c user.name=verify-octo-feather -c user.email=verify@octo-feather.invalid -c core.hooksPath=/dev/null "$@"; }
    echo one >"$r/file" && gitc add file && gitc commit -q -m one
    a=$(git -C "$r" rev-parse HEAD)
    echo "drive output one" >"$sc/outputs/out.txt"
    case_env=("XDG_STATE_HOME=$sc/state")

    case_run "$dir" append-a octo-feather-evidence append --repo "$r" --criterion "$crit" --criterion-text "$text" --outputs "$sc/outputs"
    first=$(find "$sc/state" -name record.json | head -n 1)
    obs "$dir" append-a record cat "$first"
    check "$dir" append-a 'code == 0 and re.fullmatch(r"[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}\n", out)
        and json.loads(o["record"])["id"] + "\n" == out and json.loads(o["record"])["revision"] == "'"$a"'"
        and json.loads(o["record"])["criterion"]["text_from"] == "caller"' || fails=1
    sha256sum "$first" >"$sc/first.sha"

    echo two >"$r/file" && gitc commit -q -am two
    b=$(git -C "$r" rev-parse HEAD)
    echo "drive output two" >"$sc/outputs/out.txt"
    case_run "$dir" append-b octo-feather-evidence append --repo "$r" --criterion "$crit" --criterion-text "$text" --outputs "$sc/outputs"
    obs "$dir" append-b first-unchanged sha256sum -c --quiet "$sc/first.sha"
    obs "$dir" append-b records sh -c 'find "$1" -name record.json | wc -l' sh "$sc/state"
    obs "$dir" append-b repo-status git -C "$r" status --porcelain=v1
    check "$dir" append-b 'code == 0 and re.fullmatch(r"[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}\n", out)
        and o["first-unchanged"] == "" and o["records"].strip() == "2" and o["repo-status"] == ""' || fails=1

    case_run "$dir" read-a octo-feather-evidence read --repo "$r" --criterion "$crit" --commit "$a" --json
    check "$dir" read-a 'code == 0 and isinstance(j, list) and len(j) == 1 and j[0]["record"]["revision"] == "'"$a"'"
        and j[0]["record"]["criterion"]["id"] == v["scratch_criterion"] and len(j[0]["record"]["criterion"]["text_sha256"]) == 64
        and "contract" in j[0]["record"] and "fixture" in j[0]["record"] and "out.txt" in j[0]["record"]["outputs"]' || fails=1
    case_run "$dir" read-b-text octo-feather-evidence read --repo "$r" --criterion "$crit" --commit "$b"
    check "$dir" read-b-text 'code == 0 and "drive output two" in out and "drive output one" not in out and "'"$b"'" in out' || fails=1
    case_env=()
    say "evidence evidence: $dir"
    return "$fails"
}

cmd_drive() {
    local feature=${1:-}
    [[ -n $feature ]] || die "usage: verify-octo-feather drive <feature> (features: $features)"
    load_state
    writable "$evidence_dir" || die "cannot write evidence folder: $evidence_dir"
    [[ " $features " == *" $feature "* ]] || die "unknown feature '$feature' (features: $features)"
    local i code=0 dir="$evidence_dir/$feature"
    for i in "${!QC_FIXTURES[@]}"; do
        say "reset fixture ${QC_FIXTURES[i]} (qc.toml)"
        (cd "$REPO" && QC_REPO=$REPO sh -c "${QC_RESETS[i]}") || die "qc.toml fixture ${QC_FIXTURES[i]} reset failed: ${QC_RESETS[i]}"
    done
    rm -rf "$dir" && mkdir -p "$dir"
    echo "$feature @ rev $REV, $(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$dir/summary.txt"
    case $feature in
    new-repo) drive_new_repo || code=1 ;;
    install-check) drive_install_check || code=1 ;;
    contract) drive_contract || code=1 ;;
    evidence) drive_evidence || code=1 ;;
    esac
    if [[ $code == 0 ]]; then echo "PASS $feature" >>"$dir/summary.txt"; else echo "FAIL $feature" >>"$dir/summary.txt"; fi
    record_evidence "$feature"
    return "$code"
}

# Every drive, passed or failed, appends one record to the kit's evidence store (quality spec #evidence-store) through
# the kit's octo-feather-evidence, entered by the contract: the criterion the feature file's `Drive criterion:` line
# names, its text from the kit's own spec, the feature's evidence folder as outputs. Cleanup never touches the store.
record_evidence() {
    local feature=$1 file="$script_dir/../features/$1.md" crit id
    crit=$(sed -n 's/^Drive criterion: `\([^`]*\)`.*/\1/p' "$file" | head -n 1)
    [[ -n $crit ]] || die "$file has no Drive criterion line (Drive criterion: \`<spec>#<anchor>\`): each drive names the criterion it serves"
    id=$("$KIT" octo-feather-evidence append --repo "$REPO" --criterion "$crit" --outputs "$evidence_dir/$feature") ||
        die "evidence record for $feature not appended (octo-feather-evidence failed, message above)"
    say "evidence record $id (criterion $crit; read: octo-feather-evidence read --criterion $crit --commit $REV)"
}

cmd_cleanup() {
    # Nothing runs in the background: every kit command exits per case. Remove only what this helper made.
    local p
    if [[ -f $created ]]; then
        while IFS= read -r p; do
            [[ -n $p && -e $p ]] || continue
            rm -rf -- "$p"
            say "removed scratch $p"
        done <"$created"
    fi
    if [[ -e $run_dir ]]; then
        rm -rf "$run_dir/scratch" "$state" "$created"
        rm -f "$run_dir/bin/kit"
        rmdir "$run_dir/bin" 2>/dev/null || true
        rmdir "$run_dir" 2>/dev/null || true
        say "removed run state $run_dir"
    fi
    say "evidence kept at $evidence_dir"
}

cmd_run() {
    local code=0 feature=${1:-new-repo}
    cmd_launch
    cmd_doctor | tee "$evidence_dir/doctor.txt" || code=1
    if [[ $code == 0 ]]; then cmd_drive "$feature" || code=1; fi
    cmd_cleanup
    [[ -d $evidence_dir ]] || die "evidence folder gone after cleanup: $evidence_dir"
    ls -laR "$evidence_dir"
    if [[ $code == 0 ]]; then say "run PASS"; else say "run FAIL"; fi
    return "$code"
}

case ${1:-} in
launch) cmd_launch ;;
doctor) cmd_doctor ;;
drive)
    shift
    cmd_drive "$@"
    ;;
cleanup) cmd_cleanup ;;
run)
    shift
    cmd_run "$@"
    ;;
*) die "usage: verify-octo-feather launch|doctor|drive <feature>|cleanup|run [feature] (features: $features)" ;;
esac
