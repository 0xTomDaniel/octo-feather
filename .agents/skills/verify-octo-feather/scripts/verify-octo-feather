#!/usr/bin/env python3
"""verify-octo-feather: drive the octo-feather kit's own commands the way an owner or agent runs them, and keep the proof.

Usage: verify-octo-feather launch|doctor|drive <feature>|cleanup|run [--unreachable-exit N] [feature]
Run state: $VERIFY_OCTO_FEATHER_RUN_DIR. Evidence: $VERIFY_OCTO_FEATHER_EVIDENCE_DIR.
Both default outside the git dir, under ${TMPDIR:-/tmp}. What a drive may touch: ../SKILL.md.
Needs python3 3.11+ (tomllib reads qc.toml).
"""

from __future__ import annotations

import difflib
import glob
import hashlib
import importlib.machinery
import importlib.util
import json
import math
import os
import re
import resource
import shlex
import shutil
import statistics
import subprocess
import sys
import tempfile
import traceback
from collections.abc import Callable, Sequence
from dataclasses import asdict, dataclass, field
from datetime import UTC, datetime
from pathlib import Path
from typing import Any, NoReturn, cast

import tomllib

ME = "verify-octo-feather"
FEATURES = ("new-repo", "install-check", "contract", "evidence", "lane-archive", "director-reflection", "correction-lane", "correction-intake", "factory-report", "role-launch", "skill-loading", "shape", "qc-capture", "qc-browser", "qc-sandbox", "qc-sandbox-cost", "qc-advisory", "qc-fallback", "qc-insufficient", "qc-eval-verdict", "qc-stale", "spec-revision-init", "gate-tiers", "kit-hook", "merge-ask-proof", "pilot-pr", "template-tiers", "one-execution", "one-execution-incomplete", "starter-acceptance", "template-edge", "qa-runs", "qa-baseline", "qa-analyst", "qa-evidence", "qa-review", "qa-history", "run-slots", "queued-completion",
            "parent-resumed", "result-file", "result-missing", "lane-start", "director-relaunch")
SCRIPT_DIR = Path(os.path.realpath(os.path.dirname(os.path.abspath(__file__))))
REPO = Path(os.path.realpath(SCRIPT_DIR / "../../../.."))
CONTRACT = REPO / "qc.toml"


def cksum(data: bytes) -> int:
    """POSIX cksum's CRC, so the default folders keep the name the shell helper gave them."""
    n, tail = len(data), []
    while n:
        tail.append(n & 0xFF)
        n >>= 8
    crc = 0
    for b in [*data, *tail]:
        crc ^= b << 24
        for _ in range(8):
            crc = (((crc << 1) ^ 0x04C11DB7) if crc & 0x80000000 else crc << 1) & 0xFFFFFFFF
    return ~crc & 0xFFFFFFFF


BASE = Path(os.environ.get("TMPDIR") or "/tmp") / f"{ME}.{os.getuid()}.{cksum(str(REPO).encode())}"
RUN_DIR = Path(os.environ.get("VERIFY_OCTO_FEATHER_RUN_DIR") or BASE / "run")
EVIDENCE_DIR = Path(os.environ.get("VERIFY_OCTO_FEATHER_EVIDENCE_DIR") or BASE / "evidence")
STATE = RUN_DIR / "state"
CREATED = RUN_DIR / "created"
# The driving agent's own Herdr, session and state variables, never a drive's: with them a case would resolve the
# driver's real parent, spawn line or result file and write there (#1193).
DRIVER_LEAKS = ("HERDR_", "OCTO_FEATHER_", "XDG_STATE_HOME", "XDG_CACHE_HOME")


def case_env(env: dict[str, str] | None = None) -> dict[str, str]:
    """The environment of every command a drive runs: the helper's own without DRIVER_LEAKS, octo-feather state in
    the run's scratch (XDG_STATE_HOME) unless ENV names one or a scratch HOME, then ENV. A drive never writes under
    the caller's state."""
    env = env or {}
    own = {k: v for k, v in os.environ.items() if not k.startswith(DRIVER_LEAKS)}
    state = {} if "HOME" in env else {"XDG_STATE_HOME": str(RUN_DIR / "scratch" / "state")}
    return own | state | env


def say(msg: str) -> None:
    print(f"{ME}: {msg}", flush=True)


def die(msg: str) -> NoReturn:
    sys.stdout.flush()
    print(f"{ME}: {msg}", file=sys.stderr, flush=True)
    sys.exit(1)


def now() -> str:
    return datetime.now(UTC).strftime("%Y-%m-%dT%H:%M:%SZ")


def writable(d: Path) -> bool:
    """Prove a folder is writable by writing to it; `test -w` lies under some sandboxes."""
    try:
        d.mkdir(parents=True, exist_ok=True)
        probe = d / f".{ME}-probe.{os.getpid()}"
        probe.write_bytes(b"")
        probe.unlink()
    except OSError:
        return False
    return True


def output(argv: Sequence[str], **kw: Any) -> tuple[int, str]:
    """A command's exit code and its stdout then stderr, as text."""
    try:
        r = subprocess.run(list(argv), capture_output=True, text=True, check=False, **kw)
    except OSError as e:
        return 127, f"{e}\n"
    return r.returncode, r.stdout + r.stderr


def git_rev(repo: Path) -> str:
    code, out = output(["git", "-C", str(repo), "rev-parse", "--short", "HEAD"])
    return out.strip() if code == 0 and out.strip() else "unknown"


@dataclass(frozen=True)
class Contract:
    """The kit's contract, qc.toml at the kit root (format 2). The helper enters the kit only through it."""

    setup: str
    entry: str
    services: list[str]
    fixtures: dict[str, str]  # name: reset command
    values: dict[str, str]
    browser: str = ""  # [browser] playwright: the Playwright release whose headless shell the qc-browser drive needs


def read_contract() -> Contract:
    try:
        with CONTRACT.open("rb") as fh:
            c: dict[str, Any] = tomllib.load(fh)
    except (OSError, ValueError) as e:
        die(f"cannot read the kit's contract {CONTRACT}: {e}")
    if c.get("format") != 2:
        die(f"{CONTRACT}: format {c.get('format')!r}; this helper reads format 2 (validate: octo-feather-contract)")
    entry, services, fixture, values = (c.get(k) for k in ("entry", "services", "fixture", "values"))
    if not (isinstance(entry, dict) and isinstance(entry.get("command"), str) and isinstance(services, dict)
            and isinstance(fixture, dict)
            and all(isinstance(f, dict) and isinstance(f.get("reset"), str) for f in fixture.values())
            and isinstance(values, dict) and all(isinstance(v, str) for v in values.values())
            and isinstance(c.get("setup", ""), str)):
        die(f"{CONTRACT} does not match format 2 (validate: octo-feather-contract)")
    return Contract(setup=c.get("setup", ""), entry=entry["command"], services=list(services),
                    fixtures={k: f["reset"] for k, f in fixture.items()}, values=dict(values),
                    browser=str(c.get("browser", {}).get("playwright", "")))


def sh_in_repo(command: str) -> bool:
    """A contract command, as the contract says it runs: under sh, in the kit, with QC_REPO set."""
    return subprocess.run(["sh", "-c", command], cwd=REPO, env={**os.environ, "QC_REPO": str(REPO)},
                          check=False).returncode == 0


@dataclass(frozen=True)
class State:
    contract: Contract
    kit: str
    repo: str
    rev: str
    launched: str


def load_state() -> State:
    if not STATE.is_file():
        die(f"no run state at {STATE}: run '{ME} launch' first")
    s = json.loads(STATE.read_text())
    return State(contract=Contract(**s["contract"]), kit=s["kit"], repo=s["repo"], rev=s["rev"], launched=s["launched"])


def cmd_launch() -> None:
    if not writable(RUN_DIR):
        die(f"cannot write run state folder: {RUN_DIR}")
    if not writable(EVIDENCE_DIR):
        die(f"cannot write evidence folder: {EVIDENCE_DIR}")
    c = read_contract()
    # Short-lived commands: this helper starts no service. A contract that declares one needs a helper that readies it.
    if c.services:
        die(f"qc.toml declares services ({' '.join(c.services)}); this helper starts none: extend it to start and ready them")
    if c.setup:
        say(f"setup in {REPO} (qc.toml setup): {c.setup}")
        if not sh_in_repo(c.setup):
            die(f"qc.toml setup failed: {c.setup}")
    # The kit command: qc.toml's entry with the user's command appended.
    kit = RUN_DIR / "bin" / "kit"
    try:
        (RUN_DIR / "bin").mkdir(parents=True, exist_ok=True)
        (RUN_DIR / "scratch").mkdir(parents=True, exist_ok=True)
    except OSError:
        die(f"cannot write run state folder: {RUN_DIR}")
    wrapper = f"""#!/usr/bin/env bash\nexport QC_REPO={shlex.quote(str(REPO))}\nexec sh -c {shlex.quote(c.entry + ' "$@"')} kit "$@"\n"""
    try:
        kit.write_text(wrapper)
        kit.chmod(0o755)
    except OSError:
        die(f"cannot write kit command: {kit}")
    rev = git_rev(REPO)
    try:
        STATE.write_text(json.dumps({"contract": asdict(c), "kit": str(kit), "repo": str(REPO), "rev": rev,
                                     "launched": now()}, indent=1) + "\n")
    except OSError:
        die(f"cannot write run state file: {STATE}")
    if STATE.stat().st_size == 0:
        die(f"run state file is empty: {STATE}")
    say(f"ready: kit={kit} entry={c.entry} rev={rev}")
    say(f"run state: {RUN_DIR}")
    say(f"evidence:  {EVIDENCE_DIR}")


def cmd_doctor(tee: Path | None = None) -> int:
    s = load_state()
    ok = 0
    log = tee.open("w") if tee else None

    def report(level: str, msg: str) -> None:
        line = f"{level:<8} {msg}"
        print(line, flush=True)
        if log:
            log.write(line + "\n")

    if os.access(s.kit, os.X_OK):
        report("ok", f"kit command {s.kit}")
    else:
        report("FAIL", f"kit command missing: {s.kit}")
        ok = 1
    report("info", f"entry (qc.toml): {s.contract.entry}")
    for t in ("just", "git", "python3"):
        if shutil.which(t):
            report("ok", f"{t} on PATH")
        else:
            report("FAIL", f"{t} not on PATH: the kit's commands need it")
            ok = 1
    for t in ("octo-feather-new-repo", "octo-feather-contract", "octo-feather-evidence", "pi-role"):
        out = output([s.kit, "sh", "-c", 'command -v "$1"', "sh", t])[1].rstrip("\n")
        if out == f"{s.repo}/scripts/{t}":
            report("ok", f"{t} resolves to this checkout")
        else:
            report("FAIL", f"{t} resolves to '{out}', not {s.repo}/scripts/{t}")
            ok = 1
    code, out = output([s.kit, "just", "--justfile", f"{s.repo}/justfile", "--summary"])
    out = out.rstrip("\n")
    if code == 0 and {"new-repo", "install-check"} <= set(out.split()):
        report("ok", "kit justfile lists new-repo and install-check")
    else:
        report("FAIL", f"'just --summary' failed or lacks new-repo, install-check: {out}")
        ok = 1
    code, out = output([s.kit, "octo-feather-contract", s.repo])
    out = out.rstrip("\n")
    if code == 0:
        report("ok", out)
    else:
        report("FAIL", out)
        ok = 1
    rev = git_rev(Path(s.repo))
    if rev == s.rev:
        report("ok", f"checkout at launch rev {s.rev}")
    else:
        report("WARN", f"checkout moved: launched at {s.rev}, now {rev} (relaunch)")
    installer = spec_chat_installer()
    if os.access(installer, os.X_OK):
        report("ok", f"Spec Chat installer {installer} (new-repo links it)")
    else:
        report("WARN", f"no Spec Chat installer at {installer}: the new-repo drive creates with --no-spec-chat and reports "
               "the Spec Chat link step unreachable (features/new-repo.md Gotchas); the shape drive reports its launch "
               "unreachable (features/shape.md)")
    if has_netns():
        report("ok", "unshare -Un: install-check drives without network")
    else:
        report("WARN", "no network namespace (unshare -Un): the install-check drive fails (features/install-check.md Gotchas)")
    if (RUN_DIR / "scratch").is_dir():
        report("ok", f"scratch {RUN_DIR / 'scratch'}")
    else:
        report("FAIL", "scratch missing")
        ok = 1
    if log:
        log.close()
    return ok


NETNS = ["unshare", "-Un", "--map-current-user"]


def spec_chat_installer() -> str:
    """Where new-repo looks for Spec Chat's installer: $SPEC_CHAT_CLONE (default ~/src/spec-chat)/scripts/install-spec-chat."""
    clone = os.environ.get("SPEC_CHAT_CLONE") or f"{Path.home()}/src/spec-chat"
    return f"{clone}/scripts/install-spec-chat"


def has_netns() -> bool:
    return output([*NETNS, "true"])[0] == 0


@dataclass(frozen=True)
class Case:
    """What one case left: stdout, stderr, exit code, stdout as JSON (None when it is not), the facts
    observed after it (o[key]), the contract's values (v) and the kit root (kit)."""

    out: str
    err: str
    code: int
    j: Any
    o: dict[str, str]
    v: dict[str, str]
    kit: str


@dataclass
class Feature:
    """One feature's drive: its evidence folder and its cases' results."""

    s: State
    d: Path
    fails: int = 0
    unreachable: list[str] = field(default_factory=list[str])  # steps not reached, each with its prerequisite
    env: dict[str, str] = field(default_factory=dict[str, str])  # scratch env for the next cases
    pre: list[str] = field(default_factory=list[str])  # a wrapper such as unshare for the next cases
    cpu: float = 0.0  # the last case command's CPU, user + system, with every process it waited for (getrusage)

    def run(self, name: str, *args: str) -> None:
        """One isolated case: fresh empty cwd, the command as typed, stdout, stderr, exit code, files left
        in cwd, and the kit checkout's git status before and after (a drive changes nothing in the kit)."""
        d = self.d
        cwd = RUN_DIR / "scratch" / "cwd" / name
        shutil.rmtree(cwd, ignore_errors=True)
        cwd.mkdir(parents=True)
        typed = [f"{k}={v}" for k, v in self.env.items()] + self.pre + list(args)
        (d / f"{name}.cmd").write_text("".join(f"{shlex.quote(a)} " for a in typed) + "\n")
        before = self.kit_status()
        with (d / f"{name}.stdout").open("wb") as out, (d / f"{name}.stderr").open("wb") as err:
            r0 = resource.getrusage(resource.RUSAGE_CHILDREN)
            rc = subprocess.run([*self.pre, self.s.kit, *args], cwd=cwd, env=case_env(self.env),
                                stdout=out, stderr=err, check=False).returncode
            r1 = resource.getrusage(resource.RUSAGE_CHILDREN)
            self.cpu = r1.ru_utime - r0.ru_utime + r1.ru_stime - r0.ru_stime
        (d / f"{name}.exit").write_text(f"{128 - rc if rc < 0 else rc}\n")
        left = sorted(str(Path(r) / f) for r, ds, fs in os.walk(cwd) for f in [*ds, *fs])
        (d / f"{name}.files").write_text("".join(f"{p}\n" for p in left))
        after = self.kit_status()
        (d / f"{name}.kit-status").write_text("".join(difflib.unified_diff(
            before.splitlines(keepends=True), after.splitlines(keepends=True), "before", "after")))

    def kit_status(self) -> str:
        return output(["git", "-C", self.s.repo, "status", "--porcelain=v1"])[1]

    def obs(self, name: str, key: str, text: str) -> None:
        """An observed fact for the check as o[key]."""
        (self.d / f"{name}.obs.{key}").write_text(text)

    def obs_cmd(self, name: str, key: str, *argv: str) -> None:
        """An observed fact: a command's stdout and stderr."""
        self.obs(name, key, output(argv)[1])

    def check(self, name: str, holds: Callable[[Case], object]) -> None:
        """A case passes when holds is true, it left no files in its cwd and the kit's git status did not change."""
        d = self.d
        out = (d / f"{name}.stdout").read_text()
        err = (d / f"{name}.stderr").read_text()
        code = int((d / f"{name}.exit").read_text())
        o = {p.name[len(name) + 5:]: p.read_text() for p in d.glob(f"{glob.escape(name)}.obs.*")}
        clean = (d / f"{name}.files").read_text() == "" and (d / f"{name}.kit-status").read_text() == ""
        try:
            j = json.loads(out)
        except ValueError:
            j = None
        try:
            passed = bool(holds(Case(out=out, err=err, code=code, j=j, o=o, v=self.s.contract.values, kit=self.s.repo)))
        except Exception as e:  # noqa: BLE001  a check that cannot evaluate fails its case
            print(f"check error: {type(e).__name__}: {e}", file=sys.stderr, flush=True)
            passed = False
        verdict = "PASS" if passed and clean else "FAIL"
        self.summary(f"{verdict} {name}: {(d / f'{name}.cmd').read_text().rstrip(chr(10))}")
        for label, text in (("stdout", out), ("stderr", err)):
            for ln in text.splitlines():
                print(f"    {label}: {ln}")
        print(f"    exit: {code}", flush=True)
        if verdict != "PASS":
            self.fails += 1

    def unreachable_step(self, name: str, why: str) -> None:
        """A step this box cannot reach: printed and recorded with its prerequisite, never counted as passed."""
        self.unreachable.append(name)
        self.summary(f"UNREACHABLE {name}: {why}")

    def verdict(self) -> str:
        if self.fails:
            return "FAIL"
        return "PASS-with-unreachable" if self.unreachable else "PASS"

    def summary(self, line: str) -> None:
        print(line, flush=True)
        with (self.d / "summary.txt").open("a") as fh:
            fh.write(line + "\n")


def qc_report(f: Feature, name: str) -> dict[str, Any]:
    """The report of case NAME's `just qc` run, from the path qc itself printed (`report <path>`, its last), {} when
    it printed none. Never a glob of a state dir: qc's state dir follows the caller's Herdr session (octo-feather-state),
    a scratch session's inside the qc sandbox."""
    text = (f.d / f"{name}.stdout").read_text() + (f.d / f"{name}.stderr").read_text()
    paths = [p for p in re.findall(r"\breport (/\S+?\.json)\b", text) if Path(p).is_file()]
    return json.loads(Path(paths[-1]).read_text()) if paths else {}


def scratch_state(f: Feature) -> Path:
    """The state dir the drive's commands use: `octo-feather-state` asked under the drive's env (f.env), never a guessed
    root (inside a qc sandbox HERDR_SESSION names the run's session, so it is that session's dir)."""
    r = subprocess.run([f.s.kit, "octo-feather-state"], capture_output=True, text=True, env=case_env(f.env), check=False)
    if r.returncode or not r.stdout.strip():
        die(f"octo-feather-state failed under the drive's env: {r.stderr.strip()}")
    return Path(r.stdout.strip())


def fake_tracker(kit: str, sc: Path) -> dict[str, str]:
    """The scratch env that fakes the tracker: the kit's offline gh (tests/fixtures/tracker-gh) first on PATH, its
    store under SC, so a correction lane a reflection files never reaches GitHub (SKILL.md)."""
    # All four callers drive reflection: its required director is synthetic, not the box's.
    env = {"PATH": f"{kit}/tests/fixtures/tracker-gh:{os.environ.get('PATH', '')}", "FAKE_GH_STORE": str(sc / "gh.json")}
    fixture = Path(kit) / "tests/fixtures/reflection-director"
    binary = sc / "reflection-bin"
    binary.mkdir(exist_ok=True)
    shutil.copy2(fixture, binary / "herdr")
    (binary / "herdr").chmod(0o755)
    env["REFLECT_DIRECTOR_FILE"] = str(sc / "director-source.jsonl")
    subprocess.run([sys.executable, str(fixture), "seed", str(sc / "state/octo-feather")],
                   env=case_env(env), check=True, capture_output=True, text=True)
    env["PATH"] = f"{binary}:{env['PATH']}"
    return env


def fresh_path(p: Path) -> None:
    """A path a drive creates; cleanup removes it, and only it. Refuses a path that already holds anything."""
    if p.exists() and (not p.is_dir() or any(p.iterdir())):
        die(f"{p} exists and is not empty: pick a new path (VERIFY_OCTO_FEATHER_NEW_REPO_DEST)")
    with CREATED.open("a") as fh:
        fh.write(f"{p}\n")


def sorted_lines(text: str) -> str:
    return "".join(f"{ln}\n" for ln in sorted(text.splitlines()))


def drive_new_repo(f: Feature) -> None:
    s, v = f.s, f.s.contract.values
    if "lang" not in v:
        die("qc.toml [values] has no lang: the new-repo drive creates a repo from templates/<lang>")
    lang = v["lang"]
    dest = Path(os.path.realpath(os.environ.get("VERIFY_OCTO_FEATHER_NEW_REPO_DEST") or RUN_DIR / "scratch" / "new-repo" / lang))
    bad = RUN_DIR / "scratch" / "new-repo" / "bad-lang"
    kitjust = f"{s.repo}/justfile"
    fresh_path(dest)
    fresh_path(bad)
    say(f"new-repo dest: {dest}")
    # Spec Chat's installer writes its onboarding state under XDG_STATE_HOME: a scratch one, never the box's.
    f.env = {"XDG_STATE_HOME": str(RUN_DIR / "scratch" / "state")}

    installer = spec_chat_installer()
    linked = os.access(installer, os.X_OK)
    create, flags = ("create", []) if linked else ("create-no-spec-chat", ["--no-spec-chat"])
    # The template's tracked files, which the new repo must hold exactly.
    f.obs(create, "template-files", sorted_lines(output(["git", "-C", f"{s.repo}/templates/{lang}", "ls-files"])[1]))
    f.obs(create, "dest", f"{dest}\n")
    if not linked:
        # No installer on this box: the Spec Chat link step is unreachable. Attempt the plain create (the
        # route), record its refusal, then prove everything else new-repo does with --no-spec-chat.
        f.run("spec-chat-link", "just", "--justfile", kitjust, "new-repo", lang, str(dest))
        err = (f.d / "spec-chat-link.stderr").read_text()
        code = int((f.d / "spec-chat-link.exit").read_text())
        refused = [ln for ln in err.splitlines() if "no Spec Chat installer at" in ln]
        clean = (f.d / "spec-chat-link.files").read_text() == "" and (f.d / "spec-chat-link.kit-status").read_text() == ""
        if code == 1 and refused and not dest.exists() and clean:
            f.unreachable_step("spec-chat-link", f"Spec Chat installer not at $SPEC_CHAT_CLONE/scripts/install-spec-chat "
                               f"({installer}; SPEC_CHAT_CLONE defaults to ~/src/spec-chat); prerequisite: a Spec Chat "
                               f"clone there or SPEC_CHAT_CLONE set to one; route attempted: "
                               f"{(f.d / 'spec-chat-link.cmd').read_text().strip()} -> exit 1: {refused[0]}")
        else:
            f.summary(f"FAIL spec-chat-link: installer absent at {installer}, but new-repo without --no-spec-chat "
                      f"did not refuse it (exit {code}; spec-chat-link.stderr)")
            f.fails += 1

    f.run(create, "just", "--justfile", kitjust, "new-repo", lang, str(dest), *flags)
    f.obs_cmd(create, "log", "git", "-C", str(dest), "log", "--format=%s", "main")
    f.obs_cmd(create, "branch", "git", "-C", str(dest), "branch", "--show-current")
    f.obs_cmd(create, "status", "git", "-C", str(dest), "status", "--porcelain=v1")
    f.obs(create, "files", sorted_lines(output(["git", "-C", str(dest), "ls-files"])[1]))
    agents = dest / "AGENTS.md"
    lines = agents.read_text().splitlines() if agents.is_file() else []
    f.obs(create, "repo-skills", "".join(f"{ln}\n" for ln in lines if ln.startswith("Repo skills:")))
    f.obs(create, "verify-skill", "".join(f"{p}\n" for p in sorted(glob.glob(f"{glob.escape(str(dest))}/.agents/skills/verify-*/SKILL.md"))))
    f.obs_cmd(create, "contract", s.kit, "octo-feather-contract", str(dest))
    # Without the installer the summary must say no Spec Chat was linked: never claim the links were made.
    f.check(create, lambda c: c.code == 0 and c.o["dest"].strip() + " from templates/" + c.v["lang"] in c.out
            and (not flags or ", no Spec Chat (--no-spec-chat)" in c.out)
            and re.fullmatch(r"Initial commit from octo-feather templates/" + c.v["lang"] + r" @ [0-9a-f]+\n", c.o["log"])
            and c.o["branch"] == "main\n" and c.o["status"] == "" and c.o["files"] == c.o["template-files"]
            and re.search(r"\bverify-\w+", c.o["repo-skills"]) and c.o["verify-skill"].strip()
            and c.o["contract"].endswith(": ok (format 2)\n"))

    # Over the repo just made: refused, the repo untouched.
    f.obs_cmd("refuse-nonempty", "head-before", "git", "-C", str(dest), "rev-parse", "HEAD")
    f.run("refuse-nonempty", "just", "--justfile", kitjust, "new-repo", lang, str(dest))
    f.obs_cmd("refuse-nonempty", "head-after", "git", "-C", str(dest), "rev-parse", "HEAD")
    f.check("refuse-nonempty", lambda c: c.code == 1 and "exists and is not empty" in c.err
            and c.o["head-before"] == c.o["head-after"] and len(c.o["head-after"]) > 7)

    f.run("refuse-lang", "just", "--justfile", kitjust, "new-repo", "no-such-lang", str(bad))
    f.obs("refuse-lang", "made", "made\n" if bad.exists() else "")
    f.check("refuse-lang", lambda c: c.code == 1 and "unknown LANG" in c.err and c.o["made"] == "")
    f.env = {}
    say(f"new-repo evidence: {f.d}")


def drive_install_check(f: Feature) -> None:
    # No network: gh auth status cannot reach GitHub, so the gh line is deterministic (features/install-check.md).
    if not has_netns():
        f.summary("FAIL offline: no network namespace (unshare -Un) on this box; install-check's gh auth status would reach GitHub")
        f.fails += 1
        return
    f.pre = NETNS
    f.run("offline", "just", "--justfile", f"{f.s.repo}/justfile", "install-check", f.s.repo)
    f.pre = []
    tools = ("herdr", "pi", "gh", "jq", "git", "just", "python3", "node")
    f.check("offline", lambda c: c.code == 1
            and all(re.search(r"(?m)^" + t + r" +(ok  /|MISSING; \S)", c.out) for t in tools)
            and all(re.search(r"(?m)^" + b, c.out) for b in (
                r"kernel \S+ (ok \(6\.6 or later|TOO OLD, .*; boot a 6\.6)", r"userns (ok |FAILED .*; \S)", r"state  (ok  /|[A-Z ]+ .*; \S)",
                r"kit    (ok  /|[A-Z ]+ .*; \S)", r"ffmpeg (ok  /|OPTIONAL .*; to record video: )",
                r"sharing MANUAL .*: ssh exe\.dev share set-private \S+",
                r"review (ok  spec-chat-review\.service active, enabled|(NOT RUNNING|MISSING) .*install-spec-chat --review \S+ --public \S+\.exe\.xyz --service)",
                r"models MANUAL not checked here \(no model call\); .*: just install-check-models$"))
            and re.search(r"(?m)^agent-browser (browser (ok  /|(MISSING|UNREADABLE IN THE QC SANDBOX) .*; agent-browser install)|MISSING)", c.out)
            and re.search(r"(?m)^pi +(version \S+ ok|WRONG VERSION)", c.out)
            and re.search(r"(?m)^agent-browser (version \S+ ok|WRONG VERSION|MISSING)", c.out)
            and re.search(r"(?m)^gh +NOT authenticated \(gh auth login\)$", c.out)
            and re.search(r"(?m)^tracker \S+ \(target " + re.escape(c.kit) + r"\)$", c.out))
    # The model check, its own recipe (spec remote#host-models), offline: each role model's call cannot reach the
    # proxy, so no model is called and each is UNREACHABLE with its roles and the fix; the key never printed.
    f.pre = NETNS
    f.run("models-offline", "just", "--justfile", f"{f.s.repo}/justfile", "install-check-models")
    f.pre = []
    f.check("models-offline", lambda c: c.code == 1
            and re.search(r"(?m)^models pi /\S+ \(one short call per role model", c.out)
            and re.search(r"(?m)^model  \S+/\S+ UNREACHABLE \(.*\) for roles \S.*; the model proxy for provider \S+ did not answer: .*just install-check-models$", c.out)
            and re.search(r"(?m)^model  \S+/\S+ UNREACHABLE \(.*\) for judgment model \(evals/judgment-model\.json\): .*just install-check-models$", c.out)
            and not re.search(r"(?m)^model  .* (ok|REJECTED|FAILED) ", c.out)
            and re.search(r"(?m)^models spend 0\.0000 USD \([1-9][0-9]* calls", c.out))
    say(f"install-check evidence: {f.d}")


def drive_contract(f: Feature) -> None:
    sc = RUN_DIR / "scratch" / "contract"
    shutil.rmtree(sc, ignore_errors=True)
    (sc / "missing-entry").mkdir(parents=True)
    (sc / "none").mkdir(parents=True)
    (sc / "missing-entry" / "qc.toml").write_text("format = 1\n[services]\n[fixture]\n[values]\n")

    f.run("kit", "octo-feather-contract", f.s.repo)
    f.check("kit", lambda c: c.code == 0 and c.out == f"octo-feather-contract: {c.kit}/qc.toml: ok (format 2)\n")
    f.run("missing-entry", "octo-feather-contract", str(sc / "missing-entry"))
    f.check("missing-entry", lambda c: c.code == 1 and "missing entry" in c.out + c.err and "ok" not in c.out)
    f.run("no-contract", "octo-feather-contract", str(sc / "none"))
    f.check("no-contract", lambda c: c.code == 1 and "no qc.toml at" in c.out + c.err)
    say(f"contract evidence: {f.d}")


def drive_evidence(f: Feature) -> None:
    v = f.s.contract.values
    if "scratch_criterion" not in v or "scratch_criterion_text" not in v:
        die("qc.toml [values] needs scratch_criterion and scratch_criterion_text: the evidence drive's scratch records serve it")
    crit, text = v["scratch_criterion"], v["scratch_criterion_text"]
    sc = RUN_DIR / "scratch" / "evidence"
    r = sc / "repo"
    shutil.rmtree(sc, ignore_errors=True)
    for p in (r, sc / "outputs", sc / "state"):
        p.mkdir(parents=True)
    # A scratch target and a scratch store (XDG_STATE_HOME): the box's evidence stores are never touched.
    def git(*args: str) -> str:
        return subprocess.run(["git", "-C", str(r), "-c", "user.name=verify-octo-feather",
                               "-c", "user.email=verify@octo-feather.invalid", "-c", "core.hooksPath=/dev/null", *args],
                              check=True, capture_output=True, text=True).stdout.strip()

    git("init", "-q", "-b", "main")
    (r / "file").write_text("one\n")
    git("add", "file")
    git("commit", "-q", "-m", "one")
    a = git("rev-parse", "HEAD")
    (sc / "outputs" / "out.txt").write_text("drive output one\n")
    f.env = {"XDG_STATE_HOME": str(sc / "state")}
    append = ("octo-feather-evidence", "append", "--repo", str(r), "--criterion", crit, "--criterion-text", text,
              "--outputs", str(sc / "outputs"))
    record_id = r"[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}\n"

    def records() -> list[Path]:
        return sorted((sc / "state").rglob("record.json"))

    f.run("append-a", *append)
    first = records()[0] if records() else None
    f.obs("append-a", "record", first.read_text() if first else "")
    f.check("append-a", lambda c: c.code == 0 and re.fullmatch(record_id, c.out)
            and json.loads(c.o["record"])["id"] + "\n" == c.out and json.loads(c.o["record"])["revision"] == a
            and json.loads(c.o["record"])["criterion"]["text_from"] == "caller")
    first_sha = hashlib.sha256(first.read_bytes()).hexdigest() if first else ""

    (r / "file").write_text("two\n")
    git("commit", "-q", "-am", "two")
    b = git("rev-parse", "HEAD")
    (sc / "outputs" / "out.txt").write_text("drive output two\n")
    f.run("append-b", *append)
    same = first is not None and hashlib.sha256(first.read_bytes()).hexdigest() == first_sha
    f.obs("append-b", "first-unchanged", "" if same else f"{first}: FAILED\n")
    f.obs("append-b", "records", f"{len(records())}\n")
    f.obs_cmd("append-b", "repo-status", "git", "-C", str(r), "status", "--porcelain=v1")
    f.check("append-b", lambda c: c.code == 0 and re.fullmatch(record_id, c.out)
            and c.o["first-unchanged"] == "" and c.o["records"].strip() == "2" and c.o["repo-status"] == "")

    f.run("read-a", "octo-feather-evidence", "read", "--repo", str(r), "--criterion", crit, "--commit", a, "--json")
    f.check("read-a", lambda c: c.code == 0 and isinstance(c.j, list) and len(c.j) == 1
            and c.j[0]["record"]["revision"] == a
            and c.j[0]["record"]["criterion"]["id"] == c.v["scratch_criterion"]
            and len(c.j[0]["record"]["criterion"]["text_sha256"]) == 64
            and "contract" in c.j[0]["record"] and "fixture" in c.j[0]["record"]
            and "out.txt" in c.j[0]["record"]["outputs"])
    f.run("read-b-text", "octo-feather-evidence", "read", "--repo", str(r), "--criterion", crit, "--commit", b)
    f.check("read-b-text", lambda c: c.code == 0 and "drive output two" in c.out and "drive output one" not in c.out
            and b in c.out)
    f.env = {}
    say(f"evidence evidence: {f.d}")


def drive_lane_archive(f: Feature) -> None:
    sc = RUN_DIR / "scratch" / "lane-archive"
    shutil.rmtree(sc, ignore_errors=True)
    lanes = sc / "state" / "octo-feather" / "lanes"
    lanes.mkdir(parents=True)
    # A scratch merged lane: a review finding in its log, a stranded-worker catch in the director log.
    (lanes / "gh900.toml").write_text('supervisor = "w90:p2"\nissue = "gh900"\ngoal = "scratch lane"\n')
    seeded = ('{"at": "2026-10-28T00:05:00Z", "kind": "spawn", "name": "implementer-gh901", "pane": "w90:p3"}\n'
              '{"at": "2026-10-28T01:00:00Z", "kind": "finding", "source": "code-review", "class": "duplicated-rule", "blocking": true, "summary": "restated rule"}\n')
    (lanes / "gh900.handoffs.jsonl").write_text(seeded)
    (lanes.parent / "director.handoffs.jsonl").write_text(
        '{"at": "2026-10-28T00:40:00Z", "kind": "note", "issue": 900, "text": "read pane w90:p3: implementer-gh901 stranded at '
        'Pi\'s \'Trust project folder?\' prompt for 35 min; supervisor w90:p2 had not noticed"}\n')

    def files() -> str:
        return "".join(f"{p.relative_to(lanes)} {hashlib.sha256(p.read_bytes()).hexdigest()}\n" for p in sorted(lanes.rglob("*")) if p.is_file())

    # Scratch state, a dead Herdr socket, no saved Pi session; the reflector's model unreachable (no network).
    # OCTO_FEATHER_REFLECT_ARGS from the caller rides along (e.g. "--thinking off" for a cheap smoke).
    args = " ".join(["--no-session", os.environ.get("OCTO_FEATHER_REFLECT_ARGS", "")]).strip()
    f.env = {"XDG_STATE_HOME": str(sc / "state"), "HERDR_SESSION": "", "HERDR_SOCKET_PATH": str(sc / "no-herdr.sock"),
             "OCTO_FEATHER_REFLECT_ARGS": args, "OCTO_FEATHER_REFLECT_TIMEOUT": "120", **fake_tracker(f.s.repo, sc)}
    if not has_netns():
        f.summary("FAIL refuse-unreachable: no network namespace (unshare -Un) on this box; the reflector would reach its model")
        f.fails += 1
    else:
        f.obs("refuse-unreachable", "before", files())
        f.pre = NETNS
        f.run("refuse-unreachable", "octo-feather-lane", "archive", "gh900")
        f.pre = []
        f.obs("refuse-unreachable", "after", files())
        f.check("refuse-unreachable", lambda c: c.code == 1 and "lane reflection of gh900 failed" in c.err
                and "nothing appended" in c.err and c.o["before"] == c.o["after"] and "gh900.toml" in c.o["after"]
                and "archive/" not in c.o["after"])
    f.run("refuse-no-record", "octo-feather-lane", "reflect", "gh404")
    f.check("refuse-no-record", lambda c: c.code == 1 and "no lane record" in c.err)
    # The real reflector on the same lane, its model reached (SKILL.md: a role's model run is the one exception
    # to offline); the reflect command's gh is the fake tracker and the reflector has only read, grep, find and ls,
    # Herdr stays a dead socket and the state a scratch one, so no live lane is reached.
    f.env["OCTO_FEATHER_REFLECT_TIMEOUT"] = os.environ.get("OCTO_FEATHER_REFLECT_TIMEOUT") or "1800"
    f.run("reflect-live", "octo-feather-lane", "archive", "gh900")
    f.obs("reflect-live", "after", files())
    arch = lanes / "archive" / "gh900.handoffs.jsonl"
    f.obs("reflect-live", "archived-log", arch.read_text() if arch.is_file() else "")
    f.obs("reflect-live", "seeded", seeded)
    ids = [q["id"] for q in json.loads((Path(f.s.repo) / "reflection" / "questions.json").read_text())["questions"]
           if q["kind"] == "lane"]

    def reflected(c: Case) -> bool:
        """The archived log: the seeded lines unchanged, then N finding lines (source reflection, blocking false, a
        lane question, a route), then one reflection line with findings N; one caught-by-hand finding names the
        stranded worker; the record and log moved out of lanes/."""
        log = c.o["archived-log"]
        if not log.startswith(c.o["seeded"]):
            return False
        new = [json.loads(ln) for ln in log[len(c.o["seeded"]):].splitlines()]
        found, last = new[:-1], new[-1]
        m = re.search(r"(?m)^reflection: lane gh900, (\d+) findings?, questions ", c.out)
        return (c.code == 0 and m is not None and int(m[1]) == len(found) == last["findings"] > 0
                and last["kind"] == "reflection" and sorted(last["questions"]) == sorted(ids)
                and all(x["kind"] == "finding" and x["source"] == "reflection" and x["blocking"] is False
                        and x["question"] in ids and x["route"] and x["summary"] and x["class"] for x in found)
                and any(x["question"] == "caught-by-hand"
                        and re.search(r"strand|trust project folder|w90:p3|prompt", x["summary"], re.IGNORECASE) for x in found)
                and "archive/gh900.toml" in c.o["after"] and "\ngh900.toml" not in "\n" + c.o["after"])

    f.check("reflect-live", reflected)
    if arch.is_file():
        for ln in arch.read_text()[len(seeded):].splitlines():
            print(f"    archived log: {ln}")
    f.env = {}
    say(f"lane-archive evidence: {f.d}")


def drive_director_reflection(f: Feature) -> None:
    sc = RUN_DIR / "scratch" / "director-reflection"
    shutil.rmtree(sc, ignore_errors=True)
    lanes = sc / "state" / "octo-feather" / "lanes"
    (lanes / "archive").mkdir(parents=True)
    dlog = lanes.parent / "director.handoffs.jsonl"
    # Three lanes, one code-review class in each (two archived, gh913 open); gh911's lane reflection found no gap
    # before gh913's review found the class again. The director log: a director reflection two days ago, then an
    # owner-caught finding.
    now = datetime.now(UTC)
    def at(hours: int) -> str:
        return datetime.fromtimestamp(now.timestamp() - hours * 3600, UTC).strftime("%Y-%m-%dT%H:%M:%SZ")
    def cr(at: str, cls: str, summary: str) -> str:
        return json.dumps({"at": at, "kind": "finding", "source": "code-review", "class": cls, "blocking": True, "summary": summary}) + "\n"
    (lanes / "archive" / "gh911.handoffs.jsonl").write_text(
        cr(at(36), "duplicated-rule", "help text restates the archive refusal rule of comms #reflection-lane")
        + json.dumps({"at": at(35), "kind": "reflection", "findings": 0, "questions": ["caught-by-hand", "slow-or-from-memory",
                      "undetected-rule", "check-misfired", "mechanical-step", "writer-mistake", "reflection-missed"]}) + "\n")
    (lanes / "archive" / "gh912.handoffs.jsonl").write_text(
        cr(at(24), "duplicated-rule", "test comment restates the hand-off line fields of comms #handoff-kind-finding"))
    (lanes / "gh913.toml").write_text('supervisor = "w93:p2"\nissue = "gh913"\ngoal = "scratch lane"\n')
    (lanes / "gh913.handoffs.jsonl").write_text(
        cr(at(12), "duplicated-rule", "eval prompt restates the reflection output rule of comms #reflection-output"))
    two_days = at(48)
    seeded = (json.dumps({"at": two_days, "kind": "reflection", "findings": 0, "questions": ["owner-asked"]}) + "\n"
              + json.dumps({"at": at(1), "kind": "finding", "class": "owner-caught-stranded-worker", "issue": "gh913",
                            "summary": "owner asked why lane gh913 had not moved for an hour: implementer-gh913 sat at Pi's trust prompt; "
                                       "the director had read no pane"}) + "\n")
    dlog.write_text(seeded)
    extra = shlex.split(os.environ.get("OCTO_FEATHER_REFLECT_ARGS", ""))
    retain = "--session-dir" in extra
    args = shlex.join(extra if retain else ["--no-session", *extra])
    f.env = {"XDG_STATE_HOME": str(sc / "state"), "HERDR_SESSION": "", "HERDR_SOCKET_PATH": str(sc / "no-herdr.sock"),
             "OCTO_FEATHER_REFLECT_ARGS": args, "OCTO_FEATHER_REFLECT_TIMEOUT": "120", **fake_tracker(f.s.repo, sc)}
    # Synthetic source episodes match the fresh review and owner-intervention records.
    conversation = [
        (36, "assistant", "In gh911 I copied the archive refusal contract into help text from memory instead of referring to its source."),
        (36, "user", "Review gh911: that help text restates comms #reflection-lane. Please remove the independent wording."),
        (35, "assistant", "I fixed that text and closed gh911's reflection with no gap; I treated it as isolated."),
        (24, "assistant", "In gh912 I again wrote a local version of the hand-off field contract, this time in a test comment."),
        (24, "user", "Review gh912: the comment restates comms #handoff-kind-finding. The same writing habit happened again."),
        (12, "assistant", "In gh913 I wrote an eval prompt with its own reflection output instructions rather than a reference."),
        (12, "user", "Review gh913: that prompt restates comms #reflection-output. The earlier local fixes did not change our writing habit."),
        (1, "user", "Why has gh913 not moved for an hour? I opened the implementer's pane and found a trust prompt waiting for input."),
        (1, "assistant", "I had not read the pane before reporting progress, nor connected the repeated review corrections across these lanes."),
    ]
    with Path(f.env["REFLECT_DIRECTOR_FILE"]).open("a") as source:
        source.writelines(json.dumps({"type": "message", "timestamp": at(hours),
                                      "message": {"role": role, "content": [{"type": "text", "text": text}]}}) + "\n"
                          for hours, role, text in conversation)
    if not has_netns():
        f.summary("FAIL refuse-unreachable: no network namespace (unshare -Un) on this box; the reflector would reach its model")
        f.fails += 1
    else:
        f.pre = NETNS
        f.run("refuse-unreachable", "octo-feather-lane", "reflect", "--director")
        f.pre = []
        f.obs("refuse-unreachable", "director-log", dlog.read_text())
        f.check("refuse-unreachable", lambda c: c.code == 1 and "director reflection failed" in c.err
                and "nothing appended" in c.err and c.o["director-log"] == seeded)
    # The real reflector, its model reached (SKILL.md: a role's model run is the one exception to offline).
    f.env["OCTO_FEATHER_REFLECT_TIMEOUT"] = os.environ.get("OCTO_FEATHER_REFLECT_TIMEOUT") or "1800"
    f.run("reflect-live", "octo-feather-lane", "reflect", "--director")
    f.obs("reflect-live", "director-log", dlog.read_text())
    f.obs("reflect-live", "seeded", seeded)
    ids = [q["id"] for q in json.loads((Path(f.s.repo) / "reflection" / "questions.json").read_text())["questions"]
           if q["kind"] == "director"]

    def reflected(c: Case) -> bool:
        """The director log: the seeded lines unchanged, then N finding lines (source reflection, a director question,
        a route), then one reflection line with findings N and every director question; one finding of class
        duplicated-rule with its count 3, routed to a writer-side file, not to review."""
        log = c.o["director-log"]
        if not log.startswith(c.o["seeded"]):
            return False
        new = [json.loads(ln) for ln in log[len(c.o["seeded"]):].splitlines()]
        if not new:
            return False
        found, last = new[:-1], new[-1]
        m = re.search(r"(?m)^reflection: director, (\d+) findings?, questions ", c.out)
        return (c.code == 0 and m is not None and int(m[1]) == len(found) == last["findings"] > 0
                and last["kind"] == "reflection" and sorted(last["questions"]) == sorted(ids)
                and all(x["kind"] == "finding" and x["source"] == "reflection" and "blocking" not in x
                        and x["question"] in ids and x["route"] and x["summary"] and x["class"] for x in found)
                and any("duplicated-rule" in x["class"] + x["summary"] and re.search(r"\b(3|three)\b", x["summary"], re.IGNORECASE)
                        and not re.fullmatch(r"(code[- ])?review.*", x["route"], re.IGNORECASE) for x in found))

    f.check("reflect-live", reflected)
    for ln in dlog.read_text()[len(seeded):].splitlines():
        print(f"    director log: {ln}")
    # Fresh now: a start's --due run does nothing.
    f.obs("due-fresh", "before", dlog.read_text())
    f.run("due-fresh", "octo-feather-lane", "reflect", "--director", "--due")
    f.obs("due-fresh", "director-log", dlog.read_text())
    f.check("due-fresh", lambda c: c.code == 0 and "director reflection: not due, last ran" in c.out
            and c.o["director-log"] == c.o["before"])
    f.env = {}
    say(f"director-reflection evidence: {f.d}")


KIT_REPO = "0xTomDaniel/octo-feather"   # the kit's tracker (scripts/correction_lanes.py KIT_REPO)
INTAKE_TARGET = "varelaseb/octo-lite"   # correction-intake's target: a real repository, never written (fake gh)
# Real `gh repo view R --json nameWithOwner,createdAt` answers (gh 2.102.0, 2026-11-18), the fake gh's "repos".
REPOS = {KIT_REPO: {"nameWithOwner": KIT_REPO, "createdAt": "2026-10-18T17:03:48Z"},
         INTAKE_TARGET: {"nameWithOwner": INTAKE_TARGET, "createdAt": "2026-06-03T05:28:08Z"}}


def scratch_record(name: str, repo: str) -> str:
    """A scratch lane record of REPO, started after REPOS's creation dates."""
    return (f'supervisor = "w9{name[-1]}:p2"\nrepository = "{repo}"\nissue = "{name}"\ngoal = "scratch lane"\n'
            'started_at = "2026-10-19T00:00:00Z"\n')


def seed_repos(sc: Path) -> None:
    """The fake gh's store under SC answering `repo view` with REPOS."""
    store = sc / "gh.json"
    db: dict[str, Any] = json.loads(store.read_text()) if store.is_file() else {"issues": []}
    store.write_text(json.dumps(db | {"repos": REPOS}))


def drive_correction_lane(f: Feature) -> None:
    sc = RUN_DIR / "scratch" / "correction-lane"
    shutil.rmtree(sc, ignore_errors=True)
    lanes = sc / "state" / "octo-feather" / "lanes"
    (lanes / "archive").mkdir(parents=True)
    store = sc / "gh.json"
    # Archived lanes gh900 and gh901 logged one code-review finding of a class each; open scratch lane gh902 none.
    def cr(at: str, summary: str) -> str:
        return json.dumps({"at": at, "kind": "finding", "source": "code-review", "class": "duplicated-rule", "blocking": True,
                           "summary": summary}) + "\n"
    first, second = "help text restates the archive refusal rule of comms #reflection-lane", "test comment restates comms #handoff-fields"
    for name, at, summary, where in (("gh900", "2026-10-20T00:00:00Z", first, "archive/"), ("gh901", "2026-10-27T00:00:00Z", second, "archive/")):
        (lanes / f"{where}{name}.toml").write_text(scratch_record(name, KIT_REPO))
        (lanes / f"{where}{name}.handoffs.jsonl").write_text(cr(at, summary))
    (lanes / "gh902.toml").write_text(scratch_record("gh902", KIT_REPO))
    seed_repos(sc)
    (lanes.parent / "director.handoffs.jsonl").write_text("")
    args = " ".join(["--no-session", os.environ.get("OCTO_FEATHER_REFLECT_ARGS", "")]).strip()
    f.env = {"XDG_STATE_HOME": str(sc / "state"), "HERDR_SESSION": "", "HERDR_SOCKET_PATH": str(sc / "no-herdr.sock"),
             "OCTO_FEATHER_REFLECT_ARGS": args, "OCTO_FEATHER_REFLECT_TIMEOUT": os.environ.get("OCTO_FEATHER_REFLECT_TIMEOUT") or "1800",
             **fake_tracker(f.s.repo, sc)}
    # The real reflectors (SKILL.md: a role's model run is the one exception to offline), the tracker faked.
    f.run("file-live", "octo-feather-lane", "archive", "gh902")
    f.obs("file-live", "tracker", store.read_text() if store.is_file() else "{}")

    def filed(c: Case) -> bool:
        """The archive printed the key of one issue in the kit's tracker (the lanes' repository and the route owner of a
        class no `target:` route names) whose title carries the class's marker and whose body quotes both findings and
        names a route line; gh902 left lanes/."""
        m = re.search(rf"(?m)^correction lane: filed (\d+) in github-issues {KIT_REPO} for duplicated-rule ", c.out)
        hits = [i for i in json.loads(c.o["tracker"]).get("issues", []) if m and str(i["number"]) == m[1]]
        return (c.code == 0 and len(hits) == 1 and hits[0]["repo"] == KIT_REPO
                and "[correction-lane duplicated-rule]" in hits[0]["title"]
                and all(x in hits[0]["body"] for x in (first, second, "Class: duplicated-rule", "Route: "))
                and (lanes / "archive" / "gh902.toml").is_file())

    f.check("file-live", filed)
    issues: list[dict[str, Any]] = json.loads(store.read_text()).get("issues", []) if store.is_file() else []
    for i in issues:
        print(f"    filed: {i['repo']}#{i['number']} {i['title']}")
    f.env = {}
    say(f"correction-lane evidence: {f.d}")


# The correction-intake drive's stub `pi` for the reflectors (no model): prints the reply file the drive wrote for the
# reflection asked (the director's when its brief says Director reflection, else the lane's).
REFLECT_STUB_PI = r"""#!/usr/bin/env python3
import os, sys
who = "director" if "Director reflection" in sys.stdin.read() else "lane"
sys.stdout.write(open(os.path.join(os.environ["REFLECT_STUB_DIR"], f"reply.{who}")).read())
"""


def drive_correction_intake(f: Feature) -> None:
    """`octo-feather-lane archive` with the reflectors stubbed and the tracker faked, over scratch lane logs holding a
    class logged blocking in two lanes, one only by reflections and one blocking twice in one lane, the director
    reflection routing the first: only the first files, naming the route; then `octo-feather-lane intake` over seeded
    open issues; cases and what each observes: features/correction-intake.md."""
    sc = RUN_DIR / "scratch" / "correction-intake"
    shutil.rmtree(sc, ignore_errors=True)
    lanes = sc / "state" / "octo-feather" / "lanes"
    (lanes / "archive").mkdir(parents=True)
    (sc / "bin").mkdir()
    (sc / "bin" / "pi").write_text(REFLECT_STUB_PI)
    (sc / "bin" / "pi").chmod(0o755)
    store = sc / "gh.json"

    def fl(at: str, source: str, cls: str, summary: str, *, blocking: bool = True) -> str:
        return json.dumps({"at": at, "kind": "finding", "source": source, "class": cls, "blocking": blocking, "summary": summary}) + "\n"
    logs = {"gh910": [fl("2026-10-20T00:00:00Z", "code-review", "stale-pointer", "gh910 pointer to a moved file"),
                      fl("2026-10-20T01:00:00Z", "reflection", "slow-gate", "gh910 gate felt slow", blocking=False),
                      fl("2026-10-20T02:00:00Z", "code-review", "one-lane", "gh910 first"),
                      fl("2026-10-20T03:00:00Z", "code-review", "one-lane", "gh910 second"),
                      fl("2026-10-20T04:00:00Z", "code-review", "own-pointer", "gh910 pointer into the target's docs")],
            "gh911": [fl("2026-10-21T00:00:00Z", "qc", "stale-pointer", "gh911 demo read a moved file"),
                      fl("2026-10-21T01:00:00Z", "reflection", "slow-gate", "gh911 gate felt slow", blocking=False),
                      fl("2026-10-21T02:00:00Z", "qc", "own-pointer", "gh911 demo read the target's old docs")]}
    for name, lines in logs.items():
        (lanes / "archive" / f"{name}.toml").write_text(scratch_record(name, INTAKE_TARGET))
        (lanes / "archive" / f"{name}.handoffs.jsonl").write_text("".join(lines))
    (lanes / "gh912.toml").write_text(scratch_record("gh912", INTAKE_TARGET))
    seed_repos(sc)
    (lanes.parent / "director.handoffs.jsonl").write_text("")
    listed = json.loads((Path(f.s.repo) / "reflection" / "questions.json").read_text())["questions"]

    def qs(kind: str) -> str:
        return ", ".join(q["id"] for q in listed if q["kind"] == kind)

    (sc / "reply.lane").write_text(f"Questions: {qs('lane')}\nFinding: class: own-pointer | question: undetected-rule"
                                   " | route: target: docs/pointers.md | summary: gh912 saw the target's own docs move\n")
    (sc / "reply.director").write_text(f"Questions: {qs('director')}\nFinding: class: stale-pointer | question: writer-route"
                                       " | route: agents/implementer.md Rules | summary: blocking in gh910 and gh911\n")
    tr = fake_tracker(f.s.repo, sc)
    f.env = {"XDG_STATE_HOME": str(sc / "state"), "HERDR_SESSION": "", "HERDR_SOCKET_PATH": str(sc / "no-herdr.sock"),
             "REFLECT_STUB_DIR": str(sc), **tr, "PATH": f"{sc / 'bin'}:{tr['PATH']}"}
    f.run("file-rule", "octo-feather-lane", "archive", "gh912")
    f.obs("file-rule", "tracker", store.read_text() if store.is_file() else "{}")

    def of(c: Case, repo: str, cls: str) -> list[dict[str, Any]]:
        return [i for i in json.loads(c.o["tracker"]).get("issues", [])
                if i["repo"] == repo and f"[correction-lane {cls}]" in i["title"]]

    def filed(c: Case) -> bool:
        """stale-pointer, routed to a kit role, only in the kit's tracker naming that route, the target lanes' findings
        by lane, date and class only; no other class there."""
        issues = json.loads(c.o["tracker"]).get("issues", [])
        mine = of(c, KIT_REPO, "stale-pointer")
        return (c.code == 0 and len(mine) == 1 and [i for i in issues if i["repo"] == KIT_REPO] == mine
                and "Route: agents/implementer.md Rules\n" in mine[0]["body"]
                and "\n- gh910 2026-10-20T00:00:00Z stale-pointer\n- gh911 2026-10-21T00:00:00Z stale-pointer" in mine[0]["body"]
                and "moved file" not in mine[0]["body"] and "target" not in mine[0]["body"]
                and re.search(rf"(?m)^correction lane: filed \d+ in github-issues {KIT_REPO} for stale-pointer \(2 findings; route: agents/implementer.md Rules\)$",
                              c.out) is not None)

    def route_owner(c: Case) -> bool:
        """own-pointer, routed `target:` by the target lane gh912's reflection, only in the target's tracker, quoting
        its lanes' findings and that reflection finding in full; the kit's tracker holds none of it."""
        mine = of(c, INTAKE_TARGET, "own-pointer")
        return (c.code == 0 and len(mine) == 1 and not of(c, KIT_REPO, "own-pointer")
                and len(json.loads(c.o["tracker"]).get("issues", [])) == 2
                and all(x in mine[0]["body"] for x in ("Route: target: docs/pointers.md\n", "gh910 pointer into the target's docs",
                                                       "gh911 demo read the target's old docs", "gh912 saw the target's own docs move"))
                and re.search(rf"(?m)^correction lane: filed \d+ in github-issues {INTAKE_TARGET} for own-pointer \(3 findings; route: target: docs/pointers.md\)$",
                              c.out) is not None)
    f.check("file-rule", filed)
    f.check("file-rule", route_owner)
    # Seeded beside it: an open issue backed only by reflections, and two of one class (duplicates).
    db: dict[str, list[dict[str, Any]]] = json.loads(store.read_text()) if store.is_file() else {"issues": []}
    for n, repo, cls in ((951, INTAKE_TARGET, "slow-gate"), (952, INTAKE_TARGET, "one-lane"), (953, KIT_REPO, "one-lane")):
        db["issues"].append({"number": n, "repo": repo, "title": f"[correction-lane {cls}] repeated finding class: {cls}", "body": "",
                             "state": "OPEN", "closedAt": None})
    store.write_text(json.dumps(db))
    before = store.read_text()
    f.run("intake", "octo-feather-lane", "intake")
    f.obs("intake", "unchanged", "yes\n" if store.read_text() == before else "no\n")
    f.check("intake", lambda c: c.code == 0 and c.o["unchanged"] == "yes\n"
            and "\nclass stale-pointer: due yes; blocking 2 in 2 lane(s) (gh910, gh911); findings 3\n" in c.out
            and "\nclass slow-gate: due no; blocking 0 in 0 lane(s); findings 2\n" in c.out
            and "\nclass one-lane: due no; blocking 2 in 1 lane(s) (gh910); findings 2\n" in c.out
            and "\n  duplicates: 2 open issues of class one-lane\n" in c.out)
    f.env = {}
    say(f"correction-intake evidence: {f.d}")


def drive_factory_report(f: Feature) -> None:
    sc = RUN_DIR / "scratch" / "factory-report"
    shutil.rmtree(sc, ignore_errors=True)
    lanes = sc / "state" / "octo-feather" / "lanes"
    lanes.mkdir(parents=True)
    dlog = lanes.parent / "director.handoffs.jsonl"
    # No open lane, so no gh call; Herdr points at no server. The director log: a note, no reflection line yet.
    dlog.write_text(json.dumps({"at": "2026-10-27T00:00:00Z", "kind": "note", "text": "status sent"}) + "\n")
    f.env = {"XDG_STATE_HOME": str(sc / "state"), "HERDR_SESSION": "", "HERDR_SOCKET_PATH": str(sc / "no-herdr.sock"),
             "PI_CODING_AGENT_DIR": str(sc / "pi")}   # the box's own Pi sessions never read
    f.run("reflection-never", "octo-feather-lane", "report")
    f.check("reflection-never", lambda c: c.code == 0
            and re.findall(r"(?m)^director reflection: .*$", c.out) == ["director reflection: never ran (director.handoffs.jsonl)"])
    # The latest reflection line two days old, after an older one.
    two_days = datetime.fromtimestamp(datetime.now(UTC).timestamp() - 2 * 86400, UTC).strftime("%Y-%m-%dT%H:%M:%SZ")
    with dlog.open("a") as fh:
        for at in ("2026-10-01T09:00:00Z", two_days):
            fh.write(json.dumps({"at": at, "kind": "reflection", "findings": 0, "questions": ["owner-asked"]}) + "\n")
    f.obs("reflection-two-days", "at", two_days)
    f.obs("reflection-two-days", "before", dlog.read_text())
    f.run("reflection-two-days", "octo-feather-lane", "report")
    f.obs("reflection-two-days", "director-log", dlog.read_text())
    f.check("reflection-two-days", lambda c: c.code == 0 and c.o["director-log"] == c.o["before"]
            and len(re.findall(r"(?m)^director reflection: ", c.out)) == 1
            and re.search(rf"(?m)^director reflection: last ran {re.escape(c.o['at'])} \(2d0h\d+m ago\)$", c.out) is not None)
    # One open lane on o/r, no PR; GitHub is the kit's fake (tests/fixtures/lane-report/gh) over a scratch store: o/r's
    # default branch commits and its gate-budget.toml. The trend: three passed full runs on main, then one over the
    # budget and grown past the share; a subset run after it stays out.
    gh = sc / "gh" / "o__r"
    gh.mkdir(parents=True)
    mains = [f"{n}" * 40 for n in "1234"]
    (gh / "commits.json").write_text(json.dumps([{"sha": m} for m in reversed(mains)]))
    (gh / "gate-budget.toml").write_text("budget_seconds = 300\ngrowth_share = 0.2\ntrend_runs = 3\n")
    (lanes / "lane-r.toml").write_text('supervisor = "w1:p1"\nrepository = "o/r"\nissue = "gh1"\ngoal = "Gate grew"\n'
                                        'started_at = "2026-10-20T08:00:00Z"\nlast_handoff_at = "2026-10-20T08:00:00Z"\nwaiting_on = ""\n')

    def trend(at: str, head: str, total: float, tier: str = "full") -> str:
        steps = [{"name": "tests/slow.sh", "seconds": total - 60, "result": "ok"}, {"name": "tests/mid.sh", "seconds": 40.0, "result": "ok"},
                 {"name": "check-lint", "seconds": 2.5, "result": "ok"}]
        return json.dumps({"start": at, "repo": "/scratch/r", "head": head, "total_s": total, "exit": 0, "tier": tier, "steps": steps}) + "\n"
    (lanes.parent / "check-runs.jsonl").write_text(
        trend("2026-10-01T10:00:00Z", mains[0], 200.0) + trend("2026-10-02T10:00:00Z", mains[1], 220.0)
        + trend("2026-10-03T10:00:00Z", mains[2], 210.0) + trend("2026-10-04T10:00:00Z", mains[3], 330.0)
        + trend("2026-10-04T11:00:00Z", mains[3], 9.0, "subset"))
    (sc / "bin").mkdir()
    (sc / "bin" / "gh").write_text(f'#!/bin/sh\nexec python3 {shlex.quote(f.s.repo)}/tests/fixtures/lane-report/gh "$@"\n')
    (sc / "bin" / "gh").chmod(0o755)
    f.env = {**f.env, "FAKE_GH_PRS": str(sc / "gh"), "PATH": f"{sc / 'bin'}:{os.environ.get('PATH', '')}"}
    f.obs("gate-budget-over", "trend", (lanes.parent / "check-runs.jsonl").read_text())
    f.run("gate-budget-over", "octo-feather-lane", "report")
    f.obs("gate-budget-over", "trend-after", (lanes.parent / "check-runs.jsonl").read_text())
    block = ("gate budget o/r: the latest passed full gate run against gate-budget.toml on o/r's default branch\n"
             f"  full gate: 330s, head {mains[3][:12]}, started 2026-10-04T10:00:00Z (")
    f.check("gate-budget-over", lambda c: c.code == 0 and c.o["trend-after"] == c.o["trend"] and block in c.out
            and "): OVER BUDGET by 30s (budget 300s)\n  growth: +57.1% over the trend's median 210s (the 3 passed full runs "
                "before it); set share 20%: GROWN\n" in c.out
            and f"\n  trend: 200s {mains[0][:12]} 2026-10-01T10:00:00Z, 220s {mains[1][:12]} 2026-10-02T10:00:00Z, 210s {mains[2][:12]} "
                f"2026-10-03T10:00:00Z, 330s {mains[3][:12]} 2026-10-04T10:00:00Z (passed full runs, oldest first)\n"
                "  slowest: tests/slow.sh 270s, tests/mid.sh 40s, check-lint 2.5s\n" in c.out)
    # The headline: owner-caught findings two days and nine days ago (comms #report-owner-caught).
    nine_days = datetime.fromtimestamp(datetime.now(UTC).timestamp() - 9 * 86400, UTC).strftime("%Y-%m-%dT%H:%M:%SZ")
    with dlog.open("a") as fh:
        for at, cls in ((two_days, "owner-caught-x"), (two_days, "owner-caught-y"), (nine_days, "owner-caught-x")):
            fh.write(json.dumps({"at": at, "kind": "finding", "class": cls, "summary": "seeded"}) + "\n")
    f.run("owner-caught-headline", "octo-feather-lane", "report")
    f.check("owner-caught-headline", lambda c: c.code == 0 and c.out.splitlines()[1:2]
            == ["owner-caught (headline, director.handoffs.jsonl): 2 in the last 7 days, 1 in the 7 days before"])
    # Skill reach (comms #report-skill-reach): scratch Pi session files, each line timestamped, each tool call with its
    # result as Pi records it (a codemode batch's with nestedCalls). Implementers offered commit and tdd: one reads tdd
    # inside a codemode batch, one reads commit; one started nine days ago reads commit then (not counted) and tdd today
    # (counted); one reads none (a sed script naming a/SKILL.md, a batch grepping tdd/SKILL.md, a batch whose source
    # names tracker/SKILL.md aborted before it); one wholly nine days old is left out. A code reviewer reads tdd, not
    # offered to it.
    today = datetime.now(UTC).strftime("%Y-%m-%dT%H:%M:%SZ")

    def session(name: str, start: str, role: str, offered: list[str],
                calls: list[tuple[str, dict[str, str], str, list[tuple[str, dict[str, str], str]] | None]]) -> None:
        """One session file; each call (tool, args, at, nested calls (tool, args, status) or None) with its result."""
        skills = "".join(f"<skill><name>{n}</name><description>d</description><location>/kit/.agents/skills/{n}/SKILL.md"
                         "</location></skill>" for n in offered)
        lines: list[dict[str, Any]] = [{"type": "session", "version": 3, "id": name, "timestamp": start, "cwd": "/w"},
                                       {"type": "message", "timestamp": start, "message": {"role": "system", "content": "", "sections": {
                                           "addendum": f"# {role}\n", "skills": f"<available_skills>{skills}</available_skills>"}}}]
        for i, (t, a, at, nested) in enumerate(calls):
            lines.append({"type": "message", "timestamp": at, "message": {"role": "assistant", "content": [
                {"type": "toolCall", "id": f"c{i}", "name": t, "arguments": a}]}})
            res: dict[str, Any] = {"role": "toolResult", "toolCallId": f"c{i}", "toolName": t, "content": [], "isError": False}
            if nested is not None:
                res["nestedCalls"] = {"complete": True, "calls": [{"id": f"c{i}/{j}", "name": n, "arguments": na, "status": st}
                                                                  for j, (n, na, st) in enumerate(nested)]}
                res["isError"] = any(st == "error" for _, _, st in nested)
            lines.append({"type": "message", "timestamp": at, "message": res})
        d = sc / "pi" / "sessions" / "--w--"
        d.mkdir(parents=True, exist_ok=True)
        (d / f"{name}.jsonl").write_text("".join(json.dumps(x) + "\n" for x in lines))
    commit, tdd = {"path": "/kit/.agents/skills/commit/SKILL.md"}, {"path": "/kit/.agents/skills/tdd/SKILL.md"}
    batch = 'await Promise.all(["/kit/.agents/skills/tdd/SKILL.md", "README.md"].map(p => tools.read({path: p})));'
    mention = ('const p = "/kit/.agents/skills/tdd/SKILL.md"; await tools.grep({pattern: "x", path: p});'
               ' await tools.read({path: "README.md"});')
    aborted = 'await tools.read({path: "AGENTS.md"}); await tools.read({path: "nope.md"}); await tools.read({path: ".agents/skills/tracker/SKILL.md"});'
    sed = "git diff | sed -e 's#^--- .agents/skills/tdd/SKILL.md#--- a/SKILL.md#'"
    session("impl-1", two_days, "Implementer", ["commit", "tdd"],
            [("codemode", {"code": batch}, two_days, [("read", tdd, "ok"), ("read", {"path": "README.md"}, "ok")])])
    session("impl-2", two_days, "Implementer", ["commit", "tdd"], [("read", commit, two_days, None)])
    session("impl-long", nine_days, "Implementer", ["commit", "tdd"], [("read", commit, nine_days, None), ("read", tdd, today, None)])
    session("impl-none", two_days, "Implementer", ["commit", "tdd"], [
        ("bash", {"command": sed}, two_days, None),
        ("codemode", {"code": mention}, two_days, [("grep", {"pattern": "x", **tdd}, "ok"), ("read", {"path": "README.md"}, "ok")]),
        ("codemode", {"code": aborted}, two_days, [("read", {"path": "AGENTS.md"}, "ok"), ("read", {"path": "nope.md"}, "error")])])
    session("impl-old", nine_days, "Implementer", ["tdd"], [("read", tdd, nine_days, None)])
    session("review-1", two_days, "Code reviewer", ["code-review"], [("read", {"path": ".agents/skills/tdd/SKILL.md"}, two_days, None)])
    f.obs_cmd("skill-reach", "before", "sh", "-c", f"cd {shlex.quote(str(sc / 'pi'))} && find . -type f -exec sha256sum {{}} + | sort")
    f.run("skill-reach", "octo-feather-lane", "report")
    f.obs_cmd("skill-reach", "after", "sh", "-c", f"cd {shlex.quote(str(sc / 'pi'))} && find . -type f -exec sha256sum {{}} + | sort")
    f.check("skill-reach", lambda c: c.code == 0 and c.o["after"] == c.o["before"] and (
        "\nskill reach (Pi sessions active in the last 7 days; per role: skill read/offered, sessions):\n"
        "  code reviewer (1 session): code-review 0/1; read, not offered: tdd 1\n"
        "  implementer (4 sessions): commit 1/4, tdd 2/4\n") in c.out)
    f.env = {}
    say(f"factory-report evidence: {f.d}")
def manifest(c: Case) -> dict[str, Any]:
    """What a `pi-role --json` launch gives Pi, as the role-launch checks read it."""
    a: list[str] = c.j["args"]
    tools = a[a.index("--tools") + 1].split(",") if "--tools" in a else []
    exts = [a[i + 1] for i, x in enumerate(a) if x == "--extension"]
    web_list = a[a.index("--octo-feather-web-servers") + 1] if "--octo-feather-web-servers" in a else None
    return {"tools": tools, "no_mcp": "--no-mcp" in a, "web_ext": any(e.endswith("/extensions/web-servers.ts") for e in exts),
            "web_list": web_list, "mcp": sorted(t for t in tools if t.startswith("mcp__"))}


def web_ok(c: Case, role: str, servers: list[str], kit: str) -> bool:
    """A web role: built-ins, codemode, one mcp__<server>__* per listed server, the web extension with kit's
    list, no --no-mcp. Any other role: codemode, no MCP entry, --no-mcp, no web extension. The director: no edit
    or write (roles#acceptance-director-tools)."""
    m = manifest(c)
    web = role in c.v["web_roles"].split()
    base = [t for t in m["tools"] if not t.startswith("mcp__")]
    if "codemode" not in base:
        return False
    if role == "director" and sorted(base) != sorted(["read", "grep", "find", "ls", "bash", "codemode"]):
        return False
    if web:
        return (m["mcp"] == sorted(f"mcp__{s}__*" for s in servers) and not m["no_mcp"] and m["web_ext"]
                and m["web_list"] == f"{kit}/web-mcp.json")
    return m["mcp"] == [] and m["no_mcp"] and not m["web_ext"] and m["web_list"] is None


def drive_role_launch(f: Feature) -> None:
    """Each role's launch as Pi gets it, offline: `pi-role --json` (what herdr-spawn hands a tab and what a
    headless run executes), no model turn. features/role-launch.md."""
    v = f.s.contract.values
    if "web_roles" not in v or "web_servers" not in v:
        die("qc.toml [values] needs web_roles and web_servers: the role-launch drive's expected web roles and servers")
    roles = ("director", "supervisor", "implementer", "general-worker", "corrector", "code-reviewer", "qc-judge", "shaper")
    servers = v["web_servers"].split()
    sc = RUN_DIR / "scratch" / "role-launch"
    shutil.rmtree(sc, ignore_errors=True)
    # pi-role --json caches the role body under XDG_CACHE_HOME: a scratch one, never the box's.
    base_env = {"XDG_CACHE_HOME": str(sc / "cache")}
    f.env = base_env
    for role in roles:
        f.run(role, "pi-role", "--json", f"{f.s.repo}/agents/{role}.md")
        f.obs(role, "role-tools", "".join(ln + "\n" for ln in (Path(f.s.repo) / "agents" / f"{role}.md").read_text().splitlines()
                                          if ln.startswith("tools:")))
        f.check(role, lambda c, r=role: c.code == 0 and web_ok(c, r, servers, c.kit))

    # Another MCP server in the user's Pi config and in the target's: the launch is unchanged and names neither.
    home, agent, target = sc / "home", sc / "agent", sc / "target"
    for p in (home, agent, target / ".pi"):
        p.mkdir(parents=True)
    (agent / "mcp.json").write_text('{"mcpServers":{"userother":{"url":"https://userother.invalid/mcp"}}}\n')
    (target / ".pi" / "mcp.json").write_text('{"mcpServers":{"projother":{"url":"https://projother.invalid/mcp"}}}\n')
    subprocess.run(["git", "-c", "init.defaultBranch=main", "init", "-q", str(target)], check=True)
    f.env = {**base_env, "HOME": str(home), "PI_CODING_AGENT_DIR": str(agent)}
    for role in ("implementer", "supervisor"):
        name = f"other-mcp-{role}"
        f.run(name, "env", "-C", str(target), "pi-role", "--json", f"{f.s.repo}/agents/{role}.md")
        f.obs(name, "baseline", (f.d / f"{role}.stdout").read_text())
        f.obs(name, "configs", (agent / "mcp.json").read_text() + (target / ".pi" / "mcp.json").read_text())
        f.check(name, lambda c, r=role: c.code == 0 and c.out == c.o["baseline"] and web_ok(c, r, servers, c.kit)
                and "userother" in c.o["configs"] and "projother" in c.o["configs"]
                and "userother" not in c.out and "projother" not in c.out)

    # A scratch copy of the kit with one server added to the web list and no role file changed.
    kit2 = sc / "kit"
    for d in ("scripts", "agents", "extensions"):
        shutil.copytree(Path(f.s.repo) / d, kit2 / d, symlinks=True)
    (kit2 / ".agents").mkdir()
    (kit2 / ".agents" / "skills").symlink_to(Path(f.s.repo) / ".agents" / "skills")
    lst = json.loads((Path(f.s.repo) / "web-mcp.json").read_text())
    lst["mcpServers"]["added"] = {"url": "https://added.invalid/mcp"}
    (kit2 / "web-mcp.json").write_text(json.dumps(lst, indent=2) + "\n")
    f.env = base_env
    agents_diff = output(["diff", "-r", f"{f.s.repo}/agents", str(kit2 / "agents")])[1]
    for role in roles:
        name = f"list-once-{role}"
        f.run(name, f"{kit2}/scripts/pi-role", "--json", f"{kit2}/agents/{role}.md")
        f.obs(name, "agents-diff", agents_diff)
        f.check(name, lambda c, r=role: c.code == 0 and c.o["agents-diff"] == ""
                and web_ok(c, r, [*servers, "added"], str(kit2)))
    # The factory commit identity (#665; pi-role --help, Commit identity), in scratch state dirs, never the box's:
    # unset, a role that would commit refuses naming the setting and its command; set, the launch env carries it.
    f.env = {**base_env, "XDG_STATE_HOME": str(sc / "state-unset")}
    f.run("identity-unset", "pi-role", "--print-env", f"{f.s.repo}/agents/implementer.md")
    f.check("identity-unset", lambda c: c.code == 1 and "[identity] name and email in the box onboarding file" in c.err
            and "--set-identity" in c.err and c.out == "")
    # A role that edits and writes but never commits (the general worker, #829) starts unset, applying no identity.
    f.run("identity-unset-general-worker", "pi-role", "--print-env", f"{f.s.repo}/agents/general-worker.md")
    f.check("identity-unset-general-worker", lambda c: c.code == 0 and c.out == "")
    f.env = {**base_env, "XDG_STATE_HOME": str(sc / "state")}
    f.run("identity-set", "pi-role", "--set-identity", "Verify Identity", "verify@octo-feather.invalid")
    f.check("identity-set", lambda c: c.code == 0)
    f.run("identity-applied", "pi-role", "--print-env", f"{f.s.repo}/agents/implementer.md")
    ident = [f"GIT_{w}_{k}={v}" for w in ("AUTHOR", "COMMITTER") for k, v in (("NAME", "Verify Identity"), ("EMAIL", "verify@octo-feather.invalid"))]
    f.check("identity-applied", lambda c: c.code == 0 and sorted(c.out.splitlines()) == sorted(ident))
    f.env = {}
    say(f"role-launch evidence: {f.d}")


def drive_skill_loading(f: Feature) -> None:
    """Which skills Pi loads for a role, asked of Pi: a role launch (Pi in RPC mode, no prompt: no model turn) from
    scratch targets, refused naming each skill Pi did not load, started with exactly its listed skills otherwise;
    and the gate (check-skills) on a scratch kit copy. features/skill-loading.md."""
    sc = RUN_DIR / "scratch" / "skill-loading"
    shutil.rmtree(sc, ignore_errors=True)
    home, agent = sc / "home", sc / "agent"
    for p in (home, agent):
        p.mkdir(parents=True)
    good = '---\nname: local\ndescription: "A local skill: fine when quoted."\n---\nBody.\n'
    bad = "---\nname: {}\ndescription: A broken skill: a plain value holding a colon.\n---\nBody.\n"

    def target(name: str, declared: str, local: str | None) -> Path:
        t = sc / "targets" / name
        (t / ".agents" / "skills").mkdir(parents=True)
        subprocess.run(["git", "-c", "init.defaultBranch=main", "init", "-q", str(t)], check=True)
        (t / "AGENTS.md").write_text(f"# target\n\nRepo skills: {declared}\n")
        if local is not None:
            (t / ".agents" / "skills" / "local").mkdir()
            (t / ".agents" / "skills" / "local" / "SKILL.md").write_text(local)
        return t

    def launch(name: str, t: Path, kit: str, stdin: str = "") -> None:
        # pi-role's own launch, Pi in RPC mode: Pi starts, runs its session start, answers STDIN's RPC commands and
        # exits at end of input. --no-mcp: the web roles' servers stay unconnected (no network).
        f.run(name, "sh", "-c", 'cd "$1" && printf "%s" "$3" | "$2/scripts/pi-role" "$2/agents/implementer.md" '
              "--mode rpc --offline --no-session --no-mcp", "sh", str(t), kit, stdin)

    # The parent route emptied: a refusal in a pane tells OCTO_FEATHER_PARENT, and a drive never reaches a live pane.
    route = dict.fromkeys(("OCTO_FEATHER_PARENT", "HERDR_PANE_ID", "HERDR_TAB_ID", "HERDR_WORKSPACE_ID", "HERDR_SESSION"), "")
    # A scratch state dir holding the commit identity a launch of the implementer needs (pi-role --help, Commit identity).
    f.env = {**route, "HOME": str(home), "PI_CODING_AGENT_DIR": str(agent), "XDG_CACHE_HOME": str(sc / "cache"),
             "XDG_STATE_HOME": str(sc / "state")}
    subprocess.run([f"{f.s.repo}/scripts/pi-role", "--set-identity", "Verify Identity", "verify@octo-feather.invalid"],
                   env=case_env({"XDG_STATE_HOME": str(sc / "state")}), capture_output=True, check=True)
    refused = "Pi did not load skill"
    role_line = next(ln for ln in (Path(f.s.repo) / "agents" / "implementer.md").read_text().splitlines() if ln.startswith("skills:"))
    launch("offered", target("offered", "python, local", good), f.s.repo, '{"type":"get_commands"}\n')
    f.obs("offered", "role-skills", role_line + "\n")

    def offered(c: Case) -> bool:
        resp = next(json.loads(ln) for ln in c.out.splitlines() if '"get_commands"' in ln)
        got = sorted(x["name"].removeprefix("skill:") for x in resp["data"]["commands"] if x["source"] == "skill")
        want = sorted("github-issues" if x.strip() == "{tracker}" else x.strip()
                      for x in c.o["role-skills"].removeprefix("skills:").split(",") if x.strip())
        return c.code == 0 and refused not in c.err and got == want and "local" not in got
    f.check("offered", offered)
    # own-copy: the target holds and declares its own copy of python, a skill the role lists (the kit's own repo, #595).
    t = target("own-copy", "python", None)
    shutil.copytree(Path(f.s.repo) / ".agents" / "skills" / "python", t / ".agents" / "skills" / "python")
    launch("own-copy", t, f.s.repo, '{"type":"get_commands"}\n')
    f.obs("own-copy", "role-skills", role_line + "\n")
    f.obs("own-copy", "target-python", str(t / ".agents" / "skills" / "python" / "SKILL.md") + "\n")

    def own_copy(c: Case) -> bool:
        if not offered(c):
            return False
        resp = next(json.loads(ln) for ln in c.out.splitlines() if '"get_commands"' in ln)
        py = [x["sourceInfo"]["path"] for x in resp["data"]["commands"] if x["source"] == "skill" and x["name"] == "skill:python"]
        return [os.path.realpath(p) for p in py] == [os.path.realpath(c.o["target-python"].strip())]
    f.check("own-copy", own_copy)
    launch("declared-malformed", target("declared-malformed", "python, local", bad.format("local")), f.s.repo)
    f.check("declared-malformed", lambda c: c.code != 0 and f"{refused} local (" in c.err and "Nested mappings are not allowed" in c.err)
    t = target("declared-dangling", "python, ghost", good)
    (t / ".agents" / "skills" / "ghost").symlink_to(sc / "gone")
    launch("declared-dangling", t, f.s.repo)
    f.check("declared-dangling", lambda c: c.code != 0 and f"{refused} ghost (" in c.err and "skill path does not exist" in c.err)
    # A scratch copy of the kit: its tdd, listed by the implementer, broken; then the gate on it.
    kit2 = sc / "kit"
    for d in ("scripts", "agents", "extensions"):
        shutil.copytree(Path(f.s.repo) / d, kit2 / d, symlinks=True)
    shutil.copy(Path(f.s.repo) / "web-mcp.json", kit2 / "web-mcp.json")
    shutil.copytree(Path(f.s.repo) / ".agents" / "skills", kit2 / ".agents" / "skills", symlinks=True)
    tdd = kit2 / ".agents" / "skills" / "tdd" / "SKILL.md"
    keep = tdd.read_text()
    tdd.write_text(bad.format("tdd"))
    launch("listed-malformed", target("listed-malformed", "python", None), str(kit2))
    f.check("listed-malformed", lambda c: c.code != 0 and f"{refused} tdd (" in c.err and "Nested mappings are not allowed" in c.err)
    f.run("gate-refused", f"{kit2}/scripts/check-skills")
    f.check("gate-refused", lambda c: c.code != 0 and ".agents/skills/tdd/SKILL.md: Pi does not load it:" in c.err
            and "role implementer (agents/implementer.md): Pi does not offer its skill tdd" in c.err
            and "role code-reviewer (agents/code-reviewer.md): Pi does not offer its skill tdd" in c.err)
    tdd.write_text(keep)
    (kit2 / ".agents" / "skills" / "noname").mkdir()
    (kit2 / ".agents" / "skills" / "noname" / "SKILL.md").write_text("---\ndescription: Does a thing.\n---\nBody.\n")
    f.run("gate-no-name", f"{kit2}/scripts/check-skills")
    f.check("gate-no-name", lambda c: c.code != 0 and ".agents/skills/noname/SKILL.md: no name in its frontmatter" in c.err)
    shutil.rmtree(kit2 / ".agents" / "skills" / "noname")
    f.run("gate-clean", f"{kit2}/scripts/check-skills")
    f.check("gate-clean", lambda c: c.code == 0 and c.out.startswith("skills: ok"))
    f.env = {}
    say(f"skill-loading evidence: {f.d}")


# A fake OpenAI-compatible provider (a test double, stdlib, as tests/web-tools.sh's): logs each request body to
# argv[2], answers "fake-done"; writes argv[1] once it listens, the readiness signal. Hand-written: the helper is
# stdlib-only (AGENTS.md), and the mock LLM servers searched (mock-llm, fakellm, llm-mock, 2026) are young
# single-maintainer packages; the drive needs only the logged request Pi sends.
FAKE_PROVIDER = """import http.server, json, os, sys
ready, log = sys.argv[1], sys.argv[2]
class H(http.server.BaseHTTPRequestHandler):
    def log_message(self, *a): pass
    def do_POST(self):
        body = json.loads(self.rfile.read(int(self.headers.get("content-length", 0))))
        with open(log, "a") as f: f.write(json.dumps(body) + "\\n")
        self.send_response(200); self.send_header("content-type", "text/event-stream"); self.end_headers()
        base = {"id": "x", "object": "chat.completion.chunk", "created": 0, "model": "fake"}
        for d, fin in [({"role": "assistant", "content": "fake-done"}, None), ({}, "stop")]:
            c = {**base, "choices": [{"index": 0, "delta": d, "finish_reason": fin}]}
            if fin: c["usage"] = {"prompt_tokens": 1, "completion_tokens": 1, "total_tokens": 2}
            self.wfile.write(b"data: " + json.dumps(c).encode() + b"\\n\\n")
        self.wfile.write(b"data: [DONE]\\n\\n")
s = http.server.HTTPServer(("127.0.0.1", int(sys.argv[3])), H)
open(ready + ".tmp", "w").write("ready"); os.replace(ready + ".tmp", ready)
s.serve_forever()
"""

# The shape case's shell, inside its own network namespace (unshare -Urn: only a loopback, brought up here, so no
# request leaves it but to the fake provider on 127.0.0.1; $s/links: the interfaces holding an address). The
# provider starts in its own session, its pid in a file, and is stopped through that file. $1 scratch, $2 target, $3 kit, $4 port, then the private env for env -i.
SHAPE_SH = r"""s=$1 t=$2 k=$3 port=$4; shift 4
ip link set lo up || exit 90
ip -o addr show | awk '{print $2}' | sort -u > "$s/links"
setsid python3 "$s/fake.py" "$s/ready" "$s/requests.jsonl" "$port" & echo $! > "$s/fake.pid"
i=0; while [ ! -s "$s/ready" ] && [ $i -lt 100 ]; do sleep 0.1; i=$((i + 1)); done
cd "$t" && env -i PATH="$PATH" "$@" timeout 300 just --justfile "$k/justfile" shape --model fake/fake --no-session -p go
rc=$?
kill -- -"$(cat "$s/fake.pid")" && rm "$s/fake.pid"
exit $rc
"""


def role_list(role_file: Path, key: str) -> list[str]:
    """A role file's frontmatter list KEY (`skills`, `externalSkills`), as written, {tracker} as the kit's default
    tracker skill (pi-role's, with no .octo-feather.toml in the target)."""
    line = next((ln for ln in role_file.read_text().split("\n---", 1)[0].splitlines() if ln.startswith(f"{key}:")), f"{key}:")
    return ["github-issues" if x.strip() == "{tracker}" else x.strip() for x in line.removeprefix(f"{key}:").split(",") if x.strip()]


def offered_skills(request: dict[str, Any]) -> list[tuple[str, str]]:
    """The skills Pi offers the model in a request's system prompt: (name, location) each."""
    m = request["messages"][0]["content"]
    m = m if isinstance(m, str) else " ".join(p.get("text", "") for p in m)
    return re.findall(r"<skill>\s*<name>([^<]+)</name>.*?<location>([^<]+)</location>", m, re.DOTALL)


def drive_shape(f: Feature) -> None:
    """`just shape` in a scratch target with Spec Chat's skills linked by `just spec-chat`: the shaper launched
    headless against a fake provider in a private network namespace, no model call; the skills Pi offers are
    exactly agents/shaper.md's skills and externalSkills, Spec Chat's from the target, none from the private
    home's seeded skills folders. features/shape.md."""
    kit = Path(f.s.repo)
    sc = RUN_DIR / "scratch" / "shape"
    shutil.rmtree(sc, ignore_errors=True)
    home, agent, target = sc / "home", sc / "agent", sc / "target"
    for p in (home, agent, sc / "cache", sc / "state", sc / "tmp"):
        p.mkdir(parents=True)
    subprocess.run(["git", "-c", "init.defaultBranch=main", "init", "-q", str(target)], check=True)
    role = kit / "agents" / "shaper.md"
    kit_skills, ext_skills = role_list(role, "skills"), role_list(role, "externalSkills")
    # Spec Chat's installer writes its onboarding state under XDG_STATE_HOME: a scratch one, never the box's.
    f.env = {"XDG_STATE_HOME": str(sc / "state")}
    f.run("spec-chat-link", "just", "--justfile", f"{kit}/justfile", "spec-chat", str(target))
    installer = spec_chat_installer()
    if not os.access(installer, os.X_OK):
        err = (f.d / "spec-chat-link.stderr").read_text()
        refused = [ln for ln in err.splitlines() if "no Spec Chat installer at" in ln]
        if int((f.d / "spec-chat-link.exit").read_text()) == 1 and refused:
            f.unreachable_step("shape", f"Spec Chat installer not at {installer} (SPEC_CHAT_CLONE defaults to ~/src/spec-chat); "
                               "prerequisite: a Spec Chat clone there or SPEC_CHAT_CLONE set to one; route attempted: "
                               f"{(f.d / 'spec-chat-link.cmd').read_text().strip()} -> exit 1: {refused[0]}")
        else:
            f.summary(f"FAIL spec-chat-link: installer absent at {installer}, but just spec-chat did not refuse it (spec-chat-link.stderr)")
            f.fails += 1
        f.env = {}
        return
    f.obs("spec-chat-link", "links", "".join(f"{p.name} -> {p.readlink()}\n" for p in sorted((target / ".agents" / "skills").iterdir())
                                              if p.is_symlink()))
    f.obs_cmd("spec-chat-link", "status", "git", "-C", str(target), "status", "--porcelain=v1")
    f.check("spec-chat-link", lambda c: c.code == 0 and all(f"{n} -> " in c.o["links"] for n in ext_skills) and c.o["status"] == "")

    # Decoys in each home skills folder Pi reads: every skill the role lists, under the same names, and one more.
    for d in (home / ".agents" / "skills", home / ".pi" / "agent" / "skills", agent / "skills"):
        for n in (*kit_skills, *ext_skills, "home-decoy"):
            (d / n).mkdir(parents=True)
            (d / n / "SKILL.md").write_text(f"---\nname: {n}\ndescription: A home decoy; never offered.\n---\nBody.\n")
    # The shaper commits: its factory commit identity, set once in the scratch state as an owner sets it on a box (#665).
    subprocess.run([f.s.kit, "pi-role", "--set-identity", "verify-octo-feather", "verify@octo-feather.invalid"],
                   env=case_env({"XDG_STATE_HOME": str(sc / "state")}), capture_output=True, check=True)
    port = "8765"  # the namespace is private: no other listener can hold it
    (agent / "models.json").write_text(json.dumps({"providers": {"fake": {
        "baseUrl": f"http://127.0.0.1:{port}/v1", "api": "openai-completions", "apiKey": "x", "models": [{"id": "fake"}]}}}) + "\n")
    (sc / "fake.py").write_text(FAKE_PROVIDER)
    private = {"HOME": home, "PI_CODING_AGENT_DIR": agent, "XDG_CACHE_HOME": sc / "cache", "XDG_STATE_HOME": sc / "state",
               "TMPDIR": sc / "tmp", "PI_OFFLINE": "1", "PI_SKIP_VERSION_CHECK": "1", "PI_TELEMETRY": "0",
               "OCTO_FEATHER_PARENT": "", "HERDR_PANE_ID": "", "HERDR_SESSION": ""}
    if shutil.which("mise"):
        # The kit's `just` is mise-shimmed (mise.toml): its installs from the box's data dir (mise's own answer), its
        # state (trust) in the scratch; a private HOME would otherwise send mise to install it, offline.
        dirs = json.loads(output(["mise", "doctor", "--json"])[1] or "{}").get("dirs", {})
        private |= {"MISE_DATA_DIR": dirs.get("data", ""), "MISE_STATE_DIR": sc / "mise-state"}
    f.env = {}
    f.pre = ["unshare", "-Urn"]
    try:
        f.run("shape", "sh", "-c", SHAPE_SH, "sh", str(sc), str(target), str(kit), port, *(f"{k}={v}" for k, v in private.items()))
    finally:
        f.pre = []
        pid = sc / "fake.pid"
        if pid.is_file():  # the case did not stop it: stop it here, through its pid file
            try:
                os.killpg(int(pid.read_text()), 15)
            except (ProcessLookupError, ValueError):
                pass
            say(f"fake provider stopped by the drive (pid file {pid})")
    log = sc / "requests.jsonl"
    f.obs("shape", "requests", log.read_text() if log.is_file() else "")
    f.obs("shape", "links", (sc / "links").read_text() if (sc / "links").is_file() else "")
    f.obs("shape", "fake-stopped", "" if (sc / "fake.pid").exists() else "stopped by its pid file\n")
    f.obs("shape", "role-skills", f"skills: {', '.join(kit_skills)}\nexternalSkills: {', '.join(ext_skills)}\n")
    f.obs("shape", "home-decoys", "".join(f"{p}\n" for p in sorted(sc.glob("home/**/SKILL.md")) + sorted(agent.glob("skills/*/SKILL.md"))))
    want = {**{n: f"{kit}/.agents/skills/{n}/SKILL.md" for n in kit_skills},
            **{n: f"{target}/.agents/skills/{n}/SKILL.md" for n in ext_skills}}

    def offered_exactly(c: Case) -> bool:
        reqs = [json.loads(ln) for ln in c.o["requests"].splitlines()]
        got = offered_skills(reqs[0])
        f.obs("shape", "offered", "".join(f"{n} {loc}\n" for n, loc in got))
        print("    offered: " + ", ".join(f"{n} ({loc})" for n, loc in got), flush=True)
        return (c.code == 0 and "fake-done" in c.out and c.o["links"].split() == ["lo"] and c.o["fake-stopped"] != ""
                and all(r["model"] == "fake" for r in reqs) and dict(got) == want and len(got) == len(want)
                and len(c.o["home-decoys"].splitlines()) == 3 * (len(want) + 1)
                and not any(loc.startswith((str(home), str(agent))) for _, loc in got))
    f.check("shape", offered_exactly)
    f.env = {}
    say(f"shape evidence: {f.d}")


def classify_stub(f: Feature, sc: Path) -> str:
    """A dir under SC holding the kit's stub classifier `pi` (tests/fixtures/classify-stub/pi), for OCTO_FEATHER_QC_PATH: first
    on the qc sandbox's PATH, so `just qc`'s advisory question never reaches a real model (the kit justfile puts ~/.local/bin,
    the box's pi, before a caller's PATH). STUB_ANSWER unset: every advisory answer shows unavailable."""
    (sc / "bin").mkdir(exist_ok=True)
    (sc / "bin" / "pi").symlink_to(Path(f.s.repo) / "tests" / "fixtures" / "classify-stub" / "pi")
    return str(sc / "bin")


def drive_qc_capture(f: Feature) -> None:
    """`just qc` twice at one head of a scratch target whose qc.toml declares a passing and a failing demo: each run
    captures both into the scratch target's evidence store and decides from the demos' own checks, the same both times."""
    v = f.s.contract.values
    if "qc_demo_pass" not in v or "qc_demo_fail" not in v:
        die("qc.toml [values] needs qc_demo_pass and qc_demo_fail: the qc-capture drive's scratch demos")
    sc = RUN_DIR / "scratch" / "qc-capture"
    r = sc / "repo"
    shutil.rmtree(sc, ignore_errors=True)
    (r / "docs" / "specs").mkdir(parents=True)
    (sc / "state").mkdir()

    def git(*args: str) -> str:
        return subprocess.run(["git", "-C", str(r), *args], check=True, capture_output=True, text=True).stdout.strip()

    git("init", "-q", "-b", "main")
    for k, val in (("user.name", "verify-octo-feather"), ("user.email", "verify@octo-feather.invalid"), ("core.hooksPath", "/dev/null")):
        git("config", k, val)   # qc commits the status file in this repo
    git("commit", "-q", "--allow-empty", "-m", "accepted")
    shutil.copy(f"{f.s.repo}/tests/fixtures/spec-status/good/demo.spec.html", r / "docs" / "specs")
    git("add", "-A")
    git("commit", "-q", "-m", "spec")
    init = subprocess.run([f.s.kit, "octo-feather-spec-status", "init", str(r / "docs" / "specs" / "demo.spec.html"), git("rev-parse", "--short", "HEAD")],
                          capture_output=True, text=True, check=False)
    if init.returncode:
        die(f"qc-capture: scratch status file not made: {init.stderr.strip()}")
    (r / "qc.toml").write_text('format = 1\n[entry]\ncommand = "true"\n[services]\n[fixture]\n[values]\n' + "".join(
        f'[demo."demo#{a}"]\ncommand = {json.dumps(cmd)}\ncovers = ["docs/specs"]\ntests = ["none"]\n'
        for a, cmd in (("acceptance-a", v["qc_demo_pass"]), ("acceptance-b", v["qc_demo_fail"]))))
    git("add", "-A")
    git("commit", "-q", "-m", "contract with two demos")
    head = git("rev-parse", "HEAD")
    # Scratch box state: qc's reports, the scratch target's evidence store; never a live lane's. No real classifier.
    f.env = {"XDG_STATE_HOME": str(sc / "state"), "OCTO_FEATHER_QC_PATH": classify_stub(f, sc)}
    qc = ("just", "--justfile", f"{f.s.repo}/justfile", "qc", "docs/specs/demo.status.json", "7", "acceptance-a", "acceptance-b")
    line = r"(?m)^{v} {a}: \$ .*\n  demo exit status {x}\n  evidence complete; decision demo checks; record ([0-9]{{8}}T[0-9]{{6}}Z-[0-9a-f]{{8}})$"

    def ids(out: str) -> list[str]:
        return [m.group(1) for v_, a, x in (("PASS", "acceptance-a", "0"), ("FAIL", "acceptance-b", "[1-9][0-9]*"))
                if (m := re.search(line.format(v=v_, a=a, x=x), out))]

    def stored(c: Case, rec: str) -> dict[str, Any]:
        found: list[dict[str, Any]] = [x["record"] for x in json.loads(c.o["store"]) if x["record"]["id"] == rec]
        return found[0] if found else {}

    def holds(c: Case) -> bool:
        got = ids(c.out)
        return (c.code == 1 and len(got) == 2 and "head now" in c.out and c.o["built"] == "built planned\n"
                and all(stored(c, rec).get("revision") == head and not stored(c, rec).get("dirty")
                        and {"demo.cmd", "demo.exit", "demo.stdout", "demo.stderr"} <= set(stored(c, rec).get("outputs", {}))
                        and stored(c, rec)["contract"]["format"] == 1 for rec in got))

    first: list[str] = []
    for n in ("qc-1", "qc-2"):
        git("reset", "-q", "--hard", head)   # the second run judges the same head the first did
        f.pre = ["env", "-C", str(r)]   # just qc runs where the supervisor stands: the target's worktree
        f.run(n, *qc)
        f.pre = []
        f.obs(n, "store", output([f.s.kit, "octo-feather-evidence", "read", "--repo", str(r), "--commit", head, "--json"],
                                 env=case_env(f.env))[1])
        st = json.loads(git("show", "HEAD:docs/specs/demo.status.json"))["criteria"]
        f.obs(n, "built", f"{st['acceptance-a']['status']} {st['acceptance-b']['status']}\n")
        if n == "qc-1":
            f.check(n, holds)
            first = ids((f.d / f"{n}.stdout").read_text())
        else:
            f.check(n, lambda c, a=tuple(first): holds(c) and len(a) == 2 and not set(a) & set(ids(c.out)))
    f.run("read", "octo-feather-evidence", "read", "--repo", str(r), "--commit", head)
    f.check("read", lambda c: c.code == 0 and "4 record(s)" in c.out and c.out.count("demo.exit (") == 4)
    f.env = {}
    say(f"qc-capture evidence: {f.d}")


def drive_qc_insufficient(f: Feature) -> None:
    """`just qc` on a scratch target whose declared demo needs a step the qc sandbox cannot run (GitHub, which its
    offline gh refuses), then `octo-feather-lane merge-ask` on a PR (served by the offline gh from a scratch snapshot)
    whose merge ask lists that criterion as a triaged failure: insufficient evidence naming what is missing, still
    planned, no status commit, and the merge ask check failing naming it."""
    demo = f.s.contract.values.get("qc_demo_insufficient")
    if not demo:
        die("qc.toml [values] needs qc_demo_insufficient: the qc-insufficient drive's scratch demo")
    sc = RUN_DIR / "scratch" / "qc-insufficient"
    r, snap = sc / "repo", sc / "ghsnap"
    shutil.rmtree(sc, ignore_errors=True)
    (r / "docs" / "specs").mkdir(parents=True)
    (snap / "pr").mkdir(parents=True)
    (sc / "state").mkdir()

    def git(*args: str) -> str:
        return subprocess.run(["git", "-C", str(r), *args], check=True, capture_output=True, text=True).stdout.strip()

    git("init", "-q", "-b", "main")
    for k, val in (("user.name", "verify-octo-feather"), ("user.email", "verify@octo-feather.invalid"), ("core.hooksPath", "/dev/null")):
        git("config", k, val)
    git("commit", "-q", "--allow-empty", "-m", "accepted")
    shutil.copy(f"{f.s.repo}/tests/fixtures/spec-status/good/demo.spec.html", r / "docs" / "specs")
    git("add", "-A")
    git("commit", "-q", "-m", "spec")
    init = subprocess.run([f.s.kit, "octo-feather-spec-status", "init", str(r / "docs" / "specs" / "demo.spec.html"), git("rev-parse", "--short", "HEAD")],
                          capture_output=True, text=True, check=False)
    if init.returncode:
        die(f"qc-insufficient: scratch status file not made: {init.stderr.strip()}")
    (r / "qc.toml").write_text('format = 1\n[entry]\ncommand = "true"\n[services]\n[fixture]\n[values]\n'
                               f'[demo."demo#acceptance-a"]\ncommand = {json.dumps(demo)}\ncovers = ["docs/specs"]\ntests = ["none"]\n')
    git("add", "-A")
    git("commit", "-q", "-m", "contract with a demo that needs GitHub")
    head = git("rev-parse", "HEAD")
    # qc's reports and the scratch evidence store, never a live lane's; the stub classifier: no real model (a rerun passes)
    f.env = {"XDG_STATE_HOME": str(sc / "state"), "OCTO_FEATHER_QC_PATH": classify_stub(f, sc)}
    f.pre = ["env", "-C", str(r)]   # where the supervisor stands: the lane worktree
    f.run("qc", "just", "--justfile", f"{f.s.repo}/justfile", "qc", "docs/specs/demo.status.json", "7", "acceptance-a")
    f.obs("qc", "after", f"{git('rev-parse', 'HEAD')} {json.loads(git('show', 'HEAD:docs/specs/demo.status.json'))['criteria']['acceptance-a']['status']}"
                         f" {git('status', '--porcelain') or 'clean'}\n")
    line = (r"(?m)^INSUFFICIENT EVIDENCE acceptance-a: \$ .*\n  missing: demo did not run to its end \(exit 77, a step it needs could not run "
            r"here\): needs GitHub.*\n  evidence incomplete; decision demo checks; record [0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$")
    f.check("qc", lambda c: c.code == 2 and re.search(line, c.out) and not re.search(r"(?m)^FAIL ", c.out)
            and "insufficient evidence, never a failure to triage: acceptance-a" in c.out and c.o["after"] == f"{head} planned clean\n")
    # The PR as GitHub would serve it (snapshot layout: octo-feather-qc-ghsnap), its merge ask triaging the criterion as a failure.
    (snap / "meta.json").write_text(json.dumps({"repo": "o/r", "fetched_at": now(), "counts": {}, "capped": []}))
    (snap / "fetched_at").write_text(now() + "\n")
    body = (f"Closes #6\n\n## Merge ask\n\nHead: {head[:12]}\nChecks: check passes\n| criterion | qc verdict | judged | evidence |\n|---|---|---|---|\n"
            f"| demo#acceptance-a | fail | judged {head[:12]} | qc report, demo exit 77 |\nBuilt: none\nFailed:\n- acceptance-a: repair ticket\n")
    (snap / "pr" / "7.json").write_text(json.dumps({
        "number": 7, "baseRefName": "main", "headRefName": "gh6", "headRefOid": head, "body": body, "comments": [],
        "statusCheckRollup": [{"__typename": "CheckRun", "name": "check", "status": "COMPLETED", "conclusion": "SUCCESS"}],
        "commits": [{"oid": head, "messageHeadline": "contract with a demo that needs GitHub", "messageBody": ""}]}))
    f.env |= {"OCTO_FEATHER_GHSNAP": str(snap), "PATH": f"{f.s.repo}/.agents/skills/github-pr/scripts:{os.environ.get('PATH', '')}"}
    # The lane's base, the commit the PR's one commit sits on (no origin/main in the scratch repo).
    f.run("merge-ask", "octo-feather-lane", "merge-ask", "7", "--status", "docs/specs/demo.status.json", "--base", git("rev-parse", "HEAD^"))
    f.check("merge-ask", lambda c: c.code == 1 and not c.out and re.search(
        rf"criterion demo#acceptance-a: insufficient evidence at the judged head {head[:12]} \(demo did not run to its end \(exit 77, "
        r"[^)]*\): needs GitHub.*; qc report [0-9a-f]{40}-.*\.json\): never triaged", c.err))
    f.pre, f.env = [], {}
    say(f"qc-insufficient evidence: {f.d}")


# A scratch target's role, launching one skill (s) and extension (e.ts) in the repo, with the tracker skill pi-role
# needs. Its scripts/pi-role is a link to the kit's real one (launcher), so whatever octo-feather-qa --verdict asks
# of it (--help, Verdict) the real tool answers.
ROLE_FILES = (("agents/worker.md", "---\nname: worker\ndescription: the worker\nskills: s\nextensions: e.ts\n---\nthe worker role\n"),
              ("extensions/e.ts", "export default () => {};\n"), (".agents/skills/s/SKILL.md", "the skill\n"),
              (".agents/skills/github-issues/SKILL.md", "the tracker\n"))


def launcher(f: Feature, r: Path) -> None:
    """The scratch target R's scripts/pi-role: the kit's real launcher, linked."""
    (r / "scripts").mkdir(parents=True, exist_ok=True)
    (r / "scripts" / "pi-role").symlink_to(f"{f.s.repo}/scripts/pi-role")


def drive_qc_eval_verdict(f: Feature) -> None:
    """`just qc` on a scratch target whose declared demo is `octo-feather-qa --verdict` over a scratch stored eval run
    pinned at the target's first commit: pass at one head and at a second head leaving the run's files unchanged,
    insufficient evidence naming the role file at a head that changes it (octo-feather-qa --help, Verdict)."""
    sc = RUN_DIR / "scratch" / "qc-eval-verdict"
    r = sc / "repo"
    shutil.rmtree(sc, ignore_errors=True)
    (r / "docs" / "specs").mkdir(parents=True)

    def git(*args: str) -> str:
        return subprocess.run(["git", "-C", str(r), *args], check=True, capture_output=True, text=True).stdout.strip()

    git("init", "-q", "-b", "main")
    for k, val in (("user.name", "verify-octo-feather"), ("user.email", "verify@octo-feather.invalid"), ("core.hooksPath", "/dev/null")):
        git("config", k, val)
    case = {"id": "c1", "role": "worker", "fixture": "fx", "task": "Do it."}
    facts = [{"fact": "skill_read", "skill": "s"}]
    run, pin = "20260101T000000Z-abc123", "20260101T000000Z-abc123/s1/c1"
    for rel, text in (*ROLE_FILES,
                      ("evals/s1/cases.json", json.dumps([case])), ("evals/s1/reference/expectations.json", json.dumps({"c1": {"facts": facts}})),
                      ("evals/fixtures/fx/a.txt", "fixture\n"), ("README.md", "target\n"),
                      ("qc.toml", ('format = 2\n[entry]\ncommand = "true"\n[services]\n[fixture]\n[values]\n[demo."demo#acceptance-a"]\n'
                                   f'command = "{f.s.repo}/scripts/octo-feather-qa --verdict {pin}"\ncovers = ["agents"]\n'))):
        (r / rel).parent.mkdir(parents=True, exist_ok=True)
        (r / rel).write_text(text)
    launcher(f, r)
    shutil.copy(f"{f.s.repo}/tests/fixtures/spec-status/good/demo.spec.html", r / "docs" / "specs")
    git("add", "-A")
    git("commit", "-q", "-m", "accepted")
    kit = git("rev-parse", "HEAD")
    init = subprocess.run([f.s.kit, "octo-feather-spec-status", "init", str(r / "docs" / "specs" / "demo.spec.html"), kit[:12]],
                          capture_output=True, text=True, check=False)
    if init.returncode:
        die(f"qc-eval-verdict: scratch status file not made: {init.stderr.strip()}")
    git("add", "-A")
    git("commit", "-q", "-m", "status")
    head = git("rev-parse", "HEAD")
    # The stored run (octo-feather-qa's layout, two runs at kit KIT) in the scratch box state's qa dir, never the real one.
    d = sc / "state" / "octo-feather" / "qa" / run / "s1" / "c1"
    for k in (1, 2):
        kits = {"kit_ref": "HEAD", "kit_sha": kit, "run": k, "of": 2, "config": ""}
        (d / f"run-{k}").mkdir(parents=True)
        (d / f"run-{k}" / "input.json").write_text(json.dumps({"suite": "s1", **case, "model": "m", "max_tool_calls": 12, "timeout_s": 600, **kits}))
        (d / f"run-{k}" / "grading.json").write_text(json.dumps({"facts": [dict(x, status="pass", evidence="e") for x in facts], "deciding": []}))
        (d / f"run-{k}" / "result.json").write_text(json.dumps({"suite": "s1", "id": "c1", "verdict": "PASS", **kits}))
    (d / "result.json").write_text(json.dumps({"suite": "s1", "id": "c1", "verdict": "PASS", "role": "worker", "kit_ref": "HEAD", "kit_sha": kit,
                                               "runs": [{"run": k, "dir": f"run-{k}", "verdict": "PASS"} for k in (1, 2)], "runs_passed": 2}))
    f.env = {"XDG_STATE_HOME": str(sc / "state"), "OCTO_FEATHER_QC_PATH": classify_stub(f, sc)}
    f.pre = ["env", "-C", str(r)]
    qc = ("just", "--justfile", f"{f.s.repo}/justfile", "qc", "docs/specs/demo.status.json", "7", "acceptance-a")
    bound = re.escape(f"qc sandbox: ok   qa runs read-only: {sc / 'state' / 'octo-feather' / 'qa'} at ")
    fresh = r"PASS s1/c1: stored PASS, run \S+, kit \w+, runs 2/2 passed; fresh at HEAD"
    for name, at in (("fresh", head), ("second-head", None), ("stale", "role")):
        git("reset", "-q", "--hard", head)
        if at is None:
            (r / "README.md").write_text("target, changed\n")
            git("commit", "-q", "-am", "readme")
        elif at == "role":
            (r / "agents" / "worker.md").write_text(ROLE_FILES[0][1] + "changed\n")
            git("commit", "-q", "-am", "role")
        judged = git("rev-parse", "HEAD")
        f.run(name, *qc)
        # the demo's output, as the qc report keeps it (octo-feather-qc --help, Report)
        rep = sorted((sc / "state" / "octo-feather" / "qc").glob(f"{judged}-*.json"))
        res = [x for x in json.loads(rep[-1].read_text()).get("results", []) if x["id"] == "acceptance-a"] if rep else []
        f.obs(name, "demo", f"{res[0].get('output', '') if res else 'no qc report'}\n")
    f.check("fresh", lambda c: c.code == 0 and re.search(r"(?m)^PASS acceptance-a", c.out) and re.search(fresh, c.o["demo"])
            and re.search(bound, c.err))
    f.check("second-head", lambda c: c.code == 0 and re.search(r"(?m)^PASS acceptance-a", c.out) and re.search(fresh, c.o["demo"]))
    f.check("stale", lambda c: c.code == 2 and re.search(r"(?m)^INSUFFICIENT EVIDENCE acceptance-a", c.out)
            and "agents/worker.md changed" in c.out and not re.search(r"(?m)^FAIL ", c.out))
    f.pre, f.env = [], {}
    say(f"qc-eval-verdict evidence: {f.d}")


def drive_qa_evidence(f: Feature) -> None:
    """`octo-feather-qa --analyze RUN_DIR --evidence` on a scratch stored --baseline run (canned, octo-feather-qa's
    layout): the block, the same bytes a second time, and its pin read by `--verdict` in a scratch target as that run
    and case (octo-feather-qa --help, Evidence)."""
    sc = RUN_DIR / "scratch" / "qa-evidence"
    r = sc / "repo"
    shutil.rmtree(sc, ignore_errors=True)
    r.mkdir(parents=True)

    def git(*args: str) -> str:
        return subprocess.run(["git", "-C", str(r), *args], check=True, capture_output=True, text=True).stdout.strip()

    git("init", "-q", "-b", "main")
    for k, val in (("user.name", "verify-octo-feather"), ("user.email", "verify@octo-feather.invalid"), ("core.hooksPath", "/dev/null")):
        git("config", k, val)
    case = {"id": "c1", "role": "worker", "fixture": "fx", "task": "Report."}
    say_ = {"fact": "ran", "program": "herdr-say", "args": ["--parent"]}
    for rel, text in (*ROLE_FILES, ("evals/s1/cases.json", json.dumps([case])),
                      ("evals/s1/reference/expectations.json", json.dumps({"c1": {"facts": [say_]}})), ("evals/fixtures/fx/a.txt", "fixture\n")):
        (r / rel).parent.mkdir(parents=True, exist_ok=True)
        (r / rel).write_text(text)
    launcher(f, r)
    git("add", "-A")
    git("commit", "-q", "-m", "accepted")
    kit, base = git("rev-parse", "HEAD"), "b" * 40
    run = "20260102T000000Z-e1de1c"
    msg = "done: ```x```\nnext: gh13"
    qa = sc / "qa"
    c = qa / run / "s1" / "c1"
    res: dict[str, dict[str, object]] = {}
    for side, sha, verdict, argv in (("baseline", base, "FAIL", ["w2:p9", "go"]), ("current", kit, "PASS", ["--parent", msg])):
        rd = c / side / "run-1"
        rd.mkdir(parents=True)
        kits = {"kit_ref": "HEAD" if side == "current" else base, "kit_sha": sha}
        one = {"suite": "s1", "id": "c1", "verdict": verdict, "deciding": [f"ran herdr-say --parent: {verdict.lower()}"], "seconds": 10.0}
        st = "pass" if verdict == "PASS" else "fail"
        (rd / "input.json").write_text(json.dumps({"suite": "s1", **case, "model": "m", "fixture_head": "f" * 40, "max_tool_calls": 12,
                                                   "timeout_s": 600, **kits, "run": 1, "of": 1, "config": side}))
        (rd / "grading.json").write_text(json.dumps({"facts": [dict(say_, status=st, evidence="e")], "deciding": []}))
        (rd / "sandbox.json").write_text(json.dumps({"attempts": [{"kind": "run", "program": "herdr-say", "argv": argv, "exit": 0}]}))
        (rd / "result.json").write_text(json.dumps({**one, **kits, "run": 1, "of": 1, "config": side}))
        ok = float(verdict == "PASS")
        res[side] = {**one, "role": "worker", **kits, "runs": [{"run": 1, "dir": f"{side}/run-1", "verdict": verdict, "facts": [dict(say_, status=st)]}],
                     "runs_passed": int(ok), "pass_rate": ok, "stddev": 0.0, "time": {"mean": 10.0, "stddev": 0.0},
                     "tokens": {"mean": 100.0, "stddev": 0.0}, "cost_usd": None}
    b = res["baseline"]
    top = {**res["current"], "baseline": {"kit_ref": base, "kit_sha": base, **{k: b[k] for k in (
        "verdict", "deciding", "seconds", "runs", "runs_passed", "pass_rate", "stddev", "time", "tokens", "cost_usd")}},
           "delta": {"pass_rate": 1.0, "time": 0.0, "tokens": 0.0, "cost_usd": None}}
    (c / "result.json").write_text(json.dumps(top))
    (qa / run / "summary.json").write_text(json.dumps({"run_id": run, "kit_ref": "HEAD", "kit_sha": kit, "passed": 1, "total": 1, "scores": {},
                                                       "runs": 1, "baseline": {"kit_ref": base, "kit_sha": base}, "cases": [top]}))
    pin = f"{run}/s1/c1"
    f.run("block", "octo-feather-qa", "--analyze", str(qa / run), "--evidence")
    f.run("again", "octo-feather-qa", "--analyze", str(qa / run), "--evidence")
    f.env = {"OCTO_FEATHER_QA_DIR": str(qa)}
    f.pre = ["env", "-C", str(r)]
    f.run("pin", "octo-feather-qa", "--verdict", pin)
    f.obs("again", "block", (f.d / "block.stdout").read_text())
    f.check("block", lambda c: c.code == 0 and all(x in c.out.splitlines() for x in (
        f"- current kit: {kit} (kit ref HEAD)", f"- baseline kit: {base} (--baseline {base})", f"Pin: `octo-feather-qa --verdict {pin}`",
        f"{pin}/current/run-1: ran herdr-say --parent: pass", '  herdr-say ["--parent", "done: ```x```\\nnext: gh13"] exit 0',
        f"{pin}/baseline/run-1: ran herdr-say --parent: fail", "  no matching recorded run", "````text")) and "Smoke: " in c.out and "Removed: " in c.out)
    f.check("again", lambda c: c.code == 0 and c.out == c.o["block"])
    f.check("pin", lambda c: c.code == 0 and f"PASS s1/c1: stored PASS, run {run}, kit {kit[:12]}, runs 1/1 passed; fresh at HEAD" in c.out)
    f.pre, f.env = [], {}
    say(f"qa-evidence evidence: {f.d}")


def drive_qc_browser(f: Feature) -> None:
    """`just qc` on a scratch target whose qc.toml pins the kit's Playwright release and declares a browser demo that
    screenshots a page: the demo runs in the qc sandbox with the box's headless shell, its screenshot in its new record."""
    v = f.s.contract.values
    if "qc_demo_browser" not in v or not f.s.contract.browser:
        die("qc.toml needs [values] qc_demo_browser and [browser] playwright: the qc-browser drive's scratch demo and its pin")
    sc = RUN_DIR / "scratch" / "qc-browser"
    r = sc / "repo"
    shutil.rmtree(sc, ignore_errors=True)
    (r / "docs" / "specs").mkdir(parents=True)
    (sc / "state").mkdir()

    def git(*args: str) -> str:
        return subprocess.run(["git", "-C", str(r), *args], check=True, capture_output=True, text=True).stdout.strip()

    git("init", "-q", "-b", "main")
    for k, val in (("user.name", "verify-octo-feather"), ("user.email", "verify@octo-feather.invalid"), ("core.hooksPath", "/dev/null")):
        git("config", k, val)   # qc commits the status file in this repo
    git("commit", "-q", "--allow-empty", "-m", "accepted")
    shutil.copy(f"{f.s.repo}/tests/fixtures/spec-status/good/demo.spec.html", r / "docs" / "specs")
    (r / "page.html").write_text('<!doctype html><title>qc-browser</title><body style="background:#2a7"><h1>qc-browser drive</h1></body>\n')
    git("add", "-A")
    git("commit", "-q", "-m", "spec and page")
    init = subprocess.run([f.s.kit, "octo-feather-spec-status", "init", str(r / "docs" / "specs" / "demo.spec.html"), git("rev-parse", "--short", "HEAD")],
                          capture_output=True, text=True, check=False)
    if init.returncode:
        die(f"qc-browser: scratch status file not made: {init.stderr.strip()}")
    (r / "qc.toml").write_text('format = 1\n[entry]\ncommand = "true"\n[services]\n[fixture]\n[values]\n'
                               f'[browser]\nplaywright = {json.dumps(f.s.contract.browser)}\n'
                               f'[demo."demo#acceptance-a"]\ncommand = {json.dumps(v["qc_demo_browser"])}\nbrowser = true\n'
                               'covers = ["page.html"]\ntests = ["none"]\n')
    git("add", "-A")
    git("commit", "-q", "-m", "contract with a browser demo")
    head = git("rev-parse", "HEAD")
    f.env = {"XDG_STATE_HOME": str(sc / "state"), "OCTO_FEATHER_QC_PATH": classify_stub(f, sc)}   # qc's reports, the scratch target's evidence store; the box's browser; no real classifier
    f.pre = ["env", "-C", str(r)]
    f.run("qc", "just", "--justfile", f"{f.s.repo}/justfile", "qc", "docs/specs/demo.status.json", "7", "acceptance-a")
    f.pre = []
    f.obs("qc", "store", output([f.s.kit, "octo-feather-evidence", "read", "--repo", str(r), "--commit", head, "--json"],
                                env=case_env(f.env))[1])
    rid = r"([0-9]{8}T[0-9]{6}Z-[0-9a-f]{8})"

    def holds(c: Case) -> bool:
        m = re.search(r"(?m)^PASS acceptance-a: \$ .*\n  demo exit status 0\n  evidence complete; decision demo checks; record " + rid + "$", c.out)
        rec = [x for x in json.loads(c.o["store"]) if m and x["record"]["id"] == m.group(1)]
        if c.code != 0 or not rec or rec[0]["record"]["revision"] != head or "qc sandbox: FAIL" in c.err:
            return False
        png = Path(rec[0]["dir"], "outputs", "screenshots", "page.png")
        return (re.search(r"(?m)^qc sandbox: ok   browser: PLAYWRIGHT_BROWSERS_PATH=\S+ read-only, headless shell \S+$", c.err) is not None
                and png.is_file() and png.read_bytes()[:8] == b"\x89PNG\r\n\x1a\n")
    f.check("qc", holds)
    f.run("read", "octo-feather-evidence", "read", "--repo", str(r), "--criterion", "demo#acceptance-a", "--commit", head)
    f.check("read", lambda c: c.code == 0 and "1 record(s)" in c.out and "screenshots/page.png (" in c.out)
    f.env = {}
    say(f"qc-browser evidence: {f.d}")


def drive_qc_sandbox(f: Feature) -> None:
    """The qc sandbox by hand (`octo-feather-qc-sandbox -- CMD`) in a scratch git repo, CMD trying each escape the
    criterion names, each outcome observed outside the launcher's own proof: a mask removed (umount of the Herdr config
    mask, then what it shows), a credential copied out (git and gh credential files into the worktree and /tmp), a write
    to the worktree and to HOME kept, a process left running (a setsid'd sleep), a live Herdr session reached (the real
    herdr binary, past the shim, at the default session). After the run: no file of it in the repo or HOME, the sleep
    gone, the credential read empty."""
    sc = RUN_DIR / "scratch" / "qc-sandbox"
    r = sc / "repo"
    shutil.rmtree(sc, ignore_errors=True)
    r.mkdir(parents=True)

    def git(*args: str) -> str:
        return subprocess.run(["git", "-C", str(r), *args], check=True, capture_output=True, text=True).stdout.strip()

    git("init", "-q", "-b", "main")
    for k, val in (("user.name", "verify-octo-feather"), ("user.email", "verify@octo-feather.invalid"), ("core.hooksPath", "/dev/null")):
        git("config", k, val)
    git("commit", "-q", "--allow-empty", "-m", "scratch")
    home = Path(os.environ.get("HOME", "/"))
    tok = f"7171{os.getpid()}"
    cmd = ('umount "$HOME/.config/herdr"; echo "umount $?"; echo "mask shows [$(ls -A "$HOME/.config/herdr" | tr "\\n" " ")]"; '
           'cat "$HOME/.git-credentials" "${XDG_CONFIG_HOME:-$HOME/.config}/git/credentials" "${XDG_CONFIG_HOME:-$HOME/.config}/gh/hosts.yml" '
           '> stolen 2>/dev/null; cp stolen /tmp/stolen; echo "creds $(wc -c < stolen) bytes"; '
           'touch "$HOME/x"; echo "touch $?"; echo w > newfile; echo "wrote $?"; '
           f"setsid sh -c 'echo \"owned-child-start $$ {tok}\"; exec sleep {tok}' < /dev/null & "
           'if [ -n "$OCTO_FEATHER_QC_HERDR" ]; then "$OCTO_FEATHER_QC_HERDR" --session default workspace list > /dev/null 2>&1; '
           'echo "live herdr $?"; else echo "live herdr none"; fi')
    # Feature.run writes regular evidence files. This public-command wrapper supplies actual
    # capture pipes, so the child's inherited stdout must close before communicate succeeds.
    capture = """import subprocess, sys
p = subprocess.Popen(sys.argv[1:], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
try:
    out, err = p.communicate(timeout=120)
except subprocess.TimeoutExpired:
    try:
        p.kill()
        p.wait(timeout=10)
        print('owned launcher killed and waited after pipe timeout; descendant cleanup/accounting unproved', file=sys.stderr)
    finally:
        if p.stdout is not None: p.stdout.close()
        if p.stderr is not None: p.stderr.close()
    sys.exit(66)
sys.stdout.buffer.write(out)
sys.stderr.buffer.write(err)
sys.exit(p.returncode)
"""
    f.pre = ["env", "-C", str(r), "python3", "-c", capture]
    f.run("by-hand", "octo-feather-qc-sandbox", "--", "sh", "-c", cmd)
    f.pre = []
    f.obs("by-hand", "after", f"{(home / 'x').exists()} {(r / 'newfile').exists()} {(r / 'stolen').exists()} "
                              f"{git('status', '--porcelain') or 'clean'}\n")

    def mask_ok(out: str) -> bool:   # the mask shows only what the run's own Herdr server makes there
        m = re.search(r"(?m)^mask shows \[(.*)\]$", out)
        return m is not None and set(m.group(1).split()) <= {"sessions", ".plugins.lock"}

    def holds(c: Case) -> bool:
        live = re.search(r"(?m)^live herdr (\S+)$", c.out)
        started = re.findall(rf"(?m)^owned-child-start (\d+) {tok}$", c.out)
        cleanup = [json.loads(ln.split("record ", 1)[1]) for ln in c.err.splitlines()
                   if ln.startswith("qc sandbox: record ")]
        child_reaped = (len(started) == 1 and any(
            rec.get("left_after_kill") == 0 and f"{started[0]} sleep {tok}" in rec.get("killed", [])
            for rec in cleanup))
        return (c.code == 0 and "qc sandbox: FAIL" not in c.err and child_reaped
                and c.o["after"] == "False False False clean\n"
                and re.search(r"(?m)^umount [1-9][0-9]*$", c.out) is not None   # the mask stays
                and mask_ok(c.out)
                and re.search(r"(?m)^creds 0 bytes$", c.out) is not None   # nothing to copy out
                and re.search(r"(?m)^touch [1-9][0-9]*$", c.out) is not None and re.search(r"(?m)^wrote 0$", c.out) is not None
                and live is not None and live.group(1) != "0")   # the real herdr reaches no default session
    f.check("by-hand", holds)
    if re.search(r"(?m)^live herdr none$", (f.d / "by-hand.stdout").read_text()):
        f.unreachable_step("by-hand", "no herdr on the box: the live Herdr session escape not tried")
    say(f"qc-sandbox evidence: {f.d}")


# Per quality spec #acceptance-qc-sandbox-cost: serial runs and report-only CPU target (seconds).
QC_SANDBOX_COST_RUNS, QC_SANDBOX_COST_CPU_S = 5, 0.8


def drive_qc_sandbox_cost(f: Feature) -> None:
    """The qc sandbox around a judge that does nothing (`octo-feather-qc-sandbox -- true`, by hand, the box's herdr when
    there is one), QC_SANDBOX_COST_RUNS runs one after another in a scratch git repo: each run's CPU, the sandbox's setup,
    proof and cleanup with every process they start (the case command's waited-for children, getrusage, Feature.cpu:
    not the drive's own checks around it), printed with the
    median; QC_SANDBOX_COST_CPU_S is report-only, not a pass condition."""
    sc = RUN_DIR / "scratch" / "qc-sandbox-cost"
    r = sc / "repo"
    shutil.rmtree(sc, ignore_errors=True)
    r.mkdir(parents=True)
    for args in (("init", "-q", "-b", "main"),
                 ("-c", "user.name=verify-octo-feather", "-c", "user.email=verify@octo-feather.invalid",
                  "commit", "-q", "--allow-empty", "-m", "scratch")):
        subprocess.run(["git", "-C", str(r), *args], check=True, capture_output=True)
    f.pre = ["env", "-C", str(r)]
    cpus: list[float] = []
    for i in range(1, QC_SANDBOX_COST_RUNS + 1):
        name = f"run-{i}"
        f.run(name, "octo-feather-qc-sandbox", "--", "true")
        cpu = f.cpu  # the case command's own: not the drive's checks around it (the kit's git status)
        cpus.append(cpu)
        f.obs(name, "cpu", f"{cpu!r}\n")
        say(f"qc-sandbox-cost {name}: {cpu:.3f} s CPU; target < {QC_SANDBOX_COST_CPU_S} s: "
            f"{cpu < QC_SANDBOX_COST_CPU_S} (report-only)")
        f.check(name, lambda c: c.code == 0 and "qc sandbox: FAIL" not in c.err
                and math.isfinite(float(c.o["cpu"])) and float(c.o["cpu"]) >= 0)
    f.pre = []
    say(f"qc-sandbox-cost: {' '.join(f'{c:.3f}' for c in cpus)} s CPU per run; median {statistics.median(cpus):.3f} s, "
        f"each under {QC_SANDBOX_COST_CPU_S} s: {all(c < QC_SANDBOX_COST_CPU_S for c in cpus)} (report-only)")


def drive_qc_advisory(f: Feature) -> None:
    """`just qc` on a scratch target whose qc.toml declares a passing demo, with the classifier boundary stubbed (the
    kit's tests/fixtures/classify-stub/pi first on PATH, never a real model): the kit's judgment model is induced to
    answer does-not-show; the criterion still passes, its advisory answer and confidence shown beside it and in the report."""
    v = f.s.contract.values
    if "qc_demo_pass" not in v:
        die("qc.toml [values] needs qc_demo_pass: the qc-advisory drive's scratch demo")
    sc = RUN_DIR / "scratch" / "qc-advisory"
    r = sc / "repo"
    shutil.rmtree(sc, ignore_errors=True)
    (r / "docs" / "specs").mkdir(parents=True)
    (sc / "state").mkdir()
    model = json.loads((Path(f.s.repo) / "evals" / "judgment-model.json").read_text())["model"]

    def git(*args: str) -> str:
        return subprocess.run(["git", "-C", str(r), *args], check=True, capture_output=True, text=True).stdout.strip()

    git("init", "-q", "-b", "main")
    for k, val in (("user.name", "verify-octo-feather"), ("user.email", "verify@octo-feather.invalid"), ("core.hooksPath", "/dev/null")):
        git("config", k, val)   # qc commits the status file in this repo
    git("commit", "-q", "--allow-empty", "-m", "accepted")
    shutil.copy(f"{f.s.repo}/tests/fixtures/spec-status/good/demo.spec.html", r / "docs" / "specs")
    git("add", "-A")
    git("commit", "-q", "-m", "spec")
    init = subprocess.run([f.s.kit, "octo-feather-spec-status", "init", str(r / "docs" / "specs" / "demo.spec.html"), git("rev-parse", "--short", "HEAD")],
                          capture_output=True, text=True, check=False)
    if init.returncode:
        die(f"qc-advisory: scratch status file not made: {init.stderr.strip()}")
    (r / "qc.toml").write_text('format = 1\n[entry]\ncommand = "true"\n[services]\n[fixture]\n[values]\n'
                               f'[demo."demo#acceptance-a"]\ncommand = {json.dumps(v["qc_demo_pass"])}\ncovers = ["docs/specs"]\ntests = ["none"]\n')
    git("add", "-A")
    git("commit", "-q", "-m", "contract with a passing demo")
    # Scratch box state; the stub classifier induced to answer does-not-show at 0.91.
    f.env = {"XDG_STATE_HOME": str(sc / "state"), "OCTO_FEATHER_QC_PATH": classify_stub(f, sc),
             "STUB_ANSWER": "does-not-show", "STUB_CONFIDENCE": "0.91"}
    f.pre = ["env", "-C", str(r)]
    f.run("qc", "just", "--justfile", f"{f.s.repo}/justfile", "qc", "docs/specs/demo.status.json", "7", "acceptance-a")
    f.pre = []
    f.obs("qc", "results", json.dumps(qc_report(f, "qc").get("results"), indent=1) + "\n")
    st = json.loads(git("show", "HEAD:docs/specs/demo.status.json"))["criteria"]
    f.obs("qc", "built", f"{st['acceptance-a']['status']}\n")
    line = (r"(?m)^PASS acceptance-a: \$ .*\n  demo exit status 0\n  evidence complete; decision demo checks; record [0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}\n"
            r"  advisory model judgment \(no gate reads it\): does-not-show, confidence 0\.910 \(criterion-evidence by " + re.escape(model) + r"; [^)]+\)$")

    def holds(c: Case) -> bool:
        res: list[dict[str, Any]] = json.loads(c.o["results"]) or [{}]
        a: dict[str, Any] = res[0].get("advisory") or {}
        return (c.code == 0 and re.search(line, c.out) is not None and c.o["built"] == "built\n" and res[0].get("verdict") == "pass"
                and (a.get("answer"), a.get("confidence"), a.get("model")) == ("does-not-show", 0.91, model)
                and str(a.get("judgment", "")).startswith("model judgment") and "no gate reads it" in a["judgment"])
    f.check("qc", holds)
    git("reset", "--hard", "HEAD^")  # same demo, not a carried result
    f.env |= {"OCTO_FEATHER_QC_ADVISORY_AUTHORITY": "gpt-only-sprint-2026-11-08",
              "OCTO_FEATHER_QC_ADVISORY_SCOPE": "sandbox"}
    f.pre = ["env", "-C", str(r)]
    f.run("sprint", "just", "--justfile", f"{f.s.repo}/justfile", "qc", "docs/specs/demo.status.json", "7", "acceptance-a")
    f.pre = []
    f.obs("sprint", "results", json.dumps(qc_report(f, "sprint").get("results")) + "\n")
    f.obs("sprint", "built", json.loads(git("show", "HEAD:docs/specs/demo.status.json"))["criteria"]["acceptance-a"]["status"])

    def suspended(c: Case) -> bool:
        res = json.loads(c.o["results"])[0]
        return (c.code == 0 and res["verdict"] == "pass" and res["evidence"] == "complete"
                and c.o["built"] == "built" and "advisory NOT RUN" in c.out
                and "qc: advisory criterion-evidence question" not in c.err
                and res["advisory"] == {"status": "NOT RUN", "authority": "gpt-only-sprint-2026-11-08",
                                        "scope": "sandbox", "expiry": "sprint pause after final cleanup"})
    f.check("sprint", suspended)
    f.env = {}
    say(f"qc-advisory evidence: {f.d}")


# The qa-runs and qa-baseline drives' stub `pi` (no model): emits the Pi JSON events of one turn, each assistant message
# with usage (100 input and 10k output tokens, cost 0.001, run k from its scratch copy qa-<id>-<n>r<k>-*:
# octo-feather-qa --help); it reads the role's tdd SKILL.md when the role lists tdd and NOREAD is not in the prompt, with
# ALTERNATE in the prompt on odd runs only; with COSTLY, a role listing tdd spends 3 more messages; then a final message:
# with SAY: TEXT in the prompt, TEXT, also written to notes.md in the case repo; with TREE, what the case repo holds:
# files=<tracked files> commits=<commits> deep=ok|missing (.agents/skills/eval-cases/references/schema.md); else done.
QA_STUB_PI = r"""#!/usr/bin/env python3
import json, os, re, sys
a = sys.argv[1:]
prompt = a[a.index("-p") + 1]
k = int((re.search(r"/qa-[0-9a-f]+-[0-9]+r([0-9]+)-", os.getcwd()) or [0, "1"])[1])
def out(e):
    m = e.get("message") if e.get("type") == "message_end" else None
    if isinstance(m, dict):
        m["usage"] = {"input": 100, "output": 10 * k, "totalTokens": 100 + 10 * k, "cost": {"total": 0.001}}
    print(json.dumps(e), flush=True)
out({"type": "stub_argv", "argv": a})
out({"type": "agent_start"})
tdd = next((x + "/SKILL.md" for x in a if x.endswith("/tdd")), None)
if tdd and "COSTLY" in prompt:
    for _ in range(3):
        out({"type": "message_end", "message": {"role": "assistant", "provider": "stub", "model": "stub-model", "stopReason": "stop",
                                               "content": [{"type": "text", "text": "thinking"}]}})
if tdd and "NOREAD" not in prompt and not ("ALTERNATE" in prompt and k % 2 == 0):
    out({"type": "message_end", "message": {"role": "assistant", "provider": "stub", "model": "stub-model", "stopReason": "toolUse",
                                           "content": [{"type": "toolCall", "id": "c1", "name": "read", "arguments": {"path": tdd}}]}})
    out({"type": "tool_execution_start", "toolCallId": "c1", "toolName": "read", "args": {"path": tdd}})
    out({"type": "tool_execution_end", "toolCallId": "c1", "toolName": "read", "isError": False,
         "result": {"content": [{"type": "text", "text": open(tdd).read()}]}})
say = prompt.split("SAY:", 1)[1].strip() if "SAY:" in prompt else "done"
if "TREE" in prompt:
    import subprocess
    git = lambda *g: subprocess.run(["git", *g], capture_output=True, text=True).stdout
    deep = "ok" if os.path.isfile(".agents/skills/eval-cases/references/schema.md") else "missing"
    say = f"files={len(git('ls-files').splitlines())} commits={len(git('rev-list', 'HEAD').splitlines())} deep={deep}"
if "SAY:" in prompt:
    open("notes.md", "w").write(say + "\n")
out({"type": "message_end", "message": {"role": "assistant", "provider": "stub", "model": "stub-model", "stopReason": "stop",
                                       "content": [{"type": "text", "text": say}]}})
"""


def drive_qa_runs(f: Feature) -> None:
    """octo-feather-qa --runs on a scratch eval suite (role implementer, graded skill_read tdd), the role's model a stub
    `pi` first on the qa sandbox's PATH, never a real model; cases and what each observes: features/qa-runs.md."""
    sc = RUN_DIR / "scratch" / "qa-runs"
    ev = sc / "evals"
    shutil.rmtree(sc, ignore_errors=True)
    (ev / "vq" / "reference").mkdir(parents=True)
    (ev / "fixtures" / "fx").mkdir(parents=True)
    (sc / "bin").mkdir()
    (sc / "state").mkdir()
    (sc / "bin" / "pi").write_text(QA_STUB_PI)
    (sc / "bin" / "pi").chmod(0o755)
    (ev / "fixtures" / "fx" / "README.md").write_text("qa-runs drive fixture\n")
    (ev / "vq" / "suite.json").write_text(json.dumps({"suite": "vq", "kind": "role-transcript", "description": "qa-runs drive",
                                                     "max_tool_calls": 5, "timeout_s": 60}))
    (ev / "vq" / "cases.json").write_text(json.dumps([{"id": i, "role": "implementer", "fixture": "fx", "task": t} for i, t in
                                                      (("alt", "Build it. ALTERNATE"), ("steady", "Build it."))]))
    (ev / "vq" / "reference" / "expectations.json").write_text(json.dumps(
        {i: {"facts": [{"fact": "skill_read", "skill": "tdd"}]} for i in ("alt", "steady")}))
    # The stub first on PATH and on the qa sandbox's PATH; qa's artifacts and state in scratch.
    f.env = {"PATH": f"{sc / 'bin'}:{os.environ.get('PATH', '')}", "OCTO_FEATHER_QC_PATH": str(sc / "bin"),
             "OCTO_FEATHER_QA_DIR": str(sc / "out"), "XDG_STATE_HOME": str(sc / "state")}
    # The scratch state dir holds the commit identity the eval's role launch needs (pi-role --help, Commit identity).
    subprocess.run([f"{f.s.repo}/scripts/pi-role", "--set-identity", "Verify Identity", "verify@octo-feather.invalid"],
                   env=case_env({"XDG_STATE_HOME": str(sc / "state")}), capture_output=True, check=True)
    qa = ("octo-feather-qa", "--evals", str(ev))

    def last_run(name: str, case: str) -> None:
        runs = sorted((sc / "out").iterdir()) if (sc / "out").is_dir() else []
        c = runs[-1] / "vq" / case if runs else sc / "none"
        f.obs(name, "result", (c / "result.json").read_text() if (c / "result.json").is_file() else "{}\n")
        f.obs(name, "dirs", "".join(f"{p.name}\n" for p in sorted(c.glob("run-*")) if (p / "transcript.jsonl").is_file()))
        f.obs(name, "stub", "".join(f"{p.parent.name} {json.loads(p.read_text().splitlines()[0])['type']}\n"
                                    for p in sorted(c.glob("run-*/transcript.jsonl"))))

    f.run("alternating", *qa, "--case", "alt", "--runs", "4")
    last_run("alternating", "alt")

    def alternating(c: Case) -> bool:
        r = json.loads(c.o["result"])
        return (c.code == 1 and re.search(r"(?m)^FAIL vq/alt: 2/4 runs passed \(pass rate 0\.50, stddev 0\.58\); run 2: skill_read tdd: no load"
                                          r".*; run 4: skill_read tdd: no load.*\[kit [0-9a-f]{40}\]$", c.out) is not None
                and all(f"  run {k}/4: {v} vq/alt: " in c.out for k, v in ((1, "PASS"), (2, "FAIL"), (3, "PASS"), (4, "FAIL")))
                and (r.get("verdict"), r.get("runs_passed"), r.get("pass_rate"), r.get("stddev")) == ("FAIL", 2, 0.5, 0.5774)
                and c.o["dirs"] == "run-1\nrun-2\nrun-3\nrun-4\n" and c.o["stub"].count(" stub_argv\n") == 4)
    f.check("alternating", alternating)
    f.run("every-run", *qa, "--case", "steady", "--runs", "2")
    last_run("every-run", "steady")
    f.check("every-run", lambda c: c.code == 0 and re.search(r"(?m)^PASS vq/steady: 2/2 runs passed \(pass rate 1\.00, stddev 0\.00\); run 1: "
                                                         r"skill_read tdd: loaded at", c.out) is not None
            and json.loads(c.o["result"]).get("pass_rate") == 1.0 and c.o["stub"].count(" stub_argv\n") == 2)
    f.run("bad-runs", *qa, "--runs", "0")
    f.check("bad-runs", lambda c: c.code == 64 and "--runs needs a positive integer" in c.err and "qa: run " not in c.out)
    f.env = {}
    say(f"qa-runs evidence: {f.d}")


def scratch_kit(f: Feature, kit: Path) -> tuple[str, str]:
    """A scratch kit repo in KIT (this checkout's tracked files as in its working tree; the checkout's repo never
    written): commit before, agents/implementer.md not listing tdd, then change, as they are. Returns their shas."""
    for rel in subprocess.run(["git", "-C", f.s.repo, "ls-files", "-z"], capture_output=True, text=True, check=True).stdout.split("\0"):
        src = Path(f.s.repo) / rel
        if rel and (src.is_file() or src.is_symlink()):
            (kit / rel).parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(src, kit / rel, follow_symlinks=False)
    im = kit / "agents" / "implementer.md"
    role = im.read_text()
    im.write_text(re.sub(r"(?m)^(skills:.*), tdd,", r"\1,", role))

    def git(*args: str) -> str:
        return subprocess.run(["git", "-C", str(kit), "-c", "user.name=verify-octo-feather", "-c", "user.email=verify@octo-feather.invalid",
                               "-c", "commit.gpgsign=false", "-c", "core.hooksPath=/dev/null", *args],
                              check=True, capture_output=True, text=True).stdout.strip()

    git("init", "-q", "-b", "main")
    git("add", "-A")
    git("commit", "-q", "-m", "before: the implementer does not list tdd")
    before = git("rev-parse", "HEAD")
    im.write_text(role)
    git("commit", "-q", "-am", "change: the implementer lists tdd")
    change = git("rev-parse", "HEAD")
    # The checkout's installed JavaScript packages (gitignored, so not copied): the qc sandbox runs srt from the running
    # kit's node_modules at its package.json pin; a link, kept out of the scratch repo's status.
    (kit / "node_modules").symlink_to(Path(f.s.repo) / "node_modules")
    with (kit / ".git" / "info" / "exclude").open("a") as ex:
        ex.write("/node_modules\n")
    return before, change


def drive_qa_baseline(f: Feature) -> None:
    """octo-feather-qa --runs and --baseline on a scratch eval suite, the role's model the qa-runs drive's stub `pi`, never a
    real model, against a scratch kit repo (this checkout's tracked files): commit before, the implementer not listing
    tdd, and change, as checked out; cases and what each observes: features/qa-baseline.md."""
    sc = RUN_DIR / "scratch" / "qa-baseline"
    ev, kit = sc / "evals", sc / "kit"
    shutil.rmtree(sc, ignore_errors=True)
    (ev / "vb" / "reference").mkdir(parents=True)
    (ev / "fixtures" / "fx").mkdir(parents=True)
    for d in ("bin", "state", "kit"):
        (sc / d).mkdir()
    (sc / "bin" / "pi").write_text(QA_STUB_PI)
    (sc / "bin" / "pi").chmod(0o755)
    (ev / "fixtures" / "fx" / "README.md").write_text("qa-baseline drive fixture\n")
    (ev / "vb" / "suite.json").write_text(json.dumps({"suite": "vb", "kind": "role-transcript", "description": "qa-baseline drive",
                                                     "max_tool_calls": 5, "timeout_s": 60}))
    (ev / "vb" / "cases.json").write_text(json.dumps([{"id": "build", "role": "implementer", "fixture": "fx", "task": "Build it."}]))
    (ev / "vb" / "reference" / "expectations.json").write_text(json.dumps({"build": {"facts": [{"fact": "skill_read", "skill": "tdd"}]}}))
    before, change = scratch_kit(f, kit)
    f.env = {"PATH": f"{sc / 'bin'}:{os.environ.get('PATH', '')}", "OCTO_FEATHER_QC_PATH": str(sc / "bin"),
             "OCTO_FEATHER_QA_DIR": str(sc / "out"), "XDG_STATE_HOME": str(sc / "state")}
    # The scratch state dir holds the commit identity the eval's role launch needs (pi-role --help, Commit identity).
    subprocess.run([f"{f.s.repo}/scripts/pi-role", "--set-identity", "Verify Identity", "verify@octo-feather.invalid"],
                   env=case_env({"XDG_STATE_HOME": str(sc / "state")}), capture_output=True, check=True)
    qa = (str(kit / "scripts" / "octo-feather-qa"), "--evals", str(ev), "--case", "build", "--runs", "2")

    def result(name: str) -> None:
        runs = sorted((sc / "out").iterdir()) if (sc / "out").is_dir() else []
        c = runs[-1] / "vb" / "build" if runs else sc / "none"
        f.obs(name, "result", (c / "result.json").read_text() if (c / "result.json").is_file() else "{}\n")
        f.obs(name, "stub", "".join(f"{p.relative_to(c)} {json.loads(p.read_text().splitlines()[0])['type']}\n"
                                    for p in sorted(c.glob("**/run-*/transcript.jsonl"))))

    f.run("cost", *qa)
    result("cost")
    f.check("cost", lambda c: c.code == 0 and re.search(r"(?m)^  cost vb/build: time s [0-9.]+ \+/- [0-9.]+; tokens 115 \+/- 7$", c.out) is not None
            and json.loads(c.o["result"]).get("tokens") == {"mean": 115, "stddev": 7.0711} and c.o["stub"].count(" stub_argv\n") == 2)
    f.run("baseline", *qa, "--baseline", before)
    result("baseline")
    table = (rf"(?m)^  compare vb/build: baseline kit {before[:12]} beside current kit {change[:12]}\n {{4}} {{10}} baseline {{13}}current {{14}}difference\n"
             r" {4}pass rate  0\.00 \+/- 0\.00 {8}1\.00 \+/- 0\.00 {8}\+1\.00\n {4}time s {5}\S+ \+/- \S+ +\S+ \+/- \S+ +\S+\n"
             r" {4}tokens {5}115 \+/- 7 {12}115 \+/- 7 {12}\+0\n {4}cost usd   0\.0010 \+/- 0\.0000 {4}0\.0010 \+/- 0\.0000 {4}\+0\.0000$")

    def compared(c: Case) -> bool:
        r = json.loads(c.o["result"])
        order = re.findall(r"(?m)^  (baseline|current) run ([12])/2: (PASS|FAIL)", c.out)
        return (c.code == 0 and c.out.count("qa: run ") == 1 and re.search(table, c.out) is not None
                and order == [("baseline", "1", "FAIL"), ("current", "1", "PASS"), ("baseline", "2", "FAIL"), ("current", "2", "PASS")]
                and (r.get("verdict"), r.get("kit_sha"), r.get("baseline", {}).get("kit_sha"), r.get("delta", {}).get("pass_rate")) == ("PASS", change, before, 1.0)
                and c.o["stub"].count(" stub_argv\n") == 4)
    f.check("baseline", compared)
    f.run("bad-baseline", *qa, "--baseline", "no-such-ref")
    f.check("bad-baseline", lambda c: c.code == 64 and "--baseline no-such-ref: no such commit" in c.err and "qa: run " not in c.out)
    f.env = {}
    say(f"qa-baseline evidence: {f.d}")


def drive_qa_analyst(f: Feature) -> None:
    """octo-feather-qa --runs 2 --baseline on a scratch eval suite holding one case per analysis flag, against the
    qa-baseline drive's scratch kit, the role's model the stub `pi` (QA_STUB_PI), never a real model; then --analyze on
    the stored run dir with a poison pi first on PATH; cases and what each observes: features/qa-analyst.md."""
    sc = RUN_DIR / "scratch" / "qa-analyst"
    ev, kit = sc / "evals", sc / "kit"
    shutil.rmtree(sc, ignore_errors=True)
    (ev / "va" / "reference").mkdir(parents=True)
    (ev / "fixtures" / "fx").mkdir(parents=True)
    for d in ("bin", "poison", "state", "kit"):
        (sc / d).mkdir()
    (sc / "bin" / "pi").write_text(QA_STUB_PI)
    (sc / "poison" / "pi").write_text(f"#!/bin/sh\ntouch {shlex.quote(str(sc / 'poison' / 'ran'))}\nexit 99\n")
    for p in ("bin", "poison"):
        (sc / p / "pi").chmod(0o755)
    (ev / "fixtures" / "fx" / "README.md").write_text("qa-analyst drive fixture\n")
    (ev / "va" / "suite.json").write_text(json.dumps({"suite": "va", "kind": "role-transcript", "description": "qa-analyst drive",
                                                     "max_tool_calls": 10, "timeout_s": 60}))
    rt, np_ = {"fact": "skill_read", "skill": "tdd"}, {"fact": "skill_not_read", "skill": "pull"}
    cases = (("same", "Only look. NOREAD", [np_]), ("facts", "Build it.", [rt, np_]), ("alt", "Build it. ALTERNATE", [rt]),
             ("costly", "Only look. NOREAD COSTLY", [np_]))
    (ev / "va" / "cases.json").write_text(json.dumps([{"id": i, "role": "implementer", "fixture": "fx", "task": t} for i, t, _ in cases]))
    (ev / "va" / "reference" / "expectations.json").write_text(json.dumps({i: {"facts": fs} for i, _, fs in cases}))
    before, _ = scratch_kit(f, kit)
    f.env = {"PATH": f"{sc / 'bin'}:{os.environ.get('PATH', '')}", "OCTO_FEATHER_QC_PATH": str(sc / "bin"),
             "OCTO_FEATHER_QA_DIR": str(sc / "out"), "XDG_STATE_HOME": str(sc / "state")}
    # The scratch state dir holds the commit identity the eval's role launch needs (pi-role --help, Commit identity).
    subprocess.run([f"{f.s.repo}/scripts/pi-role", "--set-identity", "Verify Identity", "verify@octo-feather.invalid"],
                   env=case_env({"XDG_STATE_HOME": str(sc / "state")}), capture_output=True, check=True)
    qa = str(kit / "scripts" / "octo-feather-qa")
    want = ("qa: analysis (deterministic, no model; rules: octo-feather-qa --help, --analyze):\n"
            "  non-discriminating case va/same: every run on both kits passed\n"
            "  non-discriminating fact va/facts: skill_not_read pull: pass in every run on both kits\n"
            "  high variance va/alt: current kit pass rate 0.50 +/- 0.71\n"
            "  cost tradeoff va/costly: pass rate 1.00 on both kits; tokens mean 115.0 to 460.0\n")
    f.run("compare", qa, "--evals", str(ev), "--runs", "2", "--baseline", before)
    runs = sorted((sc / "out").iterdir()) if (sc / "out").is_dir() else []
    run_dir = runs[-1] if runs else sc / "none"
    f.obs("compare", "analysis", json.dumps(json.loads((run_dir / "summary.json").read_text())["analysis"]) + "\n"
          if (run_dir / "summary.json").is_file() else "{}\n")

    def flagged(c: Case) -> bool:
        a = json.loads(c.o["analysis"])
        return (c.code == 1 and want in c.out and [x["case"] for x in a.get("non_discriminating_cases", [])] == ["va/same"]
                and [(x["case"], x["fact"]) for x in a.get("non_discriminating_facts", [])] == [("va/facts", np_)]
                and [(x["case"], x["kit"]) for x in a.get("high_variance", [])] == [("va/alt", "current")]
                and [x["case"] for x in a.get("cost_tradeoffs", [])] == ["va/costly"])
    f.check("compare", flagged)
    f.env = {**f.env, "PATH": f"{sc / 'poison'}:{os.environ.get('PATH', '')}"}
    f.run("rerun", qa, "--analyze", str(run_dir))
    f.obs("rerun", "poison", "ran\n" if (sc / "poison" / "ran").exists() else "none\n")
    f.check("rerun", lambda c: c.code == 0 and c.out.endswith(want) and c.o["poison"] == "none\n" and "qc sandbox" not in c.out + c.err)
    f.env = {}
    say(f"qa-analyst evidence: {f.d}")


def drive_qa_review(f: Feature) -> None:
    """octo-feather-qa on a scratch review case (role implementer), the role's model the stub `pi` (QA_STUB_PI), never a
    real model: awaiting review with its output, --review showing it, a verdict and note recorded, then a next run
    showing them beside its new output; cases and what each observes: features/qa-review.md."""
    sc = RUN_DIR / "scratch" / "qa-review"
    ev = sc / "evals"
    shutil.rmtree(sc, ignore_errors=True)
    (ev / "vr" / "reference").mkdir(parents=True)
    (ev / "fixtures" / "fx").mkdir(parents=True)
    for d in ("bin", "state"):
        (sc / d).mkdir()
    (sc / "bin" / "pi").write_text(QA_STUB_PI)
    (sc / "bin" / "pi").chmod(0o755)
    (ev / "fixtures" / "fx" / "README.md").write_text("qa-review drive fixture\n")
    (ev / "vr" / "suite.json").write_text(json.dumps({"suite": "vr", "kind": "role-transcript", "description": "qa-review drive",
                                                     "max_tool_calls": 10, "timeout_s": 60}))
    (ev / "vr" / "reference" / "expectations.json").write_text(json.dumps({"essay": {"facts": []}}))

    def essay(say: str) -> None:
        (ev / "vr" / "cases.json").write_text(json.dumps([{"id": "essay", "role": "implementer", "fixture": "fx",
                                                           "task": f"Write the notes. NOREAD SAY: {say}",
                                                           "review": {"question": "Do the notes answer the brief?"}}]))
    essay("The notes say hi.")
    f.env = {"PATH": f"{sc / 'bin'}:{os.environ.get('PATH', '')}", "OCTO_FEATHER_QC_PATH": str(sc / "bin"),
             "OCTO_FEATHER_QA_DIR": str(sc / "out"), "XDG_STATE_HOME": str(sc / "state")}
    # The scratch state dir holds the commit identity the eval's role launch needs (pi-role --help, Commit identity).
    subprocess.run([f"{f.s.repo}/scripts/pi-role", "--set-identity", "Verify Identity", "verify@octo-feather.invalid"],
                   env=case_env({"XDG_STATE_HOME": str(sc / "state")}), capture_output=True, check=True)
    f.run("run", "octo-feather-qa", "--evals", str(ev))
    runs = sorted(p for p in (sc / "out").iterdir() if p.name != "reviews") if (sc / "out").is_dir() else []
    first = runs[-1] if runs else sc / "none"
    f.check("run", lambda c: c.code == 1 and re.search(r"(?m)^REVIEW vr/essay: awaiting review: Do the notes answer the brief\?; "
                                                       r"changed files: notes\.md \[", c.out) is not None
            and "\n  output: final message: The notes say hi.\n" in c.out and "\n  latest review: none\n" in c.out)
    f.run("awaiting", "octo-feather-qa", "--review", str(first), "vr/essay")
    f.check("awaiting", lambda c: c.code == 0 and c.out.startswith(f"REVIEW vr/essay: awaiting review (run {first.name})\n"))
    f.run("record", "octo-feather-qa", "--review", str(first), "vr/essay", "pass", "Clear and short.")
    shown = rf"pass \(run {first.name}, kit [0-9a-f]{{12}}, \S+Z\): Clear and short\."
    f.check("record", lambda c: c.code == 0 and re.match(rf"REVIEWED vr/essay: {shown}\n", c.out) is not None)
    essay("The notes say hello.")
    f.run("next-run", "octo-feather-qa", "--evals", str(ev))
    f.check("next-run", lambda c: c.code == 1 and "\n  output: final message: The notes say hello.\n" in c.out
            and re.search(rf"(?m)^  latest review: {shown}$", c.out) is not None)
    f.env = {}
    say(f"qa-review evidence: {f.d}")


def drive_qa_history(f: Feature) -> None:
    """octo-feather-qa on a scratch suite whose one case's fixture is the kit's own history at the checkout's HEAD commit
    (a history fixture), the role's model the stub `pi` (QA_STUB_PI) reporting what the case repo holds, never a real
    model; then check-evals refusing an unknown commit; cases and what each observes: features/qa-history.md."""
    sc = RUN_DIR / "scratch" / "qa-history"
    ev = sc / "evals"
    shutil.rmtree(sc, ignore_errors=True)
    (ev / "vh" / "reference").mkdir(parents=True)
    (ev / "fixtures").mkdir(parents=True)
    for d in ("bin", "state"):
        (sc / d).mkdir()
    (sc / "bin" / "pi").write_text(QA_STUB_PI)
    (sc / "bin" / "pi").chmod(0o755)
    at = output(["git", "-C", f.s.repo, "rev-parse", "HEAD"])[1].strip()
    files = len(output(["git", "-C", f.s.repo, "ls-tree", "-r", "--name-only", at])[1].splitlines())
    (ev / "vh" / "suite.json").write_text(json.dumps({"suite": "vh", "kind": "role-transcript", "description": "qa-history drive",
                                                     "max_tool_calls": 10, "timeout_s": 120}))
    (ev / "vh" / "reference" / "expectations.json").write_text(json.dumps({"tree": {"facts": [{"fact": "skill_not_read", "skill": "pull"}]}}))

    def case(commit: str) -> None:
        (ev / "vh" / "cases.json").write_text(json.dumps([{"id": "tree", "role": "implementer", "fixture": {"repo": "kit", "commit": commit},
                                                           "task": "Look around. NOREAD TREE"}]))
    case(at)
    f.env = {"PATH": f"{sc / 'bin'}:{os.environ.get('PATH', '')}", "OCTO_FEATHER_QC_PATH": str(sc / "bin"),
             "OCTO_FEATHER_QA_DIR": str(sc / "out"), "XDG_STATE_HOME": str(sc / "state")}
    # The scratch state dir holds the commit identity the eval's role launch needs (pi-role --help, Commit identity).
    subprocess.run([f"{f.s.repo}/scripts/pi-role", "--set-identity", "Verify Identity", "verify@octo-feather.invalid"],
                   env=case_env({"XDG_STATE_HOME": str(sc / "state")}), capture_output=True, check=True)
    f.run("whole-tree", "octo-feather-qa", "--evals", str(ev))
    runs = sorted((sc / "out").iterdir()) if (sc / "out").is_dir() else []
    tr = runs[-1] / "vh" / "tree" / "transcript.jsonl" if runs else sc / "none"
    said = [str(c.get("text", "")) for ln in (tr.read_text().splitlines() if tr.is_file() else [])
            for e in [json.loads(ln)] if e.get("type") == "message_end" for c in e["message"].get("content", []) if c.get("type") == "text"]
    f.obs("whole-tree", "said", (said[-1] if said else "") + "\n")
    f.obs("whole-tree", "want", f"files={files} commits=1 deep=ok\n")
    f.check("whole-tree", lambda c: c.code == 0 and re.search(r"(?m)^PASS vh/tree: ", c.out) is not None and c.o["said"] == c.o["want"])
    case("0" * 40)
    f.run("unknown-commit", "check-evals", str(ev))
    f.check("unknown-commit", lambda c: c.code == 1 and f"vh/cases.json case tree: field fixture.commit: no commit {'0' * 40} in" in c.out + c.err)
    f.env = {}
    say(f"qa-history evidence: {f.d}")


def drive_qc_fallback(f: Feature) -> None:
    """`just qc` on a scratch target whose qc.toml declares a demo for acceptance-a and none for acceptance-b: acceptance-a
    decided by its demo's checks, acceptance-b by the agent fallback, a fresh qc judge (the kit's stub judge,
    tests/fixtures/qc-judge/pi, as pi: SKILL.md) under the time cap, its report read back as acceptance-b's record."""
    v = f.s.contract.values
    if "qc_demo_pass" not in v:
        die("qc.toml [values] needs qc_demo_pass: the qc-fallback drive's scratch demo")
    sc = RUN_DIR / "scratch" / "qc-fallback"
    r = sc / "repo"
    shutil.rmtree(sc, ignore_errors=True)
    (r / "docs" / "specs").mkdir(parents=True)
    (sc / "state").mkdir()

    def git(*args: str) -> str:
        return subprocess.run(["git", "-C", str(r), *args], check=True, capture_output=True, text=True).stdout.strip()

    git("init", "-q", "-b", "main")
    for k, val in (("user.name", "verify-octo-feather"), ("user.email", "verify@octo-feather.invalid"), ("core.hooksPath", "/dev/null")):
        git("config", k, val)   # qc commits the status file in this repo
    git("commit", "-q", "--allow-empty", "-m", "accepted")
    shutil.copy(f"{f.s.repo}/tests/fixtures/spec-status/good/demo.spec.html", r / "docs" / "specs")
    git("add", "-A")
    git("commit", "-q", "-m", "spec")
    init = subprocess.run([f.s.kit, "octo-feather-spec-status", "init", str(r / "docs" / "specs" / "demo.spec.html"), git("rev-parse", "--short", "HEAD")],
                          capture_output=True, text=True, check=False)
    if init.returncode:
        die(f"qc-fallback: scratch status file not made: {init.stderr.strip()}")
    (r / "qc.toml").write_text('format = 1\n[entry]\ncommand = "true"\n[services]\n[fixture]\n[values]\n'
                               f'[demo."demo#acceptance-a"]\ncommand = {json.dumps(v["qc_demo_pass"])}\ncovers = ["docs/specs"]\ntests = ["none"]\n')
    git("add", "-A")
    git("commit", "-q", "-m", "contract: a demo for acceptance-a, none for acceptance-b")
    head = git("rev-parse", "HEAD")
    # Scratch box state (qc's reports, the scratch target's evidence store); the kit's stub judge first on the sandbox's
    # PATH (OCTO_FEATHER_QC_PATH: a plain PATH entry loses to the Pi a mise-shimmed `just` puts ahead of it, #261).
    f.env = {"XDG_STATE_HOME": str(sc / "state"), "OCTO_FEATHER_QC_PATH": f"{f.s.repo}/tests/fixtures/qc-judge"}
    f.pre = ["env", "-C", str(r)]   # just qc runs where the supervisor stands: the target's worktree
    f.run("qc", "just", "--justfile", f"{f.s.repo}/justfile", "qc", "docs/specs/demo.status.json", "7", "acceptance-a", "acceptance-b")
    f.pre = []
    f.obs("qc", "report", json.dumps(qc_report(f, "qc")))
    f.obs("qc", "store", output([f.s.kit, "octo-feather-evidence", "read", "--repo", str(r), "--criterion", "demo#acceptance-b", "--commit", head, "--json"],
                                env=case_env(f.env))[1])
    st = json.loads(git("show", "HEAD:docs/specs/demo.status.json"))["criteria"]
    f.obs("qc", "built", f"{st['acceptance-a']['status']} {st['acceptance-b']['status']}\n")
    rid = r"([0-9]{8}T[0-9]{6}Z-[0-9a-f]{8})"

    def holds(c: Case) -> bool:
        a = re.search(r"(?m)^PASS acceptance-a: \$ .*\n  demo exit status 0\n  evidence complete; decision demo checks; record " + rid + "$", c.out)
        b = re.search(r"(?m)^PASS acceptance-b: \$ judge acceptance-b\n  why acceptance-b\n  evidence complete; decision agent fallback; record " + rid + "$", c.out)
        rep = json.loads(c.o["report"])
        run = rep.get("fallback", {}).get("acceptance-b", {})
        brief = [ln for ln in run.get("stdout", "").splitlines() if ln.startswith("BRIEF ")]
        rec = [x for x in json.loads(c.o["store"]) if b and x["record"]["id"] == b.group(1)]
        if c.code != 0 or not a or not rec or sorted(rep.get("fallback", {})) != ["acceptance-b"] or c.o["built"] != "built built\n":
            return False
        stored = json.loads(Path(rec[0]["dir"], "outputs", "judge.report.json").read_text())
        cap = rep.get("cap_s")   # the fixed cap qc states (its FALLBACK_CAP_S): the judge's parent is timeout at it
        return (isinstance(cap, int) and cap > 0 and f"qc: agent fallback demo#acceptance-b: a fresh qc judge, time cap {cap} s" in c.err
                and run.get("stdout", "").startswith(f"PARENT timeout --foreground -k 10 {cap} ") and len(brief) == 1
                and brief[0].startswith("BRIEF - acceptance-b: ") and rec[0]["record"]["revision"] == head
                and stored["criteria"] == [{"id": "acceptance-b", "verdict": "pass", "command": "judge acceptance-b",
                                            "output": "out acceptance-b", "why": "why acceptance-b"}])
    f.check("qc", holds)
    f.run("read", "octo-feather-evidence", "read", "--repo", str(r), "--criterion", "demo#acceptance-b", "--commit", head)
    f.check("read", lambda c: c.code == 0 and "1 record(s)" in c.out and "judge.report.json (" in c.out)
    f.env = {}
    say(f"qc-fallback evidence: {f.d}")


TAGGED = {   # the one-execution drives' scratch tests: acceptance-a's passes, acceptance-b's skips (exit 77), one untagged
    "accept.sh": '# criterion: demo#acceptance-a\necho "RAN-accept: acceptance-a prints ok"\n',
    "skip.sh": '# criterion: demo#acceptance-b\necho "skip: needs a GPU, none here" >&2; exit 77\n',
    "plain.sh": 'echo "plain ran"\n',
}


def drive_tagged(f: Feature, feature: str, anchor: str, *, two: bool = False) -> None:
    """One execution for suite and QC on a scratch target whose gate is the kit's runner (tests/gate/ copied unchanged):
    its full gate told the claim (OCTO_FEATHER_QC_CLAIMS=demo#ANCHOR) runs the tagged test once in the qc sandbox and
    stores one record naming the case and its outcome; `just qc` then judges ANCHOR from that record, rerunning nothing.
    TWO: a second spec too, other (the demo spec, anchors acceptance-c and acceptance-d), acceptance-c tagged on
    tests/other.sh: the one gate claims both specs' criteria, and one `just qc` names both status files and both ids,
    each judged from the gate's record, both status files changed in one status-only commit (issue-lifecycle #qc-interim)."""
    kit = f.s.repo
    sc = RUN_DIR / "scratch" / feature
    r = sc / "repo"
    shutil.rmtree(sc, ignore_errors=True)
    (r / "docs" / "specs").mkdir(parents=True)
    (r / "tests" / "gate").mkdir(parents=True)
    (sc / "state").mkdir()

    def git(*args: str) -> str:
        return subprocess.run(["git", "-C", str(r), *args], check=True, capture_output=True, text=True).stdout.strip()

    git("init", "-q", "-b", "main")
    for k, val in (("user.name", "verify-octo-feather"), ("user.email", "verify@octo-feather.invalid"), ("core.hooksPath", "/dev/null")):
        git("config", k, val)
    git("commit", "-q", "--allow-empty", "-m", "accepted")
    shutil.copy(f"{kit}/tests/fixtures/spec-status/good/demo.spec.html", r / "docs" / "specs")
    for g in ("conftest.py", "test_gate.py"):
        shutil.copy(f"{kit}/tests/gate/{g}", r / "tests" / "gate")
    (r / ".gitignore").write_text(".pytest_cache/\n__pycache__/\n")
    (r / "pytest.ini").write_text("[pytest]\ntestpaths = tests/gate\naddopts = --strict-markers --junitxml=.pytest_cache/junit.xml\n")
    (r / "qc.toml").write_text('format = 1\n[entry]\ncommand = "true"\n[services]\n[fixture]\n[values]\n')
    (r / "justfile").write_text('export GATE_RECIPES := "check-ok"\nexport OCTO_FEATHER_CHECK_RUN := `check-gate-free --run`\n'
                                "check: check-tests\ncheck-ok:\n    @true\ncheck-tests *args:\n"
                                f'    uv run --project {shlex.quote(kit)} --locked --offline --no-sync pytest -n 2 "$@"\n')
    for name, body in TAGGED.items():
        (r / "tests" / name).write_text("#!/usr/bin/env bash\n" + body)
        (r / "tests" / name).chmod(0o755)
    if two:
        demo = (r / "docs" / "specs" / "demo.spec.html").read_text()
        (r / "docs" / "specs" / "other.spec.html").write_text(demo.replace("acceptance-a", "acceptance-c").replace("acceptance-b", "acceptance-d"))
        (r / "tests" / "other.sh").write_text('#!/usr/bin/env bash\n# criterion: other#acceptance-c\necho "RAN-accept: acceptance-c prints ok"\n')
        (r / "tests" / "other.sh").chmod(0o755)
    git("add", "-A")
    git("commit", "-q", "-m", "target: tagged tests")
    for stem in ("demo", "other") if two else ("demo",):
        init = subprocess.run([f.s.kit, "octo-feather-spec-status", "init", str(r / "docs" / "specs" / f"{stem}.spec.html"),
                               git("rev-parse", "--short", "HEAD")], capture_output=True, text=True, check=False)
        if init.returncode:
            die(f"{feature}: scratch status file not made: {init.stderr.strip()}")
    git("add", "-A")
    git("commit", "-q", "-m", "status")
    head = git("rev-parse", "HEAD")
    test, outcome = ("tests/accept.sh", "passed") if anchor == "acceptance-a" else ("tests/skip.sh", "skipped")
    crits = [("demo", anchor, test, outcome)] + ([("other", "acceptance-c", "tests/other.sh", "passed")] if two else [])
    f.env = {"XDG_STATE_HOME": str(sc / "state"), "OCTO_FEATHER_QC_PATH": classify_stub(f, sc)}

    def store(name: str) -> None:
        f.obs(name, "store", output([f.s.kit, "octo-feather-evidence", "read", "--repo", str(r), "--commit", head, "--json"],
                                    env=case_env(f.env))[1])

    def captured(c: Case) -> list[dict[str, Any]]:
        return [x for x in json.loads(c.o["store"]) if "test.capture.json" in x["record"]["outputs"]]

    rid = r"([0-9]{8}T[0-9]{6}Z-[0-9a-f]{8})"
    # The final full gate, told the lane's claims: one record each, the case and its outcome named; each test ran once.
    f.pre = ["env", "-C", str(r), f"OCTO_FEATHER_QC_CLAIMS={' '.join(f'{s}#{a}' for s, a, _, _ in crits)}"]
    f.run("gate", "just", "check")
    store("gate")

    def gate_holds(c: Case) -> bool:
        recs = {x["record"]["id"]: x for x in captured(c)}
        if c.code != 0 or len(recs) != len(crits):
            return False
        for s, a, t, o in crits:
            m = re.search(rf"(?m)^qc capture: {s}#{a}: record {rid}, 1 case\(s\): {t} {o}$", c.out)
            if not m or m.group(1) not in recs:
                return False
            out = Path(recs[m.group(1)]["dir"], "outputs")
            [case] = json.loads((out / "test.capture.json").read_text())["cases"]
            ran = (out / "test.output").read_text().count("RAN-accept")
            if (case["test"], case["outcome"]) != (t, o) or not case["sandbox"]["proof"] or ran != (o == "passed"):
                return False
        return True
    f.check("gate", gate_holds)
    gate_rec = {x["record"]["criterion"]["id"]: x["record"]["id"] for x in json.loads((f.d / "gate.obs.store").read_text())}
    # One just qc at that head naming every status file: judged from the gate's records, no demo, no judge, no new record.
    f.pre = ["env", "-C", str(r)]
    f.run("qc", "just", "--justfile", f"{kit}/justfile", "qc", *(f"docs/specs/{s}.status.json" for s, _, _, _ in crits), "7",
          *(a for _, a, _, _ in crits))
    f.pre = []
    text = (f.d / "qc.stdout").read_text() + (f.d / "qc.stderr").read_text()
    f.obs("qc", "report", json.dumps([json.loads(Path(p).read_text()) for p in re.findall(r"\breport (/\S+?\.json)\b", text)
                                      if Path(p).is_file()]))
    store("qc")
    f.obs("qc", "status", json.dumps({s: json.loads(git("show", f"HEAD:docs/specs/{s}.status.json"))["criteria"][a] for s, a, _, _ in crits}))
    f.obs("qc", "commit", json.dumps({"after": int(git("rev-list", "--count", f"{head}..HEAD")),
                                      "changed": sorted(git("diff", "--name-only", head, "HEAD").splitlines())}))

    def want(a: str, t: str, o: str) -> str:
        return (rf"(?m)^PASS {a}: \$ .*\n  1/1 tagged cases passed in the gate's run at {head[:12]}, not rerun\n"
                rf"  evidence complete; decision tagged test assertions; record {rid}$" if o == "passed" else
                rf"(?m)^INSUFFICIENT EVIDENCE {a}: \$ .*\n  missing: case {t} \(.*\) skipped: skip: needs a GPU, none here\n"
                rf"  evidence incomplete; decision tagged test assertions; record {rid}$")

    def qc_holds(c: Case) -> bool:
        reps = json.loads(c.o["report"])
        now_recs = {x["record"]["criterion"]["id"]: x["record"]["id"] for x in json.loads(c.o["store"])}
        rows = json.loads(c.o["status"])
        ms = {f"{s}#{a}": re.search(want(a, t, o), c.out) for s, a, t, o in crits}
        built = sorted(f"docs/specs/{s}.status.json" for s, _, _, o in crits if o == "passed")
        return (c.code == (0 if outcome == "passed" else 2) and all(ms.values()) and gate_rec == now_recs
                and all(m.group(1) == gate_rec[k] for k, m in ms.items() if m)
                and sorted(rep.get("spec") for rep in reps) == sorted(s for s, _, _, _ in crits)
                and all(rep.get("captures") == [] and "fallback" not in rep for rep in reps) and "agent fallback" not in c.err
                and json.loads(c.o["commit"]) == {"after": int(bool(built)), "changed": built}   # one status-only commit, if any
                and rows == {s: ({"status": "built", "pr": 7, "record": gate_rec[f"{s}#{a}"], "commit": head, "tests": [t]}
                                 if o == "passed" else {"status": "planned", "pr": None}) for s, a, t, o in crits})
    f.check("qc", qc_holds)
    f.env = {}
    say(f"{feature} evidence: {f.d}")


def drive_one_execution(f: Feature) -> None:
    drive_tagged(f, "one-execution", "acceptance-a", two=True)


def drive_one_execution_incomplete(f: Feature) -> None:
    drive_tagged(f, "one-execution-incomplete", "acceptance-b")


def drive_qc_stale(f: Feature) -> None:
    """`just qc` builds two criteria of a scratch target whose qc.toml declares a passing demo for each, covering its own
    code path and naming its own test: each built entry names its record, the commit it was captured at and its tests.
    A later commit changes acceptance-a's covered path, another an unrelated file; `octo-feather-spec-status show` then
    shows acceptance-a stale, naming its capture commit and that commit, and acceptance-b current."""
    v = f.s.contract.values
    if "qc_demo_pass" not in v:
        die("qc.toml [values] needs qc_demo_pass: the qc-stale drive's scratch demos")
    sc = RUN_DIR / "scratch" / "qc-stale"
    r = sc / "repo"
    shutil.rmtree(sc, ignore_errors=True)
    for d in ("docs/specs", "src", "tests"):
        (r / d).mkdir(parents=True)
    (sc / "state").mkdir()

    def git(*args: str) -> str:
        return subprocess.run(["git", "-C", str(r), *args], check=True, capture_output=True, text=True).stdout.strip()

    git("init", "-q", "-b", "main")
    for k, val in (("user.name", "verify-octo-feather"), ("user.email", "verify@octo-feather.invalid"), ("core.hooksPath", "/dev/null")):
        git("config", k, val)   # qc commits the status file in this repo; the drive commits the later changes
    git("commit", "-q", "--allow-empty", "-m", "accepted")
    shutil.copy(f"{f.s.repo}/tests/fixtures/spec-status/good/demo.spec.html", r / "docs" / "specs")
    for p in ("src/a", "src/b", "tests/a.sh", "tests/b.sh", "README"):
        (r / p).write_text(f"{p} v1\n")
    git("add", "-A")
    git("commit", "-q", "-m", "spec and code")
    init = subprocess.run([f.s.kit, "octo-feather-spec-status", "init", str(r / "docs" / "specs" / "demo.spec.html"), git("rev-parse", "--short", "HEAD")],
                          capture_output=True, text=True, check=False)
    if init.returncode:
        die(f"qc-stale: scratch status file not made: {init.stderr.strip()}")
    (r / "qc.toml").write_text('format = 1\n[entry]\ncommand = "true"\n[services]\n[fixture]\n[values]\n' + "".join(
        f'[demo."demo#acceptance-{x}"]\ncommand = {json.dumps(v["qc_demo_pass"])}\ncovers = ["src/{x}"]\ntests = ["tests/{x}.sh"]\n'
        for x in ("a", "b")))
    git("add", "-A")
    git("commit", "-q", "-m", "contract: a demo each, covering its own code path")
    head = git("rev-parse", "HEAD")
    f.env = {"XDG_STATE_HOME": str(sc / "state"), "OCTO_FEATHER_QC_PATH": classify_stub(f, sc)}   # qc's reports, the scratch target's evidence store; no real classifier
    f.pre = ["env", "-C", str(r)]   # just qc and the status view run where the owner or supervisor stands: the target
    f.run("qc", "just", "--justfile", f"{f.s.repo}/justfile", "qc", "docs/specs/demo.status.json", "7", "acceptance-a", "acceptance-b")
    f.obs("qc", "status", git("show", "HEAD:docs/specs/demo.status.json"))
    rid = r"([0-9]{8}T[0-9]{6}Z-[0-9a-f]{8})"

    def linked(c: Case) -> bool:
        recs = {a: m.group(1) for a in ("acceptance-a", "acceptance-b") if (m := re.search(
            rf"(?m)^PASS {a}: \$ .*\n  demo exit status 0\n  evidence complete; decision demo checks; record {rid}$", c.out))}
        st = json.loads(c.o["status"])["criteria"]
        return c.code == 0 and len(recs) == 2 and all(
            st[a] == {"status": "built", "pr": 7, "record": recs[a], "commit": head, "tests": [f"tests/{a[-1]}.sh"]} for a in recs)
    f.check("qc", linked)
    (r / "README").write_text("README v2\n")
    git("commit", "-q", "-am", "unrelated change")
    (r / "src" / "a").write_text("src/a v2\n")
    git("commit", "-q", "-am", "change a's code")
    change = git("rev-parse", "--short=12", "HEAD")
    f.run("show", "octo-feather-spec-status", "show")
    f.pre = []
    f.check("show", lambda c: c.code == 0 and re.search(
        rf"(?m)^  acceptance-a: built \(PR #7\), STALE: record {rid} captured at {head[:12]}; covered path src/a changed "
        rf"since {head[:12]} by {change} change a's code$", c.out) is not None and re.search(
        rf"(?m)^  acceptance-b: built \(PR #7\), current: record {rid} captured at {head[:12]}, tests tests/b.sh, covers src/b$",
        c.out) is not None and "2 built: 1 current, 1 stale, 0 no evidence link" in c.out)
    f.env = {}
    say(f"qc-stale evidence: {f.d}")


RUNNER = "tests/gate/test_gate.py::test_script"   # the gate runner's tests/*.sh items, the gate-tiers kit copy's map


def kit_copy(f: Feature, k: Path) -> None:
    """K a copy of the kit's tracked files without its tests/*.sh and without every pytest test module but the gate's
    runner (RUNNER's file): its gate items are the static checks and the tests/*.sh a drive writes."""
    k.mkdir()
    files = subprocess.run(["git", "-C", f.s.repo, "ls-files", "-z"], check=True, capture_output=True).stdout
    for rel in filter(None, files.decode().split("\0")):
        src = Path(f.s.repo) / rel
        test_module = re.fullmatch(r"tests/(.*/)?(test_[^/]*|[^/]*_test)\.py", rel) is not None   # pytest's python_files
        if src.is_file() and not re.fullmatch(r"tests/[^/]*\.sh", rel) and (not test_module or rel == RUNNER.partition("::")[0]):
            (k / rel).parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(src, k / rel)


def drive_gate_tiers(f: Feature) -> None:
    """The gate's two tiers. octo-feather-integrate on a scratch lane: the pilot runs the full gate and records the pass,
    a listed rename runs the full gate and a red one rolls back naming the file, an unlisted change runs only the fast
    tier and is provisional. just fast in a scratch copy of the kit with a small coverage map: a one-script change runs
    the static check and only the item whose coverage reaches the script, each named, the e2e item named skipped."""
    sc = RUN_DIR / "scratch" / "gate-tiers"
    r, lane = sc / "repo", sc / "lane"
    shutil.rmtree(sc, ignore_errors=True)
    r.mkdir(parents=True)
    (sc / "state").mkdir()
    ident = {"GIT_AUTHOR_NAME": "verify-octo-feather", "GIT_AUTHOR_EMAIL": "verify@octo-feather.invalid",
             "GIT_COMMITTER_NAME": "verify-octo-feather", "GIT_COMMITTER_EMAIL": "verify@octo-feather.invalid"}

    def git(at: Path, *args: str) -> str:
        return subprocess.run(["git", "-C", str(at), "-c", "core.hooksPath=/dev/null", *args], check=True, capture_output=True,
                              text=True, env=case_env(ident)).stdout.strip()

    # The scratch target: its full gate reds on machinery/b, its fast tier never reds; its list names machinery/.
    git(r, "init", "-q", "-b", "main")
    (r / "justfile").write_text("check:\n    @echo gate=full\n    test ! -e machinery/b\nfast:\n    @echo gate=fast\n")
    (r / "shared-machinery.txt").write_text("machinery\n")
    (r / "machinery").mkdir()
    (r / "machinery" / "a").write_text("a\n")
    (r / "f").write_text("f\n")
    git(r, "add", "-A")
    git(r, "commit", "-q", "-m", "base")
    git(r, "worktree", "add", "-q", "-b", "gh503", str(lane))

    def worker(name: str, change: Callable[[Path], object]) -> None:
        w = sc / name
        git(r, "worktree", "add", "-q", "-b", name, str(w), "gh503")
        change(w)
        git(w, "add", "-A")
        git(w, "commit", "-q", "-m", name)

    def passed(name: str) -> None:
        f.obs(name, "head", git(lane, "rev-parse", "HEAD") + "\n")
        code, text = output([f.s.kit, "octo-feather-gate", "passed"], cwd=lane)
        f.obs(name, "passed", f"exit {code}\n{text}")

    def integrate(name: str, branch: str) -> None:
        f.run(name, "env", "-C", str(r), "octo-feather-integrate", "503", branch)
        passed(name)

    f.env = {**ident, "XDG_STATE_HOME": str(sc / "state")}
    worker("w-pilot", lambda w: (w / "one").write_text("1\n"))
    integrate("pilot", "w-pilot")
    f.check("pilot", lambda c: c.code == 0 and "tier: full (pilot: no full pass recorded on gh503)" in c.out
            and "gate=full" in c.out and "gate=fast" not in c.out and c.o["passed"].startswith("exit 0\n")
            and json.loads(c.o["passed"].split("\n", 1)[1])["head"] == c.o["head"].strip()
            and json.loads(c.o["passed"].split("\n", 1)[1])["clean"] is True)
    before = git(lane, "rev-parse", "HEAD")
    worker("w-rename", lambda w: git(w, "mv", "machinery/a", "machinery/b"))
    integrate("checkpoint", "w-rename")
    f.check("checkpoint", lambda c: c.code == 2 and c.o["head"].strip() == before and "gate=full" in c.out
            and "listed path (shared-machinery.txt): R100 machinery/a -> machinery/b" in c.out
            and "red: just check, the full tier" in c.err and "machinery/a -> machinery/b" in c.err)
    worker("w-plain", lambda w: (w / "two").write_text("2\n"))
    integrate("fast", "w-plain")
    f.check("fast", lambda c: c.code == 0 and "tier: fast (no path on shared-machinery.txt touched" in c.out
            and "gate=fast" in c.out and "gate=full" not in c.out and "provisional: head" in c.out
            and c.o["passed"].startswith("exit 1\n"))

    # just fast in a scratch copy of the kit's tracked files without its tests/*.sh and without every pytest test
    # module but the gate's runner (tests/gate/test_gate.py), holding four items: a and b each run their own Python
    # script, c (`# gate: e2e`) runs a's, d runs a bash script coverage cannot see. So the copy's gate items are the
    # static checks and these, however many kit tests the kit grows. The static checks cut to one with just's own
    # override (--set GATE_RECIPES), the map built from the runner's test items (its node id, RUNNER). The kit's synced
    # venv serves the copy by its real path (UV_PROJECT_ENVIRONMENT; the uv cache may be masked, as in the qc sandbox):
    # through a link, the copy's uv sync would write the scratch path into the venv's scripts, broken once cleanup
    # removes it (#1193). Each item appends its name to FAST_RAN, the record of what ran.
    k = sc / "kit"
    kit_copy(f, k)
    for n in ("a", "b"):
        (k / "scripts" / f"fixture-{n}").write_text(f'#!/usr/bin/env python3\nprint("{n} ran")\n')
    (k / "scripts" / "fixture-d").write_text("#!/usr/bin/env bash\necho d ran\n")
    for n, script, tag in (("a", "a", ""), ("b", "b", ""), ("c", "a", "# gate: e2e\n"), ("d", "d", "")):
        (k / "tests" / f"{n}.sh").write_text(f'#!/usr/bin/env bash\n{tag}set -euo pipefail\necho {n} >> "$FAST_RAN"\n'
                                              f'"$(dirname "$0")/../scripts/fixture-{script}"\n')
    for x in [*(k / "scripts").glob("fixture-*"), *(k / "tests").glob("*.sh")]:
        x.chmod(0o755)
    git(k, "init", "-q", "-b", "main")
    git(k, "add", "-A")
    git(k, "commit", "-q", "-m", "kit copy")
    ran = sc / "ran"
    f.env = {"XDG_STATE_HOME": str(sc / "state"), "FAST_RAN": str(ran),
             "UV_PROJECT_ENVIRONMENT": os.path.realpath(Path(f.s.repo) / ".venv")}
    f.run("fast-map", "env", "-C", str(k), "just", "fast-map", RUNNER)
    f.check("fast-map", lambda c: c.code == 0 and "fast-map: 3 test items mapped at " in c.out)
    with (k / "scripts" / "fixture-a").open("a") as fh:
        fh.write("# one-script change\n")
    ran.write_text("")
    f.run("fast-one-script", "env", "-C", str(k), "just", "--set", "GATE_RECIPES", "check-dashes", "fast")
    f.obs("fast-one-script", "ran", "".join(sorted(ran.read_text().splitlines(keepends=True))))
    f.check("fast-one-script", lambda c: c.code == 0 and c.o["ran"] == "a\nd\n"
            and "fast: check-dashes: static check" in c.err
            and "fast: tests/a.sh: recorded coverage reaches scripts/fixture-a" in c.err
            and "fast: tests/d.sh: no recorded coverage in the map at " in c.err
            and "fast: tests/c.sh: e2e (# gate: e2e): skipped" in c.err
            and "fast: 1 non-e2e test items skipped" in c.err and re.search(r"=+ 3 passed in ", c.out) is not None)
    # The dry run after that change: the same selection named and counted, nothing run.
    ran.write_text("")
    f.run("fast-list", "env", "-C", str(k), "just", "--set", "GATE_RECIPES", "check-dashes", "fast-list")
    f.obs("fast-list", "ran", ran.read_text())
    f.check("fast-list", lambda c: c.code == 0 and c.o["ran"] == ""
            and "fast: tests/a.sh: recorded coverage reaches scripts/fixture-a" in c.out
            and "fast: tests/d.sh: no recorded coverage in the map at " in c.out
            and "fast: selected 3 of 5 gate items (1 static, 2 of 4 test items)" in c.out)
    # A mapping run with a red item, e (runs b's script, then fails): the map is written from the items that passed,
    # e left out; the dry run on the unchanged tree then names e always selected.
    git(k, "checkout", "-q", "scripts/fixture-a")
    (k / "tests" / "e.sh").write_text('#!/usr/bin/env bash\nset -euo pipefail\necho e >> "$FAST_RAN"\n'
                                      '"$(dirname "$0")/../scripts/fixture-b"\nexit 1\n')
    (k / "tests" / "e.sh").chmod(0o755)
    git(k, "add", "-A")
    git(k, "commit", "-q", "-m", "a red item")
    f.run("fast-map-red", "env", "-C", str(k), "just", "fast-map", RUNNER)
    f.check("fast-map-red", lambda c: c.code != 0 and "fast-map: 3 test items mapped at " in c.out
            and "fast-map: tests/e.sh did not pass: left out of the map, always selected" in c.out)
    f.run("fast-list-red", "env", "-C", str(k), "just", "--set", "GATE_RECIPES", "check-dashes", "fast-list")
    f.check("fast-list-red", lambda c: c.code == 0
            and "fast: tests/e.sh: did not pass the mapping run at " in c.out
            and "fast: tests/d.sh: no recorded coverage in the map at " in c.out
            and "fast: selected 3 of 6 gate items (1 static, 2 of 5 test items)" in c.out)
    f.env = {}
    say(f"gate-tiers evidence: {f.d}")


def drive_kit_hook(f: Feature) -> None:
    """The kit's git hook: just setup refused under an agent, run by a maintainer in a scratch kit copy's main
    checkout, refused in its worktree; then an implementer's commit with a red static check refused by the hook's
    just fast, naming the check, the fixed commit through, its one test item run, and a supervisor's red commit
    through with the hook's skip line, no fast tier run."""
    sc = RUN_DIR / "scratch" / "kit-hook"
    shutil.rmtree(sc, ignore_errors=True)
    sc.mkdir(parents=True)
    (sc / "state").mkdir()
    ident = {"GIT_AUTHOR_NAME": "verify-octo-feather", "GIT_AUTHOR_EMAIL": "verify@octo-feather.invalid",
             "GIT_COMMITTER_NAME": "verify-octo-feather", "GIT_COMMITTER_EMAIL": "verify@octo-feather.invalid"}

    def git(at: Path, *args: str) -> str:
        return subprocess.run(["git", "-C", str(at), "-c", "core.hooksPath=/dev/null", *args], check=True, capture_output=True,
                              text=True, env=case_env(ident)).stdout.strip()

    # The copy (kit_copy) with one test item, a.sh: it runs git in a repo of its own and records whether git found
    # that repo, as the kit's own gate items do. Its static checks cut to check-dashes in the copy's justfile: the
    # hook runs a plain just fast, so just's --set cannot reach it. The kit's venv serves it as in drive_gate_tiers.
    k, w, ran = sc / "kit", sc / "wt", sc / "ran"
    kit_copy(f, k)
    jf = k / "justfile"
    jf.write_text(re.sub(r"^export GATE_RECIPES := .*$", 'export GATE_RECIPES := "check-dashes"', jf.read_text(),
                         count=1, flags=re.MULTILINE))
    (k / "tests" / "a.sh").write_text('#!/usr/bin/env bash\nset -euo pipefail\nd="$(mktemp -d)"\ngit -C "$d" init -q\n'
                                      '[[ "$(git -C "$d" rev-parse --absolute-git-dir)" == "$d/.git" ]] && w=own || w=other\n'
                                      'echo "a $w" >> "$FAST_RAN"\n')
    (k / "tests" / "a.sh").chmod(0o755)
    git(k, "init", "-q", "-b", "main")
    git(k, "add", "-A")
    git(k, "commit", "-q", "-m", "kit copy")
    ran.write_text("")
    f.env = {**ident, "XDG_STATE_HOME": str(sc / "state"), "FAST_RAN": str(ran),
             "UV_PROJECT_ENVIRONMENT": os.path.realpath(Path(f.s.repo) / ".venv")}
    refused = "The git hook is for a maintainer's own clone, not factory worktrees; git config unchanged"
    # A drive's env carries no OCTO_FEATHER_ROLE (DRIVER_LEAKS): the maintainer's; each agent case sets one.
    f.run("setup-agent", "env", "-C", str(k), "OCTO_FEATHER_ROLE=implementer", "just", "setup")
    f.obs("setup-agent", "hooks-path", output(["git", "-C", str(k), "config", "--get", "core.hooksPath"])[1])
    f.check("setup-agent", lambda c: c.code != 0 and c.o["hooks-path"] == ""
            and "OCTO_FEATHER_ROLE=implementer is set" in c.err and refused in c.err)
    f.run("setup", "env", "-C", str(k), "just", "setup")
    f.obs("setup", "hooks-path", output(["git", "-C", str(k), "config", "--get", "core.hooksPath"])[1])
    f.check("setup", lambda c: c.code == 0 and c.o["hooks-path"].strip() == ".githooks")
    git(k, "worktree", "add", "-q", "-b", "gh1", str(w))
    f.run("setup-worktree", "env", "-C", str(w), "OCTO_FEATHER_ROLE=implementer", "just", "setup")
    f.obs("setup-worktree", "config", output(["git", "-C", str(k), "config", "--local", "--list"])[1])
    f.check("setup-worktree", lambda c: c.code != 0 and "core.hookspath=.githooks" in c.o["config"].lower()
            and "worktrees besides its main one (1" in c.err and refused in c.err)
    before = git(w, "rev-parse", "HEAD")
    (w / "hook-red.txt").write_text("one \u2014 dash\n")
    git(w, "add", "hook-red.txt")
    f.run("commit-red", "env", "-C", str(w), "OCTO_FEATHER_ROLE=implementer", "git", "commit", "-m", "red")
    f.obs("commit-red", "head", git(w, "rev-parse", "HEAD") + "\n")
    f.obs("commit-red", "ran", ran.read_text())
    f.check("commit-red", lambda c: c.code != 0 and c.o["head"].strip() == before and c.o["ran"] == ""
            and "heavy slot: not needed: fast tier" in c.out + c.err
            and "static checks red: check-dashes" in c.out + c.err and "hook-red.txt:1:one \u2014 dash" in c.out + c.err)
    (w / "hook-red.txt").write_text("one dash, gone\n")
    git(w, "add", "hook-red.txt")
    f.run("commit-green", "env", "-C", str(w), "git", "commit", "-m", "green")
    f.obs("commit-green", "head", git(w, "log", "-1", "--format=%P %s") + "\n")
    f.obs("commit-green", "ran", ran.read_text())
    f.check("commit-green", lambda c: c.code == 0 and c.o["head"] == f"{before} green\n" and c.o["ran"] == "a own\n"
            and "heavy slot: not needed: fast tier" in c.out + c.err)
    (w / "hook-red.txt").write_text("one \u2014 dash, again\n")
    git(w, "add", "hook-red.txt")
    f.run("commit-machine", "env", "-C", str(w), "OCTO_FEATHER_ROLE=supervisor", "git", "commit", "-m", "machine")
    f.obs("commit-machine", "head", git(w, "log", "-1", "--format=%s") + "\n")
    f.obs("commit-machine", "ran", ran.read_text())
    f.check("commit-machine", lambda c: c.code == 0 and c.o["head"] == "machine\n" and c.o["ran"] == "a own\n"
            and "pre-commit: fast tier skipped: OCTO_FEATHER_ROLE=supervisor" in c.out + c.err
            and "heavy slot" not in c.out + c.err)
    f.env = {}
    say(f"kit-hook evidence: {f.d}")


def drive_merge_ask_proof(f: Feature) -> None:
    """A scratch target the kit did not create, only its own `just check`, with lane gh534 and PR #9 read through the
    kit's offline gh (github-pr/scripts/gh, a scratch snapshot). merge-ask on the lane head, a commit with no recorded
    full pass, refuses naming the head and the missing pass; each octo-feather-integrate runs that gate in full, records
    the pass and adds no recipe; merge-ask on the integrated head then passes."""
    sc = RUN_DIR / "scratch" / "merge-ask-proof"
    r, lane, snap = sc / "repo", sc / "lane", sc / "snap"
    shutil.rmtree(sc, ignore_errors=True)
    (r / "docs" / "specs").mkdir(parents=True)
    (snap / "pr").mkdir(parents=True)
    (sc / "state").mkdir()
    ident = {"GIT_AUTHOR_NAME": "verify-octo-feather", "GIT_AUTHOR_EMAIL": "verify@octo-feather.invalid",
             "GIT_COMMITTER_NAME": "verify-octo-feather", "GIT_COMMITTER_EMAIL": "verify@octo-feather.invalid"}

    def git(at: Path, *args: str) -> str:
        return subprocess.run(["git", "-C", str(at), "-c", "core.hooksPath=/dev/null", *args], check=True, capture_output=True,
                              text=True, env=case_env(ident)).stdout.strip()

    git(r, "init", "-q", "-b", "main")
    (r / "justfile").write_text("check:\n    @echo own-gate ran\n")   # its own single gate: no fast recipe
    (r / "docs" / "specs" / "demo.status.json").write_text(
        '{"spec": "demo.spec.html", "accepted_commit": "0123abc", "criteria": {"acceptance-a": {"status": "planned", "pr": null}}}\n')
    (r / "f").write_text("f\n")
    (r / "gate-budget.toml").write_text("budget_seconds = 60\ngrowth_share = 0.25\ntrend_runs = 3\n")   # its gate-time budget
    git(r, "add", "-A")
    git(r, "commit", "-q", "-m", "base")
    git(r, "worktree", "add", "-q", "-b", "gh534", str(lane))
    (lane / "g").write_text("g\n")   # a lane commit no gate ran on
    git(lane, "add", "-A")
    git(lane, "commit", "-q", "-m", "fix: lane change")
    (snap / "meta.json").write_text('{"repo": "o/r", "counts": {}, "capped": []}\n')
    (snap / "fetched_at").write_text("scratch\n")
    url = "https://github.com/o/r/pull/9#issuecomment-1"

    def pr(name: str) -> None:
        """PR #9 at the lane head: a lane building no criterion, the review verdict clear on that head."""
        head = git(lane, "rev-parse", "HEAD")
        commits = [{"oid": c, "messageHeadline": git(lane, "log", "-1", "--format=%s", c), "messageBody": ""}
                   for c in git(lane, "rev-list", "--reverse", "HEAD", "^main").split()]
        verdict = f"<!-- octo-feather-review-verdict -->\n## Code review verdict\n\nHead: {head}\nPR head: {head}\nVerdict: clear\nChecks: none\n\n### Findings\n\nnone\n"
        body = (f"Closes #534\n\n## Merge ask\n\nHead: {head[:12]}\nChecks: check pass\nReview verdict: {url}\n"
                "Built: none\nFailed: none\n")
        (snap / "pr" / "9.json").write_text(json.dumps({
            "number": 9, "baseRefName": "main", "headRefName": "gh534", "headRefOid": head, "body": body, "commits": commits,
            "statusCheckRollup": [{"__typename": "CheckRun", "name": "check", "status": "COMPLETED", "conclusion": "SUCCESS"}],
            "comments": [{"author": {"login": "sup"}, "body": verdict, "url": url}]}))
        f.obs(name, "head", head + "\n")

    def ask(name: str) -> None:
        pr(name)
        f.pre = ["env", "-C", str(lane)]   # merge-ask runs in the lane worktree
        f.run(name, "octo-feather-lane", "merge-ask", "9", "--status", "docs/specs/demo.status.json", "--base", "main")
        f.pre = []

    f.env = {**ident, "XDG_STATE_HOME": str(sc / "state"), "OCTO_FEATHER_GHSNAP": str(snap),
             "PATH": f"{f.s.repo}/.agents/skills/github-pr/scripts:{os.environ.get('PATH', '')}"}
    ask("full-proof-no-pass")
    f.check("full-proof-no-pass", lambda c: c.code == 1 and c.out == "" and (h := c.o["head"].strip()[:12]) != "" and
            f"PR #9 merge ask incomplete (1 item), head {h}:\n  - Full pass: head {h} has no current recorded full gate pass for "
            f"that head and its gate configuration (none recorded on {h} or the lane commits before it): run the full gate" in c.err)
    recipes = output(["just", "--summary"], cwd=r)[1]
    for n in ("1", "2"):
        w = sc / f"w{n}"
        git(r, "worktree", "add", "-q", "-b", f"w{n}", str(w), "gh534")
        (w / f"n{n}").write_text(f"{n}\n")
        git(w, "add", "-A")
        git(w, "commit", "-q", "-m", f"w{n}")
        name = f"brownfield-full-{n}"
        f.run(name, "env", "-C", str(r), "octo-feather-integrate", "534", f"w{n}")
        f.obs(name, "head", git(lane, "rev-parse", "HEAD") + "\n")
        f.obs(name, "passed", "exit {}\n{}".format(*output([f.s.kit, "octo-feather-gate", "passed"], cwd=lane)))
        f.obs(name, "recipes", output(["just", "--summary"], cwd=lane)[1])
        f.check(name, lambda c: c.code == 0 and "no fast recipe in this repo: its one gate is the full tier" in c.out
                and c.out.startswith("tier: full (") and "own-gate ran" in c.out and "tier=full" in c.out and "provisional" not in c.out
                and c.o["passed"].startswith("exit 0\n")
                and json.loads(c.o["passed"].split("\n", 1)[1])["head"] == c.o["head"].strip()
                and c.o["recipes"] == recipes == "check\n")
    ask("full-proof-after-integrate")
    f.check("full-proof-after-integrate", lambda c: c.code == 0 and c.out.startswith("## Merge ask\n")
            and f"Head: {c.o['head'].strip()[:12]}\n" in c.out and "Full pass" not in c.err)
    # The same ask with the final head's full gate recorded over the budget (the trend line the full gate's pytest writes,
    # seeded here: this target's own gate is no pytest), after three passed full runs on main: flagged with the trend and
    # slowest items, and the ask passes exactly as above, the gate time block (its last) aside.
    base, head = git(r, "rev-parse", "main"), git(lane, "rev-parse", "HEAD")
    state = scratch_state(f)   # where merge-ask reads it under this drive's env (in a qc sandbox: its session's dir)
    state.mkdir(parents=True, exist_ok=True)
    (state / "check-runs.jsonl").write_text("".join(json.dumps({
        "start": at, "repo": str(lane), "head": h, "total_s": s, "exit": 0, "tier": "full",
        "steps": [{"name": "tests/e2e.sh", "seconds": s - 10, "result": "ok"}, {"name": "check-lint", "seconds": 4.0, "result": "ok"}]}) + "\n"
        for at, h, s in (("2026-10-01T10:00:00Z", base, 40.0), ("2026-10-02T10:00:00Z", base, 44.0),
                         ("2026-10-03T10:00:00Z", base, 42.0), ("2026-10-04T10:00:00Z", head, 75.5))))
    ask("gate-budget-over")
    f.obs("gate-budget-over", "before", (f.d / "full-proof-after-integrate.stdout").read_text())
    gate_block = re.compile(r"(?s)\nGate time \(.*\Z")   # the merge ask's last block
    f.check("gate-budget-over", lambda c: c.code == 0 and f"\nGate time (the full gate on the final head against gate-budget.toml at {head[:12]}; "
            "the code reviewer judges it, no gate reads it: issue-lifecycle #lanes-checkpoints):\n"
            f"  full gate: 75.5s, head {head[:12]}, started 2026-10-04T10:00:00Z (" in c.out
            and "): OVER BUDGET by 15.5s (budget 60s)\n  growth: +79.8% over the trend's median 42s (the 3 passed full runs before it); "
                "set share 25%: GROWN\n" in c.out
            and f"\n  trend: 40s {base[:12]} 2026-10-01T10:00:00Z, 44s {base[:12]} 2026-10-02T10:00:00Z, 42s {base[:12]} "
                f"2026-10-03T10:00:00Z, 75.5s {head[:12]} 2026-10-04T10:00:00Z (passed full runs, oldest first)\n"
                "  slowest: tests/e2e.sh 65.5s, check-lint 4s\n" in c.out
            and gate_block.sub("", c.out) == gate_block.sub("", c.o["before"]))
    f.env = {}
    say(f"merge-ask-proof evidence: {f.d}")


def drive_pilot_pr(f: Feature) -> None:
    """A lane's pilot recorded on its draft PR, on a scratch target with a bare origin and GitHub faked (the kit's offline
    gh, tests/fixtures/tracker-gh): octo-feather-integrate lands the pilot on lane gh12 (J), the lane pushed, `gh pr
    create --draft`, `just qc` on the pilot's two criteria (a passes, b fails) and its head pushed, `octo-feather-lane
    verdict` for J; the PR then shows qc's status-only commit after J, a built in that PR, and the verdict naming J."""
    v = f.s.contract.values
    if "qc_demo_pass" not in v or "qc_demo_fail" not in v:
        die("qc.toml [values] needs qc_demo_pass and qc_demo_fail: the pilot-pr drive's scratch demos")
    sc = RUN_DIR / "scratch" / "pilot-pr"
    r, lane, pilot, origin = sc / "repo", sc / "lane", sc / "pilot", sc / "origin.git"
    shutil.rmtree(sc, ignore_errors=True)
    (r / "docs" / "specs").mkdir(parents=True)
    (sc / "state").mkdir()
    ident = {"GIT_AUTHOR_NAME": "verify-octo-feather", "GIT_AUTHOR_EMAIL": "verify@octo-feather.invalid",
             "GIT_COMMITTER_NAME": "verify-octo-feather", "GIT_COMMITTER_EMAIL": "verify@octo-feather.invalid"}

    def git(at: Path, *args: str) -> str:
        return subprocess.run(["git", "-C", str(at), "-c", "core.hooksPath=/dev/null", *args], check=True, capture_output=True,
                              text=True, env=case_env(ident)).stdout.strip()

    git(sc, "init", "-q", "--bare", str(origin))
    git(r, "init", "-q", "-b", "main")
    git(r, "remote", "add", "origin", str(origin))
    git(r, "commit", "-q", "--allow-empty", "-m", "accepted")
    shutil.copy(f"{f.s.repo}/tests/fixtures/spec-status/good/demo.spec.html", r / "docs" / "specs")
    git(r, "add", "-A")
    git(r, "commit", "-q", "-m", "spec")
    init = subprocess.run([f.s.kit, "octo-feather-spec-status", "init", str(r / "docs" / "specs" / "demo.spec.html"), git(r, "rev-parse", "--short", "HEAD")],
                          capture_output=True, text=True, check=False)
    if init.returncode:
        die(f"pilot-pr: scratch status file not made: {init.stderr.strip()}")
    (r / "qc.toml").write_text('format = 2\n[entry]\ncommand = "true"\n[services]\n[fixture]\n[values]\n' + "".join(
        f'[demo."demo#{a}"]\ncommand = {json.dumps(cmd)}\ncovers = ["src"]\n'
        for a, cmd in (("acceptance-a", v["qc_demo_pass"]), ("acceptance-b", v["qc_demo_fail"]))))
    (r / "justfile").write_text("check:\n    @echo own-gate ran\n")   # its own single gate
    git(r, "add", "-A")
    git(r, "commit", "-q", "-m", "target: two demos")
    git(r, "push", "-q", "origin", "main")
    git(r, "worktree", "add", "-q", "-b", "gh12", str(lane))
    git(lane, "push", "-q", "-u", "origin", "gh12")
    git(r, "worktree", "add", "-q", "-b", "gh12-pilot", str(pilot), "gh12")
    (pilot / "src").mkdir()
    (pilot / "src" / "app").write_text("pilot\n")
    git(pilot, "add", "-A")
    git(pilot, "commit", "-q", "-m", "feat: pilot")
    (sc / "body").write_text("Closes #12\n\n## Summary\n\npilot\n\n## Validation\n\njust check\n")
    (sc / "report").write_text("Findings: none blocking.\nChecks: none\nVerdict: clear\n")
    f.env = {**ident, "XDG_STATE_HOME": str(sc / "state"), "OCTO_FEATHER_QC_PATH": classify_stub(f, sc),
             "FAKE_GH_STORE": str(sc / "gh.json"), "GH_REPO": "o/r",
             "PATH": f"{f.s.repo}/tests/fixtures/tracker-gh:{os.environ.get('PATH', '')}"}

    f.run("integrate", "env", "-C", str(r), "octo-feather-integrate", "12", "gh12-pilot")
    j = git(lane, "rev-parse", "HEAD")
    f.obs("integrate", "head", j + "\n")
    f.check("integrate", lambda c: c.code == 0 and "own-gate ran" in c.out and c.o["head"].strip() != git(r, "rev-parse", "main"))
    git(lane, "push", "-q")
    f.pre = ["env", "-C", str(lane)]   # the supervisor stands in the lane worktree
    f.run("pr-create", "gh", "pr", "create", "--draft", "--base", "main", "--head", "gh12", "--title", "gh12: pilot",
          "--body-file", str(sc / "body"))
    f.check("pr-create", lambda c: c.code == 0 and re.fullmatch(r"https://github\.com/o/r/pull/\d+\n", c.out) is not None)
    pr = (f.d / "pr-create.stdout").read_text().strip().rsplit("/", 1)[-1]
    f.run("qc", "just", "--justfile", f"{f.s.repo}/justfile", "qc", "docs/specs/demo.status.json", pr, "acceptance-a", "acceptance-b")
    h = git(lane, "rev-parse", "HEAD")
    f.obs("qc", "commit", git(lane, "show", "--format=%H %P%n%s", "--name-only", h) + "\n")
    f.obs("qc", "status", git(lane, "show", f"{h}:docs/specs/demo.status.json"))

    def recorded(c: Case) -> bool:
        st = json.loads(c.o["status"])["criteria"]
        return (c.code == 1 and c.o["commit"].split("\n")[0] == f"{h} {j}" and c.o["commit"].split("\n")[-2] == "docs/specs/demo.status.json"
                and len(c.o["commit"].strip().split("\n")) == 4
                and (st["acceptance-a"]["status"], st["acceptance-a"]["pr"], st["acceptance-b"]["status"]) == ("built", int(pr), "planned"))
    f.check("qc", recorded)
    git(lane, "push", "-q")
    with (sc / "report").open("a") as rep:   # the review's Range, main to J (code-review skill, Report fields)
        rep.write(f"Range: {git(r, 'rev-parse', 'main')}..{j}\n")
    f.run("verdict", "octo-feather-lane", "verdict", pr, j, str(sc / "report"))
    f.check("verdict", lambda c: c.code == 0 and f"(clear, head {j[:12]})" in c.err)
    f.run("pr-view", "gh", "pr", "view", pr, "--json", "isDraft,headRefOid,comments")
    f.pre = []
    f.check("pr-view", lambda c: c.code == 0 and c.j["isDraft"] is True and c.j["headRefOid"] == h and len(c.j["comments"]) == 1
            and f"\nHead: {j}\nPR head: {h}\nVerdict: clear\n" in c.j["comments"][0]["body"])
    f.env = {}
    say(f"pilot-pr: PR #{pr} status commit {h[:12]} (qc: built acceptance-a, judged {j[:12]}); verdict head {j[:12]}, the status commit's parent")
    say(f"pilot-pr evidence: {f.d}")


@dataclass(frozen=True)
class Shows:
    """What a template repo's runner prints: a test of each kind (the second module's, the CLI's, the e2e one), the
    static checks on stdout (static[0] first), their commands echoed on stderr, and the fast tier's choice line."""

    other: str
    cli: str
    e2e: str
    static: tuple[str, ...]
    echoed: tuple[str, ...]
    picks: str


def drive_template_tiers(f: Feature) -> None:
    """A template-born repo's two gate tiers, per template: `just new-repo`, its packages from the box's caches
    offline, a second module and its integration test committed (so a one-file change has a test to pick); then
    `just check` (both test kinds, the shared fixture prepared once with two workers), `just fast` after a one-file
    change (static checks, then only that module's test), a commit through the repo's git hook after a core change
    (the hook's `just fast`: the core's tests, no e2e test), and `just fast` after a justfile change (every
    integration test). CI's command is observed in its workflow; CI's decision on a status-only and a code push runs
    the workflow's own pinned filter (ci_scope)."""
    sc = RUN_DIR / "scratch" / "template-tiers"
    shutil.rmtree(sc, ignore_errors=True)
    sc.mkdir(parents=True)
    ident = {"GIT_AUTHOR_NAME": "verify-octo-feather", "GIT_AUTHOR_EMAIL": "verify@octo-feather.invalid",
             "GIT_COMMITTER_NAME": "verify-octo-feather", "GIT_COMMITTER_EMAIL": "verify@octo-feather.invalid"}
    # Trend lines and mise's trust of each created mise.toml in the scratch, never the box's.
    f.env = {**ident, "XDG_STATE_HOME": str(sc / "state"), "MISE_STATE_DIR": str(sc / "mise-state"), "GATE_WORKERS": "2"}
    env = case_env(f.env)
    second = {
        "python": ("src/app/other.py", "def double(n: int) -> int:\n    return n * 2\n",
                   "tests/integration/test_other.py",
                   "from app.other import double\n\n\ndef test_double() -> None:\n    assert double(2) == 4\n",
                   "src/app/core.py", ("clean = name.strip()", 'clean = " ".join(name.split())')),
        "typescript": ("src/other.ts", "export function double(n: number): number {\n  return n * 2;\n}\n",
                       "tests/other.test.ts",
                       ('import { expect, it } from "vitest";\nimport { double } from "../src/other.ts";\n\n'
                        'it("doubles", () => {\n  expect(double(2)).toBe(4);\n});\n'),
                       "src/core.ts", ('clean === ""', "clean.length === 0")),
    }
    # What each runner prints for a test of each kind, the static checks (on stdout; echoed: their commands on stderr)
    # and the fast tier's choice.
    shows = {
        "python": Shows(other="PASSED tests/integration/test_other.py::test_double",
                        cli="PASSED tests/integration/test_cli.py::test_hello_json_in_process",
                        e2e="tests/e2e/test_cli_e2e.py::test_installed_command_end_to_end",
                        static=("PASSED tests/test_gate.py::test_recipe[check-lint]",
                                "PASSED tests/test_gate.py::test_recipe[check-types]",
                                "PASSED tests/test_gate.py::test_recipe[check-imports]"), echoed=(),
                        picks="fast: the integration tests pytest-testmon picks from its recorded coverage"),
        # tsc and eslint print nothing when clean: their commands, which just echoes on stderr.
        "typescript": Shows(other="\u2713 |integration| tests/other.test.ts > doubles",
                            cli="\u2713 |integration| tests/cli.test.ts > app hello > prints JSON in process",
                            e2e="|e2e| tests/cli.e2e.test.ts",
                            static=("languages: ok (", "no dependency violations found"),
                            echoed=("pnpm exec tsc", "pnpm exec eslint --max-warnings 0 .", "pnpm exec depcruise src tests"),
                            picks="fast: the integration test files Vitest picks by their imports of the files changed since main"),
    }
    for lang in ("python", "typescript"):
        r = sc / lang
        other, other_src, test, test_src, core, (old, new) = second[lang]
        k = shows[lang]

        def git(*args: str, at: Path = r) -> str:
            return subprocess.run(["git", "-C", str(at), *args], check=True, capture_output=True, text=True, env=env).stdout

        f.run(f"{lang}-new-repo", "just", "--justfile", f"{f.s.repo}/justfile", "new-repo", lang, str(r), "--no-spec-chat")
        install = ["uv", "sync", "--locked", "--offline", "--quiet"] if lang == "python" else ["pnpm", "install", "--offline", "--frozen-lockfile"]
        code, text = output(install, cwd=r, env=env)
        f.obs(f"{lang}-new-repo", "install", f"{shlex.join(install)}: exit {code}\n{text}")
        f.check(f"{lang}-new-repo", lambda c: c.code == 0 and c.o["install"].split("\n", 1)[0].endswith(": exit 0"))
        (r / other).write_text(other_src)
        (r / test).write_text(test_src)
        git("add", "-A")
        git("-c", "core.hooksPath=/dev/null", "commit", "-q", "-m", "a second module and its integration test")

        # The full tier: every test shown by kind, the shared fixture prepared once for the run's two workers.
        f.run(f"{lang}-check", "env", "-C", str(r), "just", "check")
        f.check(f"{lang}-check", lambda c, k=k: c.code == 0 and all(s in c.out for s in (k.other, k.cli, k.e2e))
                and c.out.count("shared fixture greetings.json: prepared once for this run") == 1)
        checked = git("rev-parse", "HEAD").strip()

        # One source file changed: the static checks, then only the integration test the stack's tool picks for it.
        (r / other).write_text(other_src.replace("n * 2", "n + n"))
        f.run(f"{lang}-fast-one-file", "env", "-C", str(r), "just", "fast")
        f.check(f"{lang}-fast-one-file", lambda c, k=k: c.code == 0 and all(s in c.out for s in k.static)
                and all(s in c.err for s in k.echoed)
                and k.picks in c.out and c.out.index(k.static[0]) < c.out.index(k.picks) < c.out.index(k.other)
                and k.cli not in c.out and k.e2e not in c.out)
        # Kept and committed: a revert is itself a change to pytest-testmon, which compares with its last run.
        git("-c", "core.hooksPath=/dev/null", "commit", "-q", "-am", "other: n + n")

        # The core changed and committed through the repo's own git hook: the hook's just fast picks the core's
        # tests and runs no e2e test; the commit lands. CI's wiring is proven by GitHub's run of the workflow, not read here.
        (r / core).write_text((r / core).read_text().replace(old, new, 1))
        git("add", core)
        f.run(f"{lang}-hook-core", "git", "-C", str(r), "-c", "core.hooksPath=.githooks", "commit", "-m", "core: collapse inner spaces")
        f.obs(f"{lang}-hook-core", "log", git("log", "-1", "--format=%s"))
        f.check(f"{lang}-hook-core", lambda c, k=k: c.code == 0 and c.o["log"] == "core: collapse inner spaces\n"
                and k.picks in c.out + c.err and k.cli in c.out + c.err
                and k.other not in c.out + c.err and k.e2e not in c.out + c.err)

        # A path on the repo's shared-machinery.txt changed (its justfile): every integration test, still no e2e test.
        with (r / "justfile").open("a") as fh:
            fh.write("# a residual change\n")
        f.run(f"{lang}-fast-residual", "env", "-C", str(r), "just", "fast")
        f.check(f"{lang}-fast-residual", lambda c, k=k: c.code == 0
                and "fast: every integration test: justfile changed since main, on shared-machinery.txt" in c.out
                and k.other in c.out and k.cli in c.out and k.e2e not in c.out)

        # The runs' trend lines (the runner's own hook: tests/conftest.py, tests/trend-reporter.ts): just check's one
        # line full, timing every GATE_RECIPES recipe; every just fast line after it subset. Then the factory report
        # over that state, one lane on o/<lang> and the kit's fake gh (tests/fixtures/lane-report/gh) over a scratch
        # store: the repo's commits as o/<lang>'s default branch, its gate-budget.toml (none in a repo without one).
        state = scratch_state(f)   # where the runs' hook wrote and the report reads, under this drive's env
        trend = state / "check-runs.jsonl"
        top = str(r.resolve())
        f.obs(f"{lang}-trend", "lines", "".join(ln + "\n" for ln in trend.read_text().splitlines() if json.loads(ln).get("repo") == top))
        f.obs(f"{lang}-trend", "recipes", output(["just", "--evaluate", "GATE_RECIPES"], cwd=r, env=env)[1])
        store = sc / "gh" / f"o__{lang}"
        store.mkdir(parents=True)
        (store / "commits.json").write_text(json.dumps([{"sha": s} for s in git("rev-list", "HEAD").split()]))
        if (r / "gate-budget.toml").exists():
            shutil.copy(r / "gate-budget.toml", store / "gate-budget.toml")
        (state / "lanes").mkdir(exist_ok=True)
        (state / "lanes" / f"{lang}.toml").write_text(
            f'supervisor = "w1:p1"\nrepository = "o/{lang}"\nissue = "gh1"\ngoal = "Template gate"\n'
            'started_at = "2026-11-04T08:00:00Z"\nlast_handoff_at = "2026-11-04T08:00:00Z"\nwaiting_on = ""\n')
        (sc / "bin").mkdir(exist_ok=True)
        (sc / "bin" / "gh").write_text(f'#!/bin/sh\nexec python3 {shlex.quote(f.s.repo)}/tests/fixtures/lane-report/gh "$@"\n')
        (sc / "bin" / "gh").chmod(0o755)
        f.env = {**f.env, "FAKE_GH_PRS": str(sc / "gh"), "PATH": f"{sc / 'bin'}:{os.environ.get('PATH', '')}"}
        f.run(f"{lang}-trend", "octo-feather-lane", "report")
        f.env = {k: v for k, v in f.env.items() if k not in ("FAKE_GH_PRS", "PATH")}

        def trend_holds(c: Case, lang: str = lang, head: str = checked) -> bool:
            runs = [json.loads(ln) for ln in c.o["lines"].splitlines()]
            steps = " ".join(s["name"] for s in runs[0]["steps"]) if runs else ""
            block = re.search(rf"(?m)^gate budget o/{lang}: the latest passed full gate run .*\n  full gate: [\d.]+s, head {head[:12]}, "
                              r"started \S+ \(.*\): (within budget|OVER BUDGET|no budget).*\n(  .*\n)*  slowest: (.*)$", c.out)
            return (c.code == 0 and len(runs) > 1 and runs[0]["tier"] == "full" and runs[0]["exit"] == 0 and runs[0]["head"] == head
                    and all(x in steps for x in c.o["recipes"].split()) and all(x["tier"] == "subset" for x in runs[1:])
                    and block is not None and any(x in block.group(3) for x in c.o["recipes"].split()))
        f.check(f"{lang}-trend", trend_holds)
        ci_scope(f, lang, r, sc, git)
    f.env = {}
    say(f"template-tiers evidence: {f.d}")


# The one workflow expression ci_scope gives a value: the event's previous head (the push's `before`).
BEFORE = "${{ github.event.before }}"


def ci_scope(f: Feature, lang: str, r: Path, sc: Path, git: Callable[..., str]) -> None:
    """CI's decision on two pushes to the created repo's ready pull request (templates#acceptance-same-gate, spec
    issue-lifecycle #lanes-one-head): its .github/workflows/check.yml scope job's `diff` step, the pinned
    dorny/paths-filter, run as a runner would: the step's own `with:` inputs (read with PyYAML from the kit's locked
    environment) as INPUT_* variables, `before` given, a pull_request synchronize event, the head checked out, the
    action's dist/index.js at the kit's fetch-only pin (scripts/check-vendored --extract paths-filter), offline.
    A push of only a status file beside a spec gives code=false; a code push code=true. The jobs' wiring (the check job
    on the scope job's output) is not read here: GitHub's own run proves it (PR #608 at its final head, issue #589), and
    octo-feather-lane merge-ask refuses a skipped check no Judged proof carries."""
    kit = f.s.repo
    wf = r / ".github" / "workflows" / "check.yml"
    read = ("import json, sys, yaml; w = yaml.safe_load(open(sys.argv[1])); j = w['jobs']; "
            "s = [x for x in j['scope']['steps'] if x.get('id') == 'diff']; "
            "print(json.dumps({'step': s[0] if s else None}))")
    code, text = output(["uv", "run", "--project", kit, "--locked", "--offline", "--no-dev", "--quiet", "python", "-c", read, str(wf)])
    pins = [ln.split() for ln in (Path(kit) / "Skillfile").read_text().splitlines() if ln.split()[:4] == ["#fetch-only", "github", "skill", "paths-filter"]]
    dist = sc / f"paths-filter-{lang}"
    xc, xt = output([sys.executable, f"{kit}/scripts/check-vendored", "--extract", "paths-filter", str(dist)])
    for name in ("status-only", "code"):
        f.obs(f"{lang}-ci-{name}", "workflow", f"read exit {code}: {text}")
        f.obs(f"{lang}-ci-{name}", "pin", f"Skillfile: {' '.join(pins[0]) if pins else 'none'}; extract exit {xc}: {xt}")
    got: dict[str, Any] = {}
    try:
        got = cast("dict[str, Any]", json.loads(text)) if code == 0 else {}
    except ValueError:
        pass
    step = cast("dict[str, Any]", got.get("step") or {})
    inputs = {str(k): str(v) for k, v in cast("dict[str, Any]", step.get("with") or {}).items()}
    pinned = bool(pins) and step.get("uses") == f"dorny/paths-filter@{pins[0][4].split('@', 1)[1]}"
    status = r / "docs" / "specs" / "app.status.json"
    pushes = {"status-only": (lambda: status.write_text(status.read_text() + "\n") if status.exists() else status.write_text("{}\n"),
                              status, "qc: built acceptance-hello-json (judged 0123456789ab)", "false"),
              "code": (lambda: (r / "AGENTS.md").write_text((r / "AGENTS.md").read_text() + "\nA code push.\n"), r / "AGENTS.md",
                       "docs: a code push", "true")}
    for name, (change, path, subject, want) in pushes.items():
        case = f"{lang}-ci-{name}"
        before = git("rev-parse", "HEAD").strip()
        change()
        git("add", "--", str(path))   # only this push's file: earlier cases leave the tree changed (fast-residual's justfile)
        git("-c", "core.hooksPath=/dev/null", "commit", "-q", "-m", subject)
        after = git("rev-parse", "HEAD").strip()
        event, out = sc / f"{case}.event.json", sc / f"{case}.output"
        event.write_text(json.dumps({"action": "synchronize", "before": before, "after": after, "number": 1,
                                     "pull_request": {"number": 1, "draft": False, "base": {"sha": git("rev-list", "--max-parents=0", "HEAD").split()[0]},
                                                      "head": {"sha": after}}, "repository": {"default_branch": "main"}}))
        out.write_text("")
        env = {f"INPUT_{k.upper().replace(' ', '_')}": (before if v == BEFORE else v) for k, v in inputs.items()}
        git("checkout", "-q", "--detach", after)   # actions/checkout at the PR head, as the step before it
        f.env = {**f.env, "GITHUB_EVENT_NAME": "pull_request", "GITHUB_EVENT_PATH": str(event), "GITHUB_OUTPUT": str(out),
                 "GITHUB_WORKSPACE": str(r), "GITHUB_ACTIONS": "true", "RUNNER_TEMP": str(sc)}
        # The inputs as env(1) arguments, as a runner hands them to node: a shell (the entry's sh) drops a variable
        # whose name has a hyphen, such as INPUT_PREDICATE-QUANTIFIER.
        f.run(case, "env", "-C", str(r), *(f"{k}={v}" for k, v in env.items()), "node", str(dist / "dist" / "index.js"))
        f.env = {k: v for k, v in f.env.items() if not k.startswith(("GITHUB_", "RUNNER_"))}
        git("checkout", "-q", "-")
        f.obs(case, "outputs", out.read_text())
        f.obs(case, "range", f"{before[:12]}..{after[:12]}: {subject}\n")

        def holds(c: Case, want: str = want) -> bool:
            m = re.search(r"(?m)^code<<(\S+)\n(.*)\n\1$", c.o["outputs"])
            return c.code == 0 and pinned and xc == 0 and m is not None and m.group(2) == want
        f.check(case, holds)


def drive_starter_acceptance(f: Feature) -> None:
    """A template-born repo's starter criterion proven by its tagged acceptance test, per template: `just new-repo`, its
    packages from the box's caches offline, its status file made and committed; its full gate told the claim
    (OCTO_FEATHER_QC_CLAIMS=app#acceptance-hello-json just check) stores one record naming the tagged case passed; `just
    qc` on the starter criterion then judges it PASS from that record, reruns nothing (no new record), runs no demo and
    no judge, and builds it naming the record, its commit and the test. The stub classifier at the model boundary."""
    sc = RUN_DIR / "scratch" / "starter-acceptance"
    shutil.rmtree(sc, ignore_errors=True)
    sc.mkdir(parents=True)
    ident = {"GIT_AUTHOR_NAME": "verify-octo-feather", "GIT_AUTHOR_EMAIL": "verify@octo-feather.invalid",
             "GIT_COMMITTER_NAME": "verify-octo-feather", "GIT_COMMITTER_EMAIL": "verify@octo-feather.invalid"}
    f.env = {**ident, "XDG_STATE_HOME": str(sc / "state"), "MISE_STATE_DIR": str(sc / "mise-state"), "GATE_WORKERS": "2",
             "OCTO_FEATHER_QC_PATH": classify_stub(f, sc)}
    env = case_env(f.env)
    cid = "app#acceptance-hello-json"
    tests = {"python": "tests/e2e/test_cli_e2e.py", "typescript": "tests/cli.e2e.test.ts"}
    rid = r"([0-9]{8}T[0-9]{6}Z-[0-9a-f]{8})"
    for lang, test in tests.items():
        r = sc / lang

        def git(*args: str, at: Path = r) -> str:
            return subprocess.run(["git", "-C", str(at), *args], check=True, capture_output=True, text=True, env=env).stdout.strip()

        f.run(f"{lang}-new-repo", "just", "--justfile", f"{f.s.repo}/justfile", "new-repo", lang, str(r), "--no-spec-chat")
        install = ["uv", "sync", "--locked", "--offline", "--quiet"] if lang == "python" else ["pnpm", "install", "--offline", "--frozen-lockfile"]
        code, text = output(install, cwd=r, env=env)
        init = output([f.s.kit, "octo-feather-spec-status", "init", str(r / "docs" / "specs" / "app.spec.html"), git("rev-parse", "--short", "HEAD")], env=env)
        git("add", "-A")
        git("-c", "core.hooksPath=/dev/null", "commit", "-q", "-m", "status")
        f.obs(f"{lang}-new-repo", "install", f"{shlex.join(install)}: exit {code}\n{text}\nstatus init: exit {init[0]}\n{init[1]}")
        f.check(f"{lang}-new-repo", lambda c: c.code == 0 and c.o["install"].split("\n", 1)[0].endswith(": exit 0")
                and "status init: exit 0" in c.o["install"])
        head = git("rev-parse", "HEAD")

        def store(name: str, r: Path = r, head: str = head) -> None:
            f.obs(name, "store", output([f.s.kit, "octo-feather-evidence", "read", "--repo", str(r), "--commit", head, "--json"], env=env)[1])

        # The final full gate, told the claim: one record, its tagged case named passed.
        f.pre = ["env", "-C", str(r), f"OCTO_FEATHER_QC_CLAIMS={cid}"]
        f.run(f"{lang}-gate", "just", "check")
        f.pre = []
        store(f"{lang}-gate")

        def gate_holds(c: Case, test: str = test) -> bool:
            m = re.search(rf"(?m)^qc capture: {cid}: record {rid}, 1 case\(s\): {re.escape(test)} passed$", c.out)
            recs = json.loads(c.o["store"])
            return c.code == 0 and m is not None and [x["record"]["id"] for x in recs] == [m.group(1)]
        f.check(f"{lang}-gate", gate_holds)
        gate_rec = [x["record"]["id"] for x in json.loads((f.d / f"{lang}-gate.obs.store").read_text())]

        # just qc on the starter criterion: judged from the gate's record, nothing rerun, no demo, no judge.
        f.pre = ["env", "-C", str(r)]
        f.run(f"{lang}-qc", "just", "qc", "docs/specs/app.status.json", "7", "acceptance-hello-json")
        f.pre = []
        f.obs(f"{lang}-qc", "report", json.dumps(qc_report(f, f"{lang}-qc")))
        store(f"{lang}-qc")
        f.obs(f"{lang}-qc", "status", git("show", "HEAD:docs/specs/app.status.json"))

        def qc_holds(c: Case, test: str = test, head: str = head, gate_rec: list[str] = gate_rec) -> bool:
            m = re.search(rf"(?m)^PASS acceptance-hello-json: \$ .*\n  1/1 tagged cases passed in the gate's run at {head[:12]}, not rerun\n"
                          rf"  evidence complete; decision tagged test assertions; record {rid}$", c.out)
            rep = json.loads(c.o["report"])
            built = json.loads(c.o["status"])["criteria"]["acceptance-hello-json"]
            return (c.code == 0 and m is not None and [m.group(1)] == gate_rec == [x["record"]["id"] for x in json.loads(c.o["store"])]
                    and f"judged from the gate's record {gate_rec[0]} at {head[:12]}, not rerun" in c.err
                    and rep.get("captures") == [] and "fallback" not in rep and "qc: demo " not in c.err
                    and built == {"status": "built", "pr": 7, "record": gate_rec[0], "commit": head, "tests": [test]})
        f.check(f"{lang}-qc", qc_holds)
    f.env = {}
    say(f"starter-acceptance evidence: {f.d}")


def strings(doc: object) -> list[str]:
    """Every string value in a parsed JSON document, at any depth."""
    if isinstance(doc, str):
        return [doc]
    items = cast("dict[str, object]", doc).values() if isinstance(doc, dict) else cast("list[object]", doc) if isinstance(doc, list) else []
    return [s for x in items for s in strings(x)]


def drive_template_edge(f: Feature) -> None:
    """A template-born repo's starter edge, per template: `just new-repo`, its packages from the box's caches
    offline, then its installed `app` driven as templates#acceptance-edge-rejects states."""
    sc = RUN_DIR / "scratch" / "template-edge"
    shutil.rmtree(sc, ignore_errors=True)
    sc.mkdir(parents=True)
    ident = {"GIT_AUTHOR_NAME": "verify-octo-feather", "GIT_AUTHOR_EMAIL": "verify@octo-feather.invalid",
             "GIT_COMMITTER_NAME": "verify-octo-feather", "GIT_COMMITTER_EMAIL": "verify@octo-feather.invalid"}
    f.env = {**ident, "MISE_STATE_DIR": str(sc / "mise-state")}
    env = case_env(f.env)
    valid = {"name": "Ada"}
    unknown = {**valid, "mood": "glad"}
    # Each template's install, offline from the box's caches, and its app command (package.json's bin under node).
    langs: dict[str, tuple[list[str], Callable[[Path], list[str]]]] = {
        "python": (["uv", "sync", "--locked", "--offline", "--quiet"], lambda r: [str(r / ".venv/bin/app")]),
        "typescript": (["pnpm", "install", "--offline", "--frozen-lockfile"], lambda r: ["node", str(r / "src/cli.ts")])}
    for lang, (install, app) in langs.items():
        r = sc / lang
        f.run(f"{lang}-new-repo", "just", "--justfile", f"{f.s.repo}/justfile", "new-repo", lang, str(r), "--no-spec-chat")
        code, text = output(install, cwd=r, env=env)
        f.obs(f"{lang}-new-repo", "install", f"{shlex.join(install)}: exit {code}\n{text}")
        f.check(f"{lang}-new-repo", lambda c: c.code == 0 and c.o["install"].split("\n", 1)[0].endswith(": exit 0"))
        cmd = app(r)
        f.run(f"{lang}-unknown-field", *cmd, "hello", "--request", json.dumps(unknown), "--json")
        # Named: "mood" is a string value somewhere in the one document stdout holds (each template its own shape).
        f.check(f"{lang}-unknown-field", lambda c: c.code != 0 and "mood" in strings(cast("object", c.j))
                and "Hello" not in c.out)
        f.run(f"{lang}-valid", *cmd, "hello", "--request", json.dumps(valid), "--json")
        f.check(f"{lang}-valid", lambda c: c.code == 0 and c.j == {"name": "Ada", "text": "Hello, Ada"})
    f.env = {}
    say(f"template-edge evidence: {f.d}")


def drive_run_slots(f: Feature) -> None:
    """The box's heavy-run slot (octo-feather-slot --help) as a lane's implementer and the director meet it, in
    scratch box state: a lane gh7 whose implementer's `just test` over a 31-item scratch suite is refused before any
    item runs, naming the grant to ask for; the implementer's own grant refused; the director's grant; status naming
    the holder; the same run then holding the slot and passing; the lock released after it. The queue: gh8 queued
    onto gh7's slot, nothing passed before gh7 ran, the slot passed to gh8 a grace after gh7's run ended with gh8's
    supervisor and the director told (a stand-in herdr-say records each message), gh7 then told to queue, and a
    lane queued onto a free kind granted at once. Manual moves and pass-over (#977): a revoke frees the slot, the
    head granted only after the grace; a revoke then a grant by hand inside the grace keeps the director's choice;
    that hand-granted lane, starting no run within the bound, passed over to the head. herdr-say is the checkout's own; Herdr (`herdr`) is a stand-in first on
    PATH recording each prompt, also behind the justfile's PATH, which puts the kit's herdr-say first. Cases:
    features/run-slots.md."""
    sc = RUN_DIR / "scratch" / "run-slots"
    shutil.rmtree(sc, ignore_errors=True)
    (sc / "state" / "octo-feather" / "lanes").mkdir(parents=True)
    (sc / "state" / "octo-feather" / "lanes" / "gh7.toml").write_text('supervisor = "w9:p1"\n')
    (sc / "state" / "octo-feather" / "lanes" / "gh8.toml").write_text('supervisor = "w8:p1"\n')
    (sc / "state" / "octo-feather" / "lanes" / "gh6.toml").write_text('supervisor = "w6:p1"\n')
    (sc / "state" / "octo-feather" / "director.toml").write_text('pane = "w1:p1"\n')
    said = sc / "said"  # the stand-in herdr's record: one line per call, its arguments
    (sc / "bin").mkdir()
    (sc / "bin" / "herdr").write_text(f'#!/bin/sh\nprintf \'%s\\n\' "$*" >>{shlex.quote(str(said))}\n')
    (sc / "bin" / "herdr").chmod(0o755)
    (sc / "bin" / "herdr-say").symlink_to(Path(f.s.repo) / ".agents" / "skills" / "herdr-comms" / "assets" / "herdr-say")
    (sc / "suite").mkdir()
    (sc / "suite" / "pytest.ini").write_text("[pytest]\naddopts = -p no:cacheprovider\n")
    (sc / "suite" / "test_many.py").write_text("import pytest\n@pytest.mark.parametrize('n', range(31))\ndef test_n(n): pass\n")
    grace = 2  # the queue's grace, shortened through its knob (octo-feather-slot --help)
    bound = 6  # the bound, shortened likewise, for the manual-move cases; 30 before them
    box = {"XDG_STATE_HOME": str(sc / "state"), "HERDR_SESSION": "default",   # scratch slots and lane records
           "OCTO_FEATHER_SLOT_GRACE": str(grace), "OCTO_FEATHER_SLOT_BOUND": "30",
           "PATH": f"{sc / 'bin'}{os.pathsep}{os.environ['PATH']}"}
    agent = {**box, "OCTO_FEATHER_ROLE": "implementer", "HERDR_PANE_ID": "w9:p3", "OCTO_FEATHER_PARENT": "w9:p1",
             "HERDR_WORKSPACE_ID": "w9"}
    director = {**box, "OCTO_FEATHER_ROLE": "director", "HERDR_PANE_ID": "w1:p1"}
    gate = ("just", "--justfile", f"{f.s.repo}/justfile", "test", str(sc / "suite"))
    f.env = agent
    f.run("grant-not-director", "octo-feather-slot", "grant", "gh7", "--kind", "heavy")
    f.check("grant-not-director", lambda c: c.code == 77 and "grant is the director's" in c.err)
    f.run("refused", *gate)
    f.check("refused", lambda c: c.code == 75 and "passed" not in c.out and (
        "octo-feather-slot: refused, nothing ran: this heavy run selects 31 items, over heavy_items 30 (gate-budget.toml), "
        "and lane gh7 holds no heavy grant; current holder: none; ask the director: octo-feather-slot grant gh7 --kind heavy"
    ) in c.err)
    f.env = director
    f.run("grant", "octo-feather-slot", "grant", "gh7", "--kind", "heavy")
    f.check("grant", lambda c: c.code == 0 and c.out.startswith("granted: heavy slot to lane gh7 (granted ") and "by w1:p1, expires " in c.out)
    f.run("status", "octo-feather-slot", "status")
    f.check("status", lambda c: c.code == 0 and "  holder: gh7 (granted " in c.out and "eval (1 slot(s)" in c.out)
    f.env = agent
    f.run("queue-not-director", "octo-feather-slot", "queue", "gh8", "--kind", "heavy")
    f.check("queue-not-director", lambda c: c.code == 77 and "queue is the director's" in c.err)
    f.env = director
    f.run("queue", "octo-feather-slot", "queue", "gh8", "--kind", "heavy")
    f.check("queue", lambda c: c.code == 0 and c.out == "queued: lane gh8 for the heavy slot, position 1\n")
    f.run("queue-status", "octo-feather-slot", "status")
    f.check("queue-status", lambda c: c.code == 0 and "  holder: gh7 (granted " in c.out and "  queue: 1. gh8 (queued " in c.out)
    f.run("not-before-run", "octo-feather-slot", "settle", "--kind", "heavy")
    f.check("not-before-run", lambda c: c.code == 0 and "settle heavy: nothing passes (queue: gh8)" in c.out)
    f.env = agent
    f.run("granted", *gate)
    f.check("granted", lambda c: c.code == 0 and "heavy slot: held: the heavy slot for lane gh7, run pid " in c.out and "31 passed" in c.out)
    f.run("released", "octo-feather-slot", "status")
    f.check("released", lambda c: c.code == 0 and c.out.count("run holding it now: none") == 2)
    end = datetime.now(UTC).timestamp() + 30  # the detached check, a grace after gh7's run ended
    while "holder: gh8 " not in output([f.s.kit, "octo-feather-slot", "status"], env=case_env(box))[1]:
        if datetime.now(UTC).timestamp() > end:
            break
        subprocess.run(["sleep", "0.5"], check=False)
    f.run("handed", "octo-feather-slot", "status")
    f.obs("handed", "said", said.read_text() if said.exists() else "")
    wait = " --wait --until working --until idle --timeout 60000\n"  # herdr-say's prompt, bound 60 s
    f.check("handed", lambda c: c.code == 0 and "  holder: gh8 (granted " in c.out and "  queue: none" in c.out and (
        "agent prompt w8:p1 octo-feather-slot: the heavy slot is granted to lane gh8 until "
        f"{c.out.split('holder: gh8 (granted ', 1)[1].split(', expires ', 1)[1].split(')', 1)[0]} "
        f"(lane gh7's run ended, no run within the {grace} s grace); run your heavy run now.{wait}"
        f"agent prompt w1:p1 octo-feather-slot: heavy slot passed from lane gh7 to lane gh8; queue left: none.{wait}"
    ) == c.o["said"])
    f.run("refused-queue", *gate)
    f.check("refused-queue", lambda c: c.code == 75 and "passed" not in c.out and (
        "and lane gh7 holds no heavy grant; current holder: gh8 (granted "
    ) in c.err and "ask the director: octo-feather-slot queue gh7 --kind heavy" in c.err)
    f.env = director
    f.run("queue-free", "octo-feather-slot", "queue", "gh7", "--kind", "eval")
    f.obs("queue-free", "said", said.read_text().splitlines(keepends=True)[-1])
    f.check("queue-free", lambda c: c.code == 0 and c.out.startswith("granted: eval slot to lane gh7 (granted ") and (
        "agent prompt w9:p1 octo-feather-slot: the eval slot is granted to lane gh7 until "
        f"{c.out.split(', expires ', 1)[1].split(')', 1)[0]} (queued onto a free slot); run your eval run now.{wait}"
    ) == c.o["said"] and "told w9:p1" in c.out)

    def heavy(out: str) -> str:  # status's heavy kind, its lines before the eval kind's
        return out.split("\neval (", 1)[0]

    def until_holds(lane: str) -> None:  # status polled up to 30 s, each settling first
        end = datetime.now(UTC).timestamp() + 30
        while f"holder: {lane} " not in heavy(output([f.s.kit, "octo-feather-slot", "status"], env=case_env(box))[1]):
            if datetime.now(UTC).timestamp() > end:
                break
            subprocess.run(["sleep", "0.5"], check=False)

    def last(n: int) -> str:
        return "".join(said.read_text().splitlines(keepends=True)[-n:])

    def expires(out: str, lane: str) -> str:
        return heavy(out).split(f"holder: {lane} (granted ", 1)[1].split(", expires ", 1)[1].split(")", 1)[0]

    f.run("queue-behind", "octo-feather-slot", "queue", "gh7", "--kind", "heavy")
    f.check("queue-behind", lambda c: c.code == 0 and c.out == "queued: lane gh7 for the heavy slot, position 1\n")
    f.run("revoke", "octo-feather-slot", "revoke", "gh8", "--kind", "heavy")
    f.check("revoke", lambda c: c.code == 0 and c.out == (
        f"revoked: heavy slot of lane gh8\nthe heavy slot passes to lane gh7 after the {grace} s grace\n"))
    f.run("revoke-status", "octo-feather-slot", "status")
    f.check("revoke-status", lambda c: c.code == 0 and "  holder: none\n" in heavy(c.out)
            and "  queue: 1. gh7 (queued " in c.out and f"to the queue's head after the {grace} s grace" in c.out)
    until_holds("gh7")
    f.run("freed-handed", "octo-feather-slot", "status")
    f.obs("freed-handed", "said", last(2))
    f.check("freed-handed", lambda c: c.code == 0 and "  holder: gh7 (granted " in heavy(c.out) and " by queue, " in c.out and (
        f"agent prompt w9:p1 octo-feather-slot: the heavy slot is granted to lane gh7 until {expires(c.out, 'gh7')} "
        f"(the slot free for the {grace} s grace); run your heavy run now.{wait}"
        f"agent prompt w1:p1 octo-feather-slot: heavy slot free for the {grace} s grace, granted to lane gh7; queue "
        f"left: none.{wait}"
    ) == c.o["said"])
    box |= {"OCTO_FEATHER_SLOT_BOUND": str(bound)}
    director |= {"OCTO_FEATHER_SLOT_BOUND": str(bound)}
    f.env = director
    f.run("requeue", "octo-feather-slot", "queue", "gh8", "--kind", "heavy")
    f.check("requeue", lambda c: c.code == 0 and c.out == "queued: lane gh8 for the heavy slot, position 1\n")
    f.run("revoke-again", "octo-feather-slot", "revoke", "gh7", "--kind", "heavy")
    f.check("revoke-again", lambda c: c.code == 0 and c.out.startswith("revoked: heavy slot of lane gh7\n"))
    f.run("grant-by-hand", "octo-feather-slot", "grant", "gh6", "--kind", "heavy")
    f.check("grant-by-hand", lambda c: c.code == 0 and c.out.startswith("granted: heavy slot to lane gh6 (granted "))
    subprocess.run(["sleep", str(grace + 1)], check=False)  # past the grace the revoke started
    told = said.read_text()
    f.run("grant-wins", "octo-feather-slot", "status")
    f.obs("grant-wins", "said-since", said.read_text()[len(told):])
    f.check("grant-wins", lambda c: c.code == 0 and "  holder: gh6 (granted " in c.out
            and "  queue: 1. gh8 (queued " in c.out and c.o["said-since"] == "")
    until_holds("gh8")
    f.run("passed-over", "octo-feather-slot", "status")
    f.obs("passed-over", "said", last(3))
    f.check("passed-over", lambda c: c.code == 0 and "  holder: gh8 (granted " in c.out and (
        f"agent prompt w8:p1 octo-feather-slot: the heavy slot is granted to lane gh8 until {expires(c.out, 'gh8')} "
        f"(lane gh6 started no heavy run within the {bound} s bound); run your heavy run now.{wait}"
        f"agent prompt w6:p1 octo-feather-slot: lane gh6's heavy grant passed to lane gh8: no heavy run started under "
        f"it within the {bound} s bound; to run, ask the director: octo-feather-slot queue gh6 --kind heavy.{wait}"
        f"agent prompt w1:p1 octo-feather-slot: heavy slot passed over lane gh6 (no run within the {bound} s bound) to "
        f"lane gh8; queue left: none.{wait}"
    ) == c.o["said"])
    f.env = {}
    say(f"run-slots evidence: {f.d}")


def drive_queued_completion(f: Feature) -> None:
    """A worker's completion sent while its supervisor compacts, Herdr stood in by the kit's testkit Herdr
    (tests/gate/kit/testkit/herdr.py, its FAKE_HERDR world): an implementer's `herdr-say --parent` to supervisor
    w9:p1 compacting for 2 s, Herdr confirming nothing and the pane showing the completion queued; then one
    compacting past the send's bound. Each prints the delivered and attempt counts. Cases: features/queued-completion.md."""
    sc = RUN_DIR / "scratch" / "queued-completion"
    shutil.rmtree(sc, ignore_errors=True)
    (sc / "bin").mkdir(parents=True)
    (sc / "bin" / "herdr").symlink_to(Path(f.s.repo) / "tests" / "gate" / "kit" / "testkit" / "herdr.py")
    say_cmd = str(Path(f.s.repo) / ".agents" / "skills" / "herdr-comms" / "assets" / "herdr-say")
    done = "DONE commit abc123: the completion"
    for name, secs, args, want in (("delivered-once", 2, (), 0), ("still-queued", 3600, ("--timeout", "1"), 1)):
        world = sc / name
        world.mkdir()
        sup = {"name": "gh9", "pane_id": "w9:p1", "workspace_id": "w9", "tab_id": "w9:t1", "agent_status": "idle",
               "compacting_until": datetime.now(UTC).timestamp() + secs}
        (world / "agents.json").write_text(json.dumps({"w9:p1": sup}))
        f.env = {"PATH": f"{sc / 'bin'}:{os.environ['PATH']}", "FAKE_HERDR": str(world), "OCTO_FEATHER_ROLE": "implementer",
                 "OCTO_FEATHER_PARENT": "w9:p1", "HERDR_PANE_ID": "w9:p3", "HERDR_WORKSPACE_ID": "w9"}
        f.run(name, say_cmd, *args, "--parent", done)
        got = (world / "prompts").read_text().splitlines() if (world / "prompts").exists() else []
        sent = [x for x in (world / "log").read_text().splitlines() if x.startswith("agent prompt ")]
        f.obs(name, "delivered", str(got.count(f"w9:p1\t{done}")))
        f.obs(name, "attempts", str(len(sent)))
        say(f"{name}: delivered {len(got)}, attempts {len(sent)}")
        f.check(name, lambda c, want=want, n=int(want == 0): c.code == want and c.o["delivered"] == str(n)
                and c.o["attempts"] == "1" and "queued" in c.err and "resent" in c.err)
    f.env = {}
    say(f"queued-completion evidence: {f.d}")


COMMS_REPORT = "DONE commit abc123: implementer-gh7's report\nevidence: just fast green\nnext: review"


@dataclass
class CommsWorld:
    """A lane's agents in a testkit Herdr world (tests/gate/kit/testkit/herdr.py, FAKE_HERDR), the box's systemd
    user manager stood in (tests/gate/kit/testkit/systemd.py as busctl and systemctl, calls in FAKE_SYSTEMD_LOG) and
    its scratch octo-feather state: director w0:p1, lane gh7's supervisor w1:p1, its implementer-gh7 at w1:p2 (spawn line in the
    lane log, session S-impl-gh7). Cases: features/parent-resumed.md, result-file.md, result-missing.md."""

    sc: Path
    world: Path
    state: Path
    base: dict[str, str]

    def agents(self) -> dict[str, dict[str, object]]:
        return cast("dict[str, dict[str, object]]", json.loads((self.world / "agents.json").read_text()))

    def put(self, agents: dict[str, dict[str, object]]) -> None:
        (self.world / "agents.json").write_text(json.dumps(agents))

    def received(self, pane: str) -> list[str]:
        p = self.world / "prompts"
        got = p.read_text().splitlines() if p.exists() else []
        return [x.split("\t", 1)[1] for x in got if x.split("\t")[0] == pane]

    def attempts(self, pane: str) -> int:
        return sum(x.startswith(f"agent prompt {pane} ") for x in (self.world / "log").read_text().splitlines())

    def result_file(self) -> Path:
        return self.state / "lanes" / "gh7.results" / "S-impl-gh7.md"

    def worker(self) -> dict[str, str]:
        return self.base | {"OCTO_FEATHER_ROLE": "implementer", "OCTO_FEATHER_PARENT": "w1:p1",
                            "OCTO_FEATHER_SESSION_ID": "S-impl-gh7", "HERDR_PANE_ID": "w1:p2", "HERDR_WORKSPACE_ID": "w1"}

    def supervisor(self, pane: str = "w1:p1") -> dict[str, str]:
        return self.base | {"OCTO_FEATHER_ROLE": "supervisor", "OCTO_FEATHER_PARENT": "w0:p1",
                            "HERDR_PANE_ID": pane, "HERDR_WORKSPACE_ID": pane.split(":", maxsplit=1)[0]}


def comms_agent(pane: str, name: str, **more: object) -> dict[str, object]:
    w, n = pane.split(":p")
    return {"name": name, "pane_id": pane, "workspace_id": w, "tab_id": f"{w}:t{n}", "agent_status": "idle"} | more


def comms_world(f: Feature, feature: str) -> CommsWorld:
    """A fresh CommsWorld under the run's scratch for FEATURE (its class docstring)."""
    sc = RUN_DIR / "scratch" / feature
    shutil.rmtree(sc, ignore_errors=True)
    (sc / "bin").mkdir(parents=True)
    (sc / "bin" / "herdr").symlink_to(Path(f.s.repo) / "tests" / "gate" / "kit" / "testkit" / "herdr.py")
    for s in ("busctl", "systemctl"):  # the box's systemd user manager stood in: herdr-spawn's scope is not this demo's
        (sc / "bin" / s).symlink_to(Path(f.s.repo) / "tests" / "gate" / "kit" / "testkit" / "systemd.py")
    (sc / "home").mkdir()
    world = sc / "herdr"
    world.mkdir()
    state = sc / "home" / ".local" / "state" / "octo-feather" / "sessions" / "verify"
    (state / "lanes").mkdir(parents=True)
    (state / "director.toml").write_text('pane = "w0:p1"\n')
    (state / "lanes" / "gh7.toml").write_text('issue = "7"\nsupervisor = "w1:p1"\ngoal = "g"\n')
    spawn = {"at": now(), "kind": "spawn", "name": "implementer-gh7", "role": "implementer", "pane": "w1:p2",
             "cwd": str(sc), "session": "S-impl-gh7", "ticket": "gh7"}
    (state / "lanes" / "gh7.handoffs.jsonl").write_text(json.dumps(spawn) + "\n")
    # A reflection just ran: an octo-feather-start runs none in the background (scripts/octo-feather-start).
    (state / "director.handoffs.jsonl").write_text(json.dumps({"at": now(), "kind": "reflection"}) + "\n")
    base = {"PATH": f"{sc / 'bin'}:{os.environ['PATH']}", "FAKE_HERDR": str(world), "HOME": str(sc / "home"),
            "HERDR_SESSION": "verify", "FAKE_SYSTEMD_LOG": str(sc / "systemd")}
    w = CommsWorld(sc=sc, world=world, state=state, base=base)
    w.put({"w0:p1": comms_agent("w0:p1", "director"), "w1:p1": comms_agent("w1:p1", "gh7"),
           "w1:p2": comms_agent("w1:p2", "implementer-gh7")})
    return w


def comms_env(f: Feature, env: dict[str, str]) -> None:
    """The next cases run with ENV (none of the driving agent's own variables: case_env)."""
    f.env = env


def herdr_say(f: Feature) -> str:
    return str(Path(f.s.repo) / ".agents" / "skills" / "herdr-comms" / "assets" / "herdr-say")


def drive_parent_resumed(f: Feature) -> None:
    """comms#acceptance-parent-resumed: lane gh7's supervisor gone from Herdr without a park (a restart), resumed by
    `octo-feather-start --name gh7 --resume S-sup-gh7` on a new pane; its implementer's `herdr-say --parent REPORT`
    (OCTO_FEATHER_PARENT still the old pane) reaches the new pane as the notice naming its result file; the director
    receives nothing. Cases: features/parent-resumed.md."""
    w = comms_world(f, "parent-resumed")
    agents = w.agents()
    del agents["w1:p1"]
    w.put(agents)
    say("supervisor gh7 w1:p1 gone from Herdr without a park (its session restarted)")
    target = w.sc / "target"
    for argv in (["git", "init", "-q", "-b", "main", str(target)],
                 [str(Path(f.s.repo) / "scripts" / "pi-role"), "--set-identity", "t", "t@t"]):
        subprocess.run(argv, env=case_env(w.base),
                       check=True, capture_output=True)
    comms_env(f, w.base)
    f.run("resume", "octo-feather-start", "--cwd", str(target), "--name", "gh7", "--resume", "S-sup-gh7")
    out = (f.d / "resume.stdout").read_text()
    new = next((x.removeprefix("pane=") for x in out.split() if x.startswith("pane=")), "")
    record = (w.state / "lanes" / "gh7.toml").read_text()
    f.obs("resume", "record", record)
    calls = w.sc / "systemd"
    f.obs("resume", "systemd", calls.read_text() if calls.exists() else "")
    say(f"resume: new pane {new}; lanes/gh7.toml: {record.strip()!r}")
    f.check("resume", lambda c: c.code == 0 and new not in ("", "w1:p1") and f'supervisor = "{new}"' in c.o["record"]
            and "StartTransientUnit" in c.o["systemd"])
    comms_env(f, w.worker())
    f.run("report", herdr_say(f), "--parent", COMMS_REPORT)
    rf = w.result_file()
    f.obs("report", "new-pane", "\n".join(w.received(new)))
    f.obs("report", "director", "\n".join(w.received("w0:p1")))
    f.obs("report", "result-file", rf.read_text() if rf.is_file() else "")
    say(f"report: {new} received {w.received(new)}; director w0:p1 received {w.received('w0:p1')}")
    say(f"report: {rf} holds the report: {COMMS_REPORT in (rf.read_text() if rf.is_file() else '')}")
    f.check("report", lambda c: c.code == 0 and c.o["director"] == "" and str(rf) in c.o["new-pane"]
            and len(c.o["new-pane"].splitlines()) == 1 and COMMS_REPORT in c.o["result-file"])
    f.env, f.pre = {}, []
    say(f"parent-resumed evidence: {f.d}")


def drive_result_file(f: Feature) -> None:
    """comms#acceptance-result-file: lane gh7's supervisor w1:p1 compacting for 3 s; its implementer's `herdr-say
    --parent REPORT` (one send, queued, taken after compaction); then the supervisor's `octo-feather-handoff results`
    names the result file and reading it shows REPORT whole; the director received nothing. Cases:
    features/result-file.md."""
    w = comms_world(f, "result-file")
    agents = w.agents()
    agents["w1:p1"]["compacting_until"] = datetime.now(UTC).timestamp() + 3
    w.put(agents)
    comms_env(f, w.worker())
    f.run("report", herdr_say(f), "--parent", COMMS_REPORT)
    f.obs("report", "attempts", str(w.attempts("w1:p1")))
    f.obs("report", "supervisor", "\n".join(w.received("w1:p1")))
    say(f"report: send attempts {w.attempts('w1:p1')}; supervisor w1:p1 received {w.received('w1:p1')}")
    f.check("report", lambda c: c.code == 0 and c.o["attempts"] == "1" and len(c.o["supervisor"].splitlines()) == 1)
    rf = w.result_file()
    comms_env(f, w.supervisor())
    f.run("results", "octo-feather-handoff", "results")
    f.check("results", lambda c: c.code == 0 and c.out == f"implementer-gh7\tw1:p2\tlive idle\t{rf}\n")
    f.run("read", "cat", str(rf))
    f.obs("read", "director", "\n".join(w.received("w0:p1")))
    f.obs("read", "attempts", str(w.attempts("w1:p1")))
    say(f"read: director w0:p1 received {w.received('w0:p1')}; send attempts in all {w.attempts('w1:p1')}")
    f.check("read", lambda c: c.code == 0 and COMMS_REPORT in c.out and c.o["director"] == "" and c.o["attempts"] == "1")
    f.env, f.pre = {}, []
    say(f"result-file evidence: {f.d}")


def drive_result_missing(f: Feature) -> None:
    """comms#acceptance-result-missing: lane gh7's implementer-gh7 exits mid-ticket without reporting (gone from Herdr,
    no parked line, no result file) while general-worker-gh7 still works; the supervisor's `octo-feather-handoff
    results` shows implementer-gh7 `ended, no result file` and the live one `none yet`. Cases:
    features/result-missing.md."""
    w = comms_world(f, "result-missing")
    agents = w.agents()
    del agents["w1:p2"]
    agents["w1:p3"] = comms_agent("w1:p3", "general-worker-gh7", agent_status="working")
    w.put(agents)
    spawn = {"at": now(), "kind": "spawn", "name": "general-worker-gh7", "role": "general-worker", "pane": "w1:p3",
             "cwd": str(w.sc), "session": "S-gw-gh7", "ticket": "gh7"}
    with (w.state / "lanes" / "gh7.handoffs.jsonl").open("a") as log:
        log.write(json.dumps(spawn) + "\n")
    say("implementer-gh7 w1:p2: its session exited mid-ticket, no report, no parked line")
    comms_env(f, w.supervisor())
    f.run("results", "octo-feather-handoff", "results")
    f.check("results", lambda c: c.code == 0 and c.out == (
        "implementer-gh7\tw1:p2\tended\tended, no result file\ngeneral-worker-gh7\tw1:p3\tlive working\tnone yet\n"))
    f.env, f.pre = {}, []
    say(f"result-missing evidence: {f.d}")


def drive_spec_revision_init(f: Feature) -> None:
    """`octo-feather-spec-status init` over an existing status file (issue-lifecycle #spec-status-file): a scratch spec
    accepted with criteria a, b, c and initialized; a built with an evidence link, b built without; a logged call names
    c. The owner accepts a revision dropping c and adding d: init keeps a's and b's rows byte for byte, adds d planned,
    drops c and moves accepted_commit; check passes. A lane builds d; the same init changes no byte. A row with a
    partial evidence link makes init refuse, naming it, the file unchanged. Each case shows the file before and after."""
    sc = RUN_DIR / "scratch" / "spec-revision-init"
    r = sc / "repo"
    d = r / "docs" / "specs"
    st = d / "demo.status.json"
    fx = Path(f.s.repo) / "tests" / "fixtures" / "spec-status" / "revision"
    shutil.rmtree(sc, ignore_errors=True)
    d.mkdir(parents=True)

    def git(*args: str) -> str:
        return subprocess.run(["git", "-C", str(r), *args], check=True, capture_output=True, text=True).stdout.strip()

    def status(*args: str) -> None:   # the lane's own writes between cases: octo-feather-spec-status built
        p = subprocess.run([f.s.kit, "octo-feather-spec-status", *args], capture_output=True, text=True, check=False)
        if p.returncode:
            die(f"spec-revision-init: octo-feather-spec-status {' '.join(args)}: {p.stderr.strip()}")

    def row(text: str, cid: str) -> str:
        m = re.search(rf'(?ms)^    "{cid}": \{{.*?^    \}}', text)
        return m.group(0) if m else ""

    def case(name: str, *args: str) -> None:
        """One case run where the director stands (the scratch repo), the status file kept before and after."""
        before = st.read_text() if st.exists() else ""
        f.obs(name, "before", before)
        f.run(name, *args)
        after = st.read_text() if st.exists() else ""
        f.obs(name, "after", after)
        rel = st.relative_to(r)
        say(f"{name}: {rel} before:")
        print("".join(f"    {ln}" for ln in before.splitlines(keepends=True)) or "    (no file)", flush=True)
        say(f"{name}: {rel} after:" + (" byte-identical to before" if after == before else ""))
        if after != before:
            print("".join(f"    {ln}" for ln in after.splitlines(keepends=True)) or "    (no file)", flush=True)
            say(f"{name}: {rel} diff:")
            print("".join(difflib.unified_diff(before.splitlines(keepends=True), after.splitlines(keepends=True),
                                               "before", "after")), end="", flush=True)

    git("init", "-q", "-b", "main")
    for k, val in (("user.name", "verify-octo-feather"), ("user.email", "verify@octo-feather.invalid"), ("core.hooksPath", "/dev/null")):
        git("config", k, val)
    shutil.copy(fx / "accepted.spec.html", d / "demo.spec.html")
    git("add", "-A")
    git("commit", "-q", "-m", "spec accepted")
    c1 = git("rev-parse", "HEAD")
    f.pre = ["env", "-C", str(r)]
    case("fresh", "octo-feather-spec-status", "init", "docs/specs/demo.spec.html", c1)
    f.check("fresh", lambda c: c.code == 0 and list(json.loads(c.o["after"])["criteria"]) == ["acceptance-a", "acceptance-b", "acceptance-c"]
            and all(v == {"status": "planned", "pr": None} for v in json.loads(c.o["after"])["criteria"].values()))
    status("built", str(st), "7", "acceptance-a", "--record", "20261029T100000Z-0a0a0a0a", "--commit", c1, "--test", "tests/a.sh")
    status("built", str(st), "8", "acceptance-b")
    (d / "demo.calls.jsonl").write_text(json.dumps({
        "at": "2026-10-21T10:00:00Z", "lane": "gh62", "role": "supervisor", "kind": "clarifies", "anchors": ["acceptance-c"],
        "criteria": ["acceptance-c"], "what": "w", "why": "y", "passes_as_written": False, "evidence": "e"}) + "\n")
    git("add", "-A")
    git("commit", "-q", "-m", "a and b built; a call names c")
    shutil.copy(fx / "revised.spec.html", d / "demo.spec.html")
    git("add", "-A")
    git("commit", "-q", "-m", "revision accepted: c dropped, d added")
    c2 = git("rev-parse", "HEAD")
    case("revision", "octo-feather-spec-status", "init", "docs/specs/demo.spec.html", c2)

    def revised(c: Case) -> bool:
        a = json.loads(c.o["after"])
        return (c.code == 0 and all(row(c.o["after"], k) == row(c.o["before"], k) != "" for k in ("acceptance-a", "acceptance-b"))
                and list(a["criteria"]) == ["acceptance-a", "acceptance-b", "acceptance-d"] and a["accepted_commit"] == c2
                and a["criteria"]["acceptance-d"] == {"status": "planned", "pr": None})
    f.check("revision", revised)
    git("commit", "-q", "-am", "status of the revision")
    case("check", "octo-feather-spec-status", "check", "docs/specs")
    f.check("check", lambda c: c.code == 0 and "spec-status: ok (1 status files)" in c.out)
    status("built", str(st), "9", "acceptance-d", "--record", "20261030T100000Z-0d0d0d0d", "--commit", c2, "--test", "tests/d.sh")
    case("repeat", "octo-feather-spec-status", "init", "docs/specs/demo.spec.html", c2)
    f.check("repeat", lambda c: c.code == 0 and c.o["after"] == c.o["before"] and '"record": "20261030T100000Z-0d0d0d0d"' in c.o["after"])
    st.write_text(re.sub(r'(?s)("acceptance-a": \{[^}]*?"record": "[^"]*"),\s*"commit": "[^"]*",\s*"tests": \[[^]]*\]', r"\1", st.read_text()))
    case("invalid", "octo-feather-spec-status", "init", "docs/specs/demo.spec.html", c2)
    f.check("invalid", lambda c: c.code != 0 and c.o["after"] == c.o["before"] and '"commit"' not in row(c.o["before"], "acceptance-a")
            and "acceptance-a: names record without commit, tests" in c.err)
    f.pre = []
    say(f"spec-revision-init evidence: {f.d}")


LANE_TITLE = "Lane start as one command"
LANE_GOAL = ("/goal a scratch proof for gh905, delivered through implement-spec; done when an owner gate is pending "
             "(review link or merge ask sent) or PR merged and lane torn down")
LANE_BRIEF = "Build the lane start.\nSpec: docs/specs/issue-lifecycle.spec.html\n"


def drive_lane_start(f: Feature) -> None:
    """issue-lifecycle#acceptance-lane-start: the director (w0:p1) runs `octo-feather-lane start 905 --goal TITLE
    --outcome TEXT --brief-file brief.md` in its scratch target clone, whose origin's main moved past the clone; Herdr
    is the kit's testkit Herdr and GitHub the testkit's fake gh (tests/gate/kit/testkit/gh.py: repo o/r, open issue
    905), first on PATH, the real octo-feather-start and herdr-spawn behind the command. Then reads, as the director
    would: the supervisor in Herdr, the worktree's branch and head, the lane record, what the supervisor received, the
    director log. First, issue-lifecycle#acceptance-lane-start-current-kit: the kit install (OCTO_FEATHER_KIT_INSTALL, a
    scratch kit clone) one commit behind its origin's main is refused with nothing made; the install fast-forwarded as
    the refusal says, the start runs. Cases: features/lane-start.md."""
    w = comms_world(f, "lane-start")
    w.put({"w0:p1": comms_agent("w0:p1", "director")})
    (w.state / "lanes" / "gh7.toml").unlink()
    (w.state / "lanes" / "gh7.handoffs.jsonl").unlink()
    (w.sc / "bin" / "gh").symlink_to(Path(f.s.repo) / "tests" / "gate" / "kit" / "testkit" / "gh.py")
    store = w.sc / "gh"
    (store / "issue").mkdir(parents=True)
    (store / "log").write_text("")
    (store / "repo.json").write_text(json.dumps({"nameWithOwner": "o/r"}))
    none: list[object] = []
    issue: dict[str, object] = {"number": 905, "title": LANE_TITLE, "body": "b", "state": "OPEN",
                                "url": "https://github.com/o/r/issues/905", "parent": None,
                                "blockedBy": {"nodes": none}, "subIssues": {"totalCount": 0, "nodes": none}}
    (store / "issue" / "905.json").write_text(json.dumps(issue))
    base = w.base | {"FAKE_GH": str(store), "GH_TOKEN": "verify-token"}
    clean = {k: v for k, v in case_env(base).items() if k != "GH_REPO"}
    origin, seed, checkout = w.sc / "origin.git", w.sc / "seed", w.sc / "src" / "target"
    ident = ["-c", "user.name=t", "-c", "user.email=t@t", "-c", "commit.gpgsign=false"]
    for argv in (["git", "init", "-q", "--bare", "-b", "main", str(origin)], ["git", "clone", "-q", str(origin), str(seed)],
                 ["git", "-C", str(seed), *ident, "commit", "-q", "--allow-empty", "-m", "first"],
                 ["git", "-C", str(seed), "push", "-q", "origin", "main"],
                 ["git", "clone", "-q", str(origin), str(checkout)],
                 ["git", "-C", str(seed), *ident, "commit", "-q", "--allow-empty", "-m", "main moved"],
                 ["git", "-C", str(seed), "push", "-q", "origin", "main"],
                 [str(Path(f.s.repo) / "scripts" / "pi-role"), "--set-identity", "t", "t@t"]):
        subprocess.run(argv, env=clean, check=True, capture_output=True)
    main = output(["git", "-C", str(seed), "rev-parse", "HEAD"])[1].strip()
    kit_origin, kit_seed, kit = w.sc / "kit-origin.git", w.sc / "kit-seed", w.sc / "kit-install"
    for argv in (["git", "init", "-q", "--bare", "-b", "main", str(kit_origin)], ["git", "clone", "-q", str(kit_origin), str(kit_seed)],
                 ["git", "-C", str(kit_seed), *ident, "commit", "-q", "--allow-empty", "-m", "kit"],
                 ["git", "-C", str(kit_seed), "push", "-q", "origin", "main"],
                 ["git", "clone", "-q", str(kit_origin), str(kit)],
                 ["git", "-C", str(kit_seed), *ident, "commit", "-q", "--allow-empty", "-m", "kit main moved"],
                 ["git", "-C", str(kit_seed), "push", "-q", "origin", "main"]):
        subprocess.run(argv, env=clean, check=True, capture_output=True)
    kit_head = output(["git", "-C", str(kit), "rev-parse", "HEAD"])[1].strip()
    kit_main = output(["git", "-C", str(kit_seed), "rev-parse", "HEAD"])[1].strip()
    say(f"kit install {kit} at {kit_head[:12]}, its origin's main {kit_main[:12]} one commit ahead")
    brief = w.sc / "brief.md"
    brief.write_text(LANE_BRIEF)
    say(f"target {checkout}: origin's main {main[:12]}, the clone's main one commit behind")
    director = base | {"OCTO_FEATHER_ROLE": "director", "HERDR_PANE_ID": "w0:p1", "HERDR_WORKSPACE_ID": "w0",
                        "OCTO_FEATHER_KIT_INSTALL": str(kit)}
    comms_env(f, director)
    f.run("current-kit", "sh", "-c", 'cd "$1" && exec octo-feather-lane start 905 --goal "$2" --outcome "$3" --brief-file "$4"',
          "sh", str(checkout), LANE_TITLE, "a scratch proof", str(brief))
    wt = checkout.with_name("target-gh905")
    log, prompts, record = w.world / "log", w.world / "prompts", w.state / "lanes" / "gh905.toml"
    made = {f"worktree {wt}": wt.exists(), "branch gh905": bool(output(["git", "-C", str(checkout), "branch", "--list", "gh905"])[1]),
            "a herdr call": log.exists() and bool(log.read_text()), "a prompt": prompts.exists(), f"record {record}": record.exists(),
            "a gh call": bool((store / "log").read_text())}
    f.obs("current-kit", "made", ", ".join(k for k, v in made.items() if v))
    f.check("current-kit", lambda c: c.code == 1 and f"kit install {kit} at {kit_head} is behind main on its origin ({kit_main}" in c.err
            and f"git -C {kit} merge --ff-only origin/main" in c.err and c.o["made"] == "")
    subprocess.run(["git", "-C", str(kit), "merge", "-q", "--ff-only", "origin/main"], env=clean, check=True, capture_output=True)
    say(f"kit install fast-forwarded as the refusal says: {kit} at {kit_main[:12]}")
    f.run("start", "sh", "-c", 'cd "$1" && exec octo-feather-lane start 905 --goal "$2" --outcome "$3" --brief-file "$4"',
          "sh", str(checkout), LANE_TITLE, "a scratch proof", str(brief))
    out = (f.d / "start.stdout").read_text()
    pane = next((x.removeprefix("pane=") for x in out.split() if x.startswith("pane=")), "")
    f.check("start", lambda c: c.code == 0 and c.out == f"key=gh905 pane={pane} issue=905\n" and pane.startswith("w"))
    f.run("supervisor", "herdr", "agent", "get", "gh905")
    calls = (w.world / "log").read_text().splitlines()
    f.obs("supervisor", "workspace-create", "\n".join(x for x in calls if x.startswith("workspace create ")))
    f.check("supervisor", lambda c: c.code == 0 and c.j["result"]["agent"]["pane_id"] == pane
            and c.j["result"]["agent"]["cwd"] == str(wt)
            and c.j["result"]["agent"]["workspace_id"] == pane.split(":", maxsplit=1)[0]
            and c.o["workspace-create"].startswith("workspace create --label gh905 ")
            and len(c.o["workspace-create"].splitlines()) == 1)
    f.run("worktree", "git", "-C", str(wt), "log", "-1", "--format=%H %D")
    f.check("worktree", lambda c: c.code == 0 and c.out == f"{main} HEAD -> gh905, origin/main, origin/HEAD\n")
    record = w.state / "lanes" / "gh905.toml"
    f.run("record", "cat", str(record))
    f.check("record", lambda c: c.code == 0 and re.fullmatch(
        f'supervisor = "{re.escape(pane)}"\nrepository = "o/r"\nissue = "gh905"\ngoal = "{LANE_TITLE}"\n'
        'started_at = "\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ"\nwaiting_on = ""\n', c.out) is not None)
    head = (f"Lane facts (octo-feather-lane start):\nLane key: gh905\nParent issue: 905 {LANE_TITLE} "
            f"(https://github.com/o/r/issues/905)\nDirector pane: w0:p1\nWorktree: {wt}\nBranch: gh905\n"
            f"Main commit: {main}\n\n")
    f.run("messages", "cat", str(w.world / "prompts"))
    f.check("messages", lambda c: c.code == 0 and c.out == f"{pane}\t{LANE_GOAL}\n{pane}\t{head}{LANE_BRIEF}\n")
    f.run("director-log", "cat", str(w.state / "director.handoffs.jsonl"))

    def log_ok(c: Case) -> bool:
        lines = [json.loads(x) for x in c.out.splitlines()]
        prods = [x for x in lines if x.get("kind") == "prod"]
        spawns = [x for x in lines if x.get("kind") == "spawn"]
        return (c.code == 0 and len(prods) == 1 and prods[0]["issue"] == "gh905" and set(prods[0]) == {"at", "kind", "issue", "note"}
                and [(x["name"], x["pane"]) for x in spawns] == [("gh905", pane)])
    f.check("director-log", log_ok)
    lane_start_exists(f, w, str(checkout), str(brief))
    lane_start_rerun(f, w, store, str(checkout), str(brief))
    lane_start_files(f, w.sc, store, checkout, clean)
    lane_start_sub_issue(f, w, store, checkout)
    lane_start_unknown(f, w, store, str(checkout), str(brief))
    f.env, f.pre = {}, []
    say(f"lane-start evidence: {f.d}")


LANE_START = 'cd "$1" && exec octo-feather-lane start "$2" --goal "$3" --outcome "$4" --brief-file "$5"'


def lane_start_exists(f: Feature, w: CommsWorld, checkout: str, brief: str) -> None:
    """issue-lifecycle#acceptance-lane-start-exists: the same start again on the finished lane gh905 is refused,
    naming its record, worktree, branch and workspace; each as it was, no supervisor started."""
    world, record, wt = w.world, w.state / "lanes" / "gh905.toml", Path(checkout).with_name("target-gh905")
    was = {"record": record.read_text(), "prompts": (world / "prompts").read_text(),
           "head": output(["git", "-C", str(wt), "rev-parse", "HEAD"])[1], "agents": (world / "agents.json").read_text()}
    calls = len((world / "log").read_text().splitlines())
    f.run("exists", "sh", "-c", LANE_START, "sh", checkout, "905", LANE_TITLE, "a scratch proof", brief)
    now = {"record": record.read_text(), "prompts": (world / "prompts").read_text(),
           "head": output(["git", "-C", str(wt), "rev-parse", "HEAD"])[1], "agents": (world / "agents.json").read_text()}
    f.obs("exists", "unchanged", " ".join(k for k in was if was[k] == now[k]))
    made = [x for x in (world / "log").read_text().splitlines()[calls:] if x.startswith(("workspace create", "tab create", "agent start"))]
    f.obs("exists", "made", "\n".join(made))
    f.check("exists", lambda c: c.code == 1 and c.out == "" and (
        f"lane gh905 exists: lane record {record}, worktree {wt}, branch gh905, Herdr workspace gh905 (") in c.err
        and c.o["unchanged"] == "record prompts head agents" and c.o["made"] == "")


def lane_start_rerun(f: Feature, w: CommsWorld, store: Path, checkout: str, brief: str) -> None:
    """issue-lifecycle#acceptance-lane-start-rerun: lane gh906, the testkit Herdr refusing the goal's delivery once
    (its file prompt-down, agent_blocked: nothing typed): the first start stops naming step goal, the same start again finishes on the same pane,
    one worktree, supervisor, record, goal then brief once each, one spawn and one prod line; a third is refused."""
    issue = json.loads((store / "issue" / "905.json").read_text()) | {"number": 906, "url": "https://github.com/o/r/issues/906"}
    (store / "issue" / "906.json").write_text(json.dumps(issue))
    (w.world / "prompt-down").write_text("")
    argv = ("sh", "-c", LANE_START, "sh", checkout, "906", LANE_TITLE, "a scratch proof", brief)
    f.run("rerun-stopped", *argv)
    f.check("rerun-stopped", lambda c: c.code == 1 and "step goal (made so far: " in c.err
            and " exit 75 (" in c.err and "not delivered; rerun once the cause is fixed" in c.err)
    f.run("rerun", *argv)
    out = (f.d / "rerun.stdout").read_text()
    pane = next((x.removeprefix("pane=") for x in out.split() if x.startswith("pane=")), "")
    wt = Path(checkout).with_name("target-gh906")
    trees = output(["git", "-C", checkout, "worktree", "list", "--porcelain"])[1].splitlines()
    f.obs("rerun", "worktrees", "\n".join(x for x in trees if x.startswith("worktree ") and "gh906" in x))
    agents = json.loads((w.world / "agents.json").read_text())
    f.obs("rerun", "supervisors", " ".join(p for p, g in agents.items() if g["name"] == "gh906"))
    f.obs("rerun", "lanes", " ".join(sorted(p.name for p in (w.state / "lanes").iterdir() if "gh906" in p.name)))
    f.obs("rerun", "prompts", (w.world / "prompts").read_text())
    log = [json.loads(x) for x in (w.state / "director.handoffs.jsonl").read_text().splitlines()]
    f.obs("rerun", "log", " ".join(x["kind"] for x in log if "gh906" in (x.get("name"), x.get("issue"))))
    main = output(["git", "-C", str(wt), "rev-parse", "HEAD"])[1].strip()
    head = (f"Lane facts (octo-feather-lane start):\nLane key: gh906\nParent issue: 906 {LANE_TITLE} "
            f"(https://github.com/o/r/issues/906)\nDirector pane: w0:p1\nWorktree: {wt}\nBranch: gh906\n"
            f"Main commit: {main}\n\n")
    goal = LANE_GOAL.replace("gh905", "gh906")
    f.check("rerun", lambda c: c.code == 0 and c.out == f"key=gh906 pane={pane} issue=906\n" and pane.startswith("w")
            and c.o["worktrees"] == f"worktree {wt}" and c.o["supervisors"] == pane and c.o["lanes"] == "gh906.toml"
            and c.o["prompts"].endswith(f"{pane}\t{goal}\n{pane}\t{head}{LANE_BRIEF}\n")
            and c.o["prompts"].count(f"{pane}\t") == 2 and c.o["log"] == "spawn prod")
    f.run("rerun-refused", *argv)
    f.check("rerun-refused", lambda c: c.code == 1
            and f"lane gh906 exists: lane record {w.state / 'lanes' / 'gh906.toml'}, " in c.err)


def lane_start_unknown(f: Feature, w: CommsWorld, store: Path, checkout: str, brief: str) -> None:
    """issue-lifecycle#acceptance-lane-start-rerun, an unknown send: lane gh909, the testkit Herdr timing out the goal's
    send once (its file prompt-timeout: submitted, no turn seen; herdr-say exit 124). The first start stops, delivery
    unknown; the same start again refuses naming the unknown send and the pane to look at, sending nothing; with
    --shown goal (the pane shows it) it finishes, the goal and the brief once each."""
    issue = json.loads((store / "issue" / "905.json").read_text()) | {"number": 909, "url": "https://github.com/o/r/issues/909"}
    (store / "issue" / "909.json").write_text(json.dumps(issue))
    (w.world / "prompt-timeout").write_text("")
    args = ("sh", checkout, "909", LANE_TITLE, "a scratch proof", brief)
    goal = LANE_GOAL.replace("gh905", "gh909")

    def pane() -> str:
        return next((p for p, g in json.loads((w.world / "agents.json").read_text()).items() if g["name"] == "gh909"), "")

    def goals() -> str:
        return str(sum(x == f"{pane()}\t{goal}" for x in (w.world / "prompts").read_text().splitlines()))

    f.run("unknown-stopped", "sh", "-c", LANE_START, *args)
    f.obs("unknown-stopped", "goals", goals())
    f.check("unknown-stopped", lambda c: c.code == 1 and f"herdr-say {pane()} exit 124 (" in c.err
            and "delivery unknown, not sent again blind" in c.err and c.o["goals"] == "1")
    f.run("unknown-refused", "sh", "-c", LANE_START, *args)
    f.obs("unknown-refused", "goals", goals())
    f.check("unknown-refused", lambda c: c.code == 1
            and f"step goal: the goal send to {pane()} is unknown (herdr-say {pane()} exit 124" in c.err
            and f"look at supervisor pane {pane()} (herdr pane read {pane()})" in c.err
            and "--shown goal" in c.err and "--absent goal" in c.err and c.o["goals"] == "1")
    f.run("unknown-shown", "sh", "-c", LANE_START + " --shown goal", *args)
    f.obs("unknown-shown", "goals", goals())
    f.obs("unknown-shown", "briefs", str((w.world / "prompts").read_text().count(f"{pane()}\tLane facts")))
    f.check("unknown-shown", lambda c: c.code == 0 and c.out == f"key=gh909 pane={pane()} issue=909\n"
            and c.o["goals"] == "1" and c.o["briefs"] == "1")


LANE_NEW = "Scratch lane"
LANE_BODY = "The scratch lane's parent.\nIt has two lines.\n"


def lane_start_files(f: Feature, sc: Path, store: Path, checkout: Path, clean: dict[str, str]) -> None:
    """issue-lifecycle#acceptance-lane-start-files: the director starts a lane naming a title and a body file instead of a
    ticket; the gh stand-in files issue 907 (one `issue create`, no --parent), the start prints it, then starts gh907."""
    body, brief = sc / "body.md", sc / "brief.md"
    body.write_text(LANE_BODY)
    f.run("files", "sh", "-c", 'cd "$1" && exec octo-feather-lane start --new "$2" --body-file "$3" --goal "$2" --outcome "$4"'
          ' --brief-file "$5"', "sh", str(checkout), LANE_NEW, str(body), "a scratch proof", str(brief))
    f.obs("files", "gh-creates", "\n".join(x for x in (store / "log").read_text().splitlines() if x.startswith("issue create")))
    view = Path(f.s.repo) / ".agents" / "skills" / "github-issues" / "scripts" / "issue-view"
    f.obs("files", "issue-view-907", subprocess.run([str(view), "907"], env=clean, capture_output=True, text=True, check=False).stdout)
    f.obs("files", "worktree", output(["git", "-C", str(checkout.with_name("target-gh907")), "rev-parse", "--abbrev-ref", "HEAD"])[1])

    def ok(c: Case) -> bool:
        lines = c.out.splitlines()
        v = json.loads(c.o["issue-view-907"] or "{}")
        return (c.code == 0 and len(lines) == 2 and lines[0] == "filed=907"
                and re.fullmatch(r"key=gh907 pane=w\S+ issue=907", lines[1]) is not None
                and c.o["gh-creates"] == f"issue create --title {LANE_NEW} --body-file {body}"
                and (v.get("title"), v.get("body"), v.get("parent")) == (LANE_NEW, LANE_BODY, None)
                and c.o["worktree"].strip() == "gh907")
    f.check("files", ok)


def lane_start_sub_issue(f: Feature, w: CommsWorld, store: Path, checkout: Path) -> None:
    """issue-lifecycle#acceptance-lane-start-sub-issue: ticket 908, a sub-issue of 905, is refused naming 905, and no
    worktree, branch, workspace, record or prompt exists for gh908."""
    none: list[object] = []
    child: dict[str, object] = {"number": 908, "title": "A child", "body": "b", "state": "OPEN",
                                "url": "https://github.com/o/r/issues/908", "parent": {"number": 905},
                                "blockedBy": {"nodes": none}, "subIssues": {"totalCount": 0, "nodes": none}}
    (store / "issue" / "908.json").write_text(json.dumps(child))
    calls = len((w.world / "log").read_text().splitlines())
    prompts = (w.world / "prompts").read_text()
    f.run("sub-issue", "sh", "-c", 'cd "$1" && exec octo-feather-lane start 908 --goal "A child" --outcome "$2" --brief-file "$3"',
          "sh", str(checkout), "a scratch proof", str(w.sc / "brief.md"))
    made = [str(p) for p in (checkout.with_name("target-gh908"), w.state / "lanes" / "gh908.toml") if p.exists()]
    made += output(["git", "-C", str(checkout), "branch", "--list", "gh908"])[1].split()
    new_calls = (w.world / "log").read_text().splitlines()[calls:]
    made += [x for x in new_calls if x.startswith(("workspace create", "tab create"))]
    made += ["prompt"] if (w.world / "prompts").read_text() != prompts else []
    f.obs("sub-issue", "made", "\n".join(made))
    f.check("sub-issue", lambda c: c.code == 1 and c.out == "" and "ticket 908 is a sub-issue of 905" in c.err
            and c.o["made"] == "")



DEAD_MODEL = """import socket, sys
s = socket.socket(); s.bind(("127.0.0.1", 0)); s.listen(64)
open(sys.argv[1], "w").write(str(s.getsockname()[1]))
held = []
while True:
    held.append(s.accept()[0])  # never answers: a model turn stays busy until aborted
"""


def herdr_scope() -> Any:
    """The kit's Herdr readers (.agents/skills/herdr-comms/assets/herdr_scope.py): each Herdr answer checked against
    the shape Herdr states for it, the failing field named."""
    path = REPO / ".agents" / "skills" / "herdr-comms" / "assets" / "herdr_scope.py"
    loader = importlib.machinery.SourceFileLoader("herdr_scope", str(path))
    spec = importlib.util.spec_from_loader("herdr_scope", loader)
    assert spec
    mod = sys.modules["herdr_scope"] = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def json_object(v: object, where: str) -> dict[str, object]:
    """V, a decoded JSON value, as an object; TypeError naming WHERE when it is not."""
    if not isinstance(v, dict):
        msg = f"{where}: not a JSON object"
        raise TypeError(msg)
    return cast("dict[str, object]", v)


def pi_user_texts(path: Path) -> list[str]:
    """The user messages' text parts in Pi session file PATH, each JSONL record decoded and its fields checked: a
    record an object with a string `type`; a `message` record's `message` an object with a string `role`; a user
    message's `content` a list of objects, a `text` part's `text` a string. TypeError (ValueError: not JSON) naming the line and field."""
    out: list[str] = []
    for n, line in enumerate(path.read_text().splitlines(), 1):
        at = f"{path}:{n}"
        rec = json_object(json.loads(line), at)
        if not isinstance(rec.get("type"), str):
            msg = f"{at}.type: not a string"
            raise TypeError(msg)
        if rec["type"] != "message":
            continue
        message = json_object(rec.get("message"), f"{at}.message")
        if not isinstance(message.get("role"), str):
            msg = f"{at}.message.role: not a string"
            raise TypeError(msg)
        if message["role"] != "user":
            continue
        content = message.get("content")
        if not isinstance(content, list):
            msg = f"{at}.message.content: not a list"
            raise TypeError(msg)
        for i, part in enumerate(cast("list[object]", content)):
            item = json_object(part, f"{at}.message.content[{i}]")
            if item.get("type") == "text":
                text = item.get("text")
                if not isinstance(text, str):
                    msg = f"{at}.message.content[{i}].text: not a string"
                    raise TypeError(msg)
                out.append(text)
    return out


def drive_director_relaunch(f: Feature) -> None:
    """comms#acceptance-director-relaunch-busy, -own-scope, -same-session: a real scratch Herdr server (its own
    XDG_CONFIG_HOME and session, never the box's), a real Pi director started by `octo-feather-start --director`, its
    model a local socket that never answers (a turn stays busy), its agent scope the box's real systemd user manager's.
    The refusals, each leaving the director's pane and director.toml as they were, then the relaunch: a new pane= that
    `herdr agent get director` and director.toml name, one Pi on the session, one message naming the old pane. The
    server and the dead model stopped through their pid files. Cases: features/director-relaunch.md."""
    pi_bin = shutil.which("pi") or str(Path.home() / ".local" / "pi" / "pi")
    need = [n for n, ok in (("herdr", shutil.which("herdr")), ("pi", Path(pi_bin).exists()),
                            ("a systemd user manager", output(["systemctl", "--user", "is-system-running"])[1].strip()
                             in ("running", "degraded"))) if not ok]
    models = Path.home() / ".pi" / "agent" / "models.json"
    if need or not models.is_file():
        f.unreachable_step("director-relaunch", f"needs {', '.join(need) or str(models)} on this box; no case ran")
        return
    sc = RUN_DIR / "scratch" / "director-relaunch"
    shutil.rmtree(sc, ignore_errors=True)
    for d in ("state", "pi-agent", "pids", "tmp", "steps", "logs"):
        (sc / d).mkdir(parents=True)
    # Herdr's config dir holds its socket, whose path must fit sun_path (108 bytes): a short dir of its own under
    # /tmp, removed at the end, linked from the scratch as xdg-config.
    xdg = Path(tempfile.mkdtemp(prefix="vof-", dir="/tmp"))
    (xdg / "herdr").mkdir()
    (sc / "xdg-config").symlink_to(xdg)
    session = "verify-relaunch"
    sock = xdg / "herdr" / "sessions" / session / "herdr.sock"
    kit = Path(f.s.repo)
    base = {"XDG_CONFIG_HOME": str(xdg), "XDG_STATE_HOME": str(sc / "state"), "HERDR_SESSION": session,
            "HERDR_SOCKET_PATH": str(sock), "PI_CODING_AGENT_DIR": str(sc / "pi-agent"), "PI_OFFLINE": "1",
            "PI_SKIP_VERSION_CHECK": "1", "PI_TELEMETRY": "0", "TMPDIR": str(sc / "tmp")}
    env = case_env(base)
    scope = herdr_scope()  # its calls run in this process's environment: the scratch one while the drive runs
    saved = dict(os.environ)

    def h(*args: str) -> str:
        return subprocess.run(["herdr", *args], env=env, capture_output=True, text=True, check=False).stdout

    def bg(name: str, *argv: str) -> None:  # setsid, its pid file in sc/pids, stopped in the finally below
        subprocess.Popen(["setsid", "sh", "-c", f'echo $$ > "{sc / "pids" / name}"; exec "$@"', "_", *argv], env=env,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def until(test: Callable[[], bool], secs: float) -> bool:
        end = datetime.now(UTC).timestamp() + secs
        while not test():
            if datetime.now(UTC).timestamp() > end:
                return False
            subprocess.run(["sleep", "0.5"], check=False)
        return True

    def agent(target: str, field: str) -> str:  # FIELD of `herdr agent get TARGET`, validated; '' with no such agent
        try:
            answer = scope.herdr("agent", "get", target)
        except scope.HerdrFailedError:
            return ""
        return str(scope.found(answer, f"herdr agent get {target}", "agent", scope.AGENT_FIELDS, field))

    def status(pane: str) -> str:
        return agent(pane, "agent_status")

    def workspaces() -> list[str]:  # `herdr workspace list`'s ids, its envelope and each workspace_id checked
        where = "herdr workspace list"
        got = scope.result(scope.herdr("workspace", "list"), where, "workspace_list", "workspaces")
        if not isinstance(got, list):
            msg = f"{where}: result.workspaces not a list"
            raise scope.BadAnswerError(msg)
        items = cast("list[object]", got)
        return [scope.text(json_object(v, f"{where}: result.workspaces[{i}]"), "workspace_id",
                           f"{where}: result.workspaces[{i}]") for i, v in enumerate(items)]

    def answers() -> bool:
        try:
            workspaces()
        except scope.HerdrFailedError:
            return False
        return True

    toml = sc / "state" / "octo-feather" / "sessions" / session / "director.toml"

    def director_now(name: str) -> None:  # the director as Herdr and director.toml name it, after case NAME
        f.obs(name, "director", agent("director", "pane_id"))
        f.obs(name, "toml", toml.read_text() if toml.is_file() else "")

    def typed(pane: str, name: str, script: str) -> None:  # a `!!bash` step typed into the Pi at PANE (no model turn)
        (sc / "steps" / f"{name}.sh").write_text(script)
        h("pane", "run", pane, f"!!bash {sc / 'steps' / f'{name}.sh'}")

    try:
        os.environ.clear()
        os.environ.update(env)
        port = sc / "dead-model.port"
        bg("dead-model", sys.executable, "-c", DEAD_MODEL, str(port))
        if not until(lambda: port.is_file() and port.read_text().strip() != "", 10):
            msg = "the dead model socket did not start"
            raise RuntimeError(msg)
        m = json_object(json.loads(models.read_text()), str(models))
        providers = json_object(m.get("providers", {}), f"{models}: providers")
        for k, v in providers.items():
            p = json_object(v, f"{models}: providers.{k}")
            p["baseUrl"], p["apiKey"] = f"http://127.0.0.1:{port.read_text().strip()}", "invalid-verify"
        (sc / "pi-agent" / "models.json").write_text(json.dumps(m))
        user = models.parent / "settings.json"
        own = json_object(json.loads(user.read_text()), str(user)) if user.is_file() else {}
        settings: dict[str, object] = {k: own[k] for k in ("defaultProvider", "defaultModel", "enabledModels") if k in own}
        (sc / "pi-agent" / "settings.json").write_text(json.dumps(settings | {"retry": {"enabled": False}}))
        (sc / "pi-agent" / "auth.json").write_text("{}")
        (xdg / "herdr" / "config.toml").write_text(
            "[update]\nversion_check = false\nmanifest_check = false\n[session]\nresume_agents_on_restore = false\n")
        bg("herdr-server", "herdr", "--session", session, "server")
        if not until(lambda: sock.exists() and answers(), 15):
            msg = "the scratch Herdr server did not answer"
            raise RuntimeError(msg)
        say(f"scratch Herdr session {session}: socket {sock}")
        target = sc / "target"
        name = output(["git", "-C", str(kit), "config", "user.name"])[1].strip() or "verify"
        email = output(["git", "-C", str(kit), "config", "user.email"])[1].strip() or "verify@invalid"
        for argv in (["git", "init", "-q", "-b", "main", str(target)], [str(kit / "scripts" / "pi-role"), "--set-identity", name, email]):
            subprocess.run(argv, env=env, check=True, capture_output=True)
        toml.parent.mkdir(parents=True, exist_ok=True)
        # A reflection just ran: an octo-feather-start runs none in the background (scripts/octo-feather-start).
        toml.with_name("director.handoffs.jsonl").write_text(json.dumps({"at": now(), "kind": "reflection"}) + "\n")
        f.env = base
        start = ["octo-feather-start", "--director", "--cwd", str(target)]
        f.run("start", *start)
        out = (f.d / "start.stdout").read_text()
        old = next((x[5:] for x in out.split() if x.startswith("pane=")), "")
        sid = next((x[20:] for x in out.split() if x.startswith("provider_session_id=")), "")
        typed(old, "director-toml", 'printf \'pane = "%s"\\n\' "$HERDR_PANE_ID" > "$(octo-feather-state)/director.toml"\n')
        until(toml.is_file, 20)
        director_now("start")
        say(f"start: director {old} session {sid}; director.toml {toml.read_text().strip() if toml.is_file() else '(none)'}")
        f.check("start", lambda c: c.code == 0 and old and sid and c.o["director"] == old
                and c.o["toml"] == f'pane = "{old}"\n')
        unchanged = f'pane = "{old}"\n'

        def held(c: Case) -> bool:
            return c.o["director"] == old and c.o["toml"] == unchanged

        subprocess.run([str(kit / ".agents/skills/herdr-comms/assets/herdr-say"), old, "verify: a turn the model never answers"],
                       env=env, capture_output=True, check=False)
        until(lambda: status(old) == "working", 20)
        f.run("busy", *start[:2], "--relaunch", "--wait", "20", *start[2:])
        director_now("busy")
        f.obs("busy", "status", status(old))
        f.check("busy", lambda c: c.code == 75 and "busy" in c.err and old in c.err and held(c) and c.o["status"] == "working")
        h("pane", "send-keys", old, "Escape")
        until(lambda: status(old) in ("idle", "done"), 20)
        job = sc / "logs" / "own-scope.log"
        relaunch = f"octo-feather-start --director --relaunch --wait 20 --cwd {target}"
        typed(old, "own-scope", f"(env -u HERDR_PANE_ID setsid sh -c 'cat /proc/self/cgroup; {relaunch}; echo rc=$?' "
                                f"> {job} 2>&1 </dev/null &)\n")
        f.run("own-scope", "cat", str(sc / "steps" / "own-scope.sh"))
        until(lambda: job.is_file() and "rc=" in job.read_text(), 60)
        f.obs("own-scope", "job", job.read_text() if job.is_file() else "")
        director_now("own-scope")
        say(f"own-scope: the job typed into {old}'s Pi printed: {f.d / 'own-scope.obs.job'}")
        f.check("own-scope", lambda c: "rc=64" in c.o["job"] and f"octo-feather-agent-{old}-" in c.o["job"]
                and f"director pane {old}'s agent scope" in c.o["job"] and held(c))
        f.run("own-pane", "env", f"HERDR_PANE_ID={old}", *start[:2], "--relaunch", "--wait", "20", *start[2:])
        director_now("own-pane")
        f.check("own-pane", lambda c: c.code == 64 and f"HERDR_PANE_ID is the director's pane {old}" in c.err and held(c))
        f.run("same-session", *start[:2], "--resume", sid, *start[2:])
        director_now("same-session")
        f.check("same-session", lambda c: c.code == 73 and old in c.err and sid in c.err and held(c))
        f.run("bare", *start)
        director_now("bare")
        f.check("bare", lambda c: c.code == 73 and "--relaunch" in c.err and "--replace" in c.err and held(c))
        pid = sc / "logs" / "bg-job.pid"
        typed(old, "bg-job", f"(setsid sleep 600 </dev/null >/dev/null 2>&1 & echo $! > {pid})\n")
        until(lambda: pid.is_file() and pid.read_text().strip() != "", 20)
        f.run("park-refused", *start[:2], "--relaunch", "--wait", "90", *start[2:])
        director_now("park-refused")
        f.check("park-refused", lambda c: c.code == 75 and f"{old} not parked" in c.err and "no plain close" in c.err
                and held(c))
        subprocess.run(["kill", pid.read_text().strip()], check=False)
        f.run("relaunch", *start[:2], "--relaunch", "--wait", "120", *start[2:])
        out = (f.d / "relaunch.stdout").read_text()
        new = next((x[5:] for x in out.split() if x.startswith("pane=")), "")
        director_now("relaunch")
        f.obs("relaunch", "pi", str(len(output(["pgrep", "-f", "--", f"--session-id {sid}"])[1].split())))
        # What the new pane received, from Pi's own session file (the pane wraps long lines), each record decoded.
        texts = [t for p in (sc / "pi-agent" / "sessions").glob(f"*/*_{sid}.jsonl") for t in pi_user_texts(p)]
        f.obs("relaunch", "received", "\n".join(t for t in texts if t.startswith("Relaunched (")))
        say(f"relaunch: new pane {new}; agent get director, director.toml and the message: {f.d}")
        f.check("relaunch", lambda c: c.code == 0 and new not in ("", old) and c.o["director"] == new
                and c.o["toml"] == f'pane = "{new}"\n' and c.o["pi"] == "1" and len(c.o["received"].splitlines()) == 1
                and f"replacing pane {old}, session {sid}" in c.o["received"] and "director.handoffs.jsonl" in c.o["received"])
    finally:
        f.env = {}
        try:
            if sock.exists():
                for w in workspaces():
                    subprocess.run([str(kit / ".agents/skills/herdr-comms/assets/herdr-close"), w], env=env,
                                   capture_output=True, check=False)
        finally:  # whatever Herdr answered: the server and the dead model stopped, the caller's environment back
            if sock.exists():
                h("server", "stop")
            for p in sorted((sc / "pids").glob("*")) if (sc / "pids").is_dir() else []:
                if p.read_text().strip():
                    subprocess.run(["kill", "--", f"-{p.read_text().strip()}"], capture_output=True, check=False)
                p.unlink()
            shutil.rmtree(xdg, ignore_errors=True)
            os.environ.clear()
            os.environ.update(saved)
        say(f"director-relaunch: scratch Herdr {session} and the dead model stopped; evidence: {f.d}")


DRIVES: dict[str, Callable[[Feature], None]] = {
    "new-repo": drive_new_repo,
