// The kit's own TypeScript and JavaScript (#245, #361): templates/typescript's compiler settings, allowJs and
// checkJs so tooling JavaScript (eslint.config.js) is gated too. This file is the one declaration of which files the
// gate checks: tsc reads it and eslint.config.js lints exactly the files it lists (just check-ts); check-languages
// fails when scc finds tracked TypeScript or JavaScript it misses. tests/fixtures/ is kit test code (Pi extensions
// the tests load), so it is in. tsc's wildcard skips dot directories: a dot path is named here.
{
  "extends": ["@tsconfig/strictest/tsconfig.json", "@tsconfig/node22/tsconfig.json"],
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"]
  },
  "include": ["**/*"],
  "exclude": [
    // Installed packages, not kit code.
    "node_modules",
    // Eval fixtures are data: seeded target repos whose flaws the eval cases need.
    "evals/fixtures",
    // Each template is a target repo with its own tsconfig, eslint config and `just check`.
    "templates",
    // Scratch space (.gitignore), never tracked.
    "tmp"
  ]
}
