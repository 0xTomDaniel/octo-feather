# The one gate (AGENTS.md): agents, .githooks/pre-commit and CI run `just check`.

set shell := ["bash", "-euo", "pipefail", "-c"]
# Recipe arguments reach the shell as "$@", never as pasted text.
set positional-arguments

default:
    @just --list

# Install dependencies and the git hook.
setup:
    uv sync --locked
    git config core.hooksPath .githooks

# The gate's steps, each one pytest item (tests/test_gate.py) beside the integration and E2E tests.
# Every tracked file's language and the tools that gate it: languages.json, checked and run by
# scripts/check-languages (the octo-feather kit's checker, copied byte for byte).
export GATE_RECIPES := "install-check check-languages check-scripts check-lint check-format check-types check-imports"

# Lint, format, types, shell, import boundaries, integration and E2E tests, each a pytest item (AGENTS.md
# Commands; trend line: tests/conftest.py). Timing never decides pass or fail.
check: check-tests

# Every tracked file is of a declared language or a reasoned exemption, each tool bound below.
check-languages:
    @python3 scripts/check-languages

check-scripts:
    @python3 scripts/check-languages run check-scripts

check-lint:
    @python3 scripts/check-languages run check-lint

check-format:
    @python3 scripts/check-languages run check-format

check-types:
    @python3 scripts/check-languages run check-types

check-imports:
    uv run --locked --offline --no-sync lint-imports

# Each gate tool at the one pin CI installs from: scripts/install-check.
install-check:
    python3 scripts/install-check

# uv sync, then pytest; a gate run inside another gate's item (GATE_NESTED set) is sequential and stops at
# its first failure (-n 0 -x). Extra arguments go to pytest.
check-tests *args:
    @python3 scripts/check-languages gate "$@"

# The gate's pytest items, all or a subset by pytest arguments (`just test -k check-types`, `just test --lf`).
test *args:
    @just check-tests "$@"

# Integrate worker commits onto the lane of TICKET (12, ENG-123), its branch the lane key (octo-feather kit script on PATH).
integrate issue +refs:
    octo-feather-integrate "$@"

# Product QC on the lane head: passed criteria become built (octo-feather kit script on PATH; never in check).
qc $status $pr +$ids:
    octo-feather-qc "$@"
