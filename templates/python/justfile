# The one gate (AGENTS.md): agents, .githooks/pre-commit and CI run `just check`.

set shell := ["bash", "-euo", "pipefail", "-c"]
# Recipe arguments reach the shell as "$@", never as pasted text.
set positional-arguments

# This repo's tools (mise.toml at mise.lock versions) on PATH for every recipe, from any caller (a shell, the git
# hook, CI, an agent pane): mise's own answer for this repo's config (`mise bin-paths`, the config its shims read),
# placed just before the caller PATH's first system dir (/usr/local/sbin /usr/local/bin /usr/sbin /usr/bin /sbin
# /bin; at the end when it has none): mise replaces only what would resolve from the system, and every dir the
# caller put earlier still wins. A tool not installed is named on stderr with the fix. Only this repo's tools, which
# scripts/own-tool-paths names: `mise bin-paths` alone adds the user's global mise tools too (octo-feather #500).
export PATH := `command -v mise >/dev/null || { echo "just: mise is not on PATH, so this repo's tools (mise.toml) are not resolved; install mise $(cat mise-version) (mise-version)" >&2; printf '%s' "$PATH"; exit 0; }; m="$(mise ls --local --missing 2>/dev/null | awk '{print $1 "@" $2}' | paste -sd ' ' -)"; [[ -z "$m" ]] || echo "just: not installed: $m (mise.toml, mise.lock); run: octo-feather-mise-install (the octo-feather kit's scripts/)" >&2; add="$(python3 scripts/own-tool-paths 2>/dev/null)"; out=""; put=""; IFS=: read -ra ds <<<"$PATH"; for d in "${ds[@]}"; do [[ -n "$d" ]] || continue; case "${d%/}" in /usr/local/sbin|/usr/local/bin|/usr/sbin|/usr/bin|/sbin|/bin) [[ -n "$put" ]] || { out+="${add:+$add:}"; put=1; } ;; esac; out+="$d:"; done; [[ -n "$put" ]] || out+="${add:+$add:}"; printf '%s' "${out%:}"`

default:
    @just --list

# Install the pinned tools (mise.toml, mise.lock), dependencies and the git hook. The tools: octo-feather-mise-install,
# the octo-feather kit's one install of a repo's own locked mise tools (why not a bare mise install: its --help), when
# on PATH (an agent pane's); else mise's own `mise install --locked`, and on its failure the kit command is named.
setup:
    @if command -v octo-feather-mise-install >/dev/null; then octo-feather-mise-install; else mise install --locked || { rc=$?; echo "just setup: mise install --locked failed (exit $rc); if it names tools of your global mise config, install only this repo's: octo-feather-mise-install, in the octo-feather kit's scripts dir (e.g. ~/src/octo-feather/scripts/octo-feather-mise-install)" >&2; exit "$rc"; }; fi
    uv sync --locked
    git config core.hooksPath .githooks

# The gate's steps, each one pytest item (tests/test_gate.py) beside the integration and E2E tests.
export GATE_RECIPES := "check-languages check-scripts check-lint check-format check-types check-imports"

# Lint, format, types, import boundaries, integration and E2E tests, each a pytest item (AGENTS.md Commands;
# trend line: tests/conftest.py). Timing never decides pass or fail.
check: check-tests

# Every language scc finds in the tracked files has its lint and type step here; rules and what passes by design:
# the head of scripts/check-languages (the octo-feather kit's, a byte copy).
check-languages:
    uv run --locked scripts/check-languages

# check-languages' data (the head of scripts/check-languages): one LANGUAGE:TOOL:GATE_RECIPE:FILES_RECIPE entry
# per language scc can name and gate tool that must cover its files; FILES_RECIPE prints that tool's own file list.
check_languages := "Python:ruff:check-lint:ruff-files Python:basedpyright:check-types:pyright-files Shell:shellcheck:check-scripts:shell-files BASH:shellcheck:check-scripts:shell-files"

# ruff's own file list: name an extensionless script in pyproject.toml [tool.ruff] extend-include
ruff-files:
    @uv run --locked ruff check --show-files

# Its --verbose --stats listing, both projects (check-types).
# basedpyright's analyzed files: add a path to [tool.basedpyright] include (under .agents/: .agents/pyrightconfig.json)
pyright-files:
    @{ uv run --locked basedpyright --verbose --stats || true; uv run --locked basedpyright -p .agents --verbose --stats || true; } | sed -n 's|^[0-9]*ms: file://||p'

# ShellCheck's file list: give a file the `shell` attribute in .gitattributes
shell-files:
    @git ls-files ':(attr:shell)'

check-scripts:
    just shell-files | xargs -d '\n' shellcheck -S warning

check-lint:
    uv run --locked ruff check .

check-format:
    uv run --locked ruff format --check .

# Two projects: basedpyright's CLI skips dot directories, so .agents/ has its own (.agents/pyrightconfig.json).
check-types:
    uv run --locked basedpyright
    uv run --locked basedpyright -p .agents

check-imports:
    uv run --locked lint-imports

# A gate run inside another gate's item (GATE_NESTED set) is sequential and stops at its first failure
# (-n 0 -x). Extra arguments go to pytest.
check-tests *args:
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ -n "${GATE_NESTED:-}" ]]; then set -- -n 0 -x "$@"; else set -- -n "${GATE_WORKERS:-2}" "$@"; fi
    GATE_NESTED=1 exec uv run --locked pytest "$@"

# The gate's pytest items, all or a subset by pytest arguments (`just test -k check-types`, `just test --lf`).
test *args:
    @just check-tests "$@"

# Integrate worker commits onto the lane of TICKET (12, ENG-123), its branch the lane key (octo-feather kit script on PATH).
integrate issue +refs:
    octo-feather-integrate "$@"

# Product QC on the lane head: passed criteria become built (octo-feather kit script on PATH; never in check).
qc $status $pr +$ids:
    octo-feather-qc "$@"
