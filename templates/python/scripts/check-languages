#!/usr/bin/env python3
"""Every language in this repo's tracked files has its lint and type step in `just check`.

The octo-feather kit's check; templates/python carries a byte copy, templates/typescript a port
(scripts/check-languages.ts). Rule owners: issue #261 comment 6498859284 (with #225 comment
6446828103). Each repo's own data, read at run time: the justfile's `check_languages` (language,
tool, gate recipe, the recipe printing the tool's file list), its gate (GATE_RECIPES and what
`check` depends on), and .gitattributes `language-exempt` (paths not scanned).

Fails, naming each file and its fix: 1. scc calls a tracked file Unknown;
2. a language is neither in `check_languages` nor DATA; 3. a tool's file list misses a file of its
language; 4. a tool's gate recipe is not in the gate; 5. a file scc does not list starts with `#!`
(scc drops `env -S` shebangs); 6. mise.toml pins pnpm and package.json has `packageManager`.
Passes by design: a file scc does not list that does not start with `#!` (no language found).
"""

import json
import shutil
import subprocess
import sys
from pathlib import Path
from typing import Any

# Languages that are data, with no lint or type step.
DATA = {
    "Markdown",
    "JSON",
    "JSONL",
    "TOML",
    "YAML",
    "HTML",
    "CSS",
    "Patch",
    "Plain Text",
    "License",
}


class UnansweredError(Exception):
    """A tool gave no usable answer: the check cannot pass."""


def missing_tool(tool: str) -> str:
    mise = shutil.which("mise")
    if mise is None:
        return "mise is not on PATH: install mise at mise-version, then: octo-feather-mise-install"
    r = subprocess.run([mise, "which", tool], capture_output=True, text=True, check=False)
    if r.returncode == 0:
        return f"{tool} is installed ({r.stdout.strip()}) but not on PATH: run this through just"
    return f"{tool} is not installed: octo-feather-mise-install (mise.toml, mise.lock)"


def ask(*cmd: str) -> str:
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, check=False)
    except OSError as e:
        msg = f"cannot run {cmd[0]}: {e}; {missing_tool(cmd[0])}"
        raise UnansweredError(msg) from e
    if r.returncode != 0:
        msg = f"{' '.join(cmd)} exited {r.returncode}: {r.stderr.strip()}"
        raise UnansweredError(msg)
    return r.stdout


def relative(line: str) -> str:
    path = Path(line)
    if path.is_absolute():
        return path.resolve().relative_to(Path.cwd().resolve()).as_posix()
    return line.removeprefix("./")


def scanned() -> set[str]:
    out = ask("git", "ls-files", "-z", "--", ".", ":(exclude,attr:language-exempt)")
    return {f for f in out.split("\0") if f and Path(f).is_file() and not Path(f).is_symlink()}


def scc_languages(files: set[str]) -> dict[str, str]:
    # scc walks the directory: named on its command line, a file under a dot dir loses its shebang.
    out = ask("scc", "--by-file", "--format", "json", "--count-unsupported", "--no-config", ".")
    found: dict[str, str] = {}
    langs: list[dict[str, Any]] = json.loads(out)
    for lang in langs:
        entries: list[dict[str, str]] = lang.get("Files") or []
        for f in entries:
            if relative(f["Location"]) in files:
                found[relative(f["Location"])] = lang["Name"]
    return found


def justfile() -> tuple[list[list[str]], set[str], dict[str, Any]]:
    dump: dict[str, Any] = json.loads(
        ask("just", "--justfile", "justfile", "--dump", "--dump-format", "json")
    )
    rows = [e.split(":") for e in dump["assignments"]["check_languages"]["value"].split()]
    gate = set(dump["assignments"].get("GATE_RECIPES", {}).get("value", "").split())
    todo = ["check"]
    while todo:
        for dep in dump["recipes"].get(todo.pop(), {}).get("dependencies", []):
            if dep["recipe"] not in gate:
                gate.add(dep["recipe"])
                todo.append(dep["recipe"])
    return rows, gate, dump


def findings(
    found: dict[str, str], rows: list[list[str]], gate: set[str], dump: dict[str, Any]
) -> list[str]:
    bad: list[str] = []
    lists: dict[str, set[str]] = {}
    for lang in sorted(set(found.values())):
        files = sorted(f for f, name in found.items() if name == lang)
        tools = [row for row in rows if row[0] == lang]
        if lang == "Unknown":
            bad += [
                f"{f}: scc does not know this file type; give it a known extension, or mark it"
                " `language-exempt` in .gitattributes with the reason"
                for f in files
            ]
        elif not tools and lang not in DATA:
            bad.append(
                f"{lang} ({', '.join(files)}) has no lint or type step: add its tools to the gate"
                " and to the justfile's check_languages, or declare it DATA in check-languages"
            )
        for _, tool, recipe, files_recipe in tools:
            if recipe not in gate:
                bad.append(f"{tool} gates {lang}, but its recipe {recipe} is not in the gate")
            if files_recipe not in lists:
                out = ask("just", "--justfile", "justfile", files_recipe)
                lists[files_recipe] = {relative(line) for line in out.splitlines() if line}
            how = str(dump["recipes"][files_recipe]["doc"])
            bad += [
                f"{f}: {lang}, but {tool}'s own file list misses it; {how} (just {files_recipe})"
                for f in files
                if f not in lists[files_recipe]
            ]
    return bad


def unreadable_shebangs(unlisted: set[str]) -> list[str]:
    return [
        f"{f}: scc cannot name the language of its shebang (it drops `env -S` forms); start it"
        " with #!/usr/bin/env <interpreter> or give it an extension"
        for f in sorted(unlisted)
        if Path(f).read_bytes()[:2] == b"#!"
    ]


def both_pnpm_pins() -> list[str]:
    pins = json.loads(ask("mise", "ls", "--local", "--json"))
    package = Path("package.json")
    manifest: dict[str, Any] = (
        json.loads(package.read_text(encoding="utf-8")) if package.is_file() else {}
    )
    if "pnpm" not in pins or "packageManager" not in manifest:
        return []
    return [
        (
            "package.json: packageManager and mise.toml [tools] pnpm both pin pnpm; delete"
            " packageManager: mise owns pnpm (owner ruling, issue #261), and pnpm's switch to"
            " packageManager would override it and need the network"
        )
    ]


def main() -> int:
    files = scanned()
    found = scc_languages(files)
    rows, gate, dump = justfile()
    bad = (
        findings(found, rows, gate, dump)
        + unreadable_shebangs(files - found.keys())
        + both_pnpm_pins()
    )
    for line in bad:
        sys.stderr.write(f"check-languages: {line}\n")
    if bad:
        return 1
    sys.stdout.write(f"languages: ok ({len(files)} tracked files scanned)\n")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (UnansweredError, OSError, ValueError, KeyError) as e:
        sys.exit(f"check-languages: {e}")
