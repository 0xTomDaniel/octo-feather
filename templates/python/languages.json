{
  "languages": {
    "python": {
      "extensions": [
        ".py"
      ],
      "shebangs": [
        "python"
      ],
      "tools": [
        "ruff",
        "ruff-format",
        "basedpyright"
      ]
    },
    "shell": {
      "extensions": [
        ".sh"
      ],
      "shebangs": [
        "bash",
        "sh"
      ],
      "tools": [
        "shellcheck"
      ]
    }
  },
  "tools": {
    "ruff": {
      "program": "ruff",
      "argv": [
        "uv",
        "run",
        "--locked",
        "--offline",
        "--no-sync",
        "ruff",
        "check"
      ],
      "recipe": "check-lint",
      "install": "uv sync --locked"
    },
    "ruff-format": {
      "program": "ruff",
      "argv": [
        "uv",
        "run",
        "--locked",
        "--offline",
        "--no-sync",
        "ruff",
        "format",
        "--check"
      ],
      "recipe": "check-format",
      "install": "uv sync --locked"
    },
    "basedpyright": {
      "program": "basedpyright",
      "argv": [
        "uv",
        "run",
        "--locked",
        "--offline",
        "--no-sync",
        "basedpyright"
      ],
      "recipe": "check-types",
      "adapter": "pyright",
      "install": "uv sync --locked"
    },
    "shellcheck": {
      "program": "shellcheck",
      "argv": [
        "uv",
        "run",
        "--locked",
        "--offline",
        "--no-sync",
        "shellcheck",
        "-S",
        "warning"
      ],
      "recipe": "check-scripts",
      "install": "uv sync --locked (shellcheck-py in uv.lock)"
    }
  },
  "exemptions": [
    {
      "path": "tests/conftest.py",
      "reason": "The octo-feather kit's trend hook, copied byte for byte; the kit gates it and its check-templates enforces the copy."
    }
  ],
  "noncode_extensions": [
    ".md",
    ".json",
    ".toml",
    ".html",
    ".yml",
    ".lock",
    ".css"
  ],
  "noncode_paths": [
    ".gitignore",
    "justfile",
    "just-version",
    ".python-version"
  ],
  "executable_roots": [
    "scripts",
    ".githooks",
    ".agents/skills/verify-app/scripts"
  ]
}
