#!/usr/bin/env bash
# verify-app: drive the `app` CLI the way a user does and keep the proof.
# Usage: verify-app setup|launch|doctor|drive <feature>|cleanup|run
# Run state: $VERIFY_APP_RUN_DIR. Evidence: $VERIFY_APP_EVIDENCE_DIR.
# Both default outside the git dir, under ${TMPDIR:-/tmp}.
set -euo pipefail

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
repo=$(cd "$script_dir/../../../.." && pwd)
repo_key=$(printf '%s' "$repo" | cksum | cut -d' ' -f1)
base="${TMPDIR:-/tmp}/verify-app.$(id -u).$repo_key"
run_dir="${VERIFY_APP_RUN_DIR:-$base/run}"
evidence_dir="${VERIFY_APP_EVIDENCE_DIR:-$base/evidence}"
state="$run_dir/state"
contract="$repo/qc.toml"
features="hello"

say() { printf 'verify-app: %s\n' "$*"; }
die() {
    printf 'verify-app: %s\n' "$*" >&2
    exit 1
}

# Prove a folder is writable by writing to it; `test -w` lies under some sandboxes.
writable() {
    local dir=$1 probe
    mkdir -p "$dir" 2>/dev/null || return 1
    probe="$dir/.verify-app-probe.$$"
    { : >"$probe"; } 2>/dev/null || return 1
    rm -f "$probe"
}

load_state() {
    [[ -f $state ]] || die "no run state at $state: run 'verify-app launch' first"
    # shellcheck source=/dev/null
    . "$state"
}

# The app-driver contract, qc.toml at the repo root (format 1), as shell assignments: QC_SETUP, QC_ENTRY,
# QC_SERVICES (names), QC_FIXTURES and QC_RESETS (names and reset commands), QC_VALUES and QC_VALUES_JSON.
# The helper sets up, enters and resets the app only through these; its commands run under sh with QC_REPO set.
read_contract() {
    command -v python3 >/dev/null || die "python3 (3.11+) not on PATH: verify-app reads $contract with its tomllib"
    python3 - "$contract" <<'EOF_PY'
import json, shlex, sys
try:
    import tomllib
except ImportError:
    sys.exit("verify-app: python3 3.11+ needed: it reads qc.toml with tomllib")
path = sys.argv[1]
try:
    with open(path, "rb") as fh:
        c = tomllib.load(fh)
except (OSError, ValueError) as e:
    sys.exit(f"verify-app: cannot read the app-driver contract {path}: {e}")
if c.get("format") != 1:
    sys.exit(f"verify-app: {path}: format {c.get('format')!r}; this helper reads format 1 (validate: octo-feather-contract)")
entry, services, fixture, values = (c.get(k) for k in ("entry", "services", "fixture", "values"))
if not (isinstance(entry, dict) and isinstance(entry.get("command"), str) and isinstance(services, dict)
        and isinstance(fixture, dict) and all(isinstance(f, dict) and isinstance(f.get("reset"), str) for f in fixture.values())
        and isinstance(values, dict) and all(isinstance(v, str) for v in values.values())):
    sys.exit(f"verify-app: {path} does not match format 1 (validate: octo-feather-contract)")
q, arr = shlex.quote, lambda xs: "(" + " ".join(shlex.quote(x) for x in xs) + ")"
print(f"QC_SETUP={q(c.get('setup', ''))}")
print(f"QC_ENTRY={q(entry['command'])}")
print(f"QC_SERVICES={arr(services)}")
print(f"QC_FIXTURES={arr(fixture)}")
print(f"QC_RESETS={arr(f['reset'] for f in fixture.values())}")
print("declare -gA QC_VALUES=(" + " ".join(f"[{q(k)}]={q(v)}" for k, v in values.items()) + ")")
print(f"QC_VALUES_JSON={q(json.dumps(values))}")
EOF_PY
}

cmd_setup() {
    eval "$(read_contract)" || exit 1
    if [[ -z $QC_SETUP ]]; then say "no setup declared in $contract"; return; fi
    say "setup in $repo (qc.toml setup): $QC_SETUP"
    (cd "$repo" && QC_REPO=$repo sh -c "$QC_SETUP") || die "qc.toml setup failed: $QC_SETUP"
}

cmd_launch() {
    writable "$run_dir" || die "cannot write run state folder: $run_dir"
    writable "$evidence_dir" || die "cannot write evidence folder: $evidence_dir"
    local contract_sh
    contract_sh=$(read_contract) || exit 1
    eval "$contract_sh"
    # A short-lived CLI: this helper starts no service. A contract that declares one needs a helper that starts and readies it.
    [[ ${#QC_SERVICES[@]} == 0 ]] || die "qc.toml declares services (${QC_SERVICES[*]}); this helper drives a CLI and starts none: extend it to start and ready them"
    cmd_setup
    local app py rev
    # The `app` command: qc.toml's entry with the user's arguments appended.
    app="$run_dir/bin/app"
    py="$repo/.venv/bin/python"
    mkdir -p "$run_dir/bin" "$run_dir/scratch"
    printf '#!/usr/bin/env bash\nexport QC_REPO=%q\nexec sh -c %q app "$@"\n' "$repo" "$QC_ENTRY \"\$@\"" >"$app" || die "cannot write app command: $app"
    chmod +x "$app"
    rev=$(git -C "$repo" rev-parse --short HEAD 2>/dev/null || echo unknown)
    {
        printf '%s\n' "$contract_sh"
        printf 'APP=%q\n' "$app"
        printf 'PY=%q\n' "$py"
        printf 'REPO=%q\n' "$repo"
        printf 'REV=%q\n' "$rev"
        printf 'LAUNCHED=%q\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    } >"$state" || die "cannot write run state file: $state"
    [[ -s $state ]] || die "run state file is empty: $state"
    say "ready: app=$app entry=$QC_ENTRY rev=$rev"
    say "run state: $run_dir"
    say "evidence:  $evidence_dir"
}

# APP, PY, REPO, REV and the contract's QC_* come from the state file.
# shellcheck disable=SC2153
cmd_doctor() {
    load_state
    local ok=0 out version origin rev
    report() { printf '%-8s %s\n' "$1" "$2"; }
    if [[ -x $APP ]]; then report ok "app command $APP"; else
        report FAIL "app command missing: $APP"
        ok=1
    fi
    report info "entry (qc.toml): $QC_ENTRY"
    if out=$("$APP" --help 2>&1) && grep -q 'hello' <<<"$out"; then
        report ok "'app --help' lists hello"
    else
        report FAIL "'app --help' failed or lacks hello"
        ok=1
    fi
    version=$("$PY" -c 'import importlib.metadata as m; print(m.version("app"))' 2>&1) || ok=1
    report info "app version $version"
    origin=$("$PY" -c 'import app; print(app.__file__)' 2>&1) || ok=1
    if [[ $origin == "$REPO/src/"* ]]; then report ok "app imports from this checkout: $origin"; else
        report FAIL "app imports from elsewhere: $origin"
        ok=1
    fi
    rev=$(git -C "$REPO" rev-parse --short HEAD 2>/dev/null || echo unknown)
    if [[ $rev == "$REV" ]]; then report ok "checkout at launch rev $REV"; else
        report WARN "checkout moved: launched at $REV, now $rev (relaunch)"
    fi
    if [[ -d $run_dir/scratch ]]; then report ok "scratch cwd $run_dir/scratch"; else
        report FAIL "scratch cwd missing"
        ok=1
    fi
    return "$ok"
}

# One isolated case: fresh empty cwd, captured argv, stdout, stderr, exit code.
# case_run <dir> <name> <arg>...
case_run() {
    local dir=$1 name=$2
    shift 2
    local cwd="$run_dir/scratch/$name" code=0
    rm -rf "$cwd" && mkdir -p "$cwd"
    printf '%q ' app "$@" >"$dir/$name.cmd"
    echo >>"$dir/$name.cmd"
    (cd "$cwd" && "$APP" "$@") >"$dir/$name.stdout" 2>"$dir/$name.stderr" || code=$?
    echo "$code" >"$dir/$name.exit"
    # Side effect check: the CLI writes no files where it runs.
    find "$cwd" -mindepth 1 >"$dir/$name.files"
}

# check <dir> <name> <python-expr over j (stdout JSON or None), out, err, code, v (qc.toml values)>
check() {
    local dir=$1 name=$2 expr=$3 verdict
    verdict=$(
        "$PY" - "$dir" "$name" "$expr" "$QC_VALUES_JSON" <<'EOF'
import json, pathlib, sys
d, n, expr = pathlib.Path(sys.argv[1]), sys.argv[2], sys.argv[3]
v = json.loads(sys.argv[4])
out = (d / f"{n}.stdout").read_text()
err = (d / f"{n}.stderr").read_text()
code = int((d / f"{n}.exit").read_text())
files = (d / f"{n}.files").read_text()
try:
    j = json.loads(out)
except ValueError:
    j = None
print("PASS" if eval(expr) and files == "" else "FAIL")
EOF
    )
    printf '%s %s: %s\n' "$verdict" "$name" "$(cat "$dir/$name.cmd")" | tee -a "$dir/summary.txt"
    # Show what the user saw: stdout and stderr, then the exit code.
    sed 's/^/    stdout: /' "$dir/$name.stdout"
    sed 's/^/    stderr: /' "$dir/$name.stderr"
    printf '    exit: %s\n' "$(cat "$dir/$name.exit")"
    [[ $verdict == PASS ]]
}

drive_hello() {
    local dir="$evidence_dir/hello" fails=0 name
    # The name greeted: qc.toml values.name.
    [[ -n ${QC_VALUES[name]+set} ]] || die "qc.toml [values] has no name: the hello drive greets values.name"
    name=${QC_VALUES[name]}
    rm -rf "$dir" && mkdir -p "$dir"
    echo "hello @ rev $REV, $(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$dir/summary.txt"
    case_run "$dir" json hello "$name" --json
    check "$dir" json 'code == 0 and err == "" and j == {"name": v["name"], "text": "Hello, " + v["name"]}' || fails=1
    case_run "$dir" text hello "$name"
    check "$dir" text 'code == 0 and err == "" and out == "Hello, " + v["name"] + "\n"' || fails=1
    case_run "$dir" trimmed hello "  $name  " --json
    check "$dir" trimmed 'code == 0 and j == {"name": v["name"], "text": "Hello, " + v["name"]}' || fails=1
    case_run "$dir" empty-json hello '  ' --json
    check "$dir" empty-json 'code == 2 and err == "" and isinstance(j, dict) and set(j) == {"error"} and j["error"]' || fails=1
    case_run "$dir" empty-text hello '  '
    check "$dir" empty-text 'code == 2 and out == "" and err.startswith("error: ")' || fails=1
    say "hello evidence: $dir"
    return "$fails"
}

cmd_drive() {
    local feature=${1:-}
    [[ -n $feature ]] || die "usage: verify-app drive <feature> (features: $features)"
    load_state
    writable "$evidence_dir" || die "cannot write evidence folder: $evidence_dir"
    local i
    for i in "${!QC_FIXTURES[@]}"; do
        say "reset fixture ${QC_FIXTURES[i]} (qc.toml)"
        (cd "$REPO" && QC_REPO=$REPO sh -c "${QC_RESETS[i]}") || die "qc.toml fixture ${QC_FIXTURES[i]} reset failed: ${QC_RESETS[i]}"
    done
    local code=0
    case $feature in
    hello) drive_hello || code=1 ;;
    *) die "unknown feature '$feature' (features: $features)" ;;
    esac
    record_evidence "$feature"
    return "$code"
}

# Every drive, passed or failed, appends one record to this repo's evidence store (octo-feather quality spec
# #evidence-store) through the kit's octo-feather-evidence: the criterion the feature file's
# `Drive criterion:` line names, the feature's evidence folder as its outputs. The store is outside the repo
# and outside both helper folders; cleanup never touches it.
record_evidence() {
    local feature=$1 file="$script_dir/../features/$1.md" crit link id
    command -v octo-feather-evidence >/dev/null ||
        die "octo-feather-evidence (the octo-feather kit's scripts/) not on PATH: every drive appends a record to the evidence store"
    crit=$(sed -n 's/^Drive criterion: `\([^`]*\)`.*/\1/p' "$file" | head -n 1)
    [[ -n $crit ]] || die "$file has no Drive criterion line (Drive criterion: \`<spec>#<anchor>\`): each drive names the criterion it serves"
    # The criterion's text, when this repo has no spec holding it: the feature file's line linking it.
    link=$(grep -m 1 -F "#${crit#*#})" "$file" || true)
    id=$(octo-feather-evidence append --repo "$REPO" --criterion "$crit" --criterion-text "$link" --outputs "$evidence_dir/$feature") ||
        die "evidence record for $feature not appended (octo-feather-evidence failed, message above)"
    say "evidence record $id (criterion $crit; read: octo-feather-evidence read --criterion $crit --commit $REV)"
}

cmd_cleanup() {
    # Nothing runs in the background: the CLI exits per case. Remove only our run state.
    if [[ -e $run_dir ]]; then
        rm -rf "$run_dir/scratch" "$state"
        rm -f "$run_dir/bin/app"
        rmdir "$run_dir/bin" 2>/dev/null || true
        rmdir "$run_dir" 2>/dev/null || true
        say "removed run state $run_dir"
    fi
    say "evidence kept at $evidence_dir"
}

cmd_run() {
    local code=0
    cmd_launch
    cmd_doctor | tee "$evidence_dir/doctor.txt" || code=1
    if [[ $code == 0 ]]; then cmd_drive hello || code=1; fi
    cmd_cleanup
    [[ -d $evidence_dir ]] || die "evidence folder gone after cleanup: $evidence_dir"
    ls -laR "$evidence_dir"
    if [[ $code == 0 ]]; then say "run PASS"; else say "run FAIL"; fi
    return "$code"
}

case ${1:-} in
setup) cmd_setup ;;
launch) cmd_launch ;;
doctor) cmd_doctor ;;
drive)
    shift
    cmd_drive "$@"
    ;;
cleanup) cmd_cleanup ;;
run) cmd_run ;;
*) die "usage: verify-app setup|launch|doctor|drive <feature>|cleanup|run" ;;
esac
