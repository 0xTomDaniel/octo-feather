# The gate's two tiers (AGENTS.md): CI runs `just check`, the full tier; agents and .githooks/pre-commit run `just fast`.

set shell := ["bash", "-euo", "pipefail", "-c"]
# Recipe arguments reach the shell as "$@", never as pasted text.
set positional-arguments

# This repo's tools (mise.toml at mise.lock versions) on PATH for every recipe, from any caller (a shell, the git
# hook, CI, an agent pane): mise's own answer for this repo's config (`mise bin-paths`, the config its shims read),
# placed just before the caller PATH's first system dir (/usr/local/sbin /usr/local/bin /usr/sbin /usr/bin /sbin
# /bin; at the end when it has none): mise replaces only what would resolve from the system, and every dir the
# caller put earlier still wins. A tool not installed is named on stderr with the fix. Only this repo's tools, which
# scripts/own-tool-paths.ts names (its node found through `mise which`, which installs nothing): `mise bin-paths`
# alone adds the user's global mise tools too (octo-feather #500). From another working directory
# (`just --working-directory DIR`, where backticks run) the script is not found: none.
export PATH := `command -v mise >/dev/null || { echo "just: mise is not on PATH, so this repo's tools (mise.toml) are not resolved; install mise $(cat mise-version) (mise-version)" >&2; printf '%s' "$PATH"; exit 0; }; m="$(mise ls --local --missing 2>/dev/null | awk '{print $1 "@" $2}' | paste -sd ' ' -)"; [[ -z "$m" ]] || echo "just: not installed: $m (mise.toml, mise.lock); run: octo-feather-mise-install (the octo-feather kit's scripts/)" >&2; n="$(mise which node 2>/dev/null)" || n=""; add="$([[ -z "$n" ]] || "$n" scripts/own-tool-paths.ts 2>/dev/null)" || add=""; out=""; put=""; IFS=: read -ra ds <<<"$PATH"; for d in "${ds[@]}"; do [[ -n "$d" ]] || continue; case "${d%/}" in /usr/local/sbin|/usr/local/bin|/usr/sbin|/usr/bin|/sbin|/bin) [[ -n "$put" ]] || { out+="${add:+$add:}"; put=1; } ;; esac; out+="$d:"; done; [[ -n "$put" ]] || out+="${add:+$add:}"; printf '%s' "${out%:}"`

default:
    @just --list

# Install the pinned tools (mise.toml, mise.lock), dependencies and the git hook. The tools: octo-feather-mise-install,
# the octo-feather kit's one install of a repo's own locked mise tools (why not a bare mise install: its --help), when
# on PATH (an agent pane's); else mise's own `mise install --locked`, and on its failure the kit command is named.
setup:
    @if command -v octo-feather-mise-install >/dev/null; then octo-feather-mise-install; else mise install --locked || { rc=$?; echo "just setup: mise install --locked failed (exit $rc); if it names tools of your global mise config, install only this repo's: octo-feather-mise-install, in the octo-feather kit's scripts dir (e.g. ~/src/octo-feather/scripts/octo-feather-mise-install)" >&2; exit "$rc"; }; fi
    pnpm install --frozen-lockfile
    git config core.hooksPath .githooks

# Every tracked language gated, shell, types and lint, architecture, dead code, integration and E2E tests: each a
# dependency of check, so what the gate runs is just's own answer (scripts/check-languages.ts reads it).
check: check-static check-tests

# The static checks both tiers run first.
check-static: check-languages check-scripts check-ts check-arch check-dead-code

# The fast tier (octo-feather quality spec #recipe-fast): the static checks, then the integration test files Vitest
# picks by their imports of the files changed since the branch left main (vitest --changed), each test named; no
# end-to-end test (the integration project only: vitest.config.ts). A change since then to a path on
# shared-machinery.txt, which the import graph cannot see, runs every integration test.
fast: check-static
    #!/usr/bin/env bash
    set -euo pipefail
    sel=()
    if ! base="$(git merge-base HEAD main 2>/dev/null)"; then
      echo "fast: every integration test: no merge base with main to compare against"
    else
      mapfile -t specs < <(sed -n '/^[[:space:]]*\(#\|$\)/!s/^/:(glob)/p' shared-machinery.txt)
      hit="$({ git diff --name-only "$base" -- "${specs[@]}"; git ls-files -o --exclude-standard -- "${specs[@]}"; } | sort -u | paste -sd' ' -)"
      if [[ -n "$hit" ]]; then
        echo "fast: every integration test: $hit changed since main, on shared-machinery.txt (the import graph cannot see it)"
      else echo "fast: the integration test files Vitest picks by their imports of the files changed since main"; sel=(--changed "$base"); fi
    fi
    pnpm exec vitest run --project integration --reporter=verbose "${sel[@]}"

# Every language scc finds in the tracked files has its lint and type step in check; rules and what passes by
# design: the head of scripts/check-languages.ts.
check-languages:
    node scripts/check-languages.ts

# check-languages' data (the head of scripts/check-languages.ts): one LANGUAGE:TOOL:GATE_RECIPE:FILES_RECIPE entry
# per language scc can name and gate tool that must cover its files; FILES_RECIPE prints that tool's own file list.
check_languages := "TypeScript:tsc:check-ts:ts-files TypeScript:eslint:check-ts:eslint-files JavaScript:tsc:check-ts:ts-files JavaScript:eslint:check-ts:eslint-files Shell:shellcheck:check-scripts:shell-files BASH:shellcheck:check-scripts:shell-files"

# tsc's own file list: add a path to tsconfig.json include (a dot path or dotfile by name)
ts-files:
    @pnpm exec tsc --showConfig | node -e 'let s = ""; process.stdin.on("data", (d) => (s += d)).on("end", () => { for (const f of JSON.parse(s).files ?? []) console.log(f); })'

# Its JSON report of `eslint .`, as check-ts runs it.
# The files eslint lints: lint the file in eslint.config.js (out of its ignores)
eslint-files:
    @{ pnpm exec eslint --format json . || true; } | node -e 'let s = ""; process.stdin.on("data", (d) => (s += d)).on("end", () => { for (const r of JSON.parse(s)) console.log(r.filePath); })'

# ShellCheck's file list: give a file the `shell` attribute in .gitattributes
shell-files:
    @git ls-files ':(attr:shell)'

check-scripts:
    just shell-files | xargs -d '\n' shellcheck -S warning

check-ts:
    pnpm exec tsc
    pnpm exec eslint --max-warnings 0 .

check-arch:
    pnpm exec depcruise src tests

check-dead-code:
    pnpm exec knip

# Every test, each named with its kind (its Vitest project: vitest.config.ts).
check-tests:
    pnpm exec vitest run --reporter=verbose

# Integrate worker commits onto the lane of TICKET (12, ENG-123), its branch the lane key (octo-feather kit script on PATH).
integrate issue +refs:
    octo-feather-integrate "$@"

# Product QC on the lane head: passed criteria become built (octo-feather kit script on PATH; never in check).
qc $status $pr +$ids:
    octo-feather-qc "$@"
