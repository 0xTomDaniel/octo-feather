{
  "languages": {
    "typescript": {
      "extensions": [
        ".ts"
      ],
      "shebangs": [],
      "tools": [
        "tsc",
        "eslint"
      ]
    },
    "javascript": {
      "extensions": [
        ".js",
        ".cjs",
        ".mjs"
      ],
      "shebangs": [],
      "tools": [
        "tsc",
        "eslint"
      ]
    },
    "shell": {
      "extensions": [
        ".sh"
      ],
      "shebangs": [
        "bash",
        "sh"
      ],
      "tools": [
        "shellcheck"
      ]
    }
  },
  "tools": {
    "tsc": {
      "program": "tsc",
      "argv": [
        "pnpm",
        "exec",
        "tsc"
      ],
      "recipe": "check-ts",
      "adapter": "tsc",
      "install": "pnpm install --frozen-lockfile"
    },
    "eslint": {
      "program": "eslint",
      "argv": [
        "pnpm",
        "exec",
        "eslint",
        "--max-warnings",
        "0",
        "--"
      ],
      "recipe": "check-ts",
      "install": "pnpm install --frozen-lockfile"
    },
    "shellcheck": {
      "program": "node",
      "argv": [
        "node",
        "scripts/shellcheck.ts",
        "-S",
        "warning"
      ],
      "recipe": "check-scripts",
      "install": "pnpm install --frozen-lockfile (@vscode-shellcheck/shellcheck-wasm in pnpm-lock.yaml)"
    }
  },
  "exemptions": [],
  "noncode_extensions": [
    ".md",
    ".json",
    ".toml",
    ".html",
    ".yml",
    ".yaml",
    ".css"
  ],
  "noncode_paths": [
    ".gitignore",
    "justfile",
    "just-version",
    ".node-version"
  ],
  "executable_roots": [
    ".githooks"
  ]
}
