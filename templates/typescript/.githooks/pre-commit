#!/usr/bin/env bash
# The fast tier agents run (AGENTS.md); CI runs the full one, just check.
# Only a writer's commit runs it: a maintainer's (no OCTO_FEATHER_ROLE), an
# implementer's or a corrector's, with no merge, cherry-pick or revert in progress; any other commit is a machine's
# and skips, saying why. It cannot stop an agent whose environment lost OCTO_FEATHER_ROLE (taken for a maintainer),
# nor --no-verify.
case "${OCTO_FEATHER_ROLE:-}" in ""|implementer|corrector) ;; *) echo "pre-commit: fast tier skipped: OCTO_FEATHER_ROLE=$OCTO_FEATHER_ROLE: a machine commit, not a writer's"; exit 0 ;; esac
for h in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD; do [[ ! -e "$(git rev-parse --git-path "$h" 2>/dev/null)" ]] || { echo "pre-commit: fast tier skipped: $h: a merge, cherry-pick or revert in progress is a machine commit"; exit 0; }; done
exec just fast
